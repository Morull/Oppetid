# --- Postgres ---
POSTGRES_USER=kraftverk
POSTGRES_PASSWORD=kraftverk
POSTGRES_DB=kraftverk
POSTGRES_PORT=5432

# --- Porter (host) ---
# Web binder til alle nettverks-interfaces (Docker default), så alle på
# samme LAN kan bruke `http://<server-ip>:5180`. Endre hvis port er opptatt.
API_PORT=5080
WEB_PORT=5180

# --- Hot-folder for auto-import (SCADA + settlement-eksporter) ---
# Default: ./CSV Eksporter (relativt til prosjekt-rota).
#
# På en delt kontor-PC bør dette peke til en delt nettverks-mappe slik at
# kollegaer kan droppe filer direkte uten å logge inn på selve serveren:
#
#   HOT_FOLDER_HOST_PATH=C:\Oppetid-imports
#   HOT_FOLDER_HOST_PATH=Z:\Oppetid\CSV Eksporter
#
# Husk: Docker Desktop → Settings → Resources → File Sharing må ha tilgang
# til drive-bokstaven hvis du peker til en mappet drive.
# HOT_FOLDER_HOST_PATH=./CSV Eksporter

# --- Azure Key Vault (tom i dev, settes i prod) ---
# KEYVAULT_URL=https://kv-kraftverkuptime-prod.vault.azure.net/

# --- Application Insights (tom i dev) ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- OTLP endpoint (valgfritt) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
