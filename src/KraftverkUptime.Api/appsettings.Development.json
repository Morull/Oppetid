{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=kraftverk;Username=kraftverk;Password=kraftverk",
    "EnableSensitiveDataLogging": true
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "./_filestore"
  },
  "Settlements": {
    "MaxUploadBytes": 26214400,
    "AllowedContentTypes": [
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.ms-excel",
      "application/octet-stream"
    ],
    "DevDefaultOwnerOrgId": "dev-org"
  },
  "Observability": {
    "ServiceName": "kraftverkuptime-api-dev",
    "ExportToConsole": true
  }
}
