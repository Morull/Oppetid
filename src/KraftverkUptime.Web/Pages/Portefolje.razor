@page "/portefolje"
@implements IDisposable
@inject NedetidApi NedetidApi
@inject KaiaCostApi KaiaCostApi
@inject ReportsApi ReportsApi
@inject FilterState Filter
@inject NavigationManager Nav

<PageTitle>Portefølje-rapport</PageTitle>

<style>
    /* Sticky first column så anleggsnavnet alltid er synlig under
       horisontalt scroll, og bedre layout-kontroll på vide tabeller. */
    .dk-portfolio-table-wrap {
        overflow-x: auto;
        max-width: 100%;
        position: relative;
    }
    .dk-portfolio-table table {
        white-space: nowrap;
        min-width: 100%;
    }
    .dk-portfolio-table thead th:first-child,
    .dk-portfolio-table tbody td:first-child,
    .dk-portfolio-table tfoot td:first-child {
        position: sticky;
        left: 0;
        background-color: var(--mud-palette-surface, #1A1F2C);
        z-index: 2;
        box-shadow: 2px 0 4px rgba(0,0,0,0.2);
    }
    .dk-portfolio-table thead th:first-child {
        z-index: 3;
    }
    /* Mer luftig padding på celler */
    .dk-portfolio-table tbody td {
        padding: 8px 12px !important;
    }
    .dk-portfolio-table thead th {
        padding: 10px 12px !important;
    }
    /* Spec NESTE-CHAT-VAKTROI-OG-UI-FIKS.md Del C: høyrejustering på
       numeriske kolonner. MudBlazor sin default sett text-align:start
       på alle celler, så vi MÅ bruke !important her for å overstyre. */
    .dk-portfolio-table .num,
    .dk-portfolio-table th.num,
    .dk-portfolio-table td.num {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }
    /* Anlegg-kolonnen: gi en rimelig min/max så residual-bredde fordeles
       til de andre kolonnene istedenfor å samle seg i Anlegg på ultrawide. */
    .dk-portfolio-table thead th:first-child,
    .dk-portfolio-table tbody td:first-child,
    .dk-portfolio-table tfoot td:first-child {
        min-width: 140px;
        max-width: 220px;
    }
</style>

<PageHeader Title="Portefølje-rapport"
            Subtitle="Samlet rapport på tvers av alle anlegg for valgt periode. Klikk anleggs-rad for detaljer. Hold musepekeren over kolonneoverskriftene for forklaringer." />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2 d-inline">Henter portefølje-data (alle anlegg parallelt)…</MudText>
}
else if (_rows is not null)
{
    @if (_rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            Ingen anlegg har en settlement-import som dekker valgt periode.
        </MudAlert>
    }
    else
    {
        @* ---- Data-mangler-banner (hvis noen anlegg mangler delsett) ---- *@
        var medMangler = _rows.Where(r => r.MissingData.Count > 0).ToList();
        @if (medMangler.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>Rapporten er ikke komplett:</strong>
                    @medMangler.Count av @_rows.Count anlegg mangler data —
                    @string.Join("; ",
                        medMangler.Select(r =>
                            $"{r.PlantName} ({string.Join(", ", r.MissingData)})"))
                </MudText>
            </MudAlert>
        }

        @* "Vurdering av vaktordningen" er flyttet til /vakt-roi i portefølje-modus
           (2026-05-19). Brukeren kommer dit ved å trykke Vakt-ROI-fanen uten et
           anlegg valgt. *@

        @* ---- KPI-strip øverst: total-bildet for porteføljen ---- *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <KpiCard Label="Produksjon"
                         Value="@($"{FormatMwh(_rows.Sum(r => r.TotalProductionMwh))} MWh")"
                         SubText="@($"{_rows.Count} anlegg · {FormatMwh(_rows.Sum(r => r.InstalledCapacityMw))} MW installert")"
                         Accent="KpiAccent.Neutral" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiCard Label="Spotomsetning"
                         Value="@($"{FormatNok(_rows.Sum(r => r.SpotomsetningNok))} NOK")"
                         SubText="@($"Merverdi: {FormatNokSigned(MerverdiSum())}")"
                         Accent="@MerverdiAccent(MerverdiSum())" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiCard Label="Nedetidstap"
                         Value="@($"{FormatNok(_rows.Sum(r => r.TapNok))} NOK")"
                         SubText="@($"{FormatHours(_rows.Sum(r => r.NedetidTimer))} timer · {_rows.Sum(r => r.AntallEvents)} hendelser")"
                         Accent="KpiAccent.Negative" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiCard Label="Reddet av vakt"
                         Value="@($"{FormatNok(_totalReddetNok)} NOK")"
                         SubText="@($"{_rows.Sum(r => r.AntallReddbare)} av {_rows.Sum(r => r.AntallEvents)} events reddbare")"
                         Accent="KpiAccent.Accent"
                         State="@(_totalReddetNok > 0 ? KpiState.Normal : KpiState.NoData)" />
            </MudItem>
        </MudGrid>

        @* KAIA-kostnad (Spec KAIA-KOSTNAD): porteføljesum av meglerprovisjon
           + fast årsavgift pro-rata. Egen rad slik at den ikke konkurrerer
           visuelt med de viktigste KPI-ene over. *@
        @if (_kaiaTotalNok.HasValue || _kaiaLoading)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6" md="4">
                    <KpiCard Label="KAIA-kostnad (totalt)"
                             Value="@(_kaiaLoading ? "—" : $"{FormatNok(_kaiaTotalNok ?? 0)} NOK")"
                             SubText="@(_kaiaLoading ? null : KaiaSubText())"
                             Accent="KpiAccent.Warning"
                             State="@(_kaiaLoading ? KpiState.Loading : KpiState.Normal)"
                             InfoText="KAIAs egen inntekt fra forvaltningen: meglerprovisjon på handler + fast årsavgift pro-rata på periodens lengde. Nord Pool- og eSett-gebyrer er viderefakturert og holdes utenfor." />
                </MudItem>
            </MudGrid>
        }

        @* ---- Hovedtabell med sticky first column ----
           Kolonnesett: 7 default (kjerne-KPI-er), 6 ekstra (skjult under "Vis flere").
           UI-gjennomgang 2026-05-20 tiltak 3: 13 kolonner ga tung horisontal scroll
           selv på wide-screen. Brukeren kan klikke en rad for å se hele anleggets
           detaljside med alle KPI-er. *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center mb-2">
                <div class="d-flex align-center" style="gap: 8px;">
                    <MudText Typo="Typo.h4">
                        Per-anleggs detaljer (@_rows.Count anlegg)
                    </MudText>
                    <HjelpeIkon Tittel="Per-anleggs detaljer"
                                Beskrivelse="Én rad per anlegg med drift- og økonomi-KPI for valgt periode. Klikk en rad for å åpne anleggets rapport-detalj. Hold musepekeren over kolonneoverskriftene for forklaringer."
                                Begreper="@(new[] { "MW", "AF", "FOR", "MWh", "NOK", "CR", "Merverdi" })" />
                </div>
                <MudSwitch T="bool" @bind-Value="_showAllColumns"
                           Color="MudBlazor.Color.Primary"
                           Size="MudBlazor.Size.Small">
                    Vis alle kolonner (@(_showAllColumns ? "13" : "7") synlige)
                </MudSwitch>
            </div>
            <div class="dk-portfolio-table-wrap">
                <MudTable Items="_rows" Hover="true" Dense="true" Elevation="0" SortLabel="Sortér"
                          OnRowClick="@((TableRowClickEventArgs<Row> args) => OnRowClick(args.Item))"
                          RowStyle="cursor: pointer;"
                          Class="dk-portfolio-table">
                    <HeaderContent>
                        <MudTh Style="min-width: 110px;"><MudTableSortLabel SortBy="@SortByName">Anlegg</MudTableSortLabel></MudTh>
                        <MudTh Class="num">
                            <MudTooltip Text="Installert effekt på generatoren(e) i megawatt. Brukes som baseline-kapasitet i KPI-ene.">
                                <MudTableSortLabel SortBy="@SortByCapacity">Effekt (MW)</MudTableSortLabel>
                            </MudTooltip>
                        </MudTh>
                        <MudTh Class="num">
                            <MudTooltip Text="Availability Factor — andel av perioden anlegget var tilgjengelig for produksjon (uten planlagt/uplanlagt nedetid). Høyt tall = bra.">
                                <MudTableSortLabel SortBy="@SortByAf">AF</MudTableSortLabel>
                            </MudTooltip>
                        </MudTh>
                        <MudTh Class="num">
                            <MudTooltip Text="Forced Outage Rate — andel av perioden anlegget var nede på grunn av uplanlagte feil (trip, alarm). Lavt tall = bra.">
                                <MudTableSortLabel SortBy="@SortByFor">FOR</MudTableSortLabel>
                            </MudTooltip>
                        </MudTh>
                        <MudTh Class="num">
                            <MudTooltip Text="Total levert energi til Elhub i perioden (MWh).">
                                <MudTableSortLabel SortBy="@SortByMwh">Produksjon (MWh)</MudTableSortLabel>
                            </MudTooltip>
                        </MudTh>
                        <MudTh Class="num">
                            <MudTooltip Text="Faktisk produksjon som andel av normalåret pro-rata på perioden. 100 % = på snitt; > 100 % over et normalår; < 100 % under. Krever at normal årsproduksjon er satt på anlegget (PlantAdmin).">
                                <MudTableSortLabel SortBy="@SortByNormalAar">Normalår %</MudTableSortLabel>
                            </MudTooltip>
                        </MudTh>
                        <MudTh Class="num">
                            <MudTooltip Text="Spotomsetning — produksjon × spotpris time-for-time. Det du teoretisk ville fått hvis du solgte alt på spot.">
                                <MudTableSortLabel SortBy="@SortByNok"
                                    InitialDirection="SortDirection.Descending">Spotoms (NOK)</MudTableSortLabel>
                            </MudTooltip>
                        </MudTh>
                        @if (_showAllColumns)
                        {
                            <MudTh Class="num">
                                <MudTooltip Text="Capture Rate — gjennomsnittlig oppnådd pris ÷ snitt-spotpris. Over 1.0× = du traff bedre tider; under 1.0× = du solgte når prisen var lav.">
                                    <MudTableSortLabel SortBy="@SortByCr">CR</MudTableSortLabel>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Class="num">
                                <MudTooltip Text="Merverdi over flat spotomsetning. Positiv = Hydrogrid/planen ga ekstra inntekter ved smart timing. Negativ = motsatt.">
                                    <MudTableSortLabel SortBy="@SortByMerverdi">Merverdi</MudTableSortLabel>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Class="num">
                                <MudTooltip Text="Sum nedetidstimer fra klassifisert settlement-data. Inkluderer både planlagt og uplanlagt.">
                                    <MudTableSortLabel SortBy="@SortByNedetid">Nedetid (t)</MudTableSortLabel>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Class="num">
                                <MudTooltip Text="Estimert tap i nedetid: nedetid-timer × forventet produksjon × spotpris.">
                                    <MudTableSortLabel SortBy="@SortByTapNok">Tap (NOK)</MudTableSortLabel>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Class="num">
                                <MudTooltip Text="Sum NOK vakten reddet ved å fikse nedetid utenom arbeidstid. Sammenlign mot vakt-kost på /vakt-roi.">
                                    <MudTableSortLabel SortBy="@SortByReddetNok">Reddet vakt (NOK)</MudTableSortLabel>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Class="num">
                                <MudTooltip Text="Antall reddbare events (innenfor vakt-vindu og av rett kategori) / totalt antall events i perioden.">
                                    <span>Reddbare</span>
                                </MudTooltip>
                            </MudTh>
                        }
                        <MudTh Class="num">
                            <MudTooltip Text="Andel timer med god data (alle kilder + Elhub stemmer overens med plan). Lavt tall flagges som varsel.">
                                <MudTableSortLabel SortBy="@SortByDq">Datakvalitet</MudTableSortLabel>
                            </MudTooltip>
                        </MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="font-weight: 500;">
                            <div class="d-flex align-center" style="gap:6px;">
                                <span style="color: var(--mud-palette-primary);">@context.PlantName</span>
                                @if (context.MissingData.Count > 0)
                                {
                                    <MudTooltip Text="@($"Mangler: {string.Join(", ", context.MissingData)}")">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning"
                                                 Color="MudBlazor.Color.Warning"
                                                 Size="MudBlazor.Size.Small" />
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                        <MudTd Class="num">
                            @if (context.InstalledCapacityMw <= 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.PriorityHigh"
                                         Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" />
                            }
                            else { @context.InstalledCapacityMw.ToString("F1", NumberFormat.Norsk) }
                        </MudTd>
                        <MudTd Class="num">@FormatRatio(context.AvailabilityFactor)</MudTd>
                        <MudTd Class="num">@FormatRatio(context.ForcedOutageRate)</MudTd>
                        <MudTd Class="num">@FormatMwh(context.TotalProductionMwh)</MudTd>
                        <MudTd Class="num">@FormatNormalAarsAndel(NormalAarsAndel(context))</MudTd>
                        <MudTd Class="num">@FormatNok(context.SpotomsetningNok)</MudTd>
                        @if (_showAllColumns)
                        {
                            <MudTd Class="num">@FormatCr(context.CaptureRateTimes)</MudTd>
                            <MudTd Class="num">@FormatMerverdi(context.MerverdiNok)</MudTd>
                            <MudTd Class="num">@FormatHours(context.NedetidTimer)</MudTd>
                            <MudTd Class="num">@FormatNok(context.TapNok)</MudTd>
                            <MudTd Class="num">
                                <span style="color: @(context.ReddetNok > 0 ? "var(--mud-palette-success)" : "inherit"); font-weight: @(context.ReddetNok > 0 ? "600" : "400");">
                                    @FormatNok(context.ReddetNok)
                                </span>
                            </MudTd>
                            <MudTd Class="num">
                                @if (context.AntallEvents > 0)
                                {
                                    <span>@context.AntallReddbare / @context.AntallEvents</span>
                                }
                                else { <span>–</span> }
                            </MudTd>
                        }
                        <MudTd Class="num">
                            <DataQualityBadge Summary="@context.DataQuality" />
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTFootRow Style="background: rgba(46,157,143,0.08); font-weight: 600;">
                            <MudTd><strong>SUM</strong></MudTd>
                            <MudTd Class="num" Style="white-space: nowrap;">@_rows.Sum(r => r.InstalledCapacityMw).ToString("F1", NumberFormat.Norsk)</MudTd>
                            <MudTd Class="num" Style="color: var(--mud-palette-text-secondary);">—</MudTd>
                            <MudTd Class="num" Style="color: var(--mud-palette-text-secondary);">—</MudTd>
                            <MudTd Class="num" Style="white-space: nowrap;">@FormatMwh(_rows.Sum(r => r.TotalProductionMwh))</MudTd>
                            <MudTd Class="num" Style="white-space: nowrap;">@FormatNormalAarsAndel(NormalAarsAndelTotal())</MudTd>
                            <MudTd Class="num" Style="white-space: nowrap;">@FormatNok(_rows.Sum(r => r.SpotomsetningNok))</MudTd>
                            @if (_showAllColumns)
                            {
                                <MudTd Class="num" Style="color: var(--mud-palette-text-secondary);">—</MudTd>
                                <MudTd Class="num" Style="white-space: nowrap;">@FormatNokSigned(_rows.Sum(r => r.MerverdiNok))</MudTd>
                                <MudTd Class="num" Style="white-space: nowrap;">@FormatHours(_rows.Sum(r => r.NedetidTimer))</MudTd>
                                <MudTd Class="num" Style="white-space: nowrap;">@FormatNok(_rows.Sum(r => r.TapNok))</MudTd>
                                <MudTd Class="num" Style="white-space: nowrap;">@FormatNok(_totalReddetNok)</MudTd>
                                <MudTd Class="num" Style="white-space: nowrap;">
                                    @_rows.Sum(r => r.AntallReddbare) / @_rows.Sum(r => r.AntallEvents)
                                </MudTd>
                            }
                            <MudTd Class="num" Style="white-space: nowrap;">@FormatPortfolioGoodPct()</MudTd>
                        </MudTFootRow>
                    </FooterContent>
                </MudTable>
            </div>
        </MudPaper>
    }
}

@code {
    private bool _loading;
    private string? _error;
    private List<Row>? _rows;
    private double _totalReddetNok;

    // Kolonnesynlighet: default = kjerne-KPI-er (7 kolonner). Bruker kan toggle
    // til alle 13 hvis hen vil se hele bildet. Resten tilgjengelig via klikk
    // på rad → /anlegg/{id}. UI-gjennomgang 2026-05-20 tiltak 3.
    private bool _showAllColumns;

    // KAIA-kostnad (Spec KAIA-KOSTNAD). Lastes parallelt med portefølje-KPI-ene
    // — én HTTP-call returnerer alle anlegg for perioden.
    private bool _kaiaLoading;
    private double? _kaiaTotalNok;
    private double _kaiaMeglerNok;
    private double _kaiaFastNok;
    private int _kaiaUkjentCount;
    private Dictionary<string, KaiaCostDto> _kaiaByPlant = new(StringComparer.OrdinalIgnoreCase);


    /// <summary>
    /// Aggregert rad per anlegg som kombinerer portefølje-KPI-er, vakt-ROI og
    /// nedetid-summary. Bygges ved å fan-out parallelle API-kall fra Web.
    /// <see cref="MissingData"/> samler hvilke kall som feilet for dette
    /// anlegget; UI viser et advarsel-ikon på raden + en summary-banner.
    /// </summary>
    private sealed record Row(
        string PlantId,
        string PlantName,
        double InstalledCapacityMw,
        double AvailabilityFactor,
        double ForcedOutageRate,
        double TotalProductionMwh,
        double SpotomsetningNok,
        double CaptureRateTimes,
        double MerverdiNok,
        double NedetidTimer,
        double TapNok,
        double ReddetNok,
        int AntallEvents,
        int AntallReddbare,
        DataQualitySummaryDto? DataQuality,
        double? NormalAarsproduksjonGwh,
        IReadOnlyList<string> MissingData);

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    private async void OnFilterChanged()
    {
        try { await LoadAsync(); }
        catch (Exception ex)
        {
            _error = $"Kunne ikke oppdatere portefølje: {ex.Message}";
            try { await InvokeAsync(StateHasChanged); } catch { /* disposed */ }
        }
    }

    /// <summary>
    /// Henter portefølje-KPI-er, vakt-ROI og nedetid for hver plant parallelt.
    /// Hver plant feiler isolert — én feilende vakt-ROI gir bare 0 i de
    /// kolonnene, ikke ødelagt rapport. Skalerer til 11 anlegg uten merkbar
    /// forsinkelse takket være parallel-fanout.
    /// </summary>
    private async Task LoadAsync()
    {
        if (!Filter.FromDate.HasValue || !Filter.ToDate.HasValue) return;
        _loading = true;
        _error = null;
        _rows = null;
        _totalReddetNok = 0;
        _kaiaTotalNok = null;
        _kaiaMeglerNok = 0;
        _kaiaFastNok = 0;
        _kaiaUkjentCount = 0;
        _kaiaByPlant = new(StringComparer.OrdinalIgnoreCase);
        _kaiaLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var fromUtc = Filter.FromDate.Value.ToUtcOffsetSafe();
            var toUtc = Filter.ToDate.Value.ToUtcOffsetSafe();

            var portfolio = await NedetidApi.GetPortfolioKpisAsync(fromUtc, toUtc);

            // Plant-detaljer for å få NormalAarsproduksjonGwh (Normalår-andel-
            // kolonnen). Failer stille — uten verdiene blir kolonnen tom.
            IReadOnlyList<PlantDto> plantDetails = Array.Empty<PlantDto>();
            try { plantDetails = await ReportsApi.ListPlantsAsync(); }
            catch { /* Normalår-andel vises tom */ }
            var normalGwhByPlant = plantDetails
                .Where(p => p.NormalAarsproduksjonGwh.HasValue)
                .ToDictionary(p => p.Id, p => p.NormalAarsproduksjonGwh!.Value,
                    StringComparer.Ordinal);

            // Datakvalitet i én bulk-spørring (SPEC-MVP-HARDENING tiltak C) —
            // unngår N+1 ved å hente alle anlegg på én gang.
            IReadOnlyList<DataQualitySummaryDto> dqSummaries = Array.Empty<DataQualitySummaryDto>();
            try { dqSummaries = await NedetidApi.GetPortfolioDataQualityAsync(fromUtc, toUtc); }
            catch { /* DQ er informasjons-kolonne; tom lykke om endepunktet feiler */ }
            var dqByPlant = dqSummaries.ToDictionary(d => d.PlantId, d => d, StringComparer.Ordinal);

            // KAIA-kostnad (Spec KAIA-KOSTNAD) — én bulk-spørring per periode.
            // Feiler stille; kortet skjules om endepunktet ikke svarer.
            _ = LoadKaiaCostAsync(fromUtc, toUtc);

            // Fan-out: vakt-ROI + nedetid for hver plant parallelt.
            var enrichTasks = portfolio.Plants.Select(p =>
                EnrichAsync(p, dqByPlant.GetValueOrDefault(p.PlantId),
                    normalGwhByPlant.TryGetValue(p.PlantId, out var n) ? n : (double?)null,
                    fromUtc, toUtc));
            var enriched = await Task.WhenAll(enrichTasks);

            _rows = enriched.OrderByDescending(r => r.ReddetNok).ToList();
            _totalReddetNok = _rows.Sum(r => r.ReddetNok);
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente portefølje: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Henter KAIA-kostnad for hele porteføljen (én HTTP-call). Aggregerer
    /// sum av meglerprovisjon (positivt) og fast avgift, og teller anlegg
    /// uten megler-data så UI kan flagge dem.
    /// </summary>
    private async Task LoadKaiaCostAsync(DateTimeOffset fromUtc, DateTimeOffset toUtc)
    {
        _kaiaLoading = true;
        try
        {
            var rows = await KaiaCostApi.GetForPortfolioAsync(fromUtc, toUtc);
            _kaiaByPlant = rows.ToDictionary(r => r.PlantId, r => r, StringComparer.OrdinalIgnoreCase);

            _kaiaMeglerNok = rows.Sum(r => r.MeglerprovisjonNok ?? 0);
            _kaiaFastNok = rows.Sum(r => r.FastAvgiftNok);
            _kaiaUkjentCount = rows.Count(r => r.MeglerprovisjonNok is null);

            // Total = sum av per-anlegg-total. Hvis noen anlegg mangler
            // meglerprovisjon, undervurderes totalen — flagg via _kaiaUkjentCount.
            _kaiaTotalNok = rows.Sum(r => r.TotalNok ?? r.FastAvgiftNok);
        }
        catch
        {
            _kaiaTotalNok = null;
            _kaiaByPlant = new(StringComparer.OrdinalIgnoreCase);
        }
        finally
        {
            _kaiaLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<Row> EnrichAsync(
        PortfolioPlantKpi p, DataQualitySummaryDto? dq, double? normalGwh,
        DateTimeOffset fromUtc, DateTimeOffset toUtc)
    {
        double Kpi(string name) => p.Kpis.TryGetValue(name, out var v) && v.HasValue ? v.Value : 0;

        // Vakt-ROI og Nedetid feiler stille per plant — vi får 0 i tabellen
        // hvis SCADA-data eller settlement-data mangler for periode. Samler
        // hvilke som feilet i MissingData så UI kan flagge anlegget.
        VaktRoiResponse? vakt = null;
        NedetidResponse? ned = null;
        var missing = new List<string>();
        try { vakt = await NedetidApi.GetVaktRoiAsync(p.PlantId, fromUtc, toUtc); }
        catch { missing.Add("Vakt-ROI"); }
        try { ned = await NedetidApi.GetNedetidAsync(p.PlantId, fromUtc, toUtc); }
        catch { missing.Add("Nedetid"); }

        // Capture rate er allerede i p.Kpis fra portefølje-API. Hvis nøkkelen
        // mangler, betyr det at server-side feilet på det anlegget — flagg.
        if (!p.Kpis.ContainsKey("CaptureRate_Times"))
        {
            missing.Add("Capture rate");
        }

        return new Row(
            PlantId: p.PlantId,
            PlantName: p.PlantName,
            InstalledCapacityMw: p.InstalledCapacityMw,
            AvailabilityFactor: Kpi("AvailabilityFactor_AF"),
            ForcedOutageRate: Kpi("ForcedOutageRate_FOR"),
            TotalProductionMwh: Kpi("TotalProduction_MWh"),
            SpotomsetningNok: Kpi("Spotomsetning_NOK"),
            CaptureRateTimes: Kpi("CaptureRate_Times"),
            MerverdiNok: Kpi("Merverdi_NOK"),
            NedetidTimer: ned?.TotalNedetidTimer ?? 0,
            TapNok: ned?.TotalTapNok ?? 0,
            ReddetNok: vakt?.TotalReddetNok ?? 0,
            AntallEvents: vakt?.AntallEventsTotalt ?? 0,
            AntallReddbare: vakt?.AntallReddbareInnenforVakt ?? 0,
            DataQuality: dq,
            NormalAarsproduksjonGwh: normalGwh,
            MissingData: missing);
    }

    /// <summary>
    /// Faktisk produksjon som andel av pro-rata normalår. Returnerer null
    /// hvis NormalAarsproduksjonGwh ikke er satt for anlegget eller
    /// periode-dager &lt;= 0.
    /// Beregning:
    ///   forventet_mwh = NormalGwh × 1000 × periode_dager / dager_i_året
    ///   andel = TotalProductionMwh / forventet_mwh
    /// </summary>
    private double? NormalAarsAndel(Row r)
    {
        if (!r.NormalAarsproduksjonGwh.HasValue || r.NormalAarsproduksjonGwh.Value <= 0) return null;
        if (!Filter.FromDate.HasValue || !Filter.ToDate.HasValue) return null;
        var dager = (Filter.ToDate.Value - Filter.FromDate.Value).TotalDays;
        if (dager <= 0) return null;
        var dagerIAaret = DateTime.IsLeapYear(Filter.FromDate.Value.Year) ? 366 : 365;
        var forventetMwh = r.NormalAarsproduksjonGwh.Value * 1000.0 * dager / dagerIAaret;
        if (forventetMwh <= 0) return null;
        return r.TotalProductionMwh / forventetMwh;
    }

    private double MerverdiSum() => _rows?.Sum(r => r.MerverdiNok) ?? 0;

    private static KpiAccent MerverdiAccent(double nok)
    {
        if (nok == 0) return KpiAccent.Muted;
        return nok > 0 ? KpiAccent.Positive : KpiAccent.Negative;
    }

    private string KaiaSubText()
    {
        var s = $"Megler {FormatNok(_kaiaMeglerNok)} · Fast {FormatNok(_kaiaFastNok)}";
        if (_kaiaUkjentCount > 0)
        {
            s += $" · {_kaiaUkjentCount} anlegg uten megler-data";
        }
        return s;
    }

    private void OnRowClick(Row? row)
    {
        if (row is null) return;
        // Klikk på en anleggsrad i porteføljerapporten → landingsside er
        // rapport-listen for det anlegget. Reports-siden henter plant fra
        // FilterState og redirecter automatisk til forrige måneds rapport.
        Filter.PlantId = row.PlantId;
        Nav.NavigateTo("reports");
    }

    // -- Sort-funksjoner --
    private static readonly Func<Row, object> SortByName     = r => r.PlantName;
    private static readonly Func<Row, object> SortByCapacity = r => r.InstalledCapacityMw;
    private static readonly Func<Row, object> SortByAf       = r => r.AvailabilityFactor;
    private static readonly Func<Row, object> SortByFor      = r => r.ForcedOutageRate;
    private static readonly Func<Row, object> SortByMwh      = r => r.TotalProductionMwh;
    private static readonly Func<Row, object> SortByNormalAar = r => r.NormalAarsproduksjonGwh ?? 0;
    private static readonly Func<Row, object> SortByNok      = r => r.SpotomsetningNok;
    private static readonly Func<Row, object> SortByCr       = r => r.CaptureRateTimes;
    private static readonly Func<Row, object> SortByMerverdi = r => r.MerverdiNok;
    private static readonly Func<Row, object> SortByNedetid  = r => r.NedetidTimer;
    private static readonly Func<Row, object> SortByTapNok   = r => r.TapNok;
    private static readonly Func<Row, object> SortByReddetNok= r => r.ReddetNok;
    private static readonly Func<Row, object> SortByDq       = r => r.DataQuality?.GoodPct ?? -1.0;

    /// <summary>Vekt-snitt-good-prosent for footer (vekter på TotalHours per anlegg).</summary>
    private string FormatPortfolioGoodPct()
    {
        if (_rows is null || _rows.Count == 0) return "—";
        var withDq = _rows.Where(r => r.DataQuality is not null).Select(r => r.DataQuality!).ToList();
        if (withDq.Count == 0) return "—";
        var totalHours = withDq.Sum(d => d.TotalHours);
        if (totalHours == 0) return "—";
        var goodHours = withDq.Sum(d => d.GoodHours);
        return (100.0 * goodHours / totalHours).ToString("F1", NumberFormat.Norsk) + " %";
    }

    // -- Format-helpers (alle bruker Services/NumberFormat for konsistens) --
    private static string FormatHours(double v) => v == 0 ? "–" : v.ToString("F0", NumberFormat.Norsk);
    private static string FormatMwh(double v) => v == 0 ? "–" : v.ToString("F1", NumberFormat.Norsk);
    // Tall-formatering delegerer til Services/NumberFormat (kultur-uavhengig).
    // Testrapport 2026-05-21 funn #3: FormatRatio/FormatCr brukte default-kultur
    // (= invariant under InvariantGlobalization), så viste "12.3" og "1.05" i
    // stedet for norsk "12,3" og "1,05".
    private static string FormatRatio(double v) => NumberFormat.Ratio(v);
    private static string FormatCr(double v) => v == 0 ? "–" : v.ToString("F2", NumberFormat.Norsk);
    private static string FormatNok(double v) => NumberFormat.Nok(v);

    /// <summary>Formatterer normalår-andel som "X %" eller "–" hvis ikke tilgjengelig.</summary>
    private static string FormatNormalAarsAndel(double? andel) => NumberFormat.Pct(andel, 0);

    /// <summary>
    /// Portefølje-andel: total faktisk MWh / sum forventet MWh for alle anlegg
    /// med NormalAarsproduksjonGwh satt. Pro-rata på periode-lengden.
    /// </summary>
    private double? NormalAarsAndelTotal()
    {
        if (_rows is null || _rows.Count == 0) return null;
        if (!Filter.FromDate.HasValue || !Filter.ToDate.HasValue) return null;
        var dager = (Filter.ToDate.Value - Filter.FromDate.Value).TotalDays;
        if (dager <= 0) return null;
        var dagerIAaret = DateTime.IsLeapYear(Filter.FromDate.Value.Year) ? 366 : 365;
        double forventetMwh = 0;
        double faktiskMwh = 0;
        foreach (var r in _rows)
        {
            if (!r.NormalAarsproduksjonGwh.HasValue || r.NormalAarsproduksjonGwh.Value <= 0) continue;
            forventetMwh += r.NormalAarsproduksjonGwh.Value * 1000.0 * dager / dagerIAaret;
            faktiskMwh += r.TotalProductionMwh;
        }
        return forventetMwh > 0 ? faktiskMwh / forventetMwh : null;
    }
    private static string FormatNokSigned(double v) => NumberFormat.NokSigned(v);
    private static string FormatMerverdi(double v) => FormatNokSigned(v);
}
