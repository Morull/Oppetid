@page "/portefolje"
@inject NedetidApi NedetidApi

<PageTitle>Portefølje</PageTitle>

<MudGrid Class="mb-4">
    <MudItem xs="12">
        <MudText Typo="Typo.h1">Portefølje</MudText>
        <MudText Typo="Typo.subtitle1" Color="MudBlazor.Color.Secondary">
            KPI-er på tvers av alle anlegg for valgt periode. Anlegg uten
            settlement-import for perioden listes ikke. Sortering: klikk på
            kolonne-headeren.
        </MudText>
    </MudItem>
</MudGrid>

@* ---- Filter ---- *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker Date="_fromDate" DateChanged="@(d => _fromDate = d)"
                           Label="Fra dato" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Date="_toDate" DateChanged="@(d => _toDate = d)"
                           Label="Til dato (eks.)" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="LoadAsync"
                       Disabled="@(_loading || !_fromDate.HasValue || !_toDate.HasValue)">
                Hent
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2 d-inline">Henter portefølje-data…</MudText>
}
else if (_response is not null)
{
    @if (_response.Plants.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            Ingen anlegg har en settlement-import som dekker valgt periode.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h4" Class="mb-2">
                @_response.PlantCount anlegg med data for perioden
            </MudText>
            <MudTable Items="_response.Plants" Hover="true" Dense="true" Elevation="0"
                      SortLabel="Sortér">
<HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="@SortByName">Anlegg</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByCapacity">Effekt (MW)</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortBySh">Drifts-timer</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByFoh">FO-timer</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByAf">AF</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByFor">FOR</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByMwh">Produksjon (MWh)</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByNok" InitialDirection="SortDirection.Descending">Spotoms (NOK)</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByCapPrice">Capture-pris (NOK/MWh)</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByCr">CR (times)</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByMerverdi">Merverdi (NOK)</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudLink Href="@($"/anlegg/{context.PlantId}")">@context.PlantName</MudLink>
                    </MudTd>
                    <MudTd Style="text-align:right">
                        @if (context.InstalledCapacityMw <= 0)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.PriorityHigh"
                                     Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" />
                        }
                        else
                        {
                            @context.InstalledCapacityMw.ToString("F1")
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">@FormatHours(Kpi(context, "ServiceHours_SH"))</MudTd>
                    <MudTd Style="text-align:right">@FormatHours(Kpi(context, "ForcedOutageHours_FOH"))</MudTd>
                    <MudTd Style="text-align:right">@FormatRatio(Kpi(context, "AvailabilityFactor_AF"))</MudTd>
                    <MudTd Style="text-align:right">@FormatRatio(Kpi(context, "ForcedOutageRate_FOR"))</MudTd>
                    <MudTd Style="text-align:right">@FormatMwh(Kpi(context, "TotalProduction_MWh"))</MudTd>
                    <MudTd Style="text-align:right">@FormatNok(Kpi(context, "Spotomsetning_NOK"))</MudTd>
                    <MudTd Style="text-align:right">
                        <MudLink Href="@($"/capture-rate/{context.PlantId}")">@FormatCapPrice(Kpi(context, "CapturePrice_NOK_MWh"))</MudLink>
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudLink Href="@($"/capture-rate/{context.PlantId}")">@FormatCr(Kpi(context, "CaptureRate_Times"))</MudLink>
                    </MudTd>
                    <MudTd Style="text-align:right">@FormatMerverdi(Kpi(context, "Merverdi_NOK"))</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _loading;
    private string? _error;
    private PortfolioKpiResponse? _response;

    protected override async Task OnInitializedAsync()
    {
        // Default-periode: forrige måned
        var now = DateTime.UtcNow;
        var firstOfThisMonth = new DateTime(now.Year, now.Month, 1);
        _fromDate = firstOfThisMonth.AddMonths(-1);
        _toDate = firstOfThisMonth;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!_fromDate.HasValue || !_toDate.HasValue) return;
        _loading = true;
        _error = null;
        _response = null;
        try
        {
            var fromUtc = new DateTimeOffset(_fromDate.Value.Date, TimeSpan.Zero);
            var toUtc = new DateTimeOffset(_toDate.Value.Date, TimeSpan.Zero);
            _response = await NedetidApi.GetPortfolioKpisAsync(fromUtc, toUtc);
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente portefølje: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Helper: returnerer KPI-verdien som double (eller 0 hvis null/manglende),
    /// brukt som sort-key i MudTable.
    /// </summary>
    private static double Kpi(PortfolioPlantKpi p, string name)
        => p.Kpis.TryGetValue(name, out var v) && v.HasValue ? v.Value : 0;

    // Sort-funksjoner for MudTableSortLabel. Definert som felt for å unngå
    // Razor-attributt-escapings-problemer med string literals.
    private static readonly Func<PortfolioPlantKpi, object> SortByName     = p => p.PlantName;
    private static readonly Func<PortfolioPlantKpi, object> SortByCapacity = p => p.InstalledCapacityMw;
    private static readonly Func<PortfolioPlantKpi, object> SortBySh       = p => Kpi(p, "ServiceHours_SH");
    private static readonly Func<PortfolioPlantKpi, object> SortByFoh      = p => Kpi(p, "ForcedOutageHours_FOH");
    private static readonly Func<PortfolioPlantKpi, object> SortByAf       = p => Kpi(p, "AvailabilityFactor_AF");
    private static readonly Func<PortfolioPlantKpi, object> SortByFor      = p => Kpi(p, "ForcedOutageRate_FOR");
    private static readonly Func<PortfolioPlantKpi, object> SortByMwh      = p => Kpi(p, "TotalProduction_MWh");
    private static readonly Func<PortfolioPlantKpi, object> SortByNok      = p => Kpi(p, "Spotomsetning_NOK");
    private static readonly Func<PortfolioPlantKpi, object> SortByCapPrice = p => Kpi(p, "CapturePrice_NOK_MWh");
    private static readonly Func<PortfolioPlantKpi, object> SortByCr       = p => Kpi(p, "CaptureRate_Times");
    private static readonly Func<PortfolioPlantKpi, object> SortByMerverdi = p => Kpi(p, "Merverdi_NOK");

    private static string FormatHours(double v) => v == 0 ? "–" : v.ToString("F0");
    private static string FormatMwh(double v) => v == 0 ? "–" : v.ToString("F1");
    private static string FormatRatio(double v) => v == 0 ? "–" : (v * 100).ToString("F1") + " %";

    private static readonly System.Globalization.NumberFormatInfo NorskTall = new()
    {
        NumberGroupSeparator = " ",
        NumberDecimalSeparator = ",",
        NumberGroupSizes = new[] { 3 },
    };
    private static string FormatNok(double v) => v == 0 ? "–" : v.ToString("N0", NorskTall);

    private static string FormatCapPrice(double v) => v == 0 ? "–" : v.ToString("N0", NorskTall);
    // CR vises som ratio med 2 desimaler (1.00 = lik baseline). 0 → "–" (mangler).
    private static string FormatCr(double v) => v == 0 ? "–" : v.ToString("F2");
    // Merverdi: positive grønne, negative røde, 0 → "–". Bruker "+" prefix for positive.
    private static string FormatMerverdi(double v)
    {
        if (v == 0) return "–";
        var sign = v > 0 ? "+" : "";
        return sign + v.ToString("N0", NorskTall);
    }
}
