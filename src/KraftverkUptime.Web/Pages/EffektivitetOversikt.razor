@page "/effektivitet/oversikt"
@implements IDisposable
@inject NedetidApi NedetidApi
@inject FilterState Filter
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Effektivitet — anleggssammenligning</PageTitle>

<PageHeader Title="Effektivitet — anleggssammenligning"
            Subtitle="Alle anlegg side om side: snitt η, sweet-spot, vannforbruk og total tapt verdi i perioden. Klikk en rad for å gå til detaljvisning.">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.OpenInNew"
                   OnClick="@(() => Nav.NavigateTo("/effektivitet"))">
            Detaljvisning
        </MudButton>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Primary" />
    <MudText Class="ml-2 d-inline">Henter data for alle anlegg…</MudText>
}
else if (_response is null || _response.Rader.Count == 0)
{
    <MudAlert Severity="Severity.Info">Ingen data tilgjengelig for valgt periode.</MudAlert>
}
else
{
    @* KPI-strip øverst — portefølje-totals (begge referanser så drifts-leder
       ser umiddelbart størrelsesforholdet mellom operativt tap og strategisk potensial). *@
    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Tap mot baseline (total)"
                     Value="@FormatTapNok(_response.Rader.Sum(r => r.TotalTaptNokBaseline))"
                     SubText="@($"{_response.Rader.Sum(r => r.TotalTaptMwhBaseline).ToString("F2", NumberFormat.Norsk)} MWh · operative avvik")"
                     Accent="KpiAccent.Negative" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Tap mot sweet-spot (total)"
                     Value="@FormatTapNok(_response.Rader.Sum(r => r.TotalTaptNokSweetSpot))"
                     SubText="@($"{_response.Rader.Sum(r => r.TotalTaptMwhSweetSpot).ToString("F2", NumberFormat.Norsk)} MWh · strategisk potensial")"
                     Accent="KpiAccent.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Snitt η (vektet)"
                     Value="@($"{VektetSnittEta().ToString("F1", NumberFormat.Norsk)} %")"
                     SubText="vektet på faktisk produksjon"
                     Accent="KpiAccent.Positive" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Anlegg med data"
                     Value="@($"{_response.Rader.Count(r => !r.DataMangler)} / {_response.Rader.Count}")"
                     SubText="@($"{_response.Rader.Count(r => r.DataMangler)} mangler SCADA-data i perioden")"
                     Accent="KpiAccent.Neutral" />
        </MudItem>
    </MudGrid>

    @* Hovedtabellen — én rad per anlegg, klikkbar til detaljvisning.
       Begge tap-referanser vises som separate kolonner. *@
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <div class="d-flex justify-space-between align-center mb-2">
            <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">
                Klikk en rad for å åpne detaljvisningen for det anlegget. «Tap mot baseline»
                = operativt avvik fra det vanlige; «Tap mot sweet-spot» = strategisk
                potensial om vannet kjørtes på toppunkt.
            </MudText>
            <HjelpeIkon Tittel="Anleggssammenligning"
                        Beskrivelse="Én rad per anlegg med snitt-η, sweet-spot, vannforbruk, og tap mot to referanser. Sortér på «Tap mot baseline» for å se hvor det er operative problemer; sortér på «Tap mot sweet-spot» for strategisk potensial."
                        Begreper="@(new[] { "η", "SweetSpot", "m³ per kWh", "Baseline", "TaptVerdi" })" />
        </div>
        <MudTable T="EffektivitetPortfolioRad" Items="_response.Rader" Hover="true" Striped="true" Elevation="0"
                  Dense="true"
                  OnRowClick="@((TableRowClickEventArgs<EffektivitetPortfolioRad> args) => OnRowClick(args.Item))"
                  RowStyle="cursor: pointer;">
            <HeaderContent>
                <KolonneHode TRow="EffektivitetPortfolioRad" Tittel="Anlegg"
                             SortBy="@SortByName" />
                <KolonneHode TRow="EffektivitetPortfolioRad" Tittel="Snitt η"
                             SortBy="@SortByEta"
                             Style="text-align:right"
                             BegrepNoekkel="η" />
                <KolonneHode TRow="EffektivitetPortfolioRad" Tittel="Sweet-spot"
                             SortBy="@SortBySweet"
                             Style="text-align:right"
                             BegrepNoekkel="SweetSpot" />
                <KolonneHode TRow="EffektivitetPortfolioRad" Tittel="SVF"
                             SortBy="@SortBySvf"
                             Style="text-align:right"
                             BegrepNoekkel="m³ per kWh" />
                <KolonneHode TRow="EffektivitetPortfolioRad" Tittel="Produksjon"
                             SortBy="@SortByProd"
                             Style="text-align:right"
                             Beskrivelse="Total levert energi i perioden, summert fra Elhub." />
                <KolonneHode TRow="EffektivitetPortfolioRad" Tittel="Episoder"
                             SortBy="@SortByEpisoderBaseline"
                             Style="text-align:right"
                             Beskrivelse="Antall sammenhengende underytelses-episoder mot baseline." />
                <KolonneHode TRow="EffektivitetPortfolioRad" Tittel="Tap mot baseline"
                             SortBy="@SortByTaptNokBaseline"
                             InitialDirection="SortDirection.Descending"
                             Style="text-align:right"
                             Beskrivelse="Tapt verdi (NOK) målt mot bin-snitt-η. Operativt avvik — bør fikses." />
                <KolonneHode TRow="EffektivitetPortfolioRad" Tittel="Tap mot sweet-spot"
                             SortBy="@SortByTaptNokSweetSpot"
                             Style="text-align:right"
                             Beskrivelse="Tapt verdi (NOK) målt mot sweet-spot-η. Strategisk potensial — kan utnyttes ved vannsparing." />
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Anlegg">
                    @if (context.DataMangler)
                    {
                        <span style="opacity: 0.5;">@context.PlantName</span>
                        <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Default"
                                 Variant="Variant.Text" Class="ml-2">mangler data</MudChip>
                    }
                    else
                    {
                        <strong>@context.PlantName</strong>
                    }
                </MudTd>
                <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                    @(context.DataMangler ? "–" : $"{context.SnittEtaPct.ToString("F1", NumberFormat.Norsk)} %")
                </MudTd>
                <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                    @(context.DataMangler ? "–" : $"{context.SweetSpotEffektKw.ToString("F0", NumberFormat.Norsk)} kW")
                </MudTd>
                <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                    @(context.DataMangler ? "–" : $"{context.SvfM3PerKwh.ToString("F2", NumberFormat.Norsk)}")
                </MudTd>
                <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                    @(context.DataMangler ? "–" : $"{context.TotalProduksjonMwh.ToString("F1", NumberFormat.Norsk)} MWh")
                </MudTd>
                <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                    @(context.DataMangler ? "–" : context.AntallEpisoderBaseline.ToString())
                </MudTd>
                <MudTd Style="text-align:right; font-variant-numeric: tabular-nums; font-weight: 600;">
                    @(context.DataMangler ? "–" : FormatTapNok(context.TotalTaptNokBaseline))
                </MudTd>
                <MudTd Style="text-align:right; font-variant-numeric: tabular-nums; font-weight: 600; opacity: 0.85;">
                    @(context.DataMangler ? "–" : FormatTapNok(context.TotalTaptNokSweetSpot))
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @* Topp 10 baseline-episoder på tvers av alle anlegg — handle-listen. *@
    @if (_response.TopBaselineEpisoder.Count > 0)
    {
        <MudPaper Class="pa-4" Elevation="0">
            <div class="d-flex justify-space-between align-center mb-2" style="flex-wrap: wrap; gap: 8px;">
                <div>
                    <div class="d-flex align-center" style="gap: 8px;">
                        <MudText Typo="Typo.h3">Topp @_response.TopBaselineEpisoder.Count å sjekke</MudText>
                        <HjelpeIkon Tittel="Topp 10 å sjekke"
                                    Beskrivelse="Verste underytelse-episoder mot baseline på tvers av alle anlegg i porteføljen, rangert på tapt verdi (NOK). Klikk en rad for detaljvisning."
                                    Begreper="@(new[] { "Δη", "Baseline", "TaptEnergi", "TaptVerdi" })" />
                    </div>
                    <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">
                        Verste baseline-episoder på tvers av porteføljen, rangert på tapt verdi.
                        Klikk en rad for detaljvisning.
                    </MudText>
                </div>
            </div>
            <MudTable T="TopPortfolioEpisode" Items="_topEpisoderIndeksert" Hover="true"
                      Dense="true" Elevation="0"
                      OnRowClick="@((TableRowClickEventArgs<TopPortfolioEpisode> args) => { if (args.Item is not null) _ = OpenTopEpisodeDialogAsync(args.Item); })"
                      RowStyle="cursor: pointer;">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Anlegg</MudTh>
                    <MudTh>Start</MudTh>
                    <MudTh Style="text-align:right">Varighet</MudTh>
                    <MudTh Style="text-align:right">Snitt Δη</MudTh>
                    <MudTh Style="text-align:right">Effekt-område</MudTh>
                    <MudTh Style="text-align:right">Tapt energi</MudTh>
                    <MudTh Style="text-align:right">Tapt verdi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(_topEpisoderIndeksert.IndexOf(context) + 1)</MudTd>
                    <MudTd><strong>@context.PlantName</strong></MudTd>
                    <MudTd>@FormatLocal(context.Episode.StartUtc)</MudTd>
                    <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                        @context.Episode.VarighetTimer.ToString("F2", NumberFormat.Norsk) t
                    </MudTd>
                    <MudTd Style="text-align:right; font-variant-numeric: tabular-nums; color: var(--mud-palette-error);">
                        @context.Episode.SnittDeltaEtaPp.ToString("F1", NumberFormat.Norsk) pp
                    </MudTd>
                    <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                        @context.Episode.EffektMinKw.ToString("F0", NumberFormat.Norsk) – @context.Episode.EffektMaksKw.ToString("F0", NumberFormat.Norsk) kW
                    </MudTd>
                    <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                        @context.Episode.TaptMwh.ToString("F3", NumberFormat.Norsk) MWh
                    </MudTd>
                    <MudTd Style="text-align:right; font-variant-numeric: tabular-nums; font-weight: 600;">
                        @FormatTapNok(context.Episode.TaptNok)
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    private EffektivitetPortfolioResponse? _response;
    private bool _loading;
    private string? _error;
    // Indeksert kopi som List<> så vi får IndexOf for radnummerering.
    private List<TopPortfolioEpisode> _topEpisoderIndeksert = new();

    private static readonly Func<EffektivitetPortfolioRad, object> SortByName              = r => r.PlantName;
    private static readonly Func<EffektivitetPortfolioRad, object> SortByEta               = r => r.SnittEtaPct;
    private static readonly Func<EffektivitetPortfolioRad, object> SortBySweet             = r => r.SweetSpotEffektKw;
    private static readonly Func<EffektivitetPortfolioRad, object> SortBySvf               = r => r.SvfM3PerKwh;
    private static readonly Func<EffektivitetPortfolioRad, object> SortByProd              = r => r.TotalProduksjonMwh;
    private static readonly Func<EffektivitetPortfolioRad, object> SortByEpisoderBaseline  = r => r.AntallEpisoderBaseline;
    private static readonly Func<EffektivitetPortfolioRad, object> SortByTaptNokBaseline   = r => r.TotalTaptNokBaseline;
    private static readonly Func<EffektivitetPortfolioRad, object> SortByTaptNokSweetSpot  = r => r.TotalTaptNokSweetSpot;

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;
        if (Filter.ErKlar) await LoadAsync();
    }

    public void Dispose() => Filter.OnChange -= OnFilterChanged;

    private async void OnFilterChanged()
    {
        try
        {
            if (Filter.ErKlar) await LoadAsync();
            else await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente data: {ex.Message}";
            try { await InvokeAsync(StateHasChanged); } catch { /* disposed */ }
        }
    }

    private async Task LoadAsync()
    {
        if (!Filter.ErKlar) return;
        _loading = true;
        _error = null;
        _response = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var fromUtc = Filter.FromDate!.Value.ToUtcOffsetSafe();
            var toUtc = Filter.ToDate!.Value.ToUtcOffsetSafe();
            _response = await NedetidApi.GetEffektivitetPortfolioAsync(fromUtc, toUtc);
            _topEpisoderIndeksert = _response.TopBaselineEpisoder.ToList();
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente portefølje: {ex.Message}";
            _response = new EffektivitetPortfolioResponse(
                Array.Empty<EffektivitetPortfolioRad>(),
                Array.Empty<TopPortfolioEpisode>());
            _topEpisoderIndeksert = new();
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnRowClick(EffektivitetPortfolioRad? row)
    {
        if (row is null || row.DataMangler) return;
        Filter.PlantId = row.PlantId;
        Nav.NavigateTo("/effektivitet");
    }

    /// <summary>
    /// Åpner samme detalj-dialog som detaljvisningen, for en topp-episode fra
    /// porteføljen. Setter også FilterState så hvis bruker lukker dialogen og
    /// klikker til detaljvisning, har den allerede riktig anlegg valgt.
    /// </summary>
    private async Task OpenTopEpisodeDialogAsync(TopPortfolioEpisode top)
    {
        Filter.PlantId = top.PlantId;
        var parameters = new DialogParameters
        {
            ["Episode"] = top.Episode,
            ["PlantId"] = top.PlantId,
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = true,
        };
        await DialogService.ShowAsync<EpisodeDetailDialog>($"{top.PlantName} — {FormatLocal(top.Episode.StartUtc)}", parameters, options);
    }

    /// <summary>Produksjon-vektet snitt η over alle anlegg som har data.</summary>
    private double VektetSnittEta()
    {
        if (_response is null) return 0;
        var medData = _response.Rader.Where(r => !r.DataMangler && r.TotalProduksjonMwh > 0).ToList();
        if (medData.Count == 0) return 0;
        var totalProd = medData.Sum(r => r.TotalProduksjonMwh);
        if (totalProd <= 0) return 0;
        return medData.Sum(r => r.SnittEtaPct * r.TotalProduksjonMwh) / totalProd;
    }

    /// <summary>Tap-format: "651 NOK" eller "–" for null. Usignert.</summary>
    private static string FormatTapNok(double v) =>
        v <= 0 ? "–" : v.ToString("N0", NumberFormat.Norsk) + " NOK";

    private static string FormatLocal(DateTimeOffset t) =>
        t.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
