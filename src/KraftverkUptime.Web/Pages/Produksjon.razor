@page "/produksjon"
@page "/produksjon/{PlantId}"
@using ApexCharts
@implements IDisposable
@inject NedetidApi NedetidApi
@inject FilterState Filter
@inject NavigationManager Nav

<PageTitle>Produksjon</PageTitle>

<MudGrid Class="mb-4">
    <MudItem xs="12" md="9">
        <MudText Typo="Typo.h1">Produksjon</MudText>
        <MudText Typo="Typo.subtitle1" Color="MudBlazor.Color.Secondary">
            Hvor godt brukes vannet? Her vurderer vi om Hydrogrid traff på de
            beste prisperiodene, om vi fulgte planen, og om vi blir bedre over
            tid. Datakilde: <strong>ProduksjonplanMwh</strong> i KAIA-eksporten
            er Hydrogrids plan, sammenlignet mot <strong>MwhElhub</strong>
            (faktisk levert) og spotpris per time.
        </MudText>
    </MudItem>
</MudGrid>

@* Anlegg + periode styres av global velger i AppBar (FilterState). *@

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2 d-inline">Henter produksjons-analyse…</MudText>
}
else if (_data is not null)
{
    @* ---- Datakvalitets-banner (SPEC-MVP-HARDENING tiltak C) ----
       Vis dekning og prosent god kvalitet for valgt periode. *@
    @if (_dataQuality is not null && _dataQuality.GoodPct < 1.0)
    {
        <MudPaper Class="pa-2 mb-3" Elevation="0"
                  Style="border-left: 4px solid var(--mud-palette-warning); background: rgba(243, 156, 18, 0.06);">
            <div class="d-flex align-center" style="gap:12px; flex-wrap:wrap;">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" />
                <MudText Typo="Typo.body2">
                    <strong>Datakvalitet:</strong>
                    @($"{_dataQuality.GoodPct * 100:F1} %") god av @_dataQuality.TotalHours timer.
                    @if (_dataQuality.WarningHours + _dataQuality.BadHours + _dataQuality.MissingHours > 0)
                    {
                        <span>(@(_dataQuality.WarningHours) advarsel, @(_dataQuality.BadHours) dårlig, @(_dataQuality.MissingHours) mangler.)</span>
                    }
                    @if (_dataQuality.ManglerImportHours > 0)
                    {
                        <span> @_dataQuality.ManglerImportHours timer er ikke importert.</span>
                    }
                </MudText>
            </div>
        </MudPaper>
    }

    @if (_data.AntallTimerMedPlan == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Ingen plan-data (ProduksjonplanMwh) for valgt periode. Sjekk at
            settlement-eksporten inkluderer plan-kolonnen, eller velg en periode
            der Hydrogrid har levert plan.
        </MudAlert>
    }
    else
    {
        @* ---- KPI-rad med trend mot forrige periode ---- *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <KpiTrendCard Label="Plan-treff"
                              Value="@(_data.PlanTreffProsent * 100)"
                              PreviousValue="@(_previous?.PlanTreffProsent * 100)"
                              Format="F1" Unit="%"
                              SubText="@($"1 − MAE/Σplan over {_data.AntallTimerMedPlan} timer med plan > 0")"
                              HigherIsBetter="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiTrendCard Label="Topp-prisperiode-utnyttelse"
                              Value="@(_data.AndelProdIToppKvartil * 100)"
                              PreviousValue="@(_previous?.AndelProdIToppKvartil * 100)"
                              Format="F1" Unit="%"
                              SubText="@($"MWh-andel i øverste 25 % spot-timer ({(_data.AndelTimerProdIToppKvartil * 100):F0} % av drifts-timer). Naiv baseline = 25 %.")"
                              HigherIsBetter="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiTrendCard Label="Hydrogrid timing-merverdi"
                              Value="_data.HydrogridMerverdiNok"
                              PreviousValue="_previous?.HydrogridMerverdiNok"
                              Format="N0" Unit="NOK"
                              SignedValue="true"
                              SubText="vs. flat baseline"
                              HigherIsBetter="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiTrendCard Label="Faktisk timing-merverdi"
                              Value="_data.FaktiskMerverdiNok"
                              PreviousValue="_previous?.FaktiskMerverdiNok"
                              Format="N0" Unit="NOK"
                              SignedValue="true"
                              SubText="@FaktiskVsHydrogrid()"
                              HigherIsBetter="true" />
            </MudItem>
        </MudGrid>

        @* ---- KPI-rad 2: kapasitet + overløp ---- *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <KpiTrendCard Label="Kapasitetsutnyttelse"
                              Value="@(_data.KapasitetsutnyttelseProsent * 100)"
                              PreviousValue="@(_previous?.KapasitetsutnyttelseProsent * 100)"
                              Format="F1" Unit="%"
                              SubText="@KapasitetTolkning(_data.KapasitetsutnyttelseProsent)"
                              HigherIsBetter="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiTrendCard Label="Andel timer med overløp"
                              Value="@(_data.OverlopProsent * 100)"
                              PreviousValue="@(_previous?.OverlopProsent * 100)"
                              Format="F1" Unit="%"
                              SubText="@OverlopTolkning(_data)"
                              HigherIsBetter="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiTrendCard Label="Antall timer overløp"
                              Value="_data.AntallTimerOverlop"
                              PreviousValue="_previous?.AntallTimerOverlop"
                              Format="F0" Unit="timer"
                              SubText="@(_data.OverlopDataTilgjengelig ? $"av {_data.AntallTimer} timer" : "Mangler SCADA-data")"
                              HigherIsBetter="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <KpiTrendCard Label="Produksjons-timer"
                              Value="_data.AntallTimerProduksjon"
                              PreviousValue="_previous?.AntallTimerProduksjon"
                              Format="F0" Unit="timer"
                              SubText="@($"av {_data.AntallTimer} mulige")"
                              HigherIsBetter="true" />
            </MudItem>
        </MudGrid>

        @* ---- Tolkning-banner ---- *@
        <MudAlert Severity="@TolkningSeverity()" Class="mb-4" Dense="true" Icon="@Icons.Material.Filled.Insights">
            <MudText Typo="Typo.body2">@HelhetligTolkning()</MudText>
        </MudAlert>

        @* ---- Plan vs faktisk-graf (daglig aggregert for lange perioder) ---- *@
        @if (_dailyPoints.Count > 0)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudText Typo="Typo.h3" Class="mb-2">Plan vs. faktisk produksjon (MWh)</MudText>
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-2">
                    @_grafForklaring Når plan- og faktisk-linjene følger hverandre tett er
                    Hydrogrid riktig og operasjonen følger planen. Stort avvik betyr enten
                    at planen feilet (Hydrogrid var off), eller at vi ikke greide å følge
                    den (nedetid, manuell justering osv.).
                </MudText>
                <ApexChart @key="@($"hg-{_chartVersion}")" TItem="DailyPoint"
                           Options="_chartOptions" Height="380">
                    <ApexPointSeries TItem="DailyPoint"
                                     Items="_dailyPoints"
                                     Name="Plan (MWh)"
                                     SeriesType="SeriesType.Line"
                                     XValue="d => d.Date"
                                     YValue="d => (decimal)d.PlanMwh" />
                    <ApexPointSeries TItem="DailyPoint"
                                     Items="_dailyPoints"
                                     Name="Faktisk (MWh)"
                                     SeriesType="SeriesType.Line"
                                     XValue="d => d.Date"
                                     YValue="d => (decimal)d.ElhubMwh" />
                </ApexChart>
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudText Typo="Typo.h3" Class="mb-2">Spotpris-utvikling (NOK/MWh)</MudText>
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-2">
                    Daglig snitt-spotpris i samme periode. Sammenlign med grafen over —
                    ønsker du å produsere høyt når spotprisen topper.
                </MudText>
                <ApexChart @key="@($"sp-{_chartVersion}")" TItem="DailyPoint"
                           Options="_spotOptions" Height="220">
                    <ApexPointSeries TItem="DailyPoint"
                                     Items="_dailyPoints"
                                     Name="Spotpris (NOK/MWh)"
                                     SeriesType="SeriesType.Line"
                                     XValue="d => d.Date"
                                     YValue="d => (decimal)d.SnittSpot" />
                </ApexChart>
            </MudPaper>
        }

        @* ---- Driftslinje med hendelser (overløp + ubalanse-kost per time) ---- *@
        @if (_data.Hourly.Count > 0)
        {
            <div class="mb-4">
                <ProduksjonTimeline Hours="_data.Hourly" OnDayClick="OnTimelineDayClicked" />
            </div>
        }

        @* ---- Måneds-tabell for å se trend ---- *@
        @if (_data.Monthly.Count > 0)
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h3" Class="mb-3">Måneds-trend</MudText>
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
                    Hydrogrid-merverdi måned-for-måned. Ser man en stigende trend i timing-
                    merverdi, blir Hydrogrid bedre. Plan-treff bør holde seg stabilt høy.
                </MudText>
                <MudTable Items="_data.Monthly" Hover="true" Dense="true" Elevation="0"
                          OnRowClick="@((TableRowClickEventArgs<ProduksjonMonthlyDto> args) => OnMonthRowClick(args.Item))"
                          RowStyle="cursor: pointer;">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="@_sortMonth">Måned</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right">
                            <MudTooltip Text="Antall hele timer med produksjon (Elhub MWh > 0) / totalt antall timer i måneden">
                                <MudTableSortLabel SortBy="@_sortTimer">Timer prod.</MudTableSortLabel>
                            </MudTooltip>
                        </MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortKap">Kap.utn.</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortOverlop">Overløp (t)</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortElhub">Elhub (MWh)</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortPlan">Plan (MWh)</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortPlanTreff">Plan-treff</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortToppPris">Topp-pris-andel</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortBunnPris">Bunn-pris-andel</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortHgMerverdi">Hydrogrid-merverdi</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortFaktiskMerverdi">Faktisk merverdi</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@_sortSnittSpot">Snitt-spot</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@($"{context.Year}-{context.Month:D2}")</MudTd>
                        <MudTd Style="text-align:right">
                            <div class="d-flex align-center justify-end" style="gap:4px;">
                                @{
                                    var totalTimerMnd = TotalHoursInMonth(context.Year, context.Month);
                                    var ikkeProd = totalTimerMnd - context.AntallTimerProduksjon;
                                    var prodPct = totalTimerMnd > 0
                                        ? context.AntallTimerProduksjon / (double)totalTimerMnd : 0;
                                }
                                <MudTooltip Text="@($"{context.AntallTimerProduksjon} timer med produksjon ({prodPct:P0}). {ikkeProd} timer uten produksjon i måneden.")">
                                    <span>
                                        <strong>@context.AntallTimerProduksjon</strong>
                                        <span style="color: var(--mud-palette-text-secondary);"> / @totalTimerMnd</span>
                                    </span>
                                </MudTooltip>
                                @if (ErOverlopRisiko(context))
                                {
                                    <MudTooltip Text="@(context.AntallTimerOverlop > 0 ? $"{context.AntallTimerOverlop} timer overløp på terminal-dam — magasinet flommet" : "Mange produksjonstimer + lav snittpris = sannsynlig overløp-risiko")">
                                        <MudIcon Icon="@Icons.Material.Filled.WaterDrop"
                                                 Color="MudBlazor.Color.Warning"
                                                 Size="MudBlazor.Size.Small" />
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <span style="@($"color: {(context.KapasitetsutnyttelseProsent >= 0.95 ? "#E76F51" : context.KapasitetsutnyttelseProsent >= 0.80 ? "#F39C12" : "inherit")};")">
                                @((context.KapasitetsutnyttelseProsent * 100).ToString("F0")) %
                            </span>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            @if (context.AntallTimerOverlop > 0)
                            {
                                <span style="color: #E76F51; font-weight: 600;">@context.AntallTimerOverlop</span>
                            }
                            else
                            {
                                <span>0</span>
                            }
                        </MudTd>
                        <MudTd Style="text-align:right">@context.ElhubMwh.ToString("F0")</MudTd>
                        <MudTd Style="text-align:right">@context.PlanMwh.ToString("F0")</MudTd>
                        <MudTd Style="text-align:right">
                            <span style="@($"color: {(context.PlanTreffProsent >= 0.85 ? "#2A9D8F" : context.PlanTreffProsent >= 0.65 ? "#F39C12" : "#E76F51")}; font-weight: 600;")">
                                @((context.PlanTreffProsent * 100).ToString("F0")) %
                            </span>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <span style="@($"color: {(context.AndelProdIToppKvartil >= 0.30 ? "#2A9D8F" : context.AndelProdIToppKvartil >= 0.20 ? "inherit" : "#E76F51")};")">
                                @((context.AndelProdIToppKvartil * 100).ToString("F0")) %
                            </span>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            @* Høy bunn-andel = produserte mest når prisen var lav. Hvis bunn > topp er det
                               et tydelig drifts-flagg (overløp-tvang eller minstevannføring). *@
                            <span style="@($"color: {(context.AndelProdIBunnKvartil > context.AndelProdIToppKvartil ? "#E76F51" : "inherit")};")">
                                @((context.AndelProdIBunnKvartil * 100).ToString("F0")) %
                            </span>
                        </MudTd>
                        <MudTd Style="text-align:right">@FormatNokSigned(context.HydrogridMerverdiNok)</MudTd>
                        <MudTd Style="text-align:right">@FormatNokSigned(context.FaktiskMerverdiNok)</MudTd>
                        <MudTd Style="text-align:right">@context.SnittSpotprisNokMwh.ToString("F0")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    }
}

@code {
    [Parameter] public string? PlantId { get; set; }

    private bool _loading;
    private string? _error;
    private ProduksjonAnalyseDto? _data;
    private ProduksjonAnalyseDto? _previous;
    private DataQualitySummaryDto? _dataQuality;

    private ApexChartOptions<DailyPoint> _chartOptions = new();
    private ApexChartOptions<DailyPoint> _spotOptions = new();
    private int _chartVersion;
    private List<DailyPoint> _dailyPoints = new();
    private string _grafForklaring = string.Empty;

    /// <summary>
    /// Aggregert dag-punkt for grafen. Time-for-time blir for tett når perioden
    /// er lang (672 punkter for én måned), så vi summerer Plan/Elhub og tar
    /// snitt-spotpris per døgn. Holder grafen lesbar uten å miste signal.
    /// </summary>
    private sealed record DailyPoint(DateTime Date, double PlanMwh, double ElhubMwh, double SnittSpot);

    // Sort-funksjoner for månedstabellen
    private readonly Func<ProduksjonMonthlyDto, object> _sortMonth = m => m.Year * 100 + m.Month;
    private readonly Func<ProduksjonMonthlyDto, object> _sortTimer = m => m.AntallTimerProduksjon;
    private readonly Func<ProduksjonMonthlyDto, object> _sortKap = m => m.KapasitetsutnyttelseProsent;
    private readonly Func<ProduksjonMonthlyDto, object> _sortOverlop = m => m.AntallTimerOverlop;
    private readonly Func<ProduksjonMonthlyDto, object> _sortElhub = m => m.ElhubMwh;
    private readonly Func<ProduksjonMonthlyDto, object> _sortPlan = m => m.PlanMwh;
    private readonly Func<ProduksjonMonthlyDto, object> _sortPlanTreff = m => m.PlanTreffProsent;
    private readonly Func<ProduksjonMonthlyDto, object> _sortToppPris = m => m.AndelProdIToppKvartil;
    private readonly Func<ProduksjonMonthlyDto, object> _sortBunnPris = m => m.AndelProdIBunnKvartil;
    private readonly Func<ProduksjonMonthlyDto, object> _sortHgMerverdi = m => m.HydrogridMerverdiNok;
    private readonly Func<ProduksjonMonthlyDto, object> _sortFaktiskMerverdi = m => m.FaktiskMerverdiNok;
    private readonly Func<ProduksjonMonthlyDto, object> _sortSnittSpot = m => m.SnittSpotprisNokMwh;

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;

        if (!string.IsNullOrEmpty(PlantId) && PlantId != Filter.PlantId)
        {
            Filter.PlantId = PlantId;
        }

        if (Filter.ErKlar)
        {
            await LoadAsync();
        }
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    private async void OnFilterChanged()
    {
        try
        {
            if (Filter.ErKlar) await LoadAsync();
            else await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente produksjons-analyse: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAsync()
    {
        if (!Filter.ErKlar) return;
        _loading = true;
        _error = null;
        _data = null;
        _previous = null;
        _dataQuality = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var fromUtc = Filter.FromDate!.Value.ToUtcOffsetSafe();
            var toUtc = Filter.ToDate!.Value.ToUtcOffsetSafe();

            // Forrige periode med samme lengde for trend-pilene
            var lengde = toUtc - fromUtc;
            var prevTo = fromUtc;
            var prevFrom = fromUtc - lengde;

            var dataTask = NedetidApi.GetProduksjonAnalyseAsync(Filter.PlantId, fromUtc, toUtc);
            var prevTask = SafeTask(() => NedetidApi.GetProduksjonAnalyseAsync(Filter.PlantId, prevFrom, prevTo));

            _data = await dataTask;
            _previous = await prevTask;

            // Datakvalitet — informasjons-banner.
            try { _dataQuality = await NedetidApi.GetDataQualityAsync(Filter.PlantId, fromUtc, toUtc); }
            catch { _dataQuality = null; }

            BuildDailyPoints();
            _chartVersion++;
            BuildChart();
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente produksjons-analyse: {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static async Task<T?> SafeTask<T>(Func<Task<T>> task) where T : class
    {
        try { return await task(); }
        catch { return null; }
    }

    /// <summary>
    /// Aggregerer time-data til daglige punkter. For lange perioder gir det
    /// en lesbar graf; kort periode (≤ 7 dager) brukes time-granulariteten direkte.
    /// </summary>
    private void BuildDailyPoints()
    {
        if (_data is null)
        {
            _dailyPoints = new();
            return;
        }
        var dager = (_data.ToUtc - _data.FromUtc).TotalDays;
        if (dager <= 7)
        {
            // For korte perioder: behold time-granularitet
            _dailyPoints = _data.Hourly
                .Select(h => new DailyPoint(
                    Date: h.TimeUtc.UtcDateTime,
                    PlanMwh: h.PlanMwh ?? 0,
                    ElhubMwh: h.ElhubMwh ?? 0,
                    SnittSpot: h.SpotprisNokMwh ?? 0))
                .ToList();
            _grafForklaring = "Time-for-time (kort periode).";
        }
        else
        {
            // Lang periode: aggreger til daglig
            _dailyPoints = _data.Hourly
                .GroupBy(h => h.TimeUtc.UtcDateTime.Date)
                .OrderBy(g => g.Key)
                .Select(g => new DailyPoint(
                    Date: g.Key,
                    PlanMwh: g.Sum(h => h.PlanMwh ?? 0),
                    ElhubMwh: g.Sum(h => h.ElhubMwh ?? 0),
                    SnittSpot: g.Where(h => h.SpotprisNokMwh.HasValue)
                                .Select(h => h.SpotprisNokMwh!.Value)
                                .DefaultIfEmpty(0)
                                .Average()))
                .ToList();
            _grafForklaring = $"Daglig aggregert ({_dailyPoints.Count} dager). " +
                              "Plan/Faktisk = sum MWh per dag, Spotpris = snitt for døgnet.";
        }
    }

    private void BuildChart()
    {
        // Plan vs. faktisk MWh — én Y-akse. Tidligere dual-axis-oppsett
        // (MWh + NOK/MWh i samme graf) rendret blankt pga. ApexCharts.Blazor-
        // bug med multi-axis-binding; splittet derfor i to grafer i UI.
        _chartOptions = new ApexChartOptions<DailyPoint>
        {
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
            Xaxis = new XAxis { Type = XAxisType.Datetime },
            Yaxis = new List<YAxis>
            {
                new() { Title = new AxisTitle { Text = "MWh" }, DecimalsInFloat = 1 }
            },
            Legend = new Legend { Position = LegendPosition.Top },
            Colors = new List<string> { "#1E5F8E", "#2A9D8F" },
        };
        _spotOptions = new ApexChartOptions<DailyPoint>
        {
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
            Xaxis = new XAxis { Type = XAxisType.Datetime },
            Yaxis = new List<YAxis>
            {
                new() { Title = new AxisTitle { Text = "NOK/MWh" }, DecimalsInFloat = 0 }
            },
            Legend = new Legend { Position = LegendPosition.Top, Show = false },
            Colors = new List<string> { "#F39C12" },
        };
    }

    // -- Tolknings-helpere --

    /// <summary>
    /// Heuristikk for overløp-risiko: mange produksjonstimer + svak topp-pris-
    /// utnyttelse antyder at anlegget måtte produsere uansett pris for å unngå
    /// at magasinet flommet over. Da er svakt CR/merverdi ikke Hydrogrids feil
    /// — det er en hydrologisk realitet drifts-leder kan informere ledelsen om.
    ///
    /// Hvis SCADA-overløp-data finnes, bruker vi reell måling istedenfor
    /// heuristikken.
    /// </summary>
    private static bool ErOverlopRisiko(ProduksjonMonthlyDto m)
    {
        if (m.AntallTimerOverlop > 0) return true;
        // Fallback-heuristikk når overløp-tag mangler
        return m.AntallTimerProduksjon >= 500 && m.AndelProdIToppKvartil < 0.22;
    }

    /// <summary>
    /// Tolker kapasitetsutnyttelse. Høy verdi = anlegget kjører nesten
    /// konstant — typisk underdimensjonert eller ren elvekraft uten
    /// magasinregulering.
    /// </summary>
    private static string KapasitetTolkning(double andel) => andel switch
    {
        >= 0.95 => "kjører nesten konstant — sannsynlig underdimensjonert",
        >= 0.80 => "høy utnyttelse — lite reguleringsrom",
        >= 0.50 => "moderat utnyttelse",
        >= 0.20 => "lav utnyttelse — god reguleringsevne",
        _       => "svært lav — lite vann eller mye nedetid"
    };

    /// <summary>
    /// Tolker overløp. Vis tydelig hvis SCADA-data mangler eller hvis det
    /// er reelle overløp-timer.
    /// </summary>
    private static string OverlopTolkning(ProduksjonAnalyseDto d)
    {
        if (!d.OverlopDataTilgjengelig) return "SCADA-data mangler — sjekk OverflowFlow-tag";
        if (d.AntallTimerOverlop == 0) return "ingen overløp i perioden";
        if (d.OverlopProsent >= 0.10) return "kritisk høyt — magasinet flommer ofte";
        if (d.OverlopProsent >= 0.03) return "moderat — vurder kapasitets-økning";
        return "lavt nivå — naturlig variasjon";
    }

    /// <summary>
    /// Antall timer i en gitt måned (28-31 dager × 24). Brukes for å vise
    /// "X / Y timer" i månedstabellen så drifts-leder ser hvor mange
    /// produksjonsfrie timer det var.
    /// </summary>
    private static int TotalHoursInMonth(int year, int month)
        => DateTime.DaysInMonth(year, month) * 24;

    /// <summary>
    /// Drill fra månedsrad i tabellen til Nedetid-siden for samme måned.
    /// Setter FilterState først så Nedetid-siden bruker riktig periode.
    /// </summary>
    private void OnMonthRowClick(ProduksjonMonthlyDto? row)
    {
        if (row is null) return;
        var monthStart = new DateTime(row.Year, row.Month, 1);
        var monthEnd = monthStart.AddMonths(1);
        Filter.SetPeriod(monthStart, monthEnd, PeriodGranularity.Maned);
        Nav.NavigateTo($"nedetid/{Filter.PlantId}");
    }

    /// <summary>
    /// Drill fra én time/celle i driftslinjen til Nedetid-siden filtrert på
    /// den dagen. Brukeren kan så se alle nedetids-events i detalj. Periode
    /// settes til ett døgn slik at Nedetid viser kun den dagen.
    /// </summary>
    private void OnTimelineDayClicked(DateTime day)
    {
        if (string.IsNullOrEmpty(Filter.PlantId)) return;
        var dayStart = day.Date;
        var dayEnd = dayStart.AddDays(1);
        Filter.SetPeriod(dayStart, dayEnd, PeriodGranularity.Egendefinert);
        Nav.NavigateTo($"nedetid/{Filter.PlantId}");
    }

    private string TimingTolkning(double andelTopp) =>
        andelTopp switch
        {
            >= 0.40 => "Sterkt — produksjonen veies tungt i topp-pris-timer",
            >= 0.30 => "Bra — produksjonen samsvarer godt med høye priser",
            >= 0.25 => "Nøytralt — jevn fordeling (baseline = 25 %)",
            >= 0.15 => "Svak — produksjonen vektes mot lavere priser",
            _ => "Dårlig — produserte hovedsakelig i lavpris-perioder"
        };

    private string FaktiskVsHydrogrid()
    {
        if (_data is null) return string.Empty;
        var diff = _data.FaktiskMerverdiNok - _data.HydrogridMerverdiNok;
        if (Math.Abs(diff) < 1000) return "fulgte planen — like merverdi";
        if (diff > 0) return $"+{diff:N0} NOK bedre enn planen";
        return $"{diff:N0} NOK svakere enn planen";
    }

    private Severity TolkningSeverity()
    {
        if (_data is null) return Severity.Info;
        if (_data.PlanTreffProsent >= 0.85 && _data.AndelProdIToppKvartil >= 0.27) return Severity.Success;
        if (_data.PlanTreffProsent < 0.65 || _data.AndelProdIToppKvartil < 0.20) return Severity.Warning;
        return Severity.Info;
    }

    private string HelhetligTolkning()
    {
        if (_data is null || _data.AntallTimerMedPlan == 0) return string.Empty;

        var planTreffStr = _data.PlanTreffProsent >= 0.85 ? "godt på plan" :
                           _data.PlanTreffProsent >= 0.65 ? "moderate avvik fra planen" :
                           "store avvik fra planen";
        var timingStr = _data.AndelProdIToppKvartil >= 0.30 ? "Hydrogrids timing er sterk."
                      : _data.AndelProdIToppKvartil >= 0.25 ? "Hydrogrids timing er nøytral."
                      : "Hydrogrids timing er svak — produserer mest når prisen er lav. Sjekk om dette skyldes overløpsrisiko eller minstevannføring.";
        var merverdiStr = _data.HydrogridMerverdiNok >= 0
            ? $"Hydrogrid-merverdien er positiv ({_data.HydrogridMerverdiNok:N0} NOK)."
            : $"Hydrogrid-merverdien er negativ ({_data.HydrogridMerverdiNok:N0} NOK) — planen plasserte volum under snittpris.";

        // Behold del3 for "vi vs. plan"-sammenligningen
        var hg = _data.HydrogridMerverdiNok;
        var faktisk = _data.FaktiskMerverdiNok;
        var del3 = (hg, faktisk) switch
        {
            ( > 0, _) when faktisk > hg => $"Vi tjente {faktisk - hg:N0} NOK mer enn Hydrogrids plan tilsa.",
            ( > 0, _) when faktisk < hg => $"Vi mistet {hg - faktisk:N0} NOK ved å avvike fra planen.",
            ( > 0, _) => "Plan og faktisk var i praksis like.",
            _ => string.Empty,
        };

        var trailing = string.IsNullOrEmpty(del3) ? "" : $" {del3}";
        return $"Det er {planTreffStr}. {timingStr} {merverdiStr}{trailing}";
    }

    private static readonly System.Globalization.NumberFormatInfo NorskTall = new()
    {
        NumberGroupSeparator = " ",
        NumberDecimalSeparator = ",",
        NumberGroupSizes = new[] { 3 },
    };
    private static string FormatNokSigned(double v)
    {
        if (Math.Abs(v) < 0.5) return "–";
        var sign = v > 0 ? "+" : "";
        return sign + v.ToString("N0", NorskTall);
    }
}
