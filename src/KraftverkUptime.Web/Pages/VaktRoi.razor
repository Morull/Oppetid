        Nav.NavigateTo($"vakt-roi/{evt.PlantId}");
    }

    private void GoToPlantSummary(PortfolioVaktRoiPlantSummary? p)
    {
        if (p is null) return;
        Nav.NavigateTo($"vakt-roi/{p.PlantId}");
    }

    private static string MonthLabel(PortfolioVaktRoiMonthlyPoint p)
    {
        var name = p.Month switch
        {
            1 => "Jan", 2 => "Feb", 3 => "Mar", 4 => "Apr",
            5 => "Mai", 6 => "Jun", 7 => "Jul", 8 => "Aug",
            9 => "Sep", 10 => "Okt", 11 => "Nov", 12 => "Des",
            _ => p.Month.ToString(System.Globalization.CultureInfo.InvariantCulture),
        };
        return $"{name} {p.Year}";
    }

    private string OverrideValueFor(VaktRoiEventDto e)
        => _overrides.TryGetValue(e.Event.StartUtc, out var v) ? v : "Auto";

    private async Task SetOverrideAsync(VaktRoiEventDto e, string classification)
    {
        try
        {
            await NedetidApi.UpsertVaktOverrideAsync(
                Filter.PlantId, e.Event.StartUtc, classification, comment: null);

            if (classification == "Auto") _overrides.Remove(e.Event.StartUtc);
            else _overrides[e.Event.StartUtc] = classification;

            Snackbar.Add(
                classification == "Auto"
                    ? "Override fjernet — bruker SCADA-data."
                    : $"Override satt: {classification}.",
                Severity.Success);

            // Re-load Vakt-ROI med ny override anvendt på serveren.
            Filter.InvalidateCaches();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kunne ikke lagre override: {ex.Message}", Severity.Error);
        }
    }

    private string PeriodLabel
    {
        get
        {
            if (_response is null) return "";
            return $"{_response.FromUtc:yyyy-MM-dd} – {_response.ToUtc:yyyy-MM-dd}";
        }
    }

    private string RoiSubText()
    {
        var aarlig = EstimertAarligReddet();
        if (_aarligVaktKost <= 0) return "Sett inn vakt-kost for ROI-sammenlikning";
        var diff = aarlig - _aarligVaktKost;
        var ratio = aarlig / _aarligVaktKost;
        if (diff >= 0)
        {
            return $"Reddet ≈ {ratio:F1}× vakt-kosten";
        }
        return $"Reddet < vakt-kost (~{ratio:F1}×)";
    }

    private string RoiCardStyle()
    {
        var diff = EstimertAarligReddet() - _aarligVaktKost;
        var color = diff >= 0 ? "#2A9D8F" : "#E76F51";
        return $"border-left: 4px solid {color};";
    }

    private static DateTimeOffset StartOfMonth(DateTimeOffset dt)
    {
        var l = dt.ToLocalTime();
        return new DateTimeOffset(new DateTime(l.Year, l.Month, 1), l.Offset);
    }

    private static string FormatLocal(DateTimeOffset dt)
        => dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    // Norsk tallformat hardkodet — Blazor WASM kjører med InvariantGlobalization=true
    // og GetCultureInfo("nb-NO") kaster CultureNotFoundException.
    private static readonly System.Globalization.NumberFormatInfo NorskTall = new()
    {
        NumberGroupSeparator = " ",
        NumberDecimalSeparator = ",",
        NumberGroupSizes = new[] { 3 },
    };

    private static string FormatNok(double nok)
        => nok.ToString("N0", NorskTall);

    private static string DisplayOverflow(VaktRoiEventDto e)
    {
        if (!e.ErInnenforVakt || !e.ErReddbar) return "–";
        if (e.OverflowDataMissing) return "Mangler data";
        if (e.OverflowTimerInCounterfactual <= 0) return "0 t";
        return $"{e.OverflowTimerInCounterfactual} t";
    }

    private static string DisplayKategori(string kategori) => kategori switch
    {
        "TripFeil" => "Trip / feil",
        "TettInntaksrist" => "Tett inntaksrist",
        "EksternForstyrrelse" => "Ekstern forstyrrelse",
        "PlanlagtVedlikehold" => "Planlagt vedlikehold",
        "Markedstopp" => "Markedstopp",
        "Ressursmangel" => "Ressursmangel",
        "DataMangel" => "Datamangel",
        "UkjentNedetid" => "Ukjent nedetid",
        _ => kategori,
    };

    public sealed record MonthlyPoint(DateTimeOffset MonthStart, double ReddetNok);
