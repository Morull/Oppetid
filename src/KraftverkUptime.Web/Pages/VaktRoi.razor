    private static string MonthLabel(PortfolioVaktRoiMonthlyPoint p)
    {
        var name = p.Month switch
        {
            1 => "Jan", 2 => "Feb", 3 => "Mar", 4 => "Apr",
            5 => "Mai", 6 => "Jun", 7 => "Jul", 8 => "Aug",
            9 => "Sep", 10 => "Okt", 11 => "Nov", 12 => "Des",
            _ => p.Month.ToString(System.Globalization.CultureInfo.InvariantCulture),
        };
        return $"{name} {p.Year}";
    }

    /// <summary>
    /// Åpner per-hendelse detalj-popup (B3, 2026-05-20). Erstatter den gamle
    /// inline Override-nedtrekken. Dialogen samler full økonomi-breakdown +
    /// overstyringer (klassifisering, faktisk slutt, kommentar) på ett sted.
    /// Ved suksess reloades Vakt-ROI så ROI gjenspeiler nye verdier.
    /// </summary>
    private async Task OpenDetailDialogAsync(VaktRoiEventDto e)
    {
        var existing = _overrides.GetValueOrDefault(e.Event.StartUtc);
        var parameters = new MudBlazor.DialogParameters<VaktEventDetailDialog>
        {
            { x => x.PlantId, Filter.PlantId },
            { x => x.RoiEvent, e },
            { x => x.ExistingOverride, existing },
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
        };
        var dlg = await DialogService.ShowAsync<VaktEventDetailDialog>(
            "Hendelses-detaljer", parameters, options);
        var result = await dlg.Result;
        if (result is null || result.Canceled) return;

        // Re-load Vakt-ROI med nye overrides anvendt på serveren.
        Filter.InvalidateCaches();
        await LoadAsync();
    }

    private string PeriodLabel
    {
        get
        {
            if (_response is null) return "";
            return $"{_response.FromUtc:yyyy-MM-dd} – {_response.ToUtc:yyyy-MM-dd}";
        }
    }

    /// <summary>
    /// Vaktkost for per-plant-ROI: bruker GWh-fordelt andel av samlet
    /// portefølje-vaktkost. Fallback til hele _aarligVaktKost hvis andelen
    /// ikke er beregnelig — bevarer tidligere oppførsel.
    /// </summary>
    private double PerPlantVaktKost()
        => PlantAarligVaktKost(Filter.PlantId) ?? _aarligVaktKost;

    private string RoiSubText()
    {
        var aarlig = EstimertAarligReddet();
        var kost = PerPlantVaktKost();
        if (kost <= 0) return "Sett inn vakt-kost for ROI-sammenlikning";
        var diff = aarlig - kost;
        var ratio = aarlig / kost;
        if (diff >= 0)
        {
            return $"Reddet ≈ {ratio.ToString("F1", NumberFormat.Norsk)}× anleggets vakt-andel";
        }
        return $"Reddet < anleggets vakt-andel (~{ratio.ToString("F1", NumberFormat.Norsk)}×)";
    }

    private KpiAccent RoiAccent()
    {
        var diff = EstimertAarligReddet() - PerPlantVaktKost();
        return diff >= 0 ? KpiAccent.Positive : KpiAccent.Negative;
    }

    private static DateTimeOffset StartOfMonth(DateTimeOffset dt)
    {
        var l = dt.ToLocalTime();
        return new DateTimeOffset(new DateTime(l.Year, l.Month, 1), l.Offset);
    }

    private static string FormatLocal(DateTimeOffset dt)
        => dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    // Tall-formatering: Services/NumberFormat. Vakt-ROI viser 0 som "0"
    // (ikke "–") siden 0 NOK reddet er en MENINGSFULL verdi.
    private static string FormatNok(double nok) => nok.ToString("N0", NumberFormat.Norsk);

    private static string DisplayOverflow(VaktRoiEventDto e)
    {
        if (!e.ErInnenforVakt || !e.ErReddbar) return "–";
        if (e.OverflowDataMissing) return "Mangler data";
        if (e.OverflowTimerInCounterfactual <= 0) return "0 t";
        return $"{e.OverflowTimerInCounterfactual} t";
    }

    private static string DisplayKategori(string kategori) => kategori switch
    {
        "TripFeil" => "Trip / feil",
        "TettInntaksrist" => "Tett inntaksrist",
        "EksternForstyrrelse" => "Ekstern forstyrrelse",
        "PlanlagtVedlikehold" => "Planlagt vedlikehold",
        "Markedstopp" => "Markedstopp",
        "Ressursmangel" => "Ressursmangel",
        "DataMangel" => "Datamangel",
        "UkjentNedetid" => "Ukjent nedetid",
        _ => kategori,
    };

