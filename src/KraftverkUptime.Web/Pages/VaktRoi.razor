@page "/vakt-roi"
@page "/vakt-roi/{PlantId}"
@using ApexCharts
@implements IDisposable
@inject NedetidApi NedetidApi
@inject ReportsApi ReportsApi
@inject FilterState Filter
@inject NavigationManager Nav
@inject CauseFormatter CauseFormatter
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Vakt-ROI</PageTitle>

<PageHeader Title="@($"Vakt-ROI{(IsPortfolioMode ? " — portefølje" : "")}")"
            Subtitle="@(IsPortfolioMode
                ? "Aggregert reddet beløp på tvers av alle 11 anlegg for valgt periode. Klikk en hendelse eller anlegg for å gå til detaljvisning."
                : "Hvor mye produksjons-tap reddet vakt-ordningen i perioden — counterfactual: vente til neste arbeidsdag 08:00.")">
    <Actions>
        @if (IsPortfolioMode)
        {
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                Velg anlegg i topp-baren for per-anleggs detaljvisning.
            </MudText>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Dashboard"
                       Href="/vakt-roi">Tilbake til portefølje</MudButton>
        }
    </Actions>
</PageHeader>

@* Vakt-vindu (per-plant + portefølje): konfigurerbar i topp-baren slik at
   drifts-leder kan simulere alternative vakt-ordninger (eks. droppe nattvakt). *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">Vakt-vindu</MudText>
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudTimePicker @bind-Time="_vaktStart" Label="Start vakt" TimeFormat="HH:mm"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Editable="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTimePicker @bind-Time="_vaktSlutt" Label="Slutt vakt (neste morgen)" TimeFormat="HH:mm"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Editable="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTimePicker @bind-Time="_oppmote" Label="Oppmøte neste arbeidsdag" TimeFormat="HH:mm"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Editable="true" />
        </MudItem>
        <MudItem xs="12">
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                ℹ Default = hjem-vakt 15-07 hverdager + hele helg/helligdag. Endre for å
                simulere alternative vakt-ordninger (eks. droppe nattvakt 22-07).
                Helg- og helligdags-håndteringen endres ikke.
            </MudText>
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-end gap-2">
            <MudButton Variant="Variant.Text" OnClick="ResetVaktVindu">Tilbakestill til default</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled"
                       OnClick="ReloadAsync" Disabled="_loading">
                Bruk vakt-vindu
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!IsPortfolioMode)
{
    @* Vakt-spesifikke parametre — kun for per-plant-modus. *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudNumericField T="double" Value="_aarligVaktKost"
                                 ValueChanged="OnVaktKostChangedAsync"
                                 Label="Samlet portefølje-vaktkost (NOK/år)"
                                 Step="50000" Format="N0"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 HelperText="Hele porteføljens årlige vaktkost — felles for alle brukere, lagret i DB. Anleggets andel beregnes ut fra normal GWh-produksjon (se admin)." />
            </MudItem>
            <MudItem xs="12" sm="6">
                @{
                    var plantKost = PlantAarligVaktKost(Filter.PlantId);
                    var plantAndel = PlantGwhAndel(Filter.PlantId);
                }
                @if (plantKost.HasValue)
                {
                    <MudPaper Class="pa-3" Elevation="0" Style="background: var(--mud-palette-action-disabled-background);">
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                            Anleggets andel av vaktkost
                        </MudText>
                        <MudText Typo="Typo.h6">
                            @FormatNok(plantKost.Value) NOK/år
                            @if (plantAndel.HasValue)
                            {
                                <span style="font-weight: 400; font-size: 0.85em; color: var(--mud-palette-text-secondary);">
                                    @(" · " + NumberFormat.Pct(plantAndel.Value, 1) + " av total")
                                </span>
                            }
                        </MudText>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                            Fordelt etter normal årsproduksjon (GWh-andel).
                        </MudText>
                    </MudPaper>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                        Reddet produksjon beregnes fra <strong>Hydrogrid-plan per time</strong> (settlement-data),
                        ikke en flat kapasitetsfaktor.
                    </MudText>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2">Henter data…</MudText>
}
else if (IsPortfolioMode && _portfolio is not null)
{
    @* ============== PORTEFØLJE-MODUS ============== *@

    @* ---- Vurdering av vaktordningen (flyttet fra /portefolje 2026-05-19) ---- *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.h3" Class="mb-2">Vurdering av vaktordningen</MudText>
                <MudNumericField T="double" Value="_aarligVaktKost"
                                 ValueChanged="OnVaktKostChangedAsync"
                                 Label="Årlig vakt-kost (NOK)"
                                 Step="50000" Format="N0"
                                 HelperText="Felles for alle brukere — lagres i DB"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <KpiCard Label="Total reddet"
                         Value="@FormatNok(_portfolio.TotalReddetNok)"
                         SubText="NOK i perioden"
                         Accent="KpiAccent.Positive" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <KpiCard Label="Annualisert"
                         Value="@FormatNok(AnnualisertReddetPortfolio())"
                         SubText="NOK/år (skalert)"
                         Accent="KpiAccent.Neutral" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <KpiCard Label="Vakt-kost / år"
                         Value="@FormatNok(_aarligVaktKost)"
                         Accent="KpiAccent.Accent" />
            </MudItem>
            <MudItem xs="6" sm="3" md="3">
                <KpiCard Label="Vurdering"
                         Value="@VaktVurderingText()"
                         SubText="@VaktVurderingForklaring()"
                         Accent="@VaktVurderingAccent()" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mt-2">
            Annualisering: total reddet × (365 / antall_dager_i_periode).
            ROI = annualisert reddet / årlig vakt-kost.
            Lønnsom ≥ 1.0, marginal 0.5–1.0, ikke lønnsom &lt; 0.5.
        </MudText>
    </MudPaper>

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Total reddet"
                     Value="@FormatNok(_portfolio.TotalReddetNok)"
                     SubText="@($"NOK på tvers av {_portfolio.PlantsWithData} av {_portfolio.PlantCount} anlegg")"
                     Accent="KpiAccent.Positive" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Reddbare events"
                     Value="@_portfolio.TotalReddbareEvents.ToString()"
                     SubText="@($"av {_portfolio.TotalEvents} totale events i perioden")"
                     Accent="KpiAccent.Neutral" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Snitt per anlegg"
                     Value="@FormatNok(SnittPerAnleggMedData())"
                     SubText="NOK reddet per anlegg med data"
                     Accent="KpiAccent.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Topp-anlegg"
                     Value="@(TopPlant()?.PlantName ?? "—")"
                     SubText="@($"{FormatNok(TopPlant()?.ReddetNok ?? 0)} NOK reddet")"
                     Accent="KpiAccent.Accent" />
        </MudItem>
    </MudGrid>

    @* ---- Sammenligning mot døgnvakt-baseline (portefølje) ---- *@
    @if (_portfolioBaseline is not null && IsCustomVaktVindu)
    {
        var customNok = _portfolio.TotalReddetNok;
        var baselineNok = _portfolioBaseline.TotalReddetNok;
        var diffNok = customNok - baselineNok;
        var pct = baselineNok == 0 ? 0 : (diffNok / baselineNok) * 100;
        var customEvents = _portfolio.TotalReddbareEvents;
        var baselineEvents = _portfolioBaseline.TotalReddbareEvents;
        var annualisertDiff = Annualiser(diffNok);
        var bedreEnnDognvakt = diffNok > 0;

        <MudPaper Class="pa-4 mb-4" Elevation="1"
                  Style="border-left: 4px solid #F39C12; background: rgba(243,156,18,0.05);">
            <MudText Typo="Typo.h4" Class="mb-3">
                Sammenligning vs. døgnvakt (porteføljen)
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Din konfig</MudText>
                    <MudText Typo="Typo.body2" Class="mb-1">@FormatVaktVindu(_portfolio.FromUtc.ToLocalTime().ToString("HH:mm"), "n/a", "n/a")</MudText>
                    <MudText Typo="Typo.h4">@FormatNok(customNok)</MudText>
                    <MudText Typo="Typo.caption">@customEvents reddbare events</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Døgnvakt (15:00-07:00)</MudText>
                    <MudText Typo="Typo.body2" Class="mb-1">Default — dagens ordning</MudText>
                    <MudText Typo="Typo.h4">@FormatNok(baselineNok)</MudText>
                    <MudText Typo="Typo.caption">@baselineEvents reddbare events</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Differanse</MudText>
                    <MudText Typo="Typo.body2" Class="mb-1">
                        @(bedreEnnDognvakt ? "+" : "")@FormatNok(diffNok) (@pct.ToString("F0", NumberFormat.Norsk) %)
                    </MudText>
                    <MudText Typo="Typo.h4" Style="@(bedreEnnDognvakt ? "color:#2A9D8F;" : "color:#E74C3C;")">
                        @(bedreEnnDognvakt ? "+" : "")@FormatNok(annualisertDiff)
                    </MudText>
                    <MudText Typo="Typo.caption">annualisert tap/gevinst vs. døgnvakt</MudText>
                </MudItem>
            </MudGrid>
            @if (!bedreEnnDognvakt && annualisertDiff < 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    <strong>Break-even:</strong> ved å bytte fra døgnvakt til din konfig taper du
                    ca. @FormatNok(Math.Abs(annualisertDiff)) reddet produksjon pr. år.
                    For at det skal lønne seg å bytte må vakt-kost-besparelsen være større enn dette.
                </MudAlert>
            }
            else if (bedreEnnDognvakt)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3" Dense="true">
                    Din konfig redder mer enn døgnvakt — uvanlig, sjekk at vakt-vinduet ditt er korrekt
                    parametrisert (events kan klassifiseres som "innenfor vakt" der de før var "arbeidstid").
                </MudAlert>
            }
        </MudPaper>
    }

    @* ---- Topp-N hendelser ---- *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h3" Class="mb-3">Topp @_portfolio.TopEvents.Count hendelser sortert på reddet beløp</MudText>
        @if (_portfolio.TopEvents.Count == 0)
        {
            <MudText>Ingen reddbare hendelser i perioden.</MudText>
        }
        else
        {
            <MudTable Items="_portfolio.TopEvents" Hover="true" Dense="true" Elevation="0"
                      OnRowClick="@((TableRowClickEventArgs<PortfolioVaktRoiTopEvent> args) => GoToPlantDetail(args.Item))"
                      Style="cursor: pointer;">
                <HeaderContent>
                    <MudTh>Anlegg</MudTh>
                    <MudTh>Start</MudTh>
                    <MudTh>Slutt</MudTh>
                    <MudTh Style="text-align:right">Varighet (t)</MudTh>
                    <MudTh>Kategori</MudTh>
                    <MudTh>
                        <MudTooltip Text="Årsak = HVORFOR enheten er i tilstanden. Drifts-leder kan gi cause-koden brukervennlig tekst på /admin/kategorier.">
                            Årsak
                        </MudTooltip>
                    </MudTh>
                    <MudTh Style="text-align:right">Ekstra (t)</MudTh>
                    <MudTh Style="text-align:right">
                        <MudTooltip Text="Verdi av produksjons-tap vakten reddet. Gjelder kun timer med overløp i magasinet (ellers er vannet bare utsatt).">
                            <span>Overløp (NOK)</span>
                        </MudTooltip>
                    </MudTh>
                    <MudTh Style="text-align:right">
                        <MudTooltip Text="Ubalanse-gebyr vakten reddet (gjelder alle counterfactual-timer fordi Spotbud-forpliktelsen står).">
                            <span>Ubalanse (NOK)</span>
                        </MudTooltip>
                    </MudTh>
                    <MudTh Style="text-align:right">Reddet (NOK)</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.PlantName</MudTd>
                    <MudTd>@FormatLocal(context.StartUtc)</MudTd>
                    <MudTd>@FormatLocal(context.EndUtc)</MudTd>
                    <MudTd Style="text-align:right">@context.VarighetTimer.ToString("F1", NumberFormat.Norsk)</MudTd>
                    <MudTd>@DisplayKategori(context.Kategori)</MudTd>
                    <MudTd>
                        <MudTooltip Text="@(context.CauseCode ?? "")">
                            <span>@CauseFormatter.Display(context.CauseCode)</span>
                        </MudTooltip>
                    </MudTd>
                    <MudTd Style="text-align:right">@context.EkstraTimerSpart.ToString("F1", NumberFormat.Norsk)</MudTd>
                    <MudTd Style="text-align:right">@(context.ReddetProduksjon_NOK > 0 ? FormatNok(context.ReddetProduksjon_NOK) : "–")</MudTd>
                    <MudTd Style="text-align:right">@(context.ReddetUbalanse_NOK > 0 ? FormatNok(context.ReddetUbalanse_NOK) : "–")</MudTd>
                    <MudTd Style="text-align:right; font-weight: 500;">@FormatNok(context.ReddetNok)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    @* ---- Månedlig trend-graf ---- *@
    @if (_portfolio.MonthlyTrend.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h3" Class="mb-3">Reddet NOK per måned (alle anlegg samlet)</MudText>
            <ApexChart @key="_chartVersion" TItem="PortfolioVaktRoiMonthlyPoint"
                       Options="_portfolioTrendOptions" Height="280">
                <ApexPointSeries TItem="PortfolioVaktRoiMonthlyPoint"
                                 Items="_portfolio.MonthlyTrend"
                                 Name="Reddet NOK"
                                 SeriesType="SeriesType.Bar"
                                 XValue="p => MonthLabel(p)"
                                 YValue="p => (decimal)p.TotalReddetNok" />
            </ApexChart>
        </MudPaper>
    }

    @* ---- Per-anlegg-tabell ---- *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h3" Class="mb-3">Per anlegg (sortert på reddet)</MudText>
        <MudTable Items="_portfolio.PerPlant" Hover="true" Dense="true" Elevation="0"
                  OnRowClick="@((TableRowClickEventArgs<PortfolioVaktRoiPlantSummary> args) => GoToPlantSummary(args.Item))"
                  Style="cursor: pointer;">
            <HeaderContent>
                <MudTh>Anlegg</MudTh>
                <MudTh Style="text-align:right">Effekt (MW)</MudTh>
                <MudTh Style="text-align:right">Reddbare events</MudTh>
                <MudTh Style="text-align:right">Totale events</MudTh>
                <MudTh Style="text-align:right">
                    <MudTooltip Text="Verdi av produksjon vakten reddet i timer med overløp.">
                        <span>Overløp (NOK)</span>
                    </MudTooltip>
                </MudTh>
                <MudTh Style="text-align:right">
                    <MudTooltip Text="Ubalanse-gebyr vakten reddet (alle counterfactual-timer).">
                        <span>Ubalanse (NOK)</span>
                    </MudTooltip>
                </MudTh>
                <MudTh Style="text-align:right">Reddet (NOK)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.PlantName</MudTd>
                <MudTd Style="text-align:right">@context.InstalledCapacityMw.ToString("F1", NumberFormat.Norsk)</MudTd>
                <MudTd Style="text-align:right">@context.ReddbareEvents</MudTd>
                <MudTd Style="text-align:right">@context.TotaleEvents</MudTd>
                <MudTd Style="text-align:right">@(context.ReddetProduksjon_NOK > 0 ? FormatNok(context.ReddetProduksjon_NOK) : "–")</MudTd>
                <MudTd Style="text-align:right">@(context.ReddetUbalanse_NOK > 0 ? FormatNok(context.ReddetUbalanse_NOK) : "–")</MudTd>
                <MudTd Style="text-align:right; font-weight: 500;">@FormatNok(context.ReddetNok)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}
else if (!IsPortfolioMode && _response is not null)
{
    @* ============== PER-PLANT-MODUS (uendret) ============== *@

    @* ---- KPI-kort ---- *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Reddet brutto"
                     Value="@FormatNok(_response.TotalReddetNok)"
                     SubText="@($"NOK i perioden ({PeriodLabel})")"
                     Accent="KpiAccent.Positive" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Reddbare events innenfor vakt"
                     Value="@_response.AntallReddbareInnenforVakt.ToString()"
                     SubText="@($"av {_response.AntallEventsTotalt} totale events")"
                     Accent="KpiAccent.Neutral" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Snitt ekstra-timer spart"
                     Value="@_response.SnittEkstraTimerPerEvent.ToString("F1", NumberFormat.Norsk)"
                     SubText="timer per reddbar event"
                     Accent="KpiAccent.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Årlig estimat vs. vakt-kost"
                     Value="@FormatNok(EstimertAarligReddet())"
                     SubText="@RoiSubText()"
                     Accent="@RoiAccent()" />
        </MudItem>
    </MudGrid>

    @* ---- Sammenligning mot døgnvakt-baseline (per-plant) ---- *@
    @if (_responseBaseline is not null && IsCustomVaktVindu)
    {
        var customNok = _response.TotalReddetNok;
        var baselineNok = _responseBaseline.TotalReddetNok;
        var diffNok = customNok - baselineNok;
        var pct = baselineNok == 0 ? 0 : (diffNok / baselineNok) * 100;
        var customEvents = _response.AntallReddbareInnenforVakt;
        var baselineEvents = _responseBaseline.AntallReddbareInnenforVakt;
        var annualisertDiff = Annualiser(diffNok);
        var bedreEnnDognvakt = diffNok > 0;
        var customVindu = FormatVaktVindu(_response.VaktStartLokal, _response.VaktSluttLokal, _response.OppmoteLokal);

        <MudPaper Class="pa-4 mb-4" Elevation="1"
                  Style="border-left: 4px solid #F39C12; background: rgba(243,156,18,0.05);">
            <MudText Typo="Typo.h4" Class="mb-3">Sammenligning vs. døgnvakt</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Din konfig</MudText>
                    <MudText Typo="Typo.body2" Class="mb-1">@customVindu</MudText>
                    <MudText Typo="Typo.h4">@FormatNok(customNok)</MudText>
                    <MudText Typo="Typo.caption">@customEvents reddbare events i perioden</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Døgnvakt (15:00-07:00)</MudText>
                    <MudText Typo="Typo.body2" Class="mb-1">Dagens ordning</MudText>
                    <MudText Typo="Typo.h4">@FormatNok(baselineNok)</MudText>
                    <MudText Typo="Typo.caption">@baselineEvents reddbare events i perioden</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Differanse</MudText>
                    <MudText Typo="Typo.body2" Class="mb-1">
                        @(bedreEnnDognvakt ? "+" : "")@FormatNok(diffNok) (@pct.ToString("F0", NumberFormat.Norsk) %)
                    </MudText>
                    <MudText Typo="Typo.h4" Style="@(bedreEnnDognvakt ? "color:#2A9D8F;" : "color:#E74C3C;")">
                        @(bedreEnnDognvakt ? "+" : "")@FormatNok(annualisertDiff)
                    </MudText>
                    <MudText Typo="Typo.caption">annualisert tap/gevinst vs. døgnvakt</MudText>
                </MudItem>
            </MudGrid>
            @if (!bedreEnnDognvakt && annualisertDiff < 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    <strong>Break-even:</strong> ved å bytte fra døgnvakt til @customVindu taper du
                    ca. <strong>@FormatNok(Math.Abs(annualisertDiff))</strong> reddet produksjon pr. år.
                    For at det skal lønne seg å bytte må vakt-kost-besparelsen være større enn dette
                    (sammenlign mot @FormatNok(_aarligVaktKost) årlig vakt-kost).
                </MudAlert>
            }
            else if (bedreEnnDognvakt)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3" Dense="true">
                    Din konfig redder mer enn døgnvakt — uvanlig, sjekk at vakt-vinduet ditt er
                    korrekt parametrisert. (Hvis riktig: du kan både spare vakt-kost OG øke ROI.)
                </MudAlert>
            }
        </MudPaper>
    }

    @* ---- Forutsetninger ---- *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h4" Class="mb-2">Forutsetninger</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Installert effekt</MudText>
                <MudText Typo="Typo.body1">@_response.InstallertEffektMw.ToString("F2", NumberFormat.Norsk) MW</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Snitt spotpris</MudText>
                <MudText Typo="Typo.body1">@_response.SnittSpotprisNokMwh.ToString("F0", NumberFormat.Norsk) NOK/MWh</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Snitt RK-tillegg</MudText>
                <MudText Typo="Typo.body1">@_response.SnittUbalansetilleggNokMwh.ToString("F0", NumberFormat.Norsk) NOK/MWh</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Vakt-modell</MudText>
                <MudText Typo="Typo.body1">15-07 hverdager + helg, 1.0 t respons</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ---- ROI-splitt (v3): produksjon vs ubalanse ---- *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h4" Class="mb-2">ROI-komponenter</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                    Reddet produksjon (kun timer med overløp)
                </MudText>
                <MudText Typo="Typo.h4">@FormatNok(_response.TotalReddetProduksjon_NOK)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                    Reddet ubalanse-gebyr (alle counterfactual-timer)
                </MudText>
                <MudText Typo="Typo.h4">@FormatNok(_response.TotalReddetUbalanse_NOK)</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ---- Trend (reddet NOK per måned) ---- *@
    @if (_monthlyTrend.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h3" Class="mb-3">Reddet NOK per måned</MudText>
            <ApexChart @key="_chartVersion" TItem="MonthlyPoint"
                       Options="_trendOptions" Height="280">
                <ApexPointSeries TItem="MonthlyPoint"
                                 Items="_monthlyTrend"
                                 Name="Reddet NOK"
                                 SeriesType="SeriesType.Bar"
                                 XValue="p => p.MonthStart.UtcDateTime"
                                 YValue="p => (decimal)p.ReddetNok" />
            </ApexChart>
        </MudPaper>
    }

    @* ---- Event-tabell ---- *@
    <MudPaper Class="pa-4" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-3">
            <MudText Typo="Typo.h3">Hendelser med ROI-vurdering</MudText>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Download"
                       Href="@_csvUrl"
                       Target="_blank"
                       Disabled="@(_csvUrl is null)">
                Last ned CSV
            </MudButton>
        </div>
        <MudTable Items="_response.Events" Hover="true" Dense="true" Elevation="0"
                  FixedHeader="true" Height="500px" Virtualize="true"
                  Filter="MatchesVaktSearch">
            <ToolBarContent>
                <MudTextField @bind-Value="_vaktSearch" Placeholder="Søk kategori, status…"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Margin="Margin.Dense" Immediate="true" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="@SortByVaktStart"
                       InitialDirection="SortDirection.Descending">Start</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@SortByVaktEnd">Slutt</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByVaktDuration">Faktisk (t)</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@SortByVaktCategory">Kategori</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@SortByVaktInWindow">Vakt-vindu</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@SortByVaktReddbar">Reddbar</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByVaktExtra">Ekstra (t)</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right">Overløp</MudTh>
                <MudTh Style="text-align:right">
                    <MudTooltip Text="Verdi av produksjon vakten reddet (kun timer med overløp).">
                        <span>Overløp (NOK)</span>
                    </MudTooltip>
                </MudTh>
                <MudTh Style="text-align:right">
                    <MudTooltip Text="Ubalanse-gebyr vakten reddet (alle counterfactual-timer).">
                        <span>Ubalanse (NOK)</span>
                    </MudTooltip>
                </MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByVaktReddetNok">Reddet (NOK)</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:center; width:120px;">
                    <MudTooltip Text="Detaljer: full økonomi-breakdown + overstyringer (klassifisering, faktisk slutt, kommentar).">
                        <span>Detaljer</span>
                    </MudTooltip>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Start">@FormatLocal(context.Event.StartUtc)</MudTd>
                <MudTd DataLabel="Slutt">@FormatLocal(context.Event.EndUtc)</MudTd>
                <MudTd DataLabel="Faktisk" Style="text-align:right; font-variant-numeric: tabular-nums;">@context.Event.VarighetTimer.ToString("F1", NumberFormat.Norsk)</MudTd>
                <MudTd DataLabel="Kategori">@DisplayKategori(context.Event.Kategori)</MudTd>
                <MudTd DataLabel="Vakt-vindu">@(context.ErInnenforVakt ? "Ja" : "–")</MudTd>
                <MudTd DataLabel="Reddbar">@(context.ErReddbar ? "Ja" : "–")</MudTd>
                <MudTd DataLabel="Ekstra" Style="text-align:right">@(context.ErInnenforVakt && context.ErReddbar ? context.EkstraTimerSpart.ToString("F1", NumberFormat.Norsk) : "–")</MudTd>
                <MudTd DataLabel="Overløp" Style="text-align:right">@DisplayOverflow(context)</MudTd>
                <MudTd DataLabel="Overløp NOK" Style="text-align:right">@(context.ReddetProduksjon_NOK > 0 ? FormatNok(context.ReddetProduksjon_NOK) : "–")</MudTd>
                <MudTd DataLabel="Ubalanse NOK" Style="text-align:right">@(context.ReddetUbalanse_NOK > 0 ? FormatNok(context.ReddetUbalanse_NOK) : "–")</MudTd>
                <MudTd DataLabel="Reddet" Style="text-align:right; font-weight: 500;">@(context.ReddetNok > 0 ? FormatNok(context.ReddetNok) : "–")</MudTd>
                <MudTd DataLabel="Detaljer" Style="text-align:center;">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                   Size="MudBlazor.Size.Small"
                                   Color="MudBlazor.Color.Primary"
                                   OnClick="@(() => OpenDetailDialogAsync(context))"
                                   aria-label="Vis hendelses-detaljer">
                    </MudIconButton>
                    @if (_overrides.ContainsKey(context.Event.StartUtc))
                    {
                        <MudTooltip Text="Manuell overstyring aktiv på denne hendelsen.">
                            <MudIcon Icon="@Icons.Material.Filled.EditNote"
                                     Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public string? PlantId { get; set; }

    // Samlet portefølje-vaktkost. Brukes i porteføljemodus direkte og som
    // grunnlag for GWh-andel-fordeling i per-plant-modus. Default = drifts-leders
    // første estimat 2026; bruker endrer via input-feltet i UI.
    private double _aarligVaktKost = 360_000;

    // Plant-listen med NormalAarsproduksjonGwh lastes for å fordele samlet
    // vaktkost etter GWh-andel. Default fallback: lik fordeling 1/N hvis
    // ingen anlegg har GWh satt (forhindrer 0-divisjon).
    private IReadOnlyList<PlantDto> _allPlants = Array.Empty<PlantDto>();

    private bool _loading;
    private string? _error;

    // Vakt-vindu (lokal tid). Default matcher VaktTidsmodellOptions.Default.
    private TimeSpan? _vaktStart = new(15, 0, 0);
    private TimeSpan? _vaktSlutt = new(7, 0, 0);
    private TimeSpan? _oppmote = new(8, 0, 0);
    private const string VaktStartDefault = "15:00";
    private const string VaktSluttDefault = "07:00";
    private const string OppmoteDefault = "08:00";

    private string? VaktStartParam =>
        _vaktStart.HasValue && _vaktStart.Value.ToString(@"hh\:mm") != VaktStartDefault
            ? _vaktStart.Value.ToString(@"hh\:mm") : null;
    private string? VaktSluttParam =>
        _vaktSlutt.HasValue && _vaktSlutt.Value.ToString(@"hh\:mm") != VaktSluttDefault
            ? _vaktSlutt.Value.ToString(@"hh\:mm") : null;
    private string? OppmoteParam =>
        _oppmote.HasValue && _oppmote.Value.ToString(@"hh\:mm") != OppmoteDefault
            ? _oppmote.Value.ToString(@"hh\:mm") : null;

    /// <summary>
    /// True hvis brukeren har endret minst én av de tre vakt-parametrene
    /// fra default 15:00 / 07:00 / 08:00 (døgnvakt). Brukes til å avgjøre
    /// om vi skal hente en baseline-beregning + vise sammenlignings-kortet.
    /// </summary>
    private bool IsCustomVaktVindu =>
        VaktStartParam is not null || VaktSluttParam is not null || OppmoteParam is not null;

    // Baseline-resultater (døgnvakt 15-07) hentes parallelt når bruker
    // har custom vakt-vindu, slik at sammenligningskortet kan vise diff.
    private VaktRoiResponse? _responseBaseline;
    private PortfolioVaktRoiResponse? _portfolioBaseline;

    private void ResetVaktVindu()
    {
        _vaktStart = new(15, 0, 0);
        _vaktSlutt = new(7, 0, 0);
        _oppmote = new(8, 0, 0);
        _responseBaseline = null;
        _portfolioBaseline = null;
    }

    /// <summary>
    /// Annualiserer reddet beløp for valgt periode. Brukes i sammenligning-
    /// kortet for å gi en års-figur drifts-leder kan måle mot vakt-kost.
    /// </summary>
    private double Annualiser(double sumNok)
    {
        if (!Filter.FromDate.HasValue || !Filter.ToDate.HasValue) return sumNok;
        var dager = (Filter.ToDate.Value - Filter.FromDate.Value).TotalDays;
        if (dager <= 0) return sumNok;
        return sumNok * (365.0 / dager);
    }

    private static string FormatVaktVindu(string start, string slutt, string oppmote) =>
        $"{start}-{slutt} (oppmøte {oppmote})";

    // ----- GWh-andel-fordeling av samlet vaktkost ----------------------------

    /// <summary>
    /// Returnerer denne plantens andel av samlet portefølje-vaktkost,
    /// fordelt etter normal årsproduksjon i GWh:
    ///   andel_plant = plant.NormalGwh / Σ alle anleggs NormalGwh
    ///   plant_kost  = _aarligVaktKost × andel_plant
    /// Fallback (ingen GWh-data): lik fordeling 1/N. Returnerer null hvis
    /// ingen plant er valgt eller listen er tom.
    /// </summary>
    private double? PlantAarligVaktKost(string? plantId)
    {
        if (string.IsNullOrEmpty(plantId)) return null;
        if (_allPlants.Count == 0) return null;
        var totalGwh = _allPlants.Sum(p => p.NormalAarsproduksjonGwh ?? 0);
        if (totalGwh <= 0)
        {
            // Fallback: lik fordeling 1/N hvis ingen anlegg har GWh satt.
            return _aarligVaktKost / _allPlants.Count;
        }
        var plant = _allPlants.FirstOrDefault(p => p.Id == plantId);
        var plantGwh = plant?.NormalAarsproduksjonGwh ?? 0;
        if (plantGwh <= 0)
        {
            // Plant uten GWh i en portefølje der andre HAR GWh — gi 0 andel
            // (plantet bidrar ikke til delt vaktkost) heller enn null.
            return 0;
        }
        return _aarligVaktKost * plantGwh / totalGwh;
    }

    /// <summary>
    /// GWh-andel som tall i prosent for vist tekst. Null hvis ikke beregnelig.
    /// </summary>
    private double? PlantGwhAndel(string? plantId)
    {
        if (string.IsNullOrEmpty(plantId)) return null;
        var totalGwh = _allPlants.Sum(p => p.NormalAarsproduksjonGwh ?? 0);
        if (totalGwh <= 0) return null;
        var plantGwh = _allPlants.FirstOrDefault(p => p.Id == plantId)
            ?.NormalAarsproduksjonGwh ?? 0;
        if (plantGwh <= 0) return 0;
        return plantGwh / totalGwh;
    }

    // ----- Vakt-vurdering (flyttet fra /portefolje) -----

    private double AnnualisertReddetPortfolio()
    {
        if (_portfolio is null) return 0;
        var dager = (Filter.ToDate - Filter.FromDate)?.TotalDays ?? 0;
        return dager <= 0 ? 0 : _portfolio.TotalReddetNok * (365.0 / dager);
    }

    private double VaktRoiRatio() => _aarligVaktKost <= 0 ? 0 : AnnualisertReddetPortfolio() / _aarligVaktKost;

    private string VaktVurderingText()
    {
        var r = VaktRoiRatio();
        if (r >= 1.0) return $"Lønnsom ({r.ToString("F2", NumberFormat.Norsk)}×)";
        if (r >= 0.5) return $"Marginal ({r.ToString("F2", NumberFormat.Norsk)}×)";
        if (r > 0) return $"Ikke lønnsom ({r.ToString("F2", NumberFormat.Norsk)}×)";
        return "–";
    }

    private string VaktVurderingForklaring()
    {
        var r = VaktRoiRatio();
        if (r >= 1.0) return "Vakt-ordningen tjener inn kostnaden.";
        if (r >= 0.5) return "Halv inntjening — vurder bemanningsmodell.";
        if (r > 0) return "Underdekning — vurder reduksjon.";
        return "Ikke nok data til vurdering.";
    }

    private KpiAccent VaktVurderingAccent()
    {
        var r = VaktRoiRatio();
        if (r >= 1.0) return KpiAccent.Positive;
        if (r >= 0.5) return KpiAccent.Warning;
        if (r > 0) return KpiAccent.Negative;
        return KpiAccent.Muted;
    }

    private async Task ReloadAsync()
    {
        if (IsPortfolioMode) await LoadPortfolioAsync();
        else await LoadAsync();
    }

    // Per-plant state
    private VaktRoiResponse? _response;
    private string? _csvUrl;
    private List<MonthlyPoint> _monthlyTrend = new();

    // Portfolio state
    private PortfolioVaktRoiResponse? _portfolio;
    private ApexChartOptions<PortfolioVaktRoiMonthlyPoint> _portfolioTrendOptions = new();

    private int _chartVersion;
    private string _vaktSearch = string.Empty;
    private string _lastLoadedPlantId = string.Empty;

    // Eksisterende overrides per event-start. Holder hele DTO-en så popup-dialogen
    // kan vise både classification, comment og ActualEndOverrideUtc uten ekstra
    // HTTP-kall. Oppdateres etter hver lagring i dialogen.
    private Dictionary<DateTimeOffset, VaktOverrideDto> _overrides = new();

    private ApexChartOptions<MonthlyPoint> _trendOptions = new();

    // Mode-flagg: hvis URL er /vakt-roi (uten plantId) viser vi portefølje-dashboard.
    private bool IsPortfolioMode => string.IsNullOrEmpty(PlantId);

    // Sort-funksjoner for vakt-roi events
    private static readonly Func<VaktRoiEventDto, object> SortByVaktStart    = e => e.Event.StartUtc;
    private static readonly Func<VaktRoiEventDto, object> SortByVaktEnd      = e => e.Event.EndUtc;
    private static readonly Func<VaktRoiEventDto, object> SortByVaktDuration = e => e.Event.VarighetTimer;
    private static readonly Func<VaktRoiEventDto, object> SortByVaktCategory = e => e.Event.Kategori;
    private static readonly Func<VaktRoiEventDto, object> SortByVaktInWindow = e => e.ErInnenforVakt;
    private static readonly Func<VaktRoiEventDto, object> SortByVaktReddbar  = e => e.ErReddbar;
    private static readonly Func<VaktRoiEventDto, object> SortByVaktExtra    = e => e.EkstraTimerSpart;
    private static readonly Func<VaktRoiEventDto, object> SortByVaktReddetNok = e => e.ReddetNok;

    private bool MatchesVaktSearch(VaktRoiEventDto e)
    {
        if (string.IsNullOrWhiteSpace(_vaktSearch)) return true;
        var s = _vaktSearch.Trim();
        return e.Event.Kategori.Contains(s, StringComparison.OrdinalIgnoreCase)
            || (e.Event.CauseCode?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || e.Forklaring.Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;

        // Når brukeren klikker på "Vakt-ROI"-fanen (URL = /vakt-roi uten plant-
        // param) MEN har et anlegg valgt i AppBar, redirect rett til
        // /vakt-roi/{plant} så plant-velgeren faktisk gjenspeiler innholdet.
        // Portefølje-modus er fortsatt tilgjengelig — brukeren kommer dit ved
        // å eksplisitt navigere til /vakt-roi når ingen plant er valgt.
        if (IsPortfolioMode && !string.IsNullOrEmpty(Filter.PlantId))
        {
            _lastLoadedPlantId = Filter.PlantId;
            Nav.NavigateTo($"vakt-roi/{Filter.PlantId}", replace: true);
            return;
        }

        // Per-plant: route-parameter overstyrer FilterState ved direkte navigering.
        if (!IsPortfolioMode && !string.IsNullOrEmpty(PlantId) && PlantId != Filter.PlantId)
        {
            Filter.PlantId = PlantId;
        }

        _ = CauseFormatter.EnsureLoadedAsync()
            .ContinueWith(_ => InvokeAsync(StateHasChanged), TaskScheduler.Default);

        // Plant-listen (med NormalAarsproduksjonGwh) trenger vi for å
        // fordele vaktkost etter GWh-andel. Feiler stille — fallback til
        // lik fordeling.
        try { _allPlants = await ReportsApi.ListPlantsAsync(); }
        catch { _allPlants = Array.Empty<PlantDto>(); }

        // Last lagret portefølje-vakt-kost (Spec NESTE-CHAT-VAKTROI-OG-UI-FIKS Del B):
        // global innstilling i DB, felles for alle brukere. Fallback til
        // default 360 000 hvis endepunktet feiler.
        try { _aarligVaktKost = await NedetidApi.GetPortfolioVaktKostAsync(); }
        catch { /* default 360 000 beholdt */ }

        await LoadFromFilterAsync();
    }

    /// <summary>
    /// Bruker endret vaktkost-feltet — persistere via API og oppdater UI.
    /// Async void er trygt her siden NumericField allerede serialiserer
    /// ValueChanged-kall.
    /// </summary>
    private async Task OnVaktKostChangedAsync(double nyVerdi)
    {
        if (nyVerdi < 0) return;
        var forrige = _aarligVaktKost;
        _aarligVaktKost = nyVerdi;
        try
        {
            await NedetidApi.SetPortfolioVaktKostAsync(nyVerdi);
        }
        catch (Exception ex)
        {
            // Persistens-feil — rull tilbake feltet og vis melding.
            _aarligVaktKost = forrige;
            _error = $"Kunne ikke lagre vakt-kost: {ex.Message}";
            try { await InvokeAsync(StateHasChanged); } catch { /* disposed */ }
        }
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    private async void OnFilterChanged()
    {
        try
        {
            // I portefølje-modus: hvis brukeren bytter anlegg i AppBar, naviger
            // til per-plant-visning slik at velgeren faktisk gjør noe meningsfylt.
            if (IsPortfolioMode
                && !string.IsNullOrEmpty(Filter.PlantId)
                && Filter.PlantId != _lastLoadedPlantId)
            {
                _lastLoadedPlantId = Filter.PlantId;
                Nav.NavigateTo($"vakt-roi/{Filter.PlantId}");
                return;
            }

            await LoadFromFilterAsync();
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente vakt-ROI-data: {ex.Message}";
            try { await InvokeAsync(StateHasChanged); } catch { /* disposed */ }
        }
    }

    private async Task LoadFromFilterAsync()
    {
        if (!Filter.FromDate.HasValue || !Filter.ToDate.HasValue)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (IsPortfolioMode)
        {
            // I portefølje-modus venter vi ikke på Filter.PlantId — vi henter alle.
            // Lagrer det Filter.PlantId-en som var aktiv så vi kan oppdage senere endringer.
            _lastLoadedPlantId = Filter.PlantId ?? string.Empty;
            await LoadPortfolioAsync();
            return;
        }

        if (!Filter.ErKlar)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (Filter.HasFreshVaktRoi())
        {
            _response = Filter.CachedVaktRoi;
            BuildCharts(_response!);
            _csvUrl = NedetidApi.BuildCsvUri(Filter.PlantId, "vakt-roi",
                Filter.FromDate!.Value.ToUtcOffsetSafe(),
                Filter.ToDate!.Value.ToUtcOffsetSafe()).ToString();
            await InvokeAsync(StateHasChanged);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadPortfolioAsync()
    {
        _loading = true;
        _error = null;
        _portfolio = null;
        _portfolioBaseline = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var fromUtc = Filter.FromDate!.Value.ToUtcOffsetSafe();
            var toUtc = Filter.ToDate!.Value.ToUtcOffsetSafe();

            // Custom vakt-vindu: kjør baseline (døgnvakt 15-07) parallelt slik
            // at sammenligningskortet får begge tall i samme render. Hvis ikke
            // custom, hopp over baseline-kallet.
            if (IsCustomVaktVindu)
            {
                var customTask = NedetidApi.GetPortfolioVaktRoiAsync(fromUtc, toUtc, topN: 10,
                    vaktStartLokal: VaktStartParam,
                    vaktSluttLokal: VaktSluttParam,
                    oppmoteLokal: OppmoteParam);
                var baselineTask = NedetidApi.GetPortfolioVaktRoiAsync(fromUtc, toUtc, topN: 10);
                await Task.WhenAll(customTask, baselineTask);
                _portfolio = customTask.Result;
                _portfolioBaseline = baselineTask.Result;
            }
            else
            {
                _portfolio = await NedetidApi.GetPortfolioVaktRoiAsync(fromUtc, toUtc, topN: 10);
            }
            BuildPortfolioCharts(_portfolio);
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente portefølje-Vakt-ROI: {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAsync()
    {
        if (!Filter.ErKlar) return;
        _loading = true;
        _error = null;
        _response = null;
        _responseBaseline = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var fromUtc = Filter.FromDate!.Value.ToUtcOffsetSafe();
            var toUtc = Filter.ToDate!.Value.ToUtcOffsetSafe();

            // Custom vakt-vindu: kjør baseline (døgnvakt) parallelt for
            // sammenligningskortet. Bare ett kall hvis vakten er default.
            if (IsCustomVaktVindu)
            {
                var customTask = NedetidApi.GetVaktRoiAsync(Filter.PlantId, fromUtc, toUtc,
                    vaktStartLokal: VaktStartParam,
                    vaktSluttLokal: VaktSluttParam,
                    oppmoteLokal: OppmoteParam);
                var baselineTask = NedetidApi.GetVaktRoiAsync(Filter.PlantId, fromUtc, toUtc);
                await Task.WhenAll(customTask, baselineTask);
                _response = customTask.Result;
                _responseBaseline = baselineTask.Result;
            }
            else
            {
                _response = await NedetidApi.GetVaktRoiAsync(Filter.PlantId, fromUtc, toUtc);
            }
            _csvUrl = NedetidApi.BuildCsvUri(Filter.PlantId, "vakt-roi", fromUtc, toUtc).ToString();
            Filter.StoreVaktRoi(_response);
            BuildCharts(_response);

            // Last overrides slik at detaljer-dialogen kan pre-fylle eksisterende
            // verdier (classification, ActualEndOverrideUtc, comment) uten ekstra
            // HTTP-spørring. Lagres som dict for O(1)-oppslag per event-start.
            try
            {
                var overrides = await NedetidApi.ListVaktOverridesAsync(Filter.PlantId);
                _overrides = overrides.ToDictionary(o => o.EventStartUtc, o => o);
            }
            catch
            {
                _overrides = new Dictionary<DateTimeOffset, VaktOverrideDto>();
            }
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente Vakt-ROI: {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void BuildCharts(VaktRoiResponse r)
    {
        _chartVersion++;
        _monthlyTrend = r.Events
            .Where(e => e.ReddetNok > 0)
            .GroupBy(e => StartOfMonth(e.Event.StartUtc))
            .Select(g => new MonthlyPoint(g.Key, g.Sum(x => x.ReddetNok)))
            .OrderBy(p => p.MonthStart)
            .ToList();

        _trendOptions = new ApexChartOptions<MonthlyPoint>
        {
            Xaxis = new XAxis { Type = XAxisType.Datetime },
            // NOK-tall: ingen desimaler. Default ApexCharts viser hele
            // floating-point-presisjonen ("40000.00000000000") som er stygg.
            Yaxis = new List<YAxis>
            {
                new() { Title = new AxisTitle { Text = "NOK" }, DecimalsInFloat = 0 }
            },
            Tooltip = new Tooltip { X = new TooltipX { Format = "MMM yyyy" } },
            Colors = new List<string> { "#2A9D8F" },
        };
    }

    private void BuildPortfolioCharts(PortfolioVaktRoiResponse r)
    {
        _chartVersion++;
        _portfolioTrendOptions = new ApexChartOptions<PortfolioVaktRoiMonthlyPoint>
        {
            Xaxis = new XAxis { Type = XAxisType.Category },
            Yaxis = new List<YAxis>
            {
                new() { Title = new AxisTitle { Text = "NOK" }, DecimalsInFloat = 0 }
            },
            Colors = new List<string> { "#2A9D8F" },
        };
    }

    private double EstimertAarligReddet()
    {
        if (_response is null) return 0;
        var dager = (_response.ToUtc - _response.FromUtc).TotalDays;
        if (dager <= 0) return 0;
        return _response.TotalReddetNok * (365.25 / dager);
    }

    private double SnittPerAnleggMedData()
    {
        if (_portfolio is null || _portfolio.PlantsWithData == 0) return 0;
        return _portfolio.TotalReddetNok / _portfolio.PlantsWithData;
    }

    private PortfolioVaktRoiPlantSummary? TopPlant()
        => _portfolio?.PerPlant.FirstOrDefault();

