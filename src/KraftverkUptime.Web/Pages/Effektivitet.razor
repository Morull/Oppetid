@page "/effektivitet"
@page "/effektivitet/{PlantId}"
@using ApexCharts
@implements IDisposable
@inject NedetidApi NedetidApi
@inject FilterState Filter

<PageTitle>Effektivitet</PageTitle>

<MudGrid Class="mb-4">
    <MudItem xs="12" md="8">
        <MudText Typo="Typo.h1">Effektivitet</MudText>
        <MudText Typo="Typo.subtitle1" Color="MudBlazor.Color.Secondary">
            η(P)-kurve, sweet-spot og spesifikt vannforbruk per anlegg.
            Algoritmen finner sweet-spot fra dataen — fungerer for alle anlegg
            som har SCADA-rollene generator-effekt, turbin-virkningsgrad og
            turbin-vannføring.
        </MudText>
    </MudItem>
</MudGrid>

@* Anlegg + periode styres av global velger i AppBar (FilterState). *@

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2 d-inline">Henter data…</MudText>
}
else if (_response is not null)
{
    @if (_response.DataMissing)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            SCADA-data mangler for valgt periode/plant. Sørg for at de tre rollene
            <strong>GeneratorActivePower</strong>, <strong>TurbineEfficiency</strong>
            og <strong>TurbineWaterFlow</strong> er konfigurert i signal_map, og at
            samples er importert.
        </MudAlert>
    }
    else if (_response.ProduksjonsTimer == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Ingen produksjons-timer (P > 50 kW) i perioden.
        </MudAlert>
    }
    else
    {
        @* ---- KPI-kort ---- *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3" lg="2">
                <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #2A9D8F;">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Snitt η</MudText>
                    <MudText Typo="Typo.h3">@_response.SnittEtaPct.ToString("F1") %</MudText>
                    <MudText Typo="Typo.caption">over @_response.ProduksjonsTimer produksjons-timer</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3" lg="2">
                <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #1E5F8E;">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Sweet-spot effekt</MudText>
                    <MudText Typo="Typo.h3">@_response.SweetSpotEffektKw.ToString("F0") kW</MudText>
                    <MudText Typo="Typo.caption">@_response.SweetSpotEtaPct.ToString("F1") % η i bin'en</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3" lg="2">
                <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #F39C12;">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Spesifikt vannforbruk</MudText>
                    <MudText Typo="Typo.h3">@_response.SnittSpesifiktVannforbrukM3PerKwh.ToString("F2")</MudText>
                    <MudText Typo="Typo.caption">m³ per kWh</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3" lg="2">
                <MudPaper Class="pa-4" Elevation="2" Style="border-left: 4px solid #6E59A5;">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Total produksjon</MudText>
                    <MudText Typo="Typo.h3">@((_response.TotalProduksjonKwh / 1000).ToString("F1")) MWh</MudText>
                    <MudText Typo="Typo.caption">i perioden</MudText>
                </MudPaper>
            </MudItem>
            @if (_captureRate is not null)
            {
                <MudItem xs="12" sm="6" md="3" lg="2">
                    <MudPaper Class="pa-4" Elevation="2" Style="@CrCardStyle(_captureRate.TimesCr)">
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Capture rate (times)</MudText>
                        <MudText Typo="Typo.h3">@_captureRate.TimesCr.ToString("F2")</MudText>
                        <MudText Typo="Typo.caption">capt.pris @_captureRate.CapturePriceNokMwh.ToString("F0") NOK/MWh</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3" lg="2">
                    <MudPaper Class="pa-4" Elevation="2" Style="@MerverdiCardStyle(_captureRate.MerverdiNok)">
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Merverdi vs spot</MudText>
                        <MudText Typo="Typo.h3">@FormatNok(_captureRate.MerverdiNok)</MudText>
                        <MudText Typo="Typo.caption">
                            <MudLink Href="@($"/capture-rate/{Filter.PlantId}")">Se detaljer →</MudLink>
                        </MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @* ---- η(P)-scatter ---- *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h3" Class="mb-3">η(P)-kurve</MudText>
            @if (_response.Punkter.Count > 0)
            {
                <ApexChart @key="_chartVersion" TItem="EffektivitetPunkt"
                           Options="_scatterOptions" Height="380">
                    <ApexPointSeries TItem="EffektivitetPunkt"
                                     Items="_response.Punkter"
                                     Name="Time-snitt"
                                     SeriesType="SeriesType.Scatter"
                                     XValue="p => (decimal)p.EffektKw"
                                     YValue="p => (decimal)p.EtaPct" />
                    <ApexPointSeries TItem="EffektivitetBin"
                                     Items="_response.Bins"
                                     Name="Bin-snitt"
                                     SeriesType="SeriesType.Line"
                                     XValue="b => (decimal)b.EffektKwMid"
                                     YValue="b => (decimal)b.SnittEtaPct" />
                </ApexChart>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">Ingen punkter å vise.</MudText>
            }
        </MudPaper>

        @* ---- Bin-tabell ---- *@
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h3" Class="mb-3">Effekt-bins (bredde 200 kW)</MudText>
            <MudTable Items="_response.Bins" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Bin (kW)</MudTh>
                    <MudTh Style="text-align:right">Antall timer</MudTh>
                    <MudTh Style="text-align:right">Snitt η (%)</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.EffektKwStart.ToString("F0") – @((context.EffektKwStart + 200).ToString("F0"))</MudTd>
                    <MudTd Style="text-align:right">@context.Antall</MudTd>
                    <MudTd Style="text-align:right">@context.SnittEtaPct.ToString("F1")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public string? PlantId { get; set; }

    private bool _loading;
    private string? _error;
    private EffektivitetResponse? _response;
    private CaptureRateResultDto? _captureRate;
    private int _chartVersion;
    private ApexChartOptions<EffektivitetPunkt> _scatterOptions = new();

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;

        if (!string.IsNullOrEmpty(PlantId) && PlantId != Filter.PlantId)
        {
            Filter.PlantId = PlantId;
        }

        if (Filter.ErKlar)
        {
            await LoadAsync();
        }
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    private async void OnFilterChanged()
    {
        try
        {
            if (Filter.ErKlar) await LoadAsync();
            else await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente effektivitets-data: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAsync()
    {
        if (!Filter.ErKlar) return;
        _loading = true;
        _error = null;
        _response = null;
        _captureRate = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var fromUtc = Filter.FromDate!.Value.ToUtcOffsetSafe();
            var toUtc = Filter.ToDate!.Value.ToUtcOffsetSafe();
            _response = await NedetidApi.GetEffektivitetAsync(Filter.PlantId, fromUtc, toUtc);

            // Capture rate er sekundær — feiler den, viser vi bare effektivitets-data.
            try
            {
                _captureRate = await NedetidApi.GetCaptureRateAsync(Filter.PlantId, fromUtc, toUtc);
            }
            catch
            {
                _captureRate = null;
            }

            _chartVersion++;
            _scatterOptions = new ApexChartOptions<EffektivitetPunkt>
            {
                Xaxis = new XAxis
                {
                    Title = new AxisTitle { Text = "Effekt (kW)" },
                    DecimalsInFloat = 0,
                },
                Yaxis = new List<YAxis>
                {
                    new()
                    {
                        Title = new AxisTitle { Text = "Virkningsgrad (%)" },
                        DecimalsInFloat = 1,
                    }
                },
                Markers = new Markers { Size = 4 },
                Stroke = new Stroke { Width = new ApexCharts.Size(2) },
                Tooltip = new Tooltip { X = new TooltipX { Show = true } },
                Colors = new List<string> { "#1E5F8E", "#E76F51" },
            };
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente effektivitets-data: {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>CR over 1.0 = grønn (bedre enn baseline), under 1.0 = rød.</summary>
    private static string CrCardStyle(double cr)
    {
        if (cr <= 0) return "border-left: 4px solid #999;";
        return cr >= 1.0
            ? "border-left: 4px solid #2A9D8F;"  // grønn
            : "border-left: 4px solid #E76F51;"; // rød
    }

    private static string MerverdiCardStyle(double nok)
    {
        if (nok == 0) return "border-left: 4px solid #999;";
        return nok > 0
            ? "border-left: 4px solid #2A9D8F;"
            : "border-left: 4px solid #E76F51;";
    }

    private static readonly System.Globalization.NumberFormatInfo NorskTall = new()
    {
        NumberGroupSeparator = " ",
        NumberDecimalSeparator = ",",
        NumberGroupSizes = new[] { 3 },
    };
    private static string FormatNok(double v)
    {
        if (v == 0) return "0 NOK";
        var sign = v > 0 ? "+" : "";
        return sign + v.ToString("N0", NorskTall) + " NOK";
    }
}
