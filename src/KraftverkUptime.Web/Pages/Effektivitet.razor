@page "/effektivitet"
@page "/effektivitet/{PlantId}"
@using ApexCharts
@implements IDisposable
@inject NedetidApi NedetidApi
@inject FilterState Filter
@inject IJSRuntime JS

<PageTitle>Effektivitet</PageTitle>

<PageHeader Title="Effektivitet"
            Subtitle="η(P)-kurve, sweet-spot og spesifikt vannforbruk per anlegg. Algoritmen finner sweet-spot fra dataen — fungerer for alle anlegg som har SCADA-rollene generator-effekt, turbin-virkningsgrad og turbin-vannføring." />

@* Anlegg + periode styres av global velger i AppBar (FilterState). *@

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2 d-inline">Henter data…</MudText>
}
else if (_response is not null)
{
    @if (_response.DataMissing)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            SCADA-data mangler for valgt periode/plant. Sørg for at de tre rollene
            <strong>GeneratorActivePower</strong>, <strong>TurbineEfficiency</strong>
            og <strong>TurbineWaterFlow</strong> er konfigurert i signal_map, og at
            samples er importert.
        </MudAlert>
    }
    else if (_response.ProduksjonsTimer == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Ingen produksjons-timer (P > 50 kW) i perioden.
        </MudAlert>
    }
    else
    {
        @* ---- KPI-kort ---- *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3" lg="2">
                <KpiCard Label="Snitt η"
                         Value="@($"{_response.SnittEtaPct:F1} %")"
                         SubText="@($"over {_response.ProduksjonsTimer} produksjons-timer")"
                         Accent="KpiAccent.Positive" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3" lg="2">
                <KpiCard Label="Sweet-spot effekt"
                         Value="@($"{_response.SweetSpotEffektKw:F0} kW")"
                         SubText="@($"{_response.SweetSpotEtaPct:F1} % η i bin'en")"
                         Accent="KpiAccent.Neutral" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3" lg="2">
                <KpiCard Label="Spesifikt vannforbruk"
                         Value="@_response.SnittSpesifiktVannforbrukM3PerKwh.ToString("F2")"
                         SubText="m³ per kWh"
                         Accent="KpiAccent.Warning" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3" lg="2">
                <KpiCard Label="Total produksjon"
                         Value="@($"{(_response.TotalProduksjonKwh / 1000):F1} MWh")"
                         SubText="i perioden"
                         Accent="KpiAccent.Accent" />
            </MudItem>
            @if (_captureRate is not null)
            {
                <MudItem xs="12" sm="6" md="3" lg="2">
                    <KpiCard Label="Capture rate (times)"
                             Value="@_captureRate.TimesCr.ToString("F2")"
                             SubText="@($"capt.pris {_captureRate.CapturePriceNokMwh:F0} NOK/MWh")"
                             Accent="@CrAccent(_captureRate.TimesCr)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3" lg="2">
                    <KpiCard Label="Merverdi vs spot"
                             Value="@FormatNok(_captureRate.MerverdiNok)"
                             Accent="@MerverdiAccent(_captureRate.MerverdiNok)" />
                </MudItem>
            }
        </MudGrid>

        @* ---- η(P)-scatter ---- *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h3" Class="mb-3">η(P)-kurve</MudText>
            @if (_response.Punkter.Count > 0)
            {
                <ApexChart @key="_chartVersion" TItem="EffektivitetPunkt"
                           Options="_scatterOptions" Height="380">
                    <ApexPointSeries TItem="EffektivitetPunkt"
                                     Items="_response.Punkter"
                                     Name="Time-snitt"
                                     SeriesType="SeriesType.Scatter"
                                     XValue="p => (decimal)p.EffektKw"
                                     YValue="p => (decimal)p.EtaPct" />
                    <ApexPointSeries TItem="EffektivitetBin"
                                     Items="_response.Bins"
                                     Name="Bin-snitt"
                                     SeriesType="SeriesType.Line"
                                     XValue="b => (decimal)b.EffektKwMid"
                                     YValue="b => (decimal)b.SnittEtaPct" />
                </ApexChart>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">Ingen punkter å vise.</MudText>
            }
        </MudPaper>

        @* ---- Bin-tabell (klikkbar drilldown til Produksjons-timer) ---- *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.h3">Effekt-bins (bredde 200 kW)</MudText>
                @if (_selectedBinStart.HasValue)
                {
                    <MudChip T="string" Color="MudBlazor.Color.Primary"
                             OnClose="@(() => SelectBin(null))" CloseIcon="@Icons.Material.Filled.Close">
                        Filter: @_selectedBinStart.Value.ToString("F0") – @((_selectedBinStart.Value + 200).ToString("F0")) kW
                    </MudChip>
                }
            </div>
            <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-2">
                Klikk en rad for å filtrere produksjons-timene under til den effekt-bin'en.
            </MudText>
            <MudTable Items="_response.Bins" Hover="true" Dense="true" Elevation="0"
                      OnRowClick="@((TableRowClickEventArgs<EffektivitetBin> args) => { if (args.Item is not null) _ = SelectBin(args.Item.EffektKwStart); })"
                      RowStyle="cursor: pointer;">
                <HeaderContent>
                    <MudTh>Bin (kW)</MudTh>
                    <MudTh Style="text-align:right">Antall timer</MudTh>
                    <MudTh Style="text-align:right">Snitt η (%)</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @if (_selectedBinStart == context.EffektKwStart)
                        {
                            <strong>@context.EffektKwStart.ToString("F0") – @((context.EffektKwStart + 200).ToString("F0"))</strong>
                        }
                        else
                        {
                            @context.EffektKwStart.ToString("F0") @:– @((context.EffektKwStart + 200).ToString("F0"))
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">@context.Antall</MudTd>
                    <MudTd Style="text-align:right">@context.SnittEtaPct.ToString("F1")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        @* ---- Produksjons-timer — alle timene som ligger bak KPI-ene + scatter ----
           Drilldown fra bin-tabellen filtrerer denne. Drifts-leder kan slå opp
           tidspunktene i SCADA for videre analyse. *@
        <MudPaper Class="pa-4" Elevation="1" id="produksjons-timer-tabell">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.h3">
                    Produksjons-timer (@FilteredPunkter().Count())
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="DownloadCsvAsync"
                           Disabled="@(_response.Punkter.Count == 0)">
                    Last ned CSV
                </MudButton>
            </div>
            <MudTable T="EffektivitetPunkt" Items="FilteredPunkter()"
                      Hover="true" Dense="true" Elevation="0"
                      FixedHeader="true" Height="500px" Virtualize="true"
                      Filter="MatchesTimerSearch">
                <ToolBarContent>
                    <MudTextField @bind-Value="_timerSearch" Placeholder="Søk tidspunkt…"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Margin="Margin.Dense" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="@SortByTimeUtc"
                           InitialDirection="SortDirection.Descending">Tidspunkt</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByEffekt">Effekt (kW)</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByEta">Virkningsgrad (%)</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByVann">Vannføring (m³/s)</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Tidspunkt">@FormatLocal(context.TimeUtc)</MudTd>
                    <MudTd DataLabel="Effekt" Style="text-align:right; font-variant-numeric: tabular-nums;">@context.EffektKw.ToString("F0")</MudTd>
                    <MudTd DataLabel="Virkningsgrad" Style="text-align:right; font-variant-numeric: tabular-nums;">@context.EtaPct.ToString("F1")</MudTd>
                    <MudTd DataLabel="Vannføring" Style="text-align:right; font-variant-numeric: tabular-nums;">@context.VannforingM3PerS.ToString("F2")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>Ingen produksjons-timer matcher filteret.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public string? PlantId { get; set; }

    private bool _loading;
    private string? _error;
    private EffektivitetResponse? _response;
    private CaptureRateResultDto? _captureRate;
    private int _chartVersion;
    private ApexChartOptions<EffektivitetPunkt> _scatterOptions = new();

    // Drilldown-state: når brukeren klikker en bin filtreres
    // Produksjons-timer-tabellen til den effekt-bin'en.
    private double? _selectedBinStart;
    private string _timerSearch = string.Empty;

    // Sort-funksjoner — felt for å unngå Razor-attributt-escape-problemer.
    private static readonly Func<EffektivitetPunkt, object> SortByTimeUtc = p => p.TimeUtc;
    private static readonly Func<EffektivitetPunkt, object> SortByEffekt  = p => p.EffektKw;
    private static readonly Func<EffektivitetPunkt, object> SortByEta     = p => p.EtaPct;
    private static readonly Func<EffektivitetPunkt, object> SortByVann    = p => p.VannforingM3PerS;

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;

        if (!string.IsNullOrEmpty(PlantId) && PlantId != Filter.PlantId)
        {
            Filter.PlantId = PlantId;
        }

        if (Filter.ErKlar)
        {
            await LoadAsync();
        }
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    private async void OnFilterChanged()
    {
        try
        {
            if (Filter.ErKlar) await LoadAsync();
            else await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente effektivitets-data: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAsync()
    {
        if (!Filter.ErKlar) return;
        _loading = true;
        _error = null;
        _response = null;
        _captureRate = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var fromUtc = Filter.FromDate!.Value.ToUtcOffsetSafe();
            var toUtc = Filter.ToDate!.Value.ToUtcOffsetSafe();
            _response = await NedetidApi.GetEffektivitetAsync(Filter.PlantId, fromUtc, toUtc);

            // Capture rate er sekundær — feiler den, viser vi bare effektivitets-data.
            try
            {
                _captureRate = await NedetidApi.GetCaptureRateAsync(Filter.PlantId, fromUtc, toUtc);
            }
            catch
            {
                _captureRate = null;
            }

            // Eksporter tidspunktene til JS slik at scatter-tooltip kan
            // slå opp dato per dataPointIndex (samme rekkefølge som items).
            try
            {
                var tidsstempler = _response.Punkter
                    .Select(p => FormatLocal(p.TimeUtc))
                    .ToArray();
                await JS.InvokeVoidAsync("dkEffPunkterSet", (object)tidsstempler);
            }
            catch
            {
                // JS-interop kan feile under prerender — tooltip viser bare
                // X/Y i så fall, ingen knekk.
            }

            _chartVersion++;
            _scatterOptions = new ApexChartOptions<EffektivitetPunkt>
            {
                Xaxis = new XAxis
                {
                    Title = new AxisTitle { Text = "Effekt (kW)" },
                    DecimalsInFloat = 0,
                },
                Yaxis = new List<YAxis>
                {
                    new()
                    {
                        Title = new AxisTitle { Text = "Virkningsgrad (%)" },
                        DecimalsInFloat = 1,
                    }
                },
                Markers = new Markers { Size = 4 },
                Stroke = new Stroke { Width = new ApexCharts.Size(2) },
                // Tooltip: vis tidspunkt + effekt + virkningsgrad. Punktene
                // er lastet i samme rekkefølge til window.dkEffPunkter, slik at
                // dataPointIndex i scatter-serien (seriesIndex 0) slår opp
                // tidspunkt direkte. Bin-serien (seriesIndex 1) viser kun X/Y.
                Tooltip = new Tooltip
                {
                    Custom = @"function({series, seriesIndex, dataPointIndex, w}) {
                        var pkt = w.config.series[seriesIndex].data[dataPointIndex];
                        var x = (pkt && pkt.x !== undefined) ? pkt.x : (pkt && pkt[0] !== undefined ? pkt[0] : 0);
                        var y = (pkt && pkt.y !== undefined) ? pkt.y : (pkt && pkt[1] !== undefined ? pkt[1] : 0);
                        var arr = (seriesIndex === 0 && window.dkEffPunkter) ? window.dkEffPunkter : null;
                        var tid = (arr && arr[dataPointIndex]) ? arr[dataPointIndex] : null;
                        var head = tid ? '<div style=""padding:4px 8px;font-weight:600;border-bottom:1px solid rgba(0,0,0,0.1);"">' + tid + '</div>' : '';
                        return '<div style=""padding:4px 0;"">' + head +
                            '<div style=""padding:2px 8px;"">Effekt: ' + (+x).toFixed(0) + ' kW</div>' +
                            '<div style=""padding:2px 8px;"">η: ' + (+y).toFixed(1) + ' %</div>' +
                            '</div>';
                    }",
                },
                Colors = new List<string> { "#1E5F8E", "#E76F51" },
            };
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente effektivitets-data: {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>CR over 1.0 = positiv (bedre enn baseline), under 1.0 = negativ.</summary>
    private static KpiAccent CrAccent(double cr)
    {
        if (cr <= 0) return KpiAccent.Muted;
        return cr >= 1.0 ? KpiAccent.Positive : KpiAccent.Negative;
    }

    private static KpiAccent MerverdiAccent(double nok)
    {
        if (nok == 0) return KpiAccent.Muted;
        return nok > 0 ? KpiAccent.Positive : KpiAccent.Negative;
    }

    // Flyttet til Services/NumberFormat.Norsk (UI-gjennomgang tiltak 9).
    private static readonly System.Globalization.NumberFormatInfo NorskTall = NumberFormat.Norsk;
    private static string FormatNok(double v)
    {
        if (v == 0) return "0 NOK";
        var sign = v > 0 ? "+" : "";
        return sign + v.ToString("N0", NorskTall) + " NOK";
    }

    // ----- Time-detalj-tabell --------------------------------------------------

    private static string FormatLocal(DateTimeOffset dt) =>
        dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    /// <summary>Punkter filtrert på valgt bin (hvis noen). Brukes både til tabell og CSV.</summary>
    private IEnumerable<EffektivitetPunkt> FilteredPunkter()
    {
        if (_response is null) return Enumerable.Empty<EffektivitetPunkt>();
        if (!_selectedBinStart.HasValue) return _response.Punkter;
        var start = _selectedBinStart.Value;
        var end = start + 200;
        return _response.Punkter.Where(p => p.EffektKw >= start && p.EffektKw < end);
    }

    /// <summary>Søk på tidspunkt (yyyy-MM-dd HH:mm i lokal tid).</summary>
    private bool MatchesTimerSearch(EffektivitetPunkt p)
    {
        if (string.IsNullOrWhiteSpace(_timerSearch)) return true;
        return FormatLocal(p.TimeUtc).Contains(_timerSearch.Trim(),
            StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Setter / fjerner bin-filteret. Scroll til tabellen så drifts-leder ikke
    /// må scrolle manuelt etter klikk. Bruker JS-interop fordi Blazor ikke har
    /// innebygd scrollIntoView.
    /// </summary>
    private async Task SelectBin(double? binStart)
    {
        _selectedBinStart = binStart;
        if (binStart.HasValue)
        {
            await JS.InvokeVoidAsync("scrollToElement", "produksjons-timer-tabell");
        }
    }

    /// <summary>
    /// Lager CSV av de filtrerte timene og trigger nedlasting via JS-interop.
    /// Klientside — ingen backend nødvendig. UTF-8 BOM så Excel åpner som
    /// nb-NO uten å gjette feil koding.
    /// </summary>
    private async Task DownloadCsvAsync()
    {
        if (_response is null) return;
        var sb = new System.Text.StringBuilder();
        sb.Append('﻿'); // UTF-8 BOM for Excel
        sb.AppendLine("Tidspunkt (lokal);Effekt (kW);Virkningsgrad (%);Vannforing (m3/s)");
        foreach (var p in FilteredPunkter().OrderBy(p => p.TimeUtc))
        {
            // Semikolon-separert for norsk Excel; komma som desimal.
            sb.Append(FormatLocal(p.TimeUtc)).Append(';');
            sb.Append(p.EffektKw.ToString("F0", NorskTall)).Append(';');
            sb.Append(p.EtaPct.ToString("F1", NorskTall)).Append(';');
            sb.AppendLine(p.VannforingM3PerS.ToString("F2", NorskTall));
        }
        var bin = _selectedBinStart.HasValue
            ? $"-bin-{_selectedBinStart.Value:F0}-{_selectedBinStart.Value + 200:F0}kW"
            : "";
        var filename = $"effektivitet-{Filter.PlantId}{bin}-{DateTime.Now:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("downloadTextFile", filename, sb.ToString());
    }
}
