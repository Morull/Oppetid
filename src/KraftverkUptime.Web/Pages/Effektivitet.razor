@page "/effektivitet"
@page "/effektivitet/{PlantId}"
@using ApexCharts
@implements IDisposable
@inject NedetidApi NedetidApi
@inject FilterState Filter
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>Effektivitet</PageTitle>

<PageHeader Title="Effektivitet"
            Subtitle="η(P)-kurve, sweet-spot og spesifikt vannforbruk per anlegg. 15-min-oppløsning. Start/stopp-ramper vises i scatter, men teller ikke i snitt-aggregat.">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Compare"
                   OnClick="@(() => Nav.NavigateTo("/effektivitet/oversikt"))">
            Anleggssammenligning
        </MudButton>
    </Actions>
</PageHeader>

@* Anlegg + periode styres av global velger i AppBar (FilterState). *@

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2 d-inline">Henter data…</MudText>
}
else if (_response is not null)
{
    @if (_response.DataMissing)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            SCADA-data mangler for valgt periode/plant. Sørg for at de tre rollene
            <strong>GeneratorActivePower</strong>, <strong>TurbineEfficiency</strong>
            og <strong>TurbineWaterFlow</strong> er konfigurert i signal_map, og at
            samples er importert.
        </MudAlert>
    }
    else if (_response.ProduksjonsTimer == 0 && _response.Punkter.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Ingen produksjons-intervaller (P &gt; 50 kW) i perioden.
        </MudAlert>
    }
    else if (_response.ProduksjonsTimer == 0 && _response.Punkter.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Ingen intervaller med normal drift i perioden — kun start/stopp-ramper.
            Aggregat-KPI-ene er derfor 0. Punktene vises i scatter for innsyn i ramp-mønster.
        </MudAlert>
    }

    @if (_response.Punkter.Count > 0)
    {
        @* ---- KPI-kort: gruppert i effektivitet + (om aktivt) økonomi ----
           UI-gjennomgang 2026-05-21 punkt 7: tidligere én MudGrid blandet KPI-er
           på tvers. Splittet nå i to seksjoner med liten tittel slik at brukeren
           ser drifts-KPI vs. økonomi-KPI som distinkte konsepter. *@
        <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Secondary" Class="mb-2">Effektivitet</MudText>
        <MudGrid Class="mb-3">
            <MudItem xs="12" sm="6" md="3" lg="3">
                <KpiCard Label="Snitt η"
                         Value="@($"{_response.SnittEtaPct.ToString("F1", NumberFormat.Norsk)} %")"
                         SubText="@($"over {_response.ProduksjonsTimer} intervaller med normal drift (15 min)")"
                         Accent="KpiAccent.Positive" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3" lg="3">
                <KpiCard Label="Sweet-spot effekt"
                         Value="@($"{_response.SweetSpotEffektKw.ToString("F0", NumberFormat.Norsk)} kW")"
                         SubText="@($"{_response.SweetSpotEtaPct.ToString("F1", NumberFormat.Norsk)} % η i bin'en")"
                         Accent="KpiAccent.Neutral" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3" lg="3">
                <KpiCard Label="Spesifikt vannforbruk"
                         Value="@_response.SnittSpesifiktVannforbrukM3PerKwh.ToString("F2", NumberFormat.Norsk)"
                         SubText="m³ per kWh"
                         Accent="KpiAccent.Warning" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3" lg="3">
                <KpiCard Label="Total produksjon"
                         Value="@($"{(_response.TotalProduksjonKwh / 1000).ToString("F1", NumberFormat.Norsk)} MWh")"
                         SubText="i perioden"
                         Accent="KpiAccent.Accent" />
            </MudItem>
        </MudGrid>

        @if (_captureRate is not null)
        {
            <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Secondary" Class="mb-2 mt-2">Økonomi</MudText>
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6" md="3" lg="3">
                    <KpiCard Label="Capture rate (times)"
                             Value="@_captureRate.TimesCr.ToString("F2", NumberFormat.Norsk)"
                             SubText="@($"capt.pris {_captureRate.CapturePriceNokMwh.ToString("F0", NumberFormat.Norsk)} NOK/MWh")"
                             Accent="@CrAccent(_captureRate.TimesCr)" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3" lg="3">
                    <KpiCard Label="Merverdi vs spot"
                             Value="@FormatNok(_captureRate.MerverdiNok)"
                             Accent="@MerverdiAccent(_captureRate.MerverdiNok)" />
                </MudItem>
            </MudGrid>
        }

        @* ---- Underytelse / tapstoppliste (Spec FORBEDRINGSFORSLAG-EFFEKTIVITET.md Del 3) ----
           To referanse-modi:
             Baseline   — bin-snitt-η. Tap = operativt avvik fra det vanlige.
                          Skal være null ved normal drift.
             Sweet-spot — anleggets toppunkt-η. Tap = strategisk potensial som
                          kan utnyttes ved vannsparing til høyprisperioder. *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center mb-3" style="flex-wrap: wrap; gap: 12px;">
                <div>
                    <div class="d-flex align-center" style="gap: 8px;">
                        <MudText Typo="Typo.h3">
                            @(_episodeReferanse == EpisodeReferanseTyp.SweetSpot
                                ? "Strategisk potensial mot sweet-spot"
                                : "Underytelse — tapstoppliste")
                        </MudText>
                        <HjelpeIkon Tittel="Tapstoppliste"
                                    Beskrivelse="Episoder der virkningsgraden ligger merkbart under referansen, gruppert til sammenhengende tidsblokker og rangert på tapt verdi (NOK)."
                                    Begreper="@(new[] { "Δη", "η", "Baseline", "SweetSpot", "TaptEnergi", "TaptVerdi" })" />
                    </div>
                    <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">
                        @if (_episodeReferanse == EpisodeReferanseTyp.SweetSpot)
                        {
                            <text>
                                Intervaller med Δη ≤ @_episodeTerskelPp.ToString("F1", NumberFormat.Norsk) pp mot sweet-spot-η.
                                Tap = hva vi kunne fått ut av samme vann ved å kjøre på sweet-spot.
                            </text>
                        }
                        else
                        {
                            <text>
                                Episoder med Δη ≤ @_episodeTerskelPp.ToString("F1", NumberFormat.Norsk) pp mot bin-baseline for effekt-bin'en.
                            </text>
                        }
                    </MudText>
                </div>
                <div class="d-flex align-center" style="gap: 12px; flex-wrap: wrap;">
                    @* Sammenlign-toggle: baseline vs sweet-spot *@
                    <MudToggleGroup T="EpisodeReferanseTyp" SelectionMode="SelectionMode.SingleSelection"
                                    @bind-Value="_episodeReferanse"
                                    @bind-Value:after="ReloadEpisoderAsync"
                                    Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Primary">
                        <MudToggleItem Value="EpisodeReferanseTyp.Baseline" Text="Mot baseline" />
                        <MudToggleItem Value="EpisodeReferanseTyp.SweetSpot" Text="Mot sweet-spot" />
                    </MudToggleGroup>
                    <MudNumericField T="double" Label="Δη-terskel (pp)" @bind-Value="_episodeTerskelPp"
                                     Min="-20" Max="0" Step="0.5"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 160px;"
                                     OnBlur="ReloadEpisoderAsync" />
                </div>
            </div>

            @if (_episodeLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Primary" />
            }
            else if (_episoder is null)
            {
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">Laster episode-data…</MudText>
            }
            else if (_episoder.Episoder.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Class="mb-0">
                    Ingen episoder under terskel i perioden — driften ligger jevnt på eller over baseline. 👌
                </MudAlert>
            }
            else
            {
                @if (_episoder.ManglerSpotpriser)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        Spotpriser mangler eller er delvis ufullstendige — tapt verdi i NOK er et estimat.
                    </MudAlert>
                }

                @* Tre-kort-sammendrag øverst — totalt tap, antall episoder, snitt-Δη *@
                <MudGrid Class="mb-3">
                    <MudItem xs="12" sm="4">
                        <KpiCard Label="Total tapt verdi"
                                 Value="@FormatTapNok(_episoder.TotalTaptNok)"
                                 SubText="@($"{_episoder.TotalTaptMwh.ToString("F2", NumberFormat.Norsk)} MWh tapt produksjon")"
                                 Accent="KpiAccent.Negative" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <KpiCard Label="Antall episoder"
                                 Value="@_episoder.Episoder.Count.ToString()"
                                 SubText="@($"{_episoder.AntallUnderytendeIntervaller} intervaller under terskel")"
                                 Accent="KpiAccent.Warning" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <KpiCard Label="Snitt-Δη i episoder"
                                 Value="@($"{(_episoder.Episoder.Count > 0 ? _episoder.Episoder.Average(e => e.SnittDeltaEtaPp) : 0).ToString("F1", NumberFormat.Norsk)} pp")"
                                 SubText="mot baseline for effekt-bin"
                                 Accent="KpiAccent.Neutral" />
                    </MudItem>
                </MudGrid>

                @* Tapstoppliste — sortert synkende på tapt verdi.
                   Klikk på rad åpner episode-detalj-dialog med intervall-bryting. *@
                <MudTable T="UnderytendeEpisode" Items="_episoder.Episoder" Hover="true" Dense="true" Elevation="0"
                          FixedHeader="true" Height="380px" Virtualize="true"
                          OnRowClick="@((TableRowClickEventArgs<UnderytendeEpisode> args) => { if (args.Item is not null) _ = OpenEpisodeDialogAsync(args.Item); })"
                          RowStyle="cursor: pointer;">
                    <HeaderContent>
                        <KolonneHode TRow="UnderytendeEpisode" Tittel="Start"
                                     SortBy="@SortByEpisodeStart"
                                     InitialDirection="SortDirection.Descending"
                                     Beskrivelse="Tidspunkt episoden begynner (lokal tid)." />
                        <KolonneHode TRow="UnderytendeEpisode" Tittel="Varighet"
                                     SortBy="@SortByEpisodeVarighet"
                                     Style="text-align:right"
                                     Beskrivelse="Antall 15-min-intervaller i episoden, totalt i timer." />
                        <KolonneHode TRow="UnderytendeEpisode" Tittel="Snitt Δη"
                                     SortBy="@SortByEpisodeDelta"
                                     Style="text-align:right"
                                     BegrepNoekkel="Δη" />
                        <KolonneHode TRow="UnderytendeEpisode" Tittel="Effektområde"
                                     SortBy="@SortByEpisodeEffektMaks"
                                     Style="text-align:right"
                                     Beskrivelse="Min–maks effekt over alle intervaller i episoden (kW). Sorterer på maks." />
                        <KolonneHode TRow="UnderytendeEpisode" Tittel="Tapt energi"
                                     SortBy="@SortByEpisodeTaptMwh"
                                     Style="text-align:right"
                                     BegrepNoekkel="TaptEnergi" />
                        <KolonneHode TRow="UnderytendeEpisode" Tittel="Tapt verdi"
                                     SortBy="@SortByEpisodeTaptNok"
                                     InitialDirection="SortDirection.Descending"
                                     Style="text-align:right"
                                     BegrepNoekkel="TaptVerdi" />
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@FormatLocal(context.StartUtc)</MudTd>
                        <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                            @context.VarighetTimer.ToString("F2", NumberFormat.Norsk) t
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="d-block">
                                @context.AntallIntervaller × 15 min
                            </MudText>
                        </MudTd>
                        <MudTd Style="text-align:right; font-variant-numeric: tabular-nums; color: var(--mud-palette-error);">
                            @context.SnittDeltaEtaPp.ToString("F1", NumberFormat.Norsk) pp
                        </MudTd>
                        <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                            @context.EffektMinKw.ToString("F0", NumberFormat.Norsk) – @context.EffektMaksKw.ToString("F0", NumberFormat.Norsk) kW
                        </MudTd>
                        <MudTd Style="text-align:right; font-variant-numeric: tabular-nums;">
                            @context.TaptMwh.ToString("F3", NumberFormat.Norsk) MWh
                        </MudTd>
                        <MudTd Style="text-align:right; font-variant-numeric: tabular-nums; font-weight: 600;">
                            @if (context.TaptNok > 0)
                            {
                                @FormatTapNok(context.TaptNok)
                                @if (context.TaptNokErEstimat)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="MudBlazor.Size.Small"
                                             Style="opacity: 0.6; margin-left: 4px;" Title="Estimat (manglende spotpriser)" />
                                }
                            }
                            else
                            {
                                <span style="opacity: 0.5;">–</span>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                @* Aggregat per effekt-bånd — gjentakende mønster-tabell *@
                @if (_episoder.AggregatPerEffektBaand.Count > 0)
                {
                    <div class="d-flex align-center mt-4 mb-2" style="gap: 6px;">
                        <MudText Typo="Typo.subtitle2">Gjentakende mønster per effekt-bånd</MudText>
                        <HjelpeIkon Tittel="Gjentakende mønster per effekt-bånd"
                                    Beskrivelse="Aggregat over alle underytende intervaller, gruppert på effekt-bin'en de falt i. Avdekker faste driftspunkt-problemer (samme effekt-bånd har stadig tap)."
                                    Begreper="@(new[] { "EffektBin", "Δη", "TaptEnergi", "TaptVerdi" })" />
                    </div>
                    <MudTable T="EffektBaandAggregat" Items="_episoder.AggregatPerEffektBaand"
                              Hover="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <KolonneHode TRow="EffektBaandAggregat" Tittel="Bånd (kW)"
                                         SortBy="@(b => (object)b.EffektKwStart)"
                                         BegrepNoekkel="EffektBin" />
                            <KolonneHode TRow="EffektBaandAggregat" Tittel="Episoder"
                                         SortBy="@(b => (object)b.AntallEpisoder)"
                                         Style="text-align:right"
                                         Beskrivelse="Antall sammenhengende episoder som dekker dette effekt-båndet." />
                            <KolonneHode TRow="EffektBaandAggregat" Tittel="Total varighet"
                                         SortBy="@(b => (object)b.TotalVarighetTimer)"
                                         Style="text-align:right"
                                         Beskrivelse="Summert tid (timer) der intervallene var underytende i dette båndet." />
                            <KolonneHode TRow="EffektBaandAggregat" Tittel="Snitt Δη"
                                         SortBy="@(b => (object)b.SnittDeltaEtaPp)"
                                         Style="text-align:right"
                                         BegrepNoekkel="Δη" />
                            <KolonneHode TRow="EffektBaandAggregat" Tittel="Tapt energi"
                                         SortBy="@(b => (object)b.TaptMwh)"
                                         Style="text-align:right"
                                         BegrepNoekkel="TaptEnergi" />
                            <KolonneHode TRow="EffektBaandAggregat" Tittel="Tapt verdi"
                                         SortBy="@(b => (object)b.TaptNok)"
                                         InitialDirection="SortDirection.Descending"
                                         Style="text-align:right"
                                         BegrepNoekkel="TaptVerdi" />
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.EffektKwStart.ToString("F0", NumberFormat.Norsk) – @context.EffektKwSlutt.ToString("F0", NumberFormat.Norsk)</MudTd>
                            <MudTd Style="text-align:right">@context.AntallEpisoder</MudTd>
                            <MudTd Style="text-align:right">@context.TotalVarighetTimer.ToString("F1", NumberFormat.Norsk) t</MudTd>
                            <MudTd Style="text-align:right">@context.SnittDeltaEtaPp.ToString("F1", NumberFormat.Norsk) pp</MudTd>
                            <MudTd Style="text-align:right">@context.TaptMwh.ToString("F2", NumberFormat.Norsk) MWh</MudTd>
                            <MudTd Style="text-align:right; font-weight: 600;">@FormatTapNok(context.TaptNok)</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
        </MudPaper>

        @* ---- η(P)-scatter — Genuine + Transition splittet i to serier ----
           Testrapport 2026-05-21 funn #2: ApexPointSeries<EffektivitetBin>
           kastet NullReferenceException i OnInitialized/Dispose når bin-serien
           ble bundet til en tom samling. Defensiv strategi:
           — Hver serie er pre-cachet til et felt (ikke metode-kall som returnerer
             ny List per render → ApexCharts ville se ny referanse hver gang).
           — Hver serie rendres bak en @if-guard med .Count > 0 sjekk slik at
             ApexPointSeries aldri får en tom Items-kilde.
           — Ytre @if-guard krever at MINST én serie har data før vi rendrer
             selve ApexChart-en (ellers er chartet meningsløst). *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex align-center mb-3" style="gap: 8px;">
                <MudText Typo="Typo.h3">η(P)-kurve</MudText>
                <HjelpeIkon Tittel="η(P)-kurve"
                            Beskrivelse="Spredningsplott av virkningsgrad mot effekt. Hvert punkt er ett 15-min-snitt. Grønn linje er bin-snitt (baseline). Sweet-spot er toppen av kurven."
                            Begreper="@(new[] { "η", "P", "Bin", "NormalDrift", "StartStopp", "SweetSpot" })" />
            </div>
            @if (_genuinePunkter.Count > 0 || _transitionPunkter.Count > 0)
            {
                <ApexChart @key="_chartVersion" TItem="EffektivitetPunkt"
                           Options="_scatterOptions" Height="380">
                    @if (_genuinePunkter.Count > 0)
                    {
                        <ApexPointSeries TItem="EffektivitetPunkt"
                                         Items="_genuinePunkter"
                                         Name="Normal drift"
                                         SeriesType="SeriesType.Scatter"
                                         XValue="p => (decimal)p.EffektKw"
                                         YValue="p => (decimal)p.EtaPct" />
                    }
                    @if (_transitionPunkter.Count > 0)
                    {
                        <ApexPointSeries TItem="EffektivitetPunkt"
                                         Items="_transitionPunkter"
                                         Name="Start/stopp"
                                         SeriesType="SeriesType.Scatter"
                                         XValue="p => (decimal)p.EffektKw"
                                         YValue="p => (decimal)p.EtaPct" />
                    }
                    @if (_binLine.Count > 0)
                    {
                        @* Bin-serien MÅ ha TItem="EffektivitetPunkt" for å matche
                           parent ApexChart-en. Hadde tidligere TItem="EffektivitetBin"
                           som ga generic-type-mismatch og NRE i OnInitialized. *@
                        <ApexPointSeries TItem="EffektivitetPunkt"
                                         Items="_binLine"
                                         Name="Bin-snitt"
                                         SeriesType="SeriesType.Line"
                                         XValue="p => (decimal)p.EffektKw"
                                         YValue="p => (decimal)p.EtaPct" />
                    }
                </ApexChart>
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mt-2">
                    Normal drift = produksjons-intervall der η ≥ @GenuineEtaFloorPctDisplay %.
                    Start/stopp = ramp-intervall (P over terskel men η under gulvet); vises i scatter,
                    men teller ikke i snitt-aggregat.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">Ingen punkter å vise.</MudText>
            }
        </MudPaper>

        @* ---- Bin-tabell (klikkbar drilldown til Produksjons-intervaller) ---- *@
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div class="d-flex align-center justify-space-between mb-3">
                <div class="d-flex align-center" style="gap: 8px;">
                    <MudText Typo="Typo.h3">Effekt-bins (bredde 200 kW)</MudText>
                    <HjelpeIkon Tittel="Effekt-bins"
                                Beskrivelse="η-snitt per 200 kW effekt-bånd. Brukes som baseline i underytelse-analysen — sammenligningen er mot bin-snitt, ikke globalt snitt, så et lav-effekt-intervall blir ikke straffet for å være lav-effekt."
                                Begreper="@(new[] { "EffektBin", "η" })" />
                </div>
                @if (_selectedBinStart.HasValue)
                {
                    <MudChip T="string" Color="MudBlazor.Color.Primary"
                             OnClose="@(() => SelectBin(null))" CloseIcon="@Icons.Material.Filled.Close">
                        Filter: @_selectedBinStart.Value.ToString("F0") – @((_selectedBinStart.Value + 200).ToString("F0")) kW
                    </MudChip>
                }
            </div>
            <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-2">
                Klikk en rad for å filtrere produksjons-intervaller under til den effekt-bin'en.
                Bins er bygget kun fra Genuine-intervaller.
            </MudText>
            <MudTable Items="_response.Bins" Hover="true" Dense="true" Elevation="0"
                      OnRowClick="@((TableRowClickEventArgs<EffektivitetBin> args) => { if (args.Item is not null) _ = SelectBin(args.Item.EffektKwStart); })"
                      RowStyle="cursor: pointer;">
                <HeaderContent>
                    <KolonneHode TRow="EffektivitetBin" Tittel="Bin (kW)"
                                 SortBy="@(b => (object)b.EffektKwStart)"
                                 BegrepNoekkel="EffektBin" />
                    <KolonneHode TRow="EffektivitetBin" Tittel="Antall intervaller"
                                 SortBy="@(b => (object)b.Antall)"
                                 Style="text-align:right"
                                 Beskrivelse="Antall 15-min-intervaller med data i denne effekt-bin'en." />
                    <KolonneHode TRow="EffektivitetBin" Tittel="Snitt η (%)"
                                 SortBy="@(b => (object)b.SnittEtaPct)"
                                 Style="text-align:right"
                                 BegrepNoekkel="η" />
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @if (_selectedBinStart == context.EffektKwStart)
                        {
                            <strong>@context.EffektKwStart.ToString("F0") – @((context.EffektKwStart + 200).ToString("F0"))</strong>
                        }
                        else
                        {
                            @context.EffektKwStart.ToString("F0") @:– @((context.EffektKwStart + 200).ToString("F0"))
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">@context.Antall</MudTd>
                    <MudTd Style="text-align:right">@context.SnittEtaPct.ToString("F1")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        @* ---- Produksjons-intervaller — alle 15-min-snittene som ligger bak KPI-ene + scatter.
           Drilldown fra bin-tabellen filtrerer denne. Klassifisering-kolonnen viser om intervallet
           teller i snitt-aggregat (Genuine) eller bare som synlig ramp (Transition). *@
        <MudPaper Class="pa-4" Elevation="1" id="produksjons-timer-tabell">
            <div class="d-flex justify-space-between align-center mb-3">
                <div class="d-flex align-center" style="gap: 8px;">
                    <MudText Typo="Typo.h3">
                        Produksjons-intervaller (@FilteredPunkter().Count())
                    </MudText>
                    <HjelpeIkon Tittel="Produksjons-intervaller"
                                Beskrivelse="Rå 15-min-snitt som ligger bak KPI-ene og scatter-en. Klassifisering skiller normal drift (η ≥ 50 %) fra start/stopp-ramper (η under gulv)."
                                Begreper="@(new[] { "η", "kW", "m³/s", "NormalDrift", "StartStopp" })" />
                </div>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="DownloadCsvAsync"
                           Disabled="@(_response.Punkter.Count == 0)">
                    Last ned CSV
                </MudButton>
            </div>
            <MudTable T="EffektivitetPunkt" Items="FilteredPunkter()"
                      Hover="true" Dense="true" Elevation="0"
                      FixedHeader="true" Height="500px" Virtualize="true"
                      Filter="MatchesTimerSearch">
                <ToolBarContent>
                    <MudTextField @bind-Value="_timerSearch" Placeholder="Søk tidspunkt eller klassifisering…"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Margin="Margin.Dense" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <KolonneHode TRow="EffektivitetPunkt" Tittel="Tidspunkt"
                                 SortBy="@SortByTimeUtc"
                                 InitialDirection="SortDirection.Descending"
                                 Beskrivelse="Start på 15-min-intervallet (lokal tid)." />
                    <KolonneHode TRow="EffektivitetPunkt" Tittel="Effekt (kW)"
                                 SortBy="@SortByEffekt"
                                 Style="text-align:right"
                                 BegrepNoekkel="P" />
                    <KolonneHode TRow="EffektivitetPunkt" Tittel="Virkningsgrad (%)"
                                 SortBy="@SortByEta"
                                 Style="text-align:right"
                                 BegrepNoekkel="η" />
                    <KolonneHode TRow="EffektivitetPunkt" Tittel="Vannføring (m³/s)"
                                 SortBy="@SortByVann"
                                 Style="text-align:right"
                                 BegrepNoekkel="m³/s" />
                    <KolonneHode TRow="EffektivitetPunkt" Tittel="Klassifisering"
                                 SortBy="@SortByKlass"
                                 Beskrivelse="Normal drift = η ≥ 50 %. Start/stopp = ramp-intervall under gulvet; vises men teller ikke i snitt." />
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Tidspunkt">@FormatLocal(context.TimeUtc)</MudTd>
                    <MudTd DataLabel="Effekt" Style="text-align:right; font-variant-numeric: tabular-nums;">@context.EffektKw.ToString("F0", NumberFormat.Norsk)</MudTd>
                    <MudTd DataLabel="Virkningsgrad" Style="text-align:right; font-variant-numeric: tabular-nums;">@context.EtaPct.ToString("F1", NumberFormat.Norsk)</MudTd>
                    <MudTd DataLabel="Vannføring" Style="text-align:right; font-variant-numeric: tabular-nums;">@context.VannforingM3PerS.ToString("F2", NumberFormat.Norsk)</MudTd>
                    <MudTd DataLabel="Klassifisering">
                        @if (context.Klassifisering == PunktKlassifisering.Genuine)
                        {
                            <MudChip T="string" Size="MudBlazor.Size.Small"
                                     Color="MudBlazor.Color.Success" Variant="Variant.Text">Normal drift</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="MudBlazor.Size.Small"
                                     Color="MudBlazor.Color.Warning" Variant="Variant.Text">Start/stopp</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>Ingen produksjons-intervaller matcher filteret.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public string? PlantId { get; set; }

    private bool _loading;
    private string? _error;
    private EffektivitetResponse? _response;
    private CaptureRateResultDto? _captureRate;
    private int _chartVersion;
    private ApexChartOptions<EffektivitetPunkt> _scatterOptions = new();

    // Pre-cachet scatter-serier (Testrapport 2026-05-21 funn #2): ApexCharts
    // ApexPointSeries krever at TItem matcher PARENT ApexChart<TItem>. Hadde
    // tidligere TItem="EffektivitetBin" inne i ApexChart<EffektivitetPunkt>
    // → cascade-typen ApexChart<EffektivitetBin> kunne ikke kastes (generic
    // typer er invariant i C#) → Chart-cascaden ble null → AddSeries(this)
    // i OnInitialized kastet NullReferenceException. Verifisert mot Blazor-
    // ApexCharts v6.0.0 ApexBaseSeries.cs.
    // Løsning: bin-data konverteres til EffektivitetPunkt-instanser for
    // linje-serien så alle tre serier deler TItem med foreldre-charten.
    // Punkt.TimeUtc/VannforingM3PerS er irrelevant for linje-rendreren —
    // bare EffektKw (X) og EtaPct (Y) brukes.
    private List<EffektivitetPunkt> _genuinePunkter = new();
    private List<EffektivitetPunkt> _transitionPunkter = new();
    private List<EffektivitetPunkt> _binLine = new();

    // Episode-analyse (Spec FORBEDRINGSFORSLAG-EFFEKTIVITET.md Del 3) —
    // lastes etter at _response er klart. Egen loading-flag siden tjenesten
    // sannsynligvis tar litt lenger (price-lookup + grupperingslogikk).
    private EpisodeAnalysisResult? _episoder;
    private bool _episodeLoading;
    private double _episodeTerskelPp = -2.0;
    // Hva Δη måles MOT. Default = baseline (anleggets bin-snitt). Bruker kan
    // toggle til sweet-spot for å se strategisk potensial mot toppen.
    private EpisodeReferanseTyp _episodeReferanse = EpisodeReferanseTyp.Baseline;

    // Drilldown-state: når brukeren klikker en bin filtreres
    // Produksjons-timer-tabellen til den effekt-bin'en.
    private double? _selectedBinStart;
    private string _timerSearch = string.Empty;

    // Sort-funksjoner — felt for å unngå Razor-attributt-escape-problemer.
    private static readonly Func<EffektivitetPunkt, object> SortByTimeUtc = p => p.TimeUtc;
    private static readonly Func<EffektivitetPunkt, object> SortByEffekt  = p => p.EffektKw;
    private static readonly Func<EffektivitetPunkt, object> SortByEta     = p => p.EtaPct;
    private static readonly Func<EffektivitetPunkt, object> SortByVann    = p => p.VannforingM3PerS;
    private static readonly Func<EffektivitetPunkt, object> SortByKlass   = p => p.Klassifisering;

    // Sort-felt for episode-tabellen (Punkt 4-visningen).
    private static readonly Func<UnderytendeEpisode, object> SortByEpisodeStart       = e => e.StartUtc;
    private static readonly Func<UnderytendeEpisode, object> SortByEpisodeVarighet    = e => e.VarighetTimer;
    private static readonly Func<UnderytendeEpisode, object> SortByEpisodeDelta       = e => e.SnittDeltaEtaPp;
    private static readonly Func<UnderytendeEpisode, object> SortByEpisodeEffektMaks  = e => e.EffektMaksKw;
    private static readonly Func<UnderytendeEpisode, object> SortByEpisodeTaptMwh     = e => e.TaptMwh;
    private static readonly Func<UnderytendeEpisode, object> SortByEpisodeTaptNok    = e => e.TaptNok;

    // η-gulv som vises i caption — speiler EffektivitetQueryService.GenuineEtaFloorPct.
    // Holdt som konstant her så vi ikke trenger en ny API-roundtrip for å lese den.
    private const double GenuineEtaFloorPctDisplay = 50;

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;

        if (!string.IsNullOrEmpty(PlantId) && PlantId != Filter.PlantId)
        {
            Filter.PlantId = PlantId;
        }

        if (Filter.ErKlar)
        {
            await LoadAsync();
        }
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    private async void OnFilterChanged()
    {
        try
        {
            if (Filter.ErKlar) await LoadAsync();
            else await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente effektivitets-data: {ex.Message}";
            try { await InvokeAsync(StateHasChanged); } catch { /* disposed */ }
        }
    }

    private async Task LoadAsync()
    {
        if (!Filter.ErKlar) return;
        _loading = true;
        _error = null;
        _response = null;
        _captureRate = null;
        _genuinePunkter = new();
        _transitionPunkter = new();
        _binLine = new();
        _episoder = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var fromUtc = Filter.FromDate!.Value.ToUtcOffsetSafe();
            var toUtc = Filter.ToDate!.Value.ToUtcOffsetSafe();
            _response = await NedetidApi.GetEffektivitetAsync(Filter.PlantId, fromUtc, toUtc);

            // Splitt punktene EN GANG til stabile felt-referanser før ApexChart
            // får dem. Tidligere bruk av GenuinePunkter()/TransitionPunkter()-
            // metode-kall returnerte ny List per render → ApexCharts re-init på
            // hver StateHasChanged → NullReferenceException i OnInitialized.
            _genuinePunkter = _response.Punkter
                .Where(p => p.Klassifisering == PunktKlassifisering.Genuine)
                .ToList();
            _transitionPunkter = _response.Punkter
                .Where(p => p.Klassifisering == PunktKlassifisering.Transition)
                .ToList();
            // Konverter bins til EffektivitetPunkt så alle tre scatter-serier
            // deler TItem med ApexChart<EffektivitetPunkt> (se kommentar over
            // felt-deklarasjonene). Linje-rendreren bruker bare X (EffektKw)
            // og Y (EtaPct) — de andre feltene er dummy.
            _binLine = _response.Bins
                .Select(b => new EffektivitetPunkt(
                    TimeUtc: DateTimeOffset.MinValue,
                    EffektKw: b.EffektKwMid,
                    EtaPct: b.SnittEtaPct,
                    VannforingM3PerS: 0,
                    Klassifisering: PunktKlassifisering.Genuine))
                .ToList();

            // Capture rate er sekundær — feiler den, viser vi bare effektivitets-data.
            try
            {
                _captureRate = await NedetidApi.GetCaptureRateAsync(Filter.PlantId, fromUtc, toUtc);
            }
            catch
            {
                _captureRate = null;
            }

            // Episode-analyse i bakgrunn — UI rendrer KPI-er + scatter med en gang
            // og fyller inn tapstopplisten når responsen kommer.
            _ = LoadEpisoderInBackgroundAsync(fromUtc, toUtc);

            // Eksporter tidspunktene til JS slik at scatter-tooltip kan
            // slå opp dato per dataPointIndex (samme rekkefølge som items).
            try
            {
                var tidsstempler = _response.Punkter
                    .Select(p => FormatLocal(p.TimeUtc))
                    .ToArray();
                await JS.InvokeVoidAsync("dkEffPunkterSet", (object)tidsstempler);
            }
            catch
            {
                // JS-interop kan feile under prerender — tooltip viser bare
                // X/Y i så fall, ingen knekk.
            }

            _chartVersion++;
            _scatterOptions = new ApexChartOptions<EffektivitetPunkt>
            {
                Xaxis = new XAxis
                {
                    Title = new AxisTitle { Text = "Effekt (kW)" },
                    DecimalsInFloat = 0,
                    // Testrapport 2026-05-21 funn B: x-aksen rendret 5966 etiketter
                    // (én per datapunkt) fordi ApexCharts defaulter til Category.
                    // Numeric gir kontinuerlig akse med auto-skalering; TickAmount
                    // kapper antall hakk så aksen blir lesbar uansett datatetthet.
                    Type = XAxisType.Numeric,
                    TickAmount = 10,
                    Labels = new XAxisLabels
                    {
                        Formatter = "function(val){return Math.round(val).toString();}",
                    },
                },
                Yaxis = new List<YAxis>
                {
                    new()
                    {
                        Title = new AxisTitle { Text = "Virkningsgrad (%)" },
                        DecimalsInFloat = 1,
                    }
                },
                Markers = new Markers { Size = 4 },
                Stroke = new Stroke { Width = new ApexCharts.Size(2) },
                // Tooltip: vis tidspunkt + effekt + virkningsgrad. Punktene
                // er lastet i samme rekkefølge til window.dkEffPunkter, slik at
                // dataPointIndex i scatter-serien (seriesIndex 0) slår opp
                // tidspunkt direkte. Bin-serien (seriesIndex 1) viser kun X/Y.
                Tooltip = new Tooltip
                {
                    Custom = @"function({series, seriesIndex, dataPointIndex, w}) {
                        var pkt = w.config.series[seriesIndex].data[dataPointIndex];
                        var x = (pkt && pkt.x !== undefined) ? pkt.x : (pkt && pkt[0] !== undefined ? pkt[0] : 0);
                        var y = (pkt && pkt.y !== undefined) ? pkt.y : (pkt && pkt[1] !== undefined ? pkt[1] : 0);
                        var arr = (seriesIndex === 0 && window.dkEffPunkter) ? window.dkEffPunkter : null;
                        var tid = (arr && arr[dataPointIndex]) ? arr[dataPointIndex] : null;
                        var head = tid ? '<div style=""padding:4px 8px;font-weight:600;border-bottom:1px solid rgba(0,0,0,0.1);"">' + tid + '</div>' : '';
                        return '<div style=""padding:4px 0;"">' + head +
                            '<div style=""padding:2px 8px;"">Effekt: ' + (+x).toFixed(0) + ' kW</div>' +
                            '<div style=""padding:2px 8px;"">η: ' + (+y).toFixed(1) + ' %</div>' +
                            '</div>';
                    }",
                },
                // Farger: Genuine (blå) → solid hovedfarge, Transition (oransje)
                // → varseltone, Bin-snitt-linje (grønn) → bin-aggregat-kurve.
                Colors = new List<string> { "#1E5F8E", "#E76F51", "#2A9D8F" },
            };
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente effektivitets-data: {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>CR over 1.0 = positiv (bedre enn baseline), under 1.0 = negativ.</summary>
    private static KpiAccent CrAccent(double cr)
    {
        if (cr <= 0) return KpiAccent.Muted;
        return cr >= 1.0 ? KpiAccent.Positive : KpiAccent.Negative;
    }

    private static KpiAccent MerverdiAccent(double nok)
    {
        if (nok == 0) return KpiAccent.Muted;
        return nok > 0 ? KpiAccent.Positive : KpiAccent.Negative;
    }

    // Tall-formatering: Services/NumberFormat (kultur-uavhengig).
    //
    // FormatNok = signert + "NOK"-suffiks. Brukes for merverdi-kort der
    // fortegnet er meningsfullt (positivt = vi tjente bedre enn spot).
    // Effektivitet viser "0 NOK" for null merverdi (ikke "–") siden CR-
    // konteksten har samme semantikk som CaptureRate-siden — 0 betyr "tjente
    // som spot".
    private static string FormatNok(double v)
    {
        if (v == 0) return "0 NOK";
        var sign = v > 0 ? "+" : "";
        return sign + v.ToString("N0", NumberFormat.Norsk) + " NOK";
    }

    /// <summary>
    /// Tap-formatering: usignert + "NOK"-suffiks. Brukes for "tapt verdi" der
    /// fortegnet er meningsløst (tap er per definisjon positivt). Tidligere
    /// brukte vi FormatNok her, men fikk "+651 NOK NOK"-dobling fordi templates
    /// la på " NOK" igjen.
    /// </summary>
    private static string FormatTapNok(double v) =>
        v <= 0 ? "–" : v.ToString("N0", NumberFormat.Norsk) + " NOK";

    // ----- Time-detalj-tabell --------------------------------------------------

    private static string FormatLocal(DateTimeOffset dt) =>
        dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    /// <summary>Punkter filtrert på valgt bin (hvis noen). Brukes både til tabell og CSV.</summary>
    private IEnumerable<EffektivitetPunkt> FilteredPunkter()
    {
        if (_response is null) return Enumerable.Empty<EffektivitetPunkt>();
        if (!_selectedBinStart.HasValue) return _response.Punkter;
        var start = _selectedBinStart.Value;
        var end = start + 200;
        return _response.Punkter.Where(p => p.EffektKw >= start && p.EffektKw < end);
    }

    // Genuine/Transition-listene er forhåndsutregnet til feltene
    // _genuinePunkter/_transitionPunkter i LoadAsync — se kommentar over
    // ApexChart-blokken. Tidligere metode-versjoner returnerte ny List per
    // render og forårsaket ApexCharts NRE (Testrapport 2026-05-21 funn #2).

    /// <summary>Bakgrunnslast av episode-analysen — kjøres etter at LoadAsync har
    /// satt _response så UI-en allerede viser KPI-er og scatter.</summary>
    private async Task LoadEpisoderInBackgroundAsync(DateTimeOffset fromUtc, DateTimeOffset toUtc)
    {
        _episodeLoading = true;
        try { await InvokeAsync(StateHasChanged); } catch { return; }
        try
        {
            _episoder = await NedetidApi.GetEpisoderAsync(
                Filter.PlantId, fromUtc, toUtc,
                terskelPp: _episodeTerskelPp,
                referanse: _episodeReferanse);
        }
        catch (Exception ex)
        {
            // Episode-feil skal IKKE blokkere resten av siden — logg via konsoll og vis tom liste.
            Console.Error.WriteLine($"Episode-analyse feilet: {ex.Message}");
            _episoder = new EpisodeAnalysisResult(
                Array.Empty<UnderytendeEpisode>(),
                Array.Empty<EffektBaandAggregat>(),
                0, 0, 0, 0, ManglerSpotpriser: true);
        }
        finally
        {
            _episodeLoading = false;
            try { await InvokeAsync(StateHasChanged); } catch { /* disposed */ }
        }
    }

    /// <summary>Åpner detalj-dialog for én underytelse-episode (Punkt 5).
    /// Episoden inneholder selv sin egen liste av underytende intervaller
    /// (Episode.Intervaller), så vi trenger ikke sende AllePunkter inn.</summary>
    private async Task OpenEpisodeDialogAsync(UnderytendeEpisode episode)
    {
        if (_response is null) return;
        var parameters = new DialogParameters
        {
            ["Episode"] = episode,
            ["PlantId"] = Filter.PlantId,
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = true,
        };
        await DialogService.ShowAsync<EpisodeDetailDialog>("Episode-detalj", parameters, options);
    }

    /// <summary>Når brukeren justerer Δη-terskel-slideren, kjør episode-analysen på nytt.</summary>
    private async Task ReloadEpisoderAsync()
    {
        if (!Filter.ErKlar) return;
        var fromUtc = Filter.FromDate!.Value.ToUtcOffsetSafe();
        var toUtc = Filter.ToDate!.Value.ToUtcOffsetSafe();
        await LoadEpisoderInBackgroundAsync(fromUtc, toUtc);
    }

    /// <summary>Søk på tidspunkt (yyyy-MM-dd HH:mm i lokal tid) eller klassifisering.</summary>
    private bool MatchesTimerSearch(EffektivitetPunkt p)
    {
        if (string.IsNullOrWhiteSpace(_timerSearch)) return true;
        var needle = _timerSearch.Trim();
        // Match både norsk visnings-navn og engelsk enum-navn for bakover-
        // kompatibilitet (test som ble skrevet før vi byttet til norske ord).
        var displayName = p.Klassifisering == PunktKlassifisering.Genuine
            ? "Normal drift"
            : "Start/stopp";
        return FormatLocal(p.TimeUtc).Contains(needle, StringComparison.OrdinalIgnoreCase)
            || displayName.Contains(needle, StringComparison.OrdinalIgnoreCase)
            || p.Klassifisering.ToString().Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Setter / fjerner bin-filteret. Scroll til tabellen så drifts-leder ikke
    /// må scrolle manuelt etter klikk. Bruker JS-interop fordi Blazor ikke har
    /// innebygd scrollIntoView.
    /// </summary>
    private async Task SelectBin(double? binStart)
    {
        _selectedBinStart = binStart;
        if (binStart.HasValue)
        {
            await JS.InvokeVoidAsync("scrollToElement", "produksjons-timer-tabell");
        }
    }

    /// <summary>
    /// Lager CSV av de filtrerte timene og trigger nedlasting via JS-interop.
    /// Klientside — ingen backend nødvendig. UTF-8 BOM så Excel åpner som
    /// nb-NO uten å gjette feil koding.
    /// </summary>
    private async Task DownloadCsvAsync()
    {
        if (_response is null) return;
        var sb = new System.Text.StringBuilder();
        sb.Append('﻿'); // UTF-8 BOM for Excel
        sb.AppendLine("Tidspunkt (lokal);Effekt (kW);Virkningsgrad (%);Vannforing (m3/s);Klassifisering");
        foreach (var p in FilteredPunkter().OrderBy(p => p.TimeUtc))
        {
            // Semikolon-separert for norsk Excel; komma som desimal.
            sb.Append(FormatLocal(p.TimeUtc)).Append(';');
            sb.Append(p.EffektKw.ToString("F0", NumberFormat.Norsk)).Append(';');
            sb.Append(p.EtaPct.ToString("F1", NumberFormat.Norsk)).Append(';');
            sb.Append(p.VannforingM3PerS.ToString("F2", NumberFormat.Norsk)).Append(';');
            sb.AppendLine(p.Klassifisering.ToString());
        }
        var bin = _selectedBinStart.HasValue
            ? $"-bin-{_selectedBinStart.Value:F0}-{_selectedBinStart.Value + 200:F0}kW"
            : "";
        var filename = $"effektivitet-{Filter.PlantId}{bin}-{DateTime.Now:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("downloadTextFile", filename, sb.ToString());
    }
}
