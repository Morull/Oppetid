@page "/reports/{PlantId}/{IdempotencyKey}"
@implements IDisposable
@using ApexCharts
@using KraftverkUptime.Web.Components
@using KraftverkUptime.Web.Services
@inject ReportsApi Api
@inject AnnotationsApi AnnotationsApi
@inject KaiaCostApi KaiaCostApi
@inject IDialogService DialogService
@inject FilterState Filter
@inject NavigationManager Nav
@inject CauseFormatter CauseFormatter

<PageTitle>Rapport – @PlantId</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Warning">
        <MudText Typo="Typo.h4">Rapport ikke funnet</MudText>
        <MudText>Fant ingen ferdig-klassifisert rapport for denne importen ennå.
        Klassifiseringen kan fortsatt pågå – <MudLink Href="reports">gå tilbake til listen</MudLink>
        og prøv igjen om et minutt.</MudText>
    </MudAlert>
}
else if (_report is null)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2">Laster rapport…</MudText>
}
else
{
    @* Side-tilpasset velger (UI-gjennomgang tiltak 4). Erstatter global
       periodevelger med direkte anlegg+rapportmåned-valg. *@
    <ReportPageSelector SelectedKey="@IdempotencyKey" />

    <PageHeader Title="@($"Rapport – {_report.PlantId}")"
                Subtitle="@($"{FormatPeriod(_report.PeriodStartUtc, _report.PeriodEndUtc)} · {_report.PeriodHours} timer")">
        <Actions>
            @* Forrige/neste-navigasjon mellom imports for samme anlegg, sortert
               kronologisk på periode-start. Knappene er disabled når man er på
               ytterpunktene. *@
            <MudTooltip Text="@(_prevReport is null ? "Ingen tidligere rapport" : $"Forrige: {_prevReport.PeriodLabel}")">
                <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Default"
                           StartIcon="@Icons.Material.Filled.NavigateBefore"
                           Disabled="@(_prevReport is null)"
                           OnClick="@(() => GoToReport(_prevReport!.IdempotencyKey))">
                    Forrige
                </MudButton>
            </MudTooltip>
            <MudTooltip Text="@(_nextReport is null ? "Ingen senere rapport" : $"Neste: {_nextReport.PeriodLabel}")">
                <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Default"
                           EndIcon="@Icons.Material.Filled.NavigateNext"
                           Disabled="@(_nextReport is null)"
                           OnClick="@(() => GoToReport(_nextReport!.IdempotencyKey))">
                    Neste
                </MudButton>
            </MudTooltip>
            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       Href="@Api.BuildXlsxDownloadUri(PlantId, IdempotencyKey).ToString()"
                       Target="_blank">
                Last ned Excel
            </MudButton>
            <MudTooltip Text="Slett denne rapporten + tilhørende blob (kan ikke angres)">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="MudBlazor.Color.Error"
                               OnClick="DeleteReportAsync"
                               Disabled="@_deleting" />
            </MudTooltip>
        </Actions>
    </PageHeader>

    @* ---------- KPI-kort — gruppert i seksjoner -----------------------------
       Spec FORBEDRINGSFORSLAG-KPI-KORT-INTEGRITET.md: KPI-kort som står sammen
       inviterer til avstemming. Tidligere 9-kort-flat-blokk blandet timer, %,
       MWh og NOK uten seksjons-titler — særlig var "Oppgjør" et avstemmings-
       brudd siden den IKKE er Spotomsetning + Ubalansekost (inkluderer flere
       poster). Speiler nå Drift/Marked/Økonomi-inndelingen fra KPI-katalog-
       tabellen lenger ned. *@
    @foreach (var seksjon in HighlightSections(_report))
    {
        <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Secondary" Class="mb-2 mt-2">@seksjon.Tittel</MudText>
        <MudGrid Class="mb-3">
            @foreach (var card in seksjon.Cards)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <KpiCard Label="@card.Label"
                             Value="@card.Value"
                             SubText="@card.Sub"
                             Accent="@card.Accent"
                             InfoText="@card.Info" />
                </MudItem>
            }
        </MudGrid>
    }

    @* KAIA-kostnad (Spec KAIA-KOSTNAD): meglerprovisjon + fast årsavgift
       pro-rata på rapportperioden. Lastes som egen HTTP-call etter
       rapporten — vises som "Laster…" inntil den er klar. Egen seksjon fordi
       den lastes asynkront og inngår ikke i Oppgjør-summen. *@
    @if (_kaiaCost is not null || _kaiaCostLoading)
    {
        <MudText Typo="Typo.subtitle2" Color="MudBlazor.Color.Secondary" Class="mb-2 mt-2">Megler &amp; avgifter</MudText>
        <MudGrid Class="mb-6">
            @if (_kaiaCost is not null)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <KpiCard Label="KAIA-kostnad"
                             Value="@FormatKaiaTotal(_kaiaCost)"
                             SubText="@($"Megler {FormatNok(_kaiaCost.MeglerprovisjonNok)} · Fast {FormatNok(_kaiaCost.FastAvgiftNok)}")"
                             Accent="KpiAccent.Warning"
                             InfoText="@KaiaTooltip(_kaiaCost)" />
                </MudItem>
            }
            else if (_kaiaCostLoading)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <KpiCard Label="KAIA-kostnad"
                             Value="—"
                             Accent="KpiAccent.Warning"
                             State="KpiState.Loading" />
                </MudItem>
            }
        </MudGrid>
    }

    @* ---------- Graf 1: Driftstilstand-fordeling (donut) ------------------ *@
    <MudGrid Class="mb-6">
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="1">
                <div class="d-flex align-center mb-3" style="gap: 8px;">
                    <MudText Typo="Typo.h3">Driftstilstand-fordeling</MudText>
                    <HjelpeIkon Tittel="Driftstilstand-fordeling"
                                Beskrivelse="Donut som viser hvor mange timer i perioden anlegget var i hver driftstilstand. Driftstilstand = HVA enheten er i; årsaken (HVORFOR) finnes i tabellen under."
                                Begreper="@(new[] { "Drift", "Stille", "Nedetid", "TvangsDerating" })" />
                </div>
                @if (_stateSlices.Count > 0)
                {
                    <ApexChart @key="_chartVersion" TItem="StateSlice" Options="_donutOptions" Height="320">
                        <ApexPointSeries TItem="StateSlice"
                                         Items="_stateSlices"
                                         Name="Timer"
                                         SeriesType="SeriesType.Donut"
                                         XValue="s => s.Display"
                                         YAggregate="xs => (decimal)xs.Sum(x => x.Hours)" />
                    </ApexChart>
                }
            </MudPaper>
        </MudItem>

        @* ---------- Graf 2: 3-veis – plan / spotbud / faktisk ------------- *@
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="1">
                <div class="d-flex align-center mb-3" style="gap: 8px;">
                    <MudText Typo="Typo.h3">Plan / Spotbud / Faktisk</MudText>
                    <HjelpeIkon Tittel="Plan / Spotbud / Faktisk"
                                Beskrivelse="Tre linjer per time: Hydrogrid-plan, meldt spotbud, og faktisk levert til Elhub. Avvik mellom Spotbud og Faktisk koster i ubalanse."
                                Begreper="@(new[] { "MWh", "Elhub", "Spotbud", "Hydrogrid" })" />
                </div>
                @if (_report.Classified.Count > 0)
                {
                    <ApexChart @key="_chartVersion" TItem="ClassifiedHourDto" Options="_lineOptions" Height="320">
                        <ApexPointSeries TItem="ClassifiedHourDto"
                                         Items="_report.Classified"
                                         Name="Produksjonsplan"
                                         SeriesType="SeriesType.Line"
                                         XValue="h => h.TimeUtc.UtcDateTime"
                                         YValue="h => (decimal)(h.ProduksjonplanMwh ?? 0)" />
                        <ApexPointSeries TItem="ClassifiedHourDto"
                                         Items="_report.Classified"
                                         Name="Spotbud"
                                         SeriesType="SeriesType.Line"
                                         XValue="h => h.TimeUtc.UtcDateTime"
                                         YValue="h => (decimal)(h.SpotbudMwh ?? 0)" />
                        <ApexPointSeries TItem="ClassifiedHourDto"
                                         Items="_report.Classified"
                                         Name="Faktisk (Elhub)"
                                         SeriesType="SeriesType.Line"
                                         XValue="h => h.TimeUtc.UtcDateTime"
                                         YValue="h => (decimal)(h.MwhElhub ?? 0)" />
                    </ApexChart>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ---------- Graf 3: Avvik fra forpliktelse ---------------------------- *@
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-3">
            <div class="d-flex align-center" style="gap: 8px;">
                <MudText Typo="Typo.h3">Avvik fra forpliktelse</MudText>
                <HjelpeIkon Tittel="Avvik fra forpliktelse"
                            Beskrivelse="Forskjellen mellom faktisk levert og forpliktet — både mot meldt spotbud og mot Hydrogrid-plan. 0 = perfekt leveranse. Avvik fra Spotbud koster i ubalanse-gebyr."
                            Begreper="@(new[] { "MWh", "Spotbud", "Hydrogrid", "Elhub" })" />
            </div>
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                Faktisk minus Spotbud / Plan. 0 = perfekt leveranse. Lys grønn = drift, rød = nedetid.
            </MudText>
        </div>
        @if (_report.Classified.Count > 0)
        {
            <ApexChart @key="_chartVersion" TItem="ClassifiedHourDto" Options="_avvikOptions" Height="280">
                <ApexPointSeries TItem="ClassifiedHourDto"
                                 Items="_report.Classified"
                                 Name="Avvik Plan"
                                 SeriesType="SeriesType.Line"
                                 XValue="h => h.TimeUtc.UtcDateTime"
                                 YValue="h => (decimal)((h.MwhElhub ?? 0) - (h.ProduksjonplanMwh ?? 0))" />
                <ApexPointSeries TItem="ClassifiedHourDto"
                                 Items="_report.Classified"
                                 Name="Avvik Spotbud"
                                 SeriesType="SeriesType.Line"
                                 XValue="h => h.TimeUtc.UtcDateTime"
                                 YValue="h => (decimal)((h.MwhElhub ?? 0) - (h.SpotbudMwh ?? 0))" />
            </ApexChart>
        }
    </MudPaper>

    @* ---------- Driftstidslinje (heatmap, klikk-til-annotere) ------------- *@
    <div class="mb-6">
        <DriftTimeline @key="_chartVersion"
                       Hours="_report.Classified"
                       Annotations="_annotations"
                       Categories="_categories"
                       OnHourClick="OpenAnnotationDialogAsync" />
    </div>

    @* ---------- KPI-katalog (gruppert etter kategori) --------------------- *@
    <MudPaper Class="pa-4 mb-6" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-3">
            <div class="d-flex align-center" style="gap: 8px;">
                <MudText Typo="Typo.h3">KPI-katalog (@_report.Kpis.Count)</MudText>
                <HjelpeIkon Tittel="KPI-katalog"
                            Beskrivelse="Komplett nøkkeltall-rapport for perioden, gruppert etter kategori. Hold musepekeren over et KPI-navn for å se definisjonen. «Confidence» = datakonfidens (kvalitetsmål)."
                            Begreper="@(new[] { "KPI", "AF", "FOR", "Confidence", "MWh", "NOK" })" />
            </div>
            <MudTextField @bind-Value="_kpiFilter" Immediate="true"
                          Placeholder="Søk KPI…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="MudBlazor.Size.Small"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Style="max-width: 280px;" />
        </div>

        <MudExpansionPanels MultiExpansion="true" Elevation="0" Square="true" Gutters="false">
            @foreach (var group in GroupedKpis())
            {
                <MudExpansionPanel Expanded="@(IsGroupExpandedByDefault(group.Category))">
                    <TitleContent>
                        <div class="d-flex align-center">
                            <MudIcon Icon="@CategoryIcon(group.Category)"
                                     Color="@CategoryColor(group.Category)"
                                     Class="mr-3" />
                            <div>
                                <MudText Typo="Typo.h4">@CategoryDisplayName(group.Category)</MudText>
                                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                                    @group.Items.Count nøkkeltall
                                </MudText>
                            </div>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (group.Items.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="pa-3">
                                Ingen treff i denne kategorien.
                            </MudText>
                        }
                        else
                        {
                            <MudTable Items="@group.Items" Hover="true" Dense="true" Elevation="0">
                                <HeaderContent>
                                    <KolonneHode TRow="KpiDto" Tittel="KPI"
                                                 SortBy="@(k => (object)k.Name)"
                                                 BegrepNoekkel="KPI" />
                                    <KolonneHode TRow="KpiDto" Tittel="Verdi"
                                                 SortBy="@(k => (object)(k.Value ?? 0))"
                                                 Style="text-align:right"
                                                 Beskrivelse="Beregnet verdi for KPI-en i perioden." />
                                    <KolonneHode TRow="KpiDto" Tittel="Enhet"
                                                 SortBy="@(k => (object)k.Unit)"
                                                 Beskrivelse="Måleenhet (ratio, MWh, NOK, hours, events osv)." />
                                    <KolonneHode TRow="KpiDto" Tittel="Timer-basis"
                                                 SortBy="@(k => (object)k.HoursBasis)"
                                                 Style="text-align:right"
                                                 Beskrivelse="Antall timer KPI-en er beregnet over." />
                                    <KolonneHode TRow="KpiDto" Tittel="Confidence"
                                                 SortBy="@(k => (object)k.Confidence)"
                                                 Style="text-align:right"
                                                 BegrepNoekkel="Confidence" />
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="KPI">
                                        <MudTooltip Text="@context.Definition">
                                            <span>@context.Name</span>
                                        </MudTooltip>
                                    </MudTd>
                                    <MudTd DataLabel="Verdi" Style="text-align:right; font-variant-numeric: tabular-nums;">@FormatKpi(context)</MudTd>
                                    <MudTd DataLabel="Enhet">@context.Unit</MudTd>
                                    <MudTd DataLabel="Timer-basis" Style="text-align:right">@context.HoursBasis</MudTd>
                                    <MudTd DataLabel="Confidence" Style="text-align:right">@context.Confidence.ToString("F2")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudPaper>

    @* ---------- Timetabell (foldbar, med filter + sortering) -------------- *@
    <MudPaper Class="pa-4" Elevation="1">
        <MudExpansionPanels Elevation="0">
            <MudExpansionPanel Expanded="true">
                <TitleContent>
                    <div class="d-flex align-center" style="gap: 8px;">
                        <MudText Typo="Typo.h3">
                            Klassifiserte timer (@FilteredHours().Count() / @_report.Classified.Count)
                        </MudText>
                        <HjelpeIkon Tittel="Klassifiserte timer"
                                    Beskrivelse="Hver rad er én klokke-time med driftstilstand, faktisk produksjon (Elhub) og avvik mot plan/spotbud. Tabellen er sortert/filtrert via knappene over og kan brukes til å spore enkelt-timer."
                                    Begreper="@(new[] { "UTC", "MWh", "Elhub", "Spotbud", "Drift", "Nedetid", "Stille" })" />
                    </div>
                </TitleContent>
                <ChildContent>
                    @* Filter-rad: hurtigvalg + per-tilstand-sjekkbokser *@
                    <div class="mb-3">
                        <div class="d-flex" style="gap:6px; flex-wrap:wrap; align-items:center;">
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Vis:</MudText>
                            <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Outlined"
                                       OnClick="@(() => ApplyPreset(HourFilterPreset.Bekymring))"
                                       Color="@(_currentPreset == HourFilterPreset.Bekymring ? MudBlazor.Color.Primary : MudBlazor.Color.Default)">
                                Sjekk: feil + mangler data
                            </MudButton>
                            <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Outlined"
                                       OnClick="@(() => ApplyPreset(HourFilterPreset.NedetidKun))"
                                       Color="@(_currentPreset == HourFilterPreset.NedetidKun ? MudBlazor.Color.Primary : MudBlazor.Color.Default)">
                                Kun nedetid
                            </MudButton>
                            <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Outlined"
                                       OnClick="@(() => ApplyPreset(HourFilterPreset.IkkeIDrift))"
                                       Color="@(_currentPreset == HourFilterPreset.IkkeIDrift ? MudBlazor.Color.Primary : MudBlazor.Color.Default)">
                                Ikke i drift
                            </MudButton>
                            <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Outlined"
                                       OnClick="@(() => ApplyPreset(HourFilterPreset.Alle))"
                                       Color="@(_currentPreset == HourFilterPreset.Alle ? MudBlazor.Color.Primary : MudBlazor.Color.Default)">
                                Alle
                            </MudButton>
                            <MudSpacer />
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Sortér:</MudText>
                            <MudSelect T="HourSort" Value="_sort" ValueChanged="OnSortChanged"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                       Style="max-width:240px;">
                                <MudSelectItem Value="@HourSort.PrioritertViktighet">Viktighet (default)</MudSelectItem>
                                <MudSelectItem Value="@HourSort.TidStigende">Tid (eldst først)</MudSelectItem>
                                <MudSelectItem Value="@HourSort.TidSynkende">Tid (nyest først)</MudSelectItem>
                                <MudSelectItem Value="@HourSort.AvvikSynkende">Plan-avvik (størst først)</MudSelectItem>
                                <MudSelectItem Value="@HourSort.MwhSynkende">MWh Elhub (størst først)</MudSelectItem>
                            </MudSelect>
                        </div>
                        <div class="d-flex mt-2" style="gap:4px; flex-wrap:wrap;">
                            @foreach (var st in _allStatesInData)
                            {
                                var st2 = st;
                                <MudChip T="string" Size="MudBlazor.Size.Small"
                                         Color="@(_visibleStates.Contains(st2) ? StateColor(st2) : MudBlazor.Color.Default)"
                                         Variant="@(_visibleStates.Contains(st2) ? Variant.Filled : Variant.Outlined)"
                                         OnClick="@(() => ToggleState(st2))"
                                         Style="cursor:pointer;">
                                    @StateDisplayName(st2) (@_stateCounts[st2])
                                </MudChip>
                            }
                        </div>
                    </div>

                    <MudTable T="ClassifiedHourDto" Items="FilteredHours()" Hover="true" Dense="true" Elevation="0"
                              Virtualize="true" FixedHeader="true" Height="480px"
                              SortLabel="Sortér">
                        <HeaderContent>
                            <MudTh>
                                <MudTooltip Text="@Begreper.Forklar("UTC")">
                                    <span>Tid (UTC)</span>
                                </MudTooltip>
                            </MudTh>
                            <MudTh>
                                <MudTooltip Text="Driftstilstand (HVA): UnitState fra klassifikator. Hover over chip-en for å se cause-kode (HVORFOR).">
                                    <span>Driftstilstand</span>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Style="text-align:right">
                                <MudTooltip Text="@Begreper.Forklar("Elhub")">
                                    <span>MWh Elhub</span>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Style="text-align:right">
                                <MudTooltip Text="Hydrogrid-planlagt produksjon for timen (MWh).">
                                    <span>Plan</span>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Style="text-align:right">
                                <MudTooltip Text="Faktisk (Elhub) minus Plan — positivt = produserte over planen.">
                                    <span>Avvik</span>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Style="text-align:right">
                                <MudTooltip Text="@Begreper.Forklar("Spotbud")">
                                    <span>Spotbud</span>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Style="text-align:right">
                                <MudTooltip Text="Day-ahead spotpris (NOK/MWh) for timen i prisområdet.">
                                    <span>Spotpris</span>
                                </MudTooltip>
                            </MudTh>
                            <MudTh>
                                <MudTooltip Text="Klassifikatorens forklaring på driftstilstand-valget for timen.">
                                    <span>Begrunnelse</span>
                                </MudTooltip>
                            </MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Tid">@context.TimeUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                            <MudTd DataLabel="Driftstilstand">
                                <MudTooltip Text="@($"Årsak: {CauseFormatter.Display(context.CauseCode)} ({context.CauseCode}) — confidence {context.Confidence:F2}")">
                                    <MudChip T="string" Size="MudBlazor.Size.Small" Color="@StateColor(context.State)">@StateDisplayName(context.State)</MudChip>
                                </MudTooltip>
                            </MudTd>
                            <MudTd DataLabel="MWh Elhub" Style="text-align:right">@FormatNullable(context.MwhElhub, "F3")</MudTd>
                            <MudTd DataLabel="Plan" Style="text-align:right">@FormatNullable(context.ProduksjonplanMwh, "F3")</MudTd>
                            <MudTd DataLabel="Avvik" Style="text-align:right">@FormatAvvik(context)</MudTd>
                            <MudTd DataLabel="Spotbud" Style="text-align:right">@FormatNullable(context.SpotbudMwh, "F3")</MudTd>
                            <MudTd DataLabel="Spotpris" Style="text-align:right">@FormatNullable(context.SpotprisNokMwh, "F2")</MudTd>
                            <MudTd DataLabel="Begrunnelse">
                                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">
                                    @context.Rationale
                                </MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>
}

@code {
    [Parameter] public string PlantId { get; set; } = string.Empty;
    [Parameter] public string IdempotencyKey { get; set; } = string.Empty;

    private UptimeReportSummary? _report;
    private bool _notFound;
    private string? _error;
    private string _kpiFilter = string.Empty;
    private List<StateSlice> _stateSlices = new();
    private IReadOnlyList<AnnotationDto> _annotations = Array.Empty<AnnotationDto>();
    private IReadOnlyList<AnnotationCategoryDto> _categories = Array.Empty<AnnotationCategoryDto>();

    // KAIA-kostnad lastes som egen HTTP-call etter rapporten —
    // null = ikke lastet ennå eller manglende data, _kaiaCostLoading = pågår.
    private KaiaCostDto? _kaiaCost;
    private bool _kaiaCostLoading;

    // Naboer for forrige/neste-navigasjon
    private NeighborReport? _prevReport;
    private NeighborReport? _nextReport;
    private bool _deleting;

    private sealed record NeighborReport(string IdempotencyKey, string PeriodLabel);

    // Filter + sortering for klassifiserte timer-tabellen
    private HourFilterPreset _currentPreset = HourFilterPreset.Bekymring;
    private HashSet<string> _visibleStates = new(StringComparer.Ordinal);
    private List<string> _allStatesInData = new();
    private Dictionary<string, int> _stateCounts = new(StringComparer.Ordinal);
    private HourSort _sort = HourSort.PrioritertViktighet;

    private enum HourFilterPreset { Bekymring, NedetidKun, IkkeIDrift, Alle, Manuell }
    private enum HourSort { PrioritertViktighet, TidStigende, TidSynkende, AvvikSynkende, MwhSynkende }

    /// <summary>
    /// Bygger state-fordelingen og initialiserer filter-bryterne. Kalles fra
    /// BuildCharts slik at filteret er klart første gang tabellen rendres.
    /// "Bekymring"-preset velges som default — det er hva drifts-leder
    /// trenger å se først.
    /// </summary>
    private void InitHourFilter(UptimeReportSummary report)
    {
        _stateCounts = report.Classified
            .GroupBy(h => h.State)
            .ToDictionary(g => g.Key, g => g.Count(), StringComparer.Ordinal);
        // Default-rekkefølgen via Priority — viktigste øverst
        _allStatesInData = _stateCounts.Keys
            .OrderBy(StatePriority)
            .ThenBy(s => s)
            .ToList();
        ApplyPreset(HourFilterPreset.Bekymring);
    }

    private void ApplyPreset(HourFilterPreset preset)
    {
        _currentPreset = preset;
        _visibleStates = preset switch
        {
            // Sjekk-listen: alt som krever oppmerksomhet
            HourFilterPreset.Bekymring => new(new[]
            {
                "ForcedOutage", "ForcedDerating",
                "InformationUnavailable",
            }, StringComparer.Ordinal),
            HourFilterPreset.NedetidKun => new(new[]
            {
                "ForcedOutage",
            }, StringComparer.Ordinal),
            HourFilterPreset.IkkeIDrift => new(new[]
            {
                "ForcedOutage", "ForcedDerating", "PlannedOutage", "MaintenanceOutage",
                "ResourceUnavailable", "ReserveShutdown",
                "InformationUnavailable",
            }, StringComparer.Ordinal),
            HourFilterPreset.Alle => new(_allStatesInData, StringComparer.Ordinal),
            _ => _visibleStates,
        };
    }

    private void ToggleState(string state)
    {
        if (_visibleStates.Contains(state)) _visibleStates.Remove(state);
        else _visibleStates.Add(state);
        // Bryter ut av preset-modus så snart bruker overstyrer manuelt
        _currentPreset = HourFilterPreset.Manuell;
    }

    private void OnSortChanged(HourSort newSort)
    {
        _sort = newSort;
    }

    /// <summary>Returnerer filtrerte + sorterte timer.</summary>
    private IEnumerable<ClassifiedHourDto> FilteredHours()
    {
        if (_report is null) return Array.Empty<ClassifiedHourDto>();
        var rows = _report.Classified.Where(h => _visibleStates.Contains(h.State));
        return _sort switch
        {
            HourSort.PrioritertViktighet => rows
                .OrderBy(h => StatePriority(h.State))
                .ThenByDescending(h => AvvikMwh(h))
                .ThenBy(h => h.TimeUtc),
            HourSort.TidStigende => rows.OrderBy(h => h.TimeUtc),
            HourSort.TidSynkende => rows.OrderByDescending(h => h.TimeUtc),
            HourSort.AvvikSynkende => rows.OrderByDescending(h => AvvikMwh(h)).ThenBy(h => h.TimeUtc),
            HourSort.MwhSynkende => rows.OrderByDescending(h => h.MwhElhub ?? 0).ThenBy(h => h.TimeUtc),
            _ => rows,
        };
    }

    /// <summary>Lavere tall = høyere viktighet. Drifts-leder ser feil + missing først.</summary>
    private static int StatePriority(string state) => state switch
    {
        "ForcedOutage" => 1,                  // viktigst — uvarslet utfall
        "InformationUnavailable" => 2,        // datafeil må sjekkes
        "ForcedDerating" => 3,                // plan-avvik
        "PlannedOutage" => 4,
        "MaintenanceOutage" => 5,
        "ResourceUnavailable" => 6,
        "ReserveShutdown" => 7,
        "InService" => 8,                     // minst presserende — alt OK
        _ => 9,
    };

    /// <summary>Plan − Elhub i MWh. Positiv verdi = underlevering. 0 hvis plan/elhub mangler.</summary>
    private static double AvvikMwh(ClassifiedHourDto h)
    {
        if (!h.ProduksjonplanMwh.HasValue || !h.MwhElhub.HasValue) return 0;
        return h.ProduksjonplanMwh.Value - h.MwhElhub.Value;
    }

    private static string FormatAvvik(ClassifiedHourDto h)
    {
        if (!h.ProduksjonplanMwh.HasValue || !h.MwhElhub.HasValue || h.ProduksjonplanMwh.Value == 0) return "–";
        var avvik = h.MwhElhub.Value - h.ProduksjonplanMwh.Value;
        var pct = (avvik / h.ProduksjonplanMwh.Value) * 100;
        return $"{(pct > 0 ? "+" : "")}{pct:F0} %";
    }

    private ApexChartOptions<StateSlice> _donutOptions = new();
    private ApexChartOptions<ClassifiedHourDto> _lineOptions = new();
    private ApexChartOptions<ClassifiedHourDto> _avvikOptions = new();

    // Inkrementeres hver gang BuildCharts kjører — brukes som @key på ApexChart
    // og DriftTimeline slik at Blazor gjenskaper komponentene istedenfor å bare
    // oppdatere parametere. Blazor-ApexCharts cacher intern chart-state og
    // viser ikke nye annotasjoner/bånd uten dette.
    private int _chartVersion;

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    /// <summary>
    /// Hvis brukeren bytter anlegg i AppBar mens vi viser en spesifikk rapport,
    /// naviger til /reports slik at de kan velge en rapport for det nye anlegget.
    /// SyncFilterState (kalt etter rapport-load) fyrer også OnChange men da
    /// matcher Filter.PlantId == PlantId og vi hopper over.
    /// </summary>
    private void OnFilterChanged()
    {
        if (string.IsNullOrEmpty(Filter.PlantId)) return;
        if (string.Equals(Filter.PlantId, PlantId, StringComparison.OrdinalIgnoreCase)) return;
        Nav.NavigateTo("/reports");
    }

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _notFound = false;
        _report = null;
        _kaiaCost = null;
        _kaiaCostLoading = false;

        // Last cause-aliaser i bakgrunnen — UI rendres med rå koder først,
        // erstattes ved neste re-render etter at CauseFormatter er klar.
        _ = CauseFormatter.EnsureLoadedAsync()
            .ContinueWith(_ => InvokeAsync(StateHasChanged), TaskScheduler.Default);

        try
        {
            _report = await Api.GetReportAsync(PlantId, IdempotencyKey);
            if (_report is null)
            {
                _notFound = true;
            }
            else
            {
                BuildCharts(_report);
                InitHourFilter(_report);
                SyncFilterState(_report);
                await LoadAnnotationsAsync();
                await LoadNeighborsAsync();
                _ = LoadKaiaCostAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente rapport: {ex.Message}";
        }
    }

    /// <summary>
    /// Laster KAIA-kostnad asynkront. Feiler stille hvis endepunktet er
    /// utilgjengelig — KPI-kortet vises ikke, og resten av rapporten
    /// forblir brukbar.
    /// </summary>
    private async Task LoadKaiaCostAsync()
    {
        _kaiaCostLoading = true;
        try
        {
            _kaiaCost = await KaiaCostApi.GetForImportAsync(PlantId, IdempotencyKey);
        }
        catch
        {
            _kaiaCost = null;
        }
        finally
        {
            _kaiaCostLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

async Task GoToReport(string idempotencyKey)
    {
        Nav.NavigateTo($"reports/{PlantId}/{idempotencyKey}");
    }

    /// <summary>
    /// Sletter rapport + import-rad + blob etter bruker-bekreftelse. Navigerer
    /// tilbake til /reports?plant={plantId} ved suksess slik at brukeren
    /// ser den oppdaterte listen uten å sitte igjen på en 404-side.
    /// </summary>
    private async Task DeleteReportAsync()
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Slett rapport?",
            $"Du er i ferd med å slette rapporten for {PlantId} ({(_report is null ? "" : FormatPeriod(_report.PeriodStartUtc, _report.PeriodEndUtc))}). " +
            "Settlement-import-raden + KPI-rapport-blobben blir borte. Operasjonen kan ikke angres.",
            yesText: "Slett",
            cancelText: "Avbryt");
        if (confirmed != true) return;

        _deleting = true;
        StateHasChanged();
        try
        {
            await Api.DeleteSettlementAsync(PlantId, IdempotencyKey);
            // Naviger tilbake til lista — rapporten finnes ikke lenger.
            Nav.NavigateTo($"reports?plant={PlantId}");
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke slette rapport: {ex.Message}";
            _deleting = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Henter alle imports for samme anlegg sortert etter periode-start, så
    /// finner naboer (forrige/neste) basert på posisjonen til den nåværende
    /// rapporten. Bruker bare imports der ReportAvailable=true (klassifisering
    /// ferdig) — pending imports skal ikke kunne navigeres til, lenken ville
    /// vist 404.
    /// </summary>
    private async Task LoadNeighborsAsync()
    {
        try
        {
            var imports = await Api.ListSettlementsAsync(PlantId);
            var ready = imports
                .Where(i => i.ReportAvailable)
                .OrderBy(i => i.PeriodStartUtc)
                .ToList();
            var idx = ready.FindIndex(i => i.IdempotencyKey == IdempotencyKey);
            if (idx < 0) return;

            _prevReport = idx > 0
                ? new NeighborReport(ready[idx - 1].IdempotencyKey,
                    FormatPeriod(ready[idx - 1].PeriodStartUtc, ready[idx - 1].PeriodEndUtc))
                : null;
            _nextReport = idx < ready.Count - 1
                ? new NeighborReport(ready[idx + 1].IdempotencyKey,
                    FormatPeriod(ready[idx + 1].PeriodStartUtc, ready[idx + 1].PeriodEndUtc))
                : null;
        }
        catch
        {
            // Naboer er sekundærdata; rapporten vises uansett.
            _prevReport = null;
            _nextReport = null;
        }
    }

    private async Task LoadAnnotationsAsync()
    {
        if (_report is null)
        {
            return;
        }
        try
        {
            // Last kategori-listen én gang per sidelast (sjelden mutasjon).
            if (_categories.Count == 0)
            {
                _categories = await AnnotationsApi.ListCategoriesAsync();
            }
            _annotations = await AnnotationsApi.ListAsync(
                PlantId, _report.PeriodStartUtc, _report.PeriodEndUtc.AddHours(1));
        }
        catch (Exception ex)
        {
            // Annoteringer er sekundærdata; rapporten vises selv om dette feiler.
            Console.Error.WriteLine($"Kunne ikke hente annoteringer: {ex.Message}");
        }
    }

    private async Task OpenAnnotationDialogAsync(DriftTimeline.HourClickedArgs args)
    {
        if (_report is null)
        {
            return;
        }

        var parameters = new DialogParameters<AnnotationDialog>
        {
            { x => x.PlantId, PlantId },
            { x => x.Categories, _categories },
            { x => x.InitialStart, args.StartUtc },
            { x => x.InitialEnd, args.EndUtc },
            { x => x.Existing, args.Annotation },
            { x => x.CurrentClassification, BuildClassificationSummary(args.RangeHours) }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };

        var title = args.Annotation is null ? "Ny annotering" : "Rediger annotering";
        var dialog = await DialogService.ShowAsync<AnnotationDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        // Invalidér Nedetid + Vakt-ROI-cache slik at navigering dit henter
        // ferske data med den nye annoteringen anvendt (samme datakilde går
        // gjennom AnnotationOverlayService i NedetidQueryService).
        Filter.InvalidateCaches();

        // Reload både annoteringene og selve rapporten (som har overlay applied).
        await LoadAnnotationsAsync();
        try
        {
            _report = await Api.GetReportAsync(PlantId, IdempotencyKey);
            if (_report is not null)
            {
                BuildCharts(_report);
            }
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke oppdatere rapport etter annotering: {ex.Message}";
        }
        StateHasChanged();
    }

    private void BuildCharts(UptimeReportSummary report)
    {
        _chartVersion++;

        _stateSlices = report.StateCounts
            .OrderByDescending(kv => kv.Value)
            .Select(kv => new StateSlice(kv.Key, StateDisplayName(kv.Key), kv.Value))
            .ToList();

        _donutOptions = new ApexChartOptions<StateSlice>
        {
            Colors = _stateSlices.Select(s => StateHexColor(s.CanonicalState)).ToList(),
            Legend = new Legend { Position = LegendPosition.Bottom },
            PlotOptions = new PlotOptions
            {
                Pie = new PlotOptionsPie { Donut = new PlotOptionsDonut { Size = "65%" } }
            },
        };

        var stateBands = BuildStateBands(report);

        _lineOptions = new ApexChartOptions<ClassifiedHourDto>
        {
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
            Xaxis = new XAxis { Type = XAxisType.Datetime },
            // MWh per time ligger typisk 0–10; 1 desimal er passende.
            Yaxis = new List<YAxis> { new YAxis { DecimalsInFloat = 1 } },
            Legend = new Legend { Position = LegendPosition.Top },
            Tooltip = new Tooltip { X = new TooltipX { Format = "dd MMM HH:mm" } },
            Colors = new List<string> { "#1E5F8E", "#F39C12", "#00A99D" },
            Annotations = new Annotations { Xaxis = stateBands },
        };

        _avvikOptions = new ApexChartOptions<ClassifiedHourDto>
        {
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
            Xaxis = new XAxis { Type = XAxisType.Datetime },
            Yaxis = new List<YAxis>
            {
                // 1 desimal — styrer både y-akse-labels og tooltip-presisjon.
                new YAxis { DecimalsInFloat = 1 }
            },
            Legend = new Legend { Position = LegendPosition.Top },
            Tooltip = new Tooltip { X = new TooltipX { Format = "dd MMM HH:mm" } },
            Colors = new List<string> { "#1E5F8E", "#F39C12" },
            Annotations = new Annotations
            {
                Xaxis = stateBands,
                Yaxis = new List<AnnotationsYAxis>
                {
                    new()
                    {
                        Y = 0,
                        BorderColor = "#9AA5B0",
                        StrokeDashArray = 4,
                    }
                }
            }
        };
    }

    /// <summary>
    /// Bygger bakgrunns-bånd for ApexCharts som markerer drift- og nedetidsperioder.
    /// Lys grønt for InService, lys rødt for ForcedOutage; andre states gir ikke bånd
    /// (for å holde grafen ryddig). Sammenhengende timer med samme state slås sammen
    /// til ett bånd.
    /// </summary>
    private static List<AnnotationsXAxis> BuildStateBands(UptimeReportSummary report)
    {
        var bands = new List<AnnotationsXAxis>();
        if (report.Classified.Count == 0)
        {
            return bands;
        }

        var rows = report.Classified.OrderBy(h => h.TimeUtc).ToList();
        DateTimeOffset bandStart = rows[0].TimeUtc;
        string bandState = rows[0].State;

        for (var i = 1; i <= rows.Count; i++)
        {
            var ended = i == rows.Count;
            var nextState = ended ? null : rows[i].State;
            var contiguous = !ended && rows[i].TimeUtc == rows[i - 1].TimeUtc.AddHours(1);

            if (ended || !contiguous || nextState != bandState)
            {
                var bandEnd = rows[i - 1].TimeUtc.AddHours(1);
                var color = StateBandColor(bandState);
                if (color is not null)
                {
                    bands.Add(new AnnotationsXAxis
                    {
                        X = bandStart.ToUnixTimeMilliseconds(),
                        X2 = bandEnd.ToUnixTimeMilliseconds(),
                        BorderColor = "transparent",
                        FillColor = color,
                        Opacity = 0.10,
                    });
                }
                if (!ended)
                {
                    bandStart = rows[i].TimeUtc;
                    bandState = nextState!;
                }
            }
        }

        return bands;
    }

    /// <summary>
    /// Mapper UnitState til en bakgrunnsfarge for ApexCharts-bånd.
    /// Returner null for states vi ikke vil flagge i grafen (RS, IU, etc.).
    /// </summary>
    private static string? StateBandColor(string state) => state switch
    {
        "InService" or "inService" => "#2ECC71",          // lys grønn — drift
        "ForcedOutage" or "forcedOutage" => "#E74C3C",    // rød — uvarslet nedetid
        "PlannedOutage" or "plannedOutage" => "#1E5F8E",  // blå — planlagt revisjon (annotert)
        "MaintenanceOutage" or "maintenanceOutage" => "#1976D2", // litt lysere blå — vedlikehold
        _ => null,
    };

    private bool FilterKpi(KpiDto k)
    {
        if (string.IsNullOrWhiteSpace(_kpiFilter)) return true;
        return k.Name.Contains(_kpiFilter, StringComparison.OrdinalIgnoreCase)
            || k.Category.Contains(_kpiFilter, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Grupper KPI-er etter Category og sorter både gruppene og KPI-ene innenfor.
    /// drift først (operasjonelt viktigst), så marked, så økonomi.
    /// </summary>
    private IEnumerable<KpiGroup> GroupedKpis()
    {
        if (_report is null) yield break;

        var filtered = _report.Kpis.Where(FilterKpi).ToList();

        foreach (var category in new[] { "drift", "marked", "okonomi" })
        {
            var items = filtered
                .Where(k => string.Equals(k.Category, category, StringComparison.Ordinal))
                .OrderBy(k => k.Name)
                .ToList();
            yield return new KpiGroup(category, items);
        }

        // Eventuelle ukjente kategorier til slutt
        var knownCategories = new HashSet<string>(new[] { "drift", "marked", "okonomi" }, StringComparer.Ordinal);
        var unknown = filtered.Where(k => !knownCategories.Contains(k.Category))
            .GroupBy(k => k.Category)
            .OrderBy(g => g.Key);
        foreach (var g in unknown)
        {
            yield return new KpiGroup(g.Key, g.OrderBy(k => k.Name).ToList());
        }
    }

    /// <summary>
    /// Drift utvides by default (operasjonelt fokus). Hvis brukeren søker, åpne alle
    /// for å gjøre treff synlige uavhengig av kategori.
    /// </summary>
    private bool IsGroupExpandedByDefault(string category)
    {
        if (!string.IsNullOrWhiteSpace(_kpiFilter))
        {
            return true;
        }
        return category == "drift";
    }

    private static string CategoryDisplayName(string category) => category switch
    {
        "drift" => "Drift",
        "marked" => "Marked",
        "okonomi" => "Økonomi",
        _ => category,
    };

    private static string CategoryIcon(string category) => category switch
    {
        "drift" => Icons.Material.Filled.PrecisionManufacturing,
        "marked" => Icons.Material.Filled.TrendingUp,
        "okonomi" => Icons.Material.Filled.Payments,
        _ => Icons.Material.Filled.Category,
    };

    private static MudBlazor.Color CategoryColor(string category) => category switch
    {
        "drift" => MudBlazor.Color.Success,
        "marked" => MudBlazor.Color.Info,
        "okonomi" => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Default,
    };

    private sealed record KpiGroup(string Category, IReadOnlyList<KpiDto> Items);

    /// <summary>
    /// KPI-kort gruppert i seksjoner (Drift / Volum / Marked / Resultat).
    /// Spec FORBEDRINGSFORSLAG-KPI-KORT-INTEGRITET.md Del 1: kort som står sammen
    /// må enten avstemmes som komponenter, eller markeres som selvstendige
    /// indikatorer via seksjons-tittel. Vi velger sistnevnte og speiler
    /// kategoriene fra KPI-katalog-tabellen lenger ned.
    /// </summary>
    private static IEnumerable<HighlightSection> HighlightSections(UptimeReportSummary r)
    {
        double? Get(string name) => r.Kpis.FirstOrDefault(k => k.Name == name)?.Value;

        // Drift — timer + andel-KPI-er.
        yield return new HighlightSection("Drift", new[]
        {
            new HighlightCard("Drift-timer", FormatNumber(Get("ServiceHours_SH"), "F0") + " t",
                "Timer i drift (Elhub > 0)", KpiAccent.Positive, null),
            new HighlightCard("Nedetid", FormatNumber(Get("ForcedOutageHours_FOH"), "F0") + " t",
                "Forpliktet, men ikke produsert", KpiAccent.Negative, null),
            new HighlightCard("Tilgjengelighet", FormatRatio(Get("AvailabilityFactor_AF")),
                "Drift-timer / (Drift + Nedetid)", KpiAccent.Neutral, null),
            new HighlightCard("Bud-leveranse", FormatRatio(Get("BidDelivery")),
                "Σ Elhub / Σ Spotbud", KpiAccent.Accent, null),
        });

        // Volum — egen seksjon så det ikke ser ut som naborkortene summerer til det.
        // "Produksjon i perioden" (ikke "Total produksjon") — Spec Del 4: ordet
        // "Total" antyder sum av nabokortene som ikke er komponenter.
        yield return new HighlightSection("Volum", new[]
        {
            new HighlightCard("Produksjon i perioden",
                FormatNumber(Get("TotalProduction_MWh"), "F2") + " MWh",
                "Akkumulert Elhub", KpiAccent.Neutral, null),
        });

        // Marked — bruttoinntekter og -kostnader fra spot/ubalanse.
        yield return new HighlightSection("Marked", new[]
        {
            new HighlightCard("Spotomsetning",
                FormatNumber(Get("Spotomsetning_NOK"), "N0") + " NOK",
                "Day-ahead-bruttoinntekt", KpiAccent.Positive, null),
            new HighlightCard("Ubalansekost",
                FormatNumber(Get("Ubalansekost_NOK"), "N0") + " NOK",
                "Total kostnad ved å avvike fra Spotbud", KpiAccent.Accent, null),
        });

        // Resultat — Oppgjør står for seg selv som SAMLET resultat. Tidligere
        // sto Oppgjør inntil Spotoms + Ubalanse i samme rad og inviterte til
        // avstemming som IKKE går opp (Spec Del 2: 55 273 NOK uforklart avvik).
        // Vi viser nå komponentene EKSPLISITT i undertittelen så regnestykket
        // kan etterprøves, og legger eventuell rest i en "andre poster"-linje.
        yield return new HighlightSection("Resultat", new[]
        {
            new HighlightCard("Oppgjør",
                FormatNumber(Get("Oppgjor_NOK"), "N0") + " NOK",
                OppgjorUndertekst(Get("Spotomsetning_NOK"), Get("Ubalansekost_NOK"), Get("Oppgjor_NOK")),
                KpiAccent.Warning,
                "Oppgjøret kan inneholde flere poster enn de synlige nabokortene (eks. ubalanse-tillegg per MWh, andre justeringer). Undertittelen viser komponentene som GÅR OPP til vist oppgjør."),
        });
    }

    /// <summary>
    /// Bygger undertekst for Oppgjør-kortet slik at brukeren ser eksplisitt
    /// at Spot + Ubalanse ALENE ikke er hele oppgjøret. Hvis det er en
    /// «andre poster»-rest, vises den med fortegn.
    /// </summary>
    private static string OppgjorUndertekst(double? spotoms, double? ubalanse, double? oppgjor)
    {
        if (!spotoms.HasValue || !ubalanse.HasValue || !oppgjor.HasValue)
        {
            return "Sum oppgjør i perioden";
        }
        var komponenter = spotoms.Value + ubalanse.Value;
        var rest = oppgjor.Value - komponenter;
        if (Math.Abs(rest) < 1.0) // innenfor avrunding
        {
            return $"Spot {FormatNumber(spotoms, "N0")} + ubalanse {FormatNumber(ubalanse, "N0")} NOK";
        }
        var restTegn = rest >= 0 ? "+" : "−";
        return $"Spot + ubalanse + andre poster ({restTegn}{Math.Abs(rest).ToString("N0", NumberFormat.Norsk)} NOK)";
    }

    // Tall-helpere delegerer til Services/NumberFormat (kultur-uavhengig, bygd
    // på eksplisitt NumberFormatInfo). Testrapport 2026-05-21 funn #1 og #3:
    // den gamle FormatNok lagde new CultureInfo("nb-NO") som kaster under
    // InvariantGlobalization (Blazor WASM-csproj), og FormatNumber brukte
    // InvariantCulture som ga "2,266,525" — feil format på rapport-detalj
    // mens resten av appen viste "2 266 525".
    private static string FormatNumber(double? v, string format) =>
        NumberFormat.Number(v, format);

    /// <summary>
    /// Formaterer NOK-beløp med tusenskille og to desimaler (norsk konvensjon).
    /// Null vises som "–" — KAIA-kostnad skiller funksjonelt mellom "ukjent"
    /// (megler-data manglet) og 0 (ingen handler).
    /// </summary>
    private static string FormatNok(double? v) => NumberFormat.NokKr2(v);

    private static string FormatKaiaTotal(KaiaCostDto k) => FormatNok(k.TotalNok);

    private static string KaiaTooltip(KaiaCostDto k)
    {
        var megler = k.MeglerprovisjonNok.HasValue
            ? FormatNok(k.MeglerprovisjonNok)
            : "ukjent";
        var dager = (int)Math.Round((k.PeriodEndUtc - k.PeriodStartUtc).TotalDays);
        return $"Meglerprovisjon ({megler}) + fast årsavgift pro-rata "
            + $"({dager} dager → {FormatNok(k.FastAvgiftNok)}). "
            + "Kun KAIAs egen inntekt regnes som KAIA-kostnad — "
            + "Nord Pool/eSett-gebyrer er viderefakturert og holdes utenfor.";
    }

    private static string FormatRatio(double? v) => NumberFormat.Ratio(v);

    private static string FormatKpi(KpiDto k)
    {
        if (!k.Value.HasValue) return "–";
        return k.Unit switch
        {
            "ratio" => NumberFormat.Pct(k.Value, 2),
            "MWh" => NumberFormat.Number(k.Value, "F2"),
            "NOK" => NumberFormat.Number(k.Value, "N0"),
            "hours" => NumberFormat.Number(k.Value, "F1"),
            "events" => NumberFormat.Number(k.Value, "F0"),
            _ => NumberFormat.Number(k.Value, "F4"),
        };
    }

    private static string FormatNullable(double? v, string format) =>
        NumberFormat.Number(v, format);

    private static string FormatPeriod(DateTimeOffset start, DateTimeOffset end)
    {
        var startLocal = start.ToLocalTime();
        var endLocal = end.ToLocalTime();
        return $"{startLocal:yyyy-MM-dd} – {endLocal:yyyy-MM-dd}";
    }

    private static MudBlazor.Color StateColor(string state) => state switch
    {
        "InService" => MudBlazor.Color.Success,
        "FO" or "ForcedOutage" => MudBlazor.Color.Error,
        "PO" or "PlannedOutage" => MudBlazor.Color.Info,
        "RS" or "ReserveShutdown" => MudBlazor.Color.Secondary,
        "FD" or "ForcedDerating" or "ForcedDerated" => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Default,
    };

    private static string StateHexColor(string state) => state switch
    {
        "InService" => "#2A9D8F",
        "FO" or "ForcedOutage" => "#E76F51",
        "PO" or "PlannedOutage" => "#1E5F8E",
        "RS" or "ReserveShutdown" => "#7E57C2",
        "FD" or "ForcedDerating" or "ForcedDerated" => "#F39C12",
        _ => "#9AA5B0",
    };

    /// <summary>
    /// Bygger en kort beskrivelse av appens klassifisering for et utvalg
    /// av timer. Brukes som info-banner øverst i annoterings-dialogen.
    /// Eksempler:
    ///   "Drift (3 t)" — alle timene i samme tilstand
    ///   "2t Drift, 1t Nedetid" — blandet, sortert på flest timer først
    /// </summary>
    private static string BuildClassificationSummary(IReadOnlyList<ClassifiedHourDto> hours)
    {
        if (hours.Count == 0)
        {
            return string.Empty;
        }

        var groups = hours
            .GroupBy(h => h.State)
            .Select(g => (State: g.Key, Count: g.Count()))
            .OrderByDescending(g => g.Count)
            .ToList();

        if (groups.Count == 1)
        {
            return $"{StateDisplayName(groups[0].State)} ({groups[0].Count} t)";
        }
        return string.Join(", ", groups.Select(g => $"{g.Count}t {StateDisplayName(g.State)}"));
    }

    /// <summary>Norske visningsnavn for UnitState. Internt brukes fortsatt
    /// engelske enum-navn ('ForcedOutage' osv.) i lagring og export.</summary>
    private static string StateDisplayName(string state) => state switch
    {
        "InService" => "Drift",
        "ForcedOutage" => "Nedetid",
        "ReserveShutdown" => "Stille",
        "InformationUnavailable" => "Mangler data",
        "PlannedOutage" => "Planlagt revisjon",
        "MaintenanceOutage" => "Vedlikehold",
        "ResourceUnavailable" => "Vannmangel",
        "ForcedDerating" => "Tvangs-derating",
        "PlannedDerating" => "Planlagt derating",
        _ => state,
    };

    public sealed record StateSlice(string CanonicalState, string Display, int Hours);
    /// <summary>
    /// Lokal record for HighlightCards — renamed fra KpiCard for å unngå
    /// navnekollisjon med den nye unified KpiCard-komponenten (UI-gjennomgang
    /// 2026-05-20). Color er semantisk navn (Positive/Negative/Neutral...) ikke hex.
    /// </summary>
    private sealed record HighlightCard(string Label, string Value, string Sub, KpiAccent Accent, string? Info);

    /// <summary>Gruppert KPI-kort-seksjon med tittel og kort-liste.</summary>
    private sealed record HighlightSection(string Tittel, IReadOnlyList<HighlightCard> Cards);

    /// <summary>
    /// Synkroniserer FilterState med rapportens plant + periode slik at /nedetid
    /// og /vakt-roi automatisk får samme kontekst når brukeren navigerer dit.
    /// PeriodEndUtc er siste time-stempel (inklusiv); legger til 1 dag for å gi
    /// /nedetid en eksklusiv til-grense.
    ///
    /// Dato-Kind settes til Unspecified slik at <c>new DateTimeOffset(d, TimeSpan.Zero)</c>
    /// i Nedetid/VaktRoi senere ikke kaster Argument_OffsetLocalMismatch.
    /// Local-kind krever lokal-offset, Utc-kind krever offset=Zero,
    /// Unspecified godtar begge.
    /// </summary>
    private void SyncFilterState(UptimeReportSummary report)
    {
        Filter.PlantId = report.PlantId;
        var from = DateTime.SpecifyKind(
            report.PeriodStartUtc.UtcDateTime.ToLocalTime().Date, DateTimeKind.Unspecified);
        var to = DateTime.SpecifyKind(
            report.PeriodEndUtc.UtcDateTime.ToLocalTime().Date.AddDays(1), DateTimeKind.Unspecified);
        // Settlement-rapporter er typisk hele måneder, men kan også være andre
        // perioder. Sett granularitet til Egendefinert slik at AppBar-velgerens
        // ←/→-piler ikke flyttes utilsiktet vekk fra rapportens periode.
        Filter.SetPeriod(from, to, PeriodGranularity.Egendefinert);
    }
}
