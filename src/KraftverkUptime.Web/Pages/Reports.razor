@page "/"
@page "/reports"
@implements IDisposable
@inject ReportsApi Api
@inject NavigationManager Nav
@inject FilterState Filter

<PageTitle>Rapporter</PageTitle>

<div class="dk-hero">
    <MudText Typo="Typo.h1">Rapporter</MudText>
    <div class="dk-hero-sub">Importerte avregninger og klassifiserte KPI-rapporter per anlegg.</div>
</div>

@* Anlegg + periode styres av global velger i AppBar (FilterState). *@

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (string.IsNullOrWhiteSpace(Filter.PlantId))
{
    <MudAlert Severity="Severity.Info">Velg et anlegg i topp-baren for å se importerte avregninger.</MudAlert>
}
else
{
    @if (_fallbackBanner is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@_fallbackBanner</MudAlert>
    }
    <MudTable T="SettlementImportSummary" Items="@_items" Loading="@(_items is null)"
              Hover="true" Striped="true" Elevation="0" Class="dk-card"
              OnRowClick="OnRowClick" RowStyle="cursor: pointer;"
              Filter="MatchesSearch">
        <ToolBarContent>
            <MudTextField @bind-Value="_searchText" Placeholder="Søk anlegg, periode, status…"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium" Class="mt-0" Margin="Margin.Dense"
                          Immediate="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="@SortByPlant">Anlegg</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="@SortByPeriod">Periode</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByHours">Timer</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByIssues">Avvik</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="@SortByImported"
                   InitialDirection="SortDirection.Descending">Importert</MudTableSortLabel></MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Anlegg">@context.PlantName</MudTd>
            <MudTd DataLabel="Periode">@FormatPeriod(context.PeriodStartUtc, context.PeriodEndUtc)</MudTd>
            <MudTd DataLabel="Timer" Style="text-align:right">@context.HourCount</MudTd>
            <MudTd DataLabel="Avvik" Style="text-align:right">
                @if (context.IssueCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@context.IssueCount</MudChip>
                }
                else
                {
                    <span>0</span>
                }
            </MudTd>
            <MudTd DataLabel="Importert">@context.ImportedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Status">
                @if (context.ReportAvailable)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Klar</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.HourglassTop">Behandles</MudChip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Ingen importer funnet for valgt anlegg og filter.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<SettlementImportSummary>? _items;
    private string? _error;
    private string? _fallbackBanner;
    private string _searchText = string.Empty;

    // Sort-funksjoner som felt for å unngå Razor-attributt-escape-problemer
    private static readonly Func<SettlementImportSummary, object> SortByPlant    = i => i.PlantName;
    private static readonly Func<SettlementImportSummary, object> SortByPeriod   = i => i.PeriodStartUtc;
    private static readonly Func<SettlementImportSummary, object> SortByHours    = i => i.HourCount;
    private static readonly Func<SettlementImportSummary, object> SortByIssues   = i => i.IssueCount;
    private static readonly Func<SettlementImportSummary, object> SortByImported = i => i.ImportedAtUtc;

    /// <summary>
    /// Søker etter substring i alle relevante felter. Periode formateres
    /// til lokal-streng først for at "februar 2026" treffer.
    /// </summary>
    private bool MatchesSearch(SettlementImportSummary i)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var s = _searchText.Trim();
        return i.PlantName.Contains(s, StringComparison.OrdinalIgnoreCase)
            || FormatPeriod(i.PeriodStartUtc, i.PeriodEndUtc).Contains(s, StringComparison.OrdinalIgnoreCase)
            || (i.ReportAvailable ? "klar" : "behandles").Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;
        await ReloadAsync();
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    private async void OnFilterChanged()
    {
        try { await ReloadAsync(); }
        catch (Exception ex)
        {
            _error = $"Kunne ikke oppdatere rapport-liste: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadAsync()
    {
        _error = null;
        _fallbackBanner = null;
        if (string.IsNullOrWhiteSpace(Filter.PlantId))
        {
            _items = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            DateTimeOffset? from = Filter.FromDate.HasValue
                ? Filter.FromDate.Value.ToUtcOffsetSafe() : null;
            DateTimeOffset? to = Filter.ToDate.HasValue
                ? Filter.ToDate.Value.ToUtcOffsetSafe() : null;

            var result = await Api.ListSettlementsAsync(Filter.PlantId, from, to);
            _items = result.ToList();

            // Direkte-redirect til forrige måneds rapport hvis vi finner én.
            // FilterState.PeriodChanged trigger denne på nytt ved periode-bytte.
            var target = FindLastMonthImport(_items);
            if (target is not null)
            {
                Nav.NavigateTo($"reports/{target.PlantId}/{target.IdempotencyKey}",
                    forceLoad: false, replace: true);
                return;
            }

            // Ingen import for forrige måned → fallback til liste-visning med banner.
            _fallbackBanner = "Ingen rapport for forrige måned for valgt anlegg — velg fra listen under.";
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente rapport-liste: {ex.Message}";
            _items = new List<SettlementImportSummary>();
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Finner nyeste import (ReportAvailable = true) for forrige kalendermåned
    /// — målt mot dagens lokal-dato. Returnerer null hvis ingen import finnes.
    /// Bruker måned-identifikasjon (år+måned i lokal tid på periode-start) for
    /// å unngå timezone-edge-cases der periode-grensene er lagret som UTC-
    /// midnatt vs Norge-midnatt (off-by-1-eller-2-timer mot Oslo sommertid).
    /// </summary>
    private static SettlementImportSummary? FindLastMonthImport(IReadOnlyList<SettlementImportSummary> items)
    {
        if (items is null || items.Count == 0) return null;
        var today = DateTime.Today;
        var lastMonth = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
        var targetYear = lastMonth.Year;
        var targetMonth = lastMonth.Month;

        return items
            .Where(i => i.ReportAvailable)
            .Where(i =>
            {
                // En måneds-rapport har periode-start på dag 1 av måneden i
                // lokal tid. Konverter UTC → local og sammenlign år+måned.
                // Dette tolererer både UTC-midnatt (00:00 UTC) og Oslo-midnatt
                // (22:00 UTC sommer / 23:00 UTC vinter) som lagrings-format.
                var startLocal = i.PeriodStartUtc.ToLocalTime();
                return startLocal.Year == targetYear
                    && startLocal.Month == targetMonth
                    && startLocal.Day == 1;
            })
            .OrderByDescending(i => i.ImportedAtUtc)
            .FirstOrDefault();
    }

    private void OnRowClick(TableRowClickEventArgs<SettlementImportSummary> args)
    {
        if (args.Item is null || !args.Item.ReportAvailable) return;
        Nav.NavigateTo($"reports/{args.Item.PlantId}/{args.Item.IdempotencyKey}");
    }

    private static string FormatPeriod(DateTimeOffset start, DateTimeOffset end)
    {
        var startLocal = start.ToLocalTime();
        var endLocal = end.ToLocalTime();
        var daysSpan = (endLocal - startLocal).TotalDays;
        if (daysSpan is >= 27 and <= 32 && startLocal.Day == 1)
        {
            return startLocal.ToString("MMM yyyy");
        }
        return $"{startLocal:yyyy-MM-dd} – {endLocal:yyyy-MM-dd}";
    }
}
