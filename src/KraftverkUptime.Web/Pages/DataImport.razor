        public string? LastSuccessMessage { get; set; }
        public List<string> UnknownStations { get; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        // Default-vindu = 6 mnd bakover + denne måneden. Drifts-leder
        // bekreftet at eldre historikk ikke er relevant for status-bildet.
        var today = DateTime.Today;
        var firstThis = new DateTime(today.Year, today.Month, 1);
        _fromDate = firstThis.AddMonths(-6);
        _toDate = firstThis.AddMonths(1);

        if (string.Equals(InitialTab, "manuell", StringComparison.OrdinalIgnoreCase)) _activeTab = 1;
        else if (string.Equals(InitialTab, "historikk", StringComparison.OrdinalIgnoreCase)) _activeTab = 2;

        try
        {
            _plants = await ReportsApi.ListPlantsAsync();
            if (!string.IsNullOrWhiteSpace(PreselectedPlantId)
                && _plants.Any(p => p.Id == PreselectedPlantId))
            {
                _selectedPlantId = PreselectedPlantId;
                _activeTab = 1; // åpne på manuell-fanen når plant er forvalgt
            }
            else if (_plants.Count == 1)
            {
                _selectedPlantId = _plants[0].Id;
            }
        }
        catch (Exception ex)
        {
            _statusError = $"Kunne ikke hente anleggs-listen: {ex.Message}";
            _plants = Array.Empty<PlantDto>();
        }

        await LoadStatusAsync();
    }

    private async Task LoadStatusAsync()
    {
        if (!_fromDate.HasValue || !_toDate.HasValue) return;
        _statusLoading = true;
        _statusError = null;
        StateHasChanged();
        try
        {
            var fromUtc = new DateTimeOffset(_fromDate.Value, TimeSpan.Zero);
            var toUtc = new DateTimeOffset(_toDate.Value, TimeSpan.Zero);

            var matrixTask = NedetidApi.GetDataStatusMatrixAsync(fromUtc, toUtc);
            var summaryTask = NedetidApi.GetDataStatusSummaryAsync();
            var recentTask = NedetidApi.GetRecentImportsAsync(_recentHours);
            var hotFolderTask = NedetidApi.GetHotFolderStatusAsync();

            _matrix = await matrixTask;
            _summary = await summaryTask;
            _recent = await recentTask;
            _hotFolder = await hotFolderTask;
        }
        catch (Exception ex)
        {
            _statusError = $"Kunne ikke hente status: {ex.Message}";
        }
        finally
        {
            _statusLoading = false;
        }
    }

    private async Task OnRecentHoursChangedAsync(int hours)
    {
        _recentHours = hours;
        try
        {
            _recent = await NedetidApi.GetRecentImportsAsync(_recentHours);
        }
        catch (Exception ex)
        {
            _statusError = $"Kunne ikke hente historikk: {ex.Message}";
        }
    }

    /// <summary>Flytt karantene-filer tilbake til hot-folder for ny prosessering.</summary>
    private async Task RetryQuarantineAsync()
    {
        _retryingQuarantine = true;
        StateHasChanged();
        try
        {
            var result = await NedetidApi.RetryQuarantineAsync();
            if (result is null)
            {
                Snackbar.Add("Kunne ikke flytte karantene-filer.", Severity.Warning);
            }
            else
            {
                Snackbar.Add(result.Message,
                    result.FilesMoved > 0 ? Severity.Success : Severity.Info);
            }
            await Task.Delay(2000);
            await LoadStatusAsync();
        }
        finally
        {
            _retryingQuarantine = false;
            StateHasChanged();
        }
    }

