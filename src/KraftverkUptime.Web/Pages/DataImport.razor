    /// <summary>
    /// Åpne celle-detalj-modal som viser nøyaktig hva som mangler i en delvis-
    /// (eller forfalt-) celle. For PARTIAL: hvilken periode importen dekket vs
    /// månedens grenser, hvor mange rader, sannsynlig årsak. For OVERDUE: bare
    /// "ingen import mottatt enda".
    /// </summary>
    private void OpenCellDetail(DataCompletenessCellDto cell)
    {
        if (cell.Status == "COMPLETE") return; // ingenting å vise — celle er full
        _cellDetail = cell;
        _cellDetailOpen = true;
    }

    private void CloseCellDetail()
    {
        _cellDetailOpen = false;
        _cellDetail = null;
    }

    /// <summary>
    /// Beregner hvor mange dager av en måned som er dekket av importen,
    /// totalt antall dager i måneden, og perioden som mangler.
    /// </summary>
    private static (int CoveredDays, int TotalDays, DateTimeOffset? MissingFrom, DateTimeOffset? MissingTo)
        ComputeMonthCoverage(DataCompletenessCellDto cell)
    {
        var monthStart = cell.Period;
        var monthEnd = cell.Period.AddMonths(1);
        var totalDays = (int)Math.Round((monthEnd - monthStart).TotalDays);

        if (cell.ImportPeriodFromUtc is null || cell.ImportPeriodToUtc is null)
        {
            return (0, totalDays, monthStart, monthEnd);
        }

        var importFrom = cell.ImportPeriodFromUtc.Value;
        var importTo = cell.ImportPeriodToUtc.Value;
        var overlapStart = importFrom > monthStart ? importFrom : monthStart;
        var overlapEnd = importTo < monthEnd ? importTo : monthEnd;
        var coveredDays = Math.Max(0, (int)Math.Round((overlapEnd - overlapStart).TotalDays));

        // Manglende del — viser den største sammenhengende ikke-dekkede biten
        // (tidlig-i-måned eller sent-i-måned). Hvis hele måneden er dekket
        // men dekning < 100% pga timehull: returnerer null-range.
        if (overlapStart > monthStart && overlapEnd < monthEnd)
        {
            // Begge ender mangler — vis den lengste
            var earlyGap = (overlapStart - monthStart).TotalDays;
            var lateGap = (monthEnd - overlapEnd).TotalDays;
            return earlyGap >= lateGap
                ? (coveredDays, totalDays, monthStart, overlapStart)
                : (coveredDays, totalDays, overlapEnd, monthEnd);
        }
        if (overlapStart > monthStart) return (coveredDays, totalDays, monthStart, overlapStart);
        if (overlapEnd < monthEnd) return (coveredDays, totalDays, overlapEnd, monthEnd);
        return (coveredDays, totalDays, null, null); // hele måneden dekket — gap er per-time
    }

    /// <summary>
    /// Trigger manuell scan av auto-import-mappa. Re-loader status etter
    /// 2 sekunder slik at brukeren ser eventuelle nye filer i køen.
    /// </summary>
    private async Task TriggerScanAsync()
    {
        _scanning = true;
        StateHasChanged();
        try
        {
            var result = await NedetidApi.TriggerHotFolderScanAsync();
            if (result is null)
            {
                Snackbar.Add("Kunne ikke trigge scan. Sjekk at API-en kjører.", Severity.Warning);
            }
            else if (!result.Triggered)
            {
                Snackbar.Add(result.Message, Severity.Info);
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Success);
            }
            // Vent litt for at watcher skal rekke å fullføre, så reload status.
            await Task.Delay(1500);
            await LoadStatusAsync();
        }
        finally
        {
            _scanning = false;
            StateHasChanged();
        }
    }

    // ----- Status helpers -----
    private DataCompletenessCellDto? FindCell(string plantId, string source, DateTimeOffset period)
        => _matrix?.Cells.FirstOrDefault(c =>
            c.PlantId == plantId
            && c.SourceType == source
            && c.Period == period);

    private bool ShouldHide(DataCompletenessCellDto? cell)
    {
        if (cell is null) return false;
        if (_onlyOverdue && cell.Status != "OVERDUE") return true;
        if (!string.IsNullOrEmpty(_filterSource) && cell.SourceType != _filterSource) return true;
        return false;
    }

    private static string CellSymbol(string status) => status switch
    {
        "COMPLETE" => "█", "PARTIAL" => "░", "PENDING" => "o", "OVERDUE" => "!", _ => "?",
    };
    private static string CellClass(string status) => status switch
    {
        "COMPLETE" => "cell-complete", "PARTIAL" => "cell-partial",
        "PENDING" => "cell-pending", "OVERDUE" => "cell-overdue", _ => "cell-na",
    };

    /// <summary>CSS-klasse for fargete celle-bokser i status-matrisen.</summary>
    private static string CellBoxClass(string status) => status switch
    {
        "COMPLETE" => "cell-box--complete",
        "PARTIAL"  => "cell-box--partial",
        "PENDING"  => "cell-box--pending",
        "OVERDUE"  => "cell-box--overdue",
        _          => "cell-box--na",
    };

    /// <summary>
    /// Inline style for celle-boks: setter <c>--fill</c> CSS-variabelen til
    /// faktisk dekning så PARTIAL-celler får en proporsjonal fyll-stripe.
    /// </summary>
    private static string CellBoxFill(DataCompletenessCellDto cell)
    {
        if (cell.Status != "PARTIAL" || !cell.CoveragePct.HasValue) return "";
        var pct = Math.Clamp(cell.CoveragePct.Value, 0.0, 1.0) * 100;
        return $"--fill: {pct:F0}%;";
    }

    /// <summary>
    /// Tekst inni celle-boksen. Vi viser kun symbol for OVERDUE (utropstegn);
    /// resten er tomt fordi fargen formidler status. Holder boksene helt rene.
    /// </summary>
    private static string CellBoxLabel(DataCompletenessCellDto cell) => cell.Status switch
    {
        "OVERDUE" => "!",
        _         => "",
    };
    private static string CellTooltip(DataCompletenessCellDto cell)
    {
        var parts = new List<string> { $"Status: {cell.Status}" };
        if (cell.LastImportedAt.HasValue)
            parts.Add($"Sist importert: {cell.LastImportedAt.Value.LocalDateTime:yyyy-MM-dd HH:mm}");
        if (cell.CoveragePct.HasValue)
            parts.Add($"Dekning: {cell.CoveragePct.Value * 100:F1} %");
        if (cell.ImportCount > 1)
            parts.Add($"{cell.ImportCount} importer (siste vinner)");
        return string.Join(" — ", parts);
    }
    private static string FormatSource(string source) => source switch
    {
        "settlement" => "Settlement (KAIA)",
        "scada" => "SCADA trender",
        "operlog" => "SCADA alarmer",
        _ => source,
    };
    private static string SourceShort(string source) => source switch
    {
        "settlement" => "S", "scada" => "T", "operlog" => "A",
        _ => source[..1].ToUpperInvariant(),
    };
    private static string CoverageStyle(double pct)
    {
        if (pct >= 0.99) return "color: var(--mud-palette-success); font-weight:500;";
        if (pct >= 0.95) return "color: var(--mud-palette-warning-darken);";
        return "color: var(--mud-palette-error); font-weight:500;";
    }
    private static string RelativeTime(DateTimeOffset utc)
    {
        var diff = DateTimeOffset.UtcNow - utc;
        if (diff.TotalMinutes < 1) return "akkurat nå";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min siden";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} t siden";
        return $"{(int)diff.TotalDays} d siden";
    }

    // ----- Single-plant upload -----
    private bool CanSubmitSingle =>
        !_singleUploading
        && !string.IsNullOrWhiteSpace(_selectedPlantId)
        && _singleFile is not null;

    private void OnSinglePlantChanged(string newValue)
    {
        _selectedPlantId = newValue ?? string.Empty;
        _singleError = null;
        _singleCsvError = null;
        _singleCsvSuccess = null;
    }

    private void OnSingleFileChanged(IBrowserFile? file)
    {
        _singleFile = file;
        _singleError = null;
        _singleSuccess = null;
    }

    private async Task SubmitSingleAsync()
    {
        if (!CanSubmitSingle) return;
        _singleError = null;
        _singleSuccess = null;
        _singleUploading = true;
        try
        {
            await using var stream = _singleFile!.OpenReadStream(MaxUploadBytes);
            var contentType = string.IsNullOrWhiteSpace(_singleFile.ContentType)
                ? XlsxContentType
                : _singleFile.ContentType;
            var resp = await ReportsApi.UploadSettlementAsync(
                _selectedPlantId, stream, _singleFile.Name, contentType);
            _singleSuccess = $"Mottatt — klassifisering pågår. Idempotency: {resp.IdempotencyKey[..16]}…";
            Snackbar.Add($"{_singleFile.Name} mottatt for {_selectedPlantId}", Severity.Success);
            _singleFile = null;
            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            _singleError = $"Opplasting feilet: {ex.Message}";
        }
        finally
        {
            _singleUploading = false;
        }
    }

    // ----- Single-plant CSV (SCADA / operlog) -----
    private async Task OnSinglePlantCsvDroppedAsync(IBrowserFile? file)
    {
        if (file is null || string.IsNullOrEmpty(_selectedPlantId) || _singleCsvUploading) return;
        if (file.Size > MaxOperlogBytes)
        {
            _singleCsvError = $"Filen er for stor ({file.Size / 1_048_576} MB).";
            return;
        }

        _singleCsvUploading = true;
        _singleCsvError = null;
        _singleCsvSuccess = null;
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(MaxOperlogBytes);
            var isOperlog = file.Name.Contains("operlog", StringComparison.OrdinalIgnoreCase);
            if (isOperlog)
            {
                var result = await ReportsApi.UploadScadaOperlogAsync(_selectedPlantId, stream, file.Name);
                _singleCsvSuccess = $"Operlog: {result.EventsWritten} events ({result.RowsSkipped} skippet).";
            }
            else
            {
                var result = await ReportsApi.UploadScadaMasterAsync(_selectedPlantId, stream, file.Name);
                _singleCsvSuccess = $"SCADA master: {result.SamplesWritten} samples, {result.SignalCount} signaler.";
            }
            Snackbar.Add(_singleCsvSuccess, Severity.Success);
            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            _singleCsvError = $"Opplasting feilet: {ex.Message}";
        }
        finally
        {
            _singleCsvUploading = false;
        }
    }

    // ----- Multi-plant settlement -----
    private async Task OnMultiPlantDroppedAsync(IBrowserFile? file)
    {
        if (file is null || _multiState.IsUploading) return;
        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            _multiState.Error = $"Bare .xlsx er støttet. Fikk: {file.Name}";
            return;
        }
        if (file.Size > MaxUploadBytes)
        {
            _multiState.Error = $"Filen er for stor ({file.Size / 1_048_576} MB). Maks 25 MB.";
            return;
        }
        _multiState.IsUploading = true;
        _multiState.Error = null;
        _multiState.LastSuccessMessage = null;
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(MaxUploadBytes);
            var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? XlsxContentType : file.ContentType;
            var result = await ReportsApi.UploadMultiPlantSettlementAsync(stream, file.Name, contentType);
            _multiState.LastSuccessMessage =
                $"{result.ImportCount} import-rad(er) opprettet, {result.Imports.Count(i => i.PlantCreated)} nytt anlegg.";
            Snackbar.Add(_multiState.LastSuccessMessage, Severity.Success);
            _plants = await ReportsApi.ListPlantsAsync();
            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            _multiState.Error = $"Multi-plant-import feilet: {ex.Message}";
            Snackbar.Add(_multiState.Error, Severity.Error);
        }
        finally
        {
            _multiState.IsUploading = false;
            StateHasChanged();
        }
    }

    // ----- Multi-plant operlog -----
    private async Task OnMultiPlantOperlogDroppedAsync(IBrowserFile? file)
    {
        if (file is null || _multiOperlogState.IsUploading) return;
        if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            _multiOperlogState.Error = $"Forventer .csv. Fikk: {file.Name}";
            return;
        }
        if (file.Size > MaxOperlogBytes)
        {
            _multiOperlogState.Error = $"Filen er for stor ({file.Size / 1_048_576} MB). Maks 100 MB.";
            return;
        }
        _multiOperlogState.IsUploading = true;
        _multiOperlogState.Error = null;
        _multiOperlogState.LastSuccessMessage = null;
        _multiOperlogState.UnknownStations.Clear();
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(MaxOperlogBytes);
            var result = await ReportsApi.UploadMultiPlantOperlogAsync(stream, file.Name);
            var totalEvents = result.PerPlant.Sum(p => p.EventsImported);
            _multiOperlogState.LastSuccessMessage =
                $"{totalEvents} events importert til {result.PerPlant.Count} anlegg "
                + $"({result.TotalRowsParsed} parset, {result.TotalRowsSkipped} skip).";
            if (result.UnknownStations > 0)
            {
                _multiOperlogState.UnknownStations.AddRange(result.UnknownStationNames);
            }
            Snackbar.Add(_multiOperlogState.LastSuccessMessage, Severity.Success);
            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            _multiOperlogState.Error = $"Multi-plant operlog-import feilet: {ex.Message}";
            Snackbar.Add(_multiOperlogState.Error, Severity.Error);
        }
        finally
        {
            _multiOperlogState.IsUploading = false;
            StateHasChanged();
        }
    }
}
