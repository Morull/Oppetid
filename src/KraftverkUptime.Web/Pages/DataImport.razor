@page "/data-import"
@inject ReportsApi ReportsApi
@inject NedetidApi NedetidApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@*
    Samlet import-side. Erstatter /upload og /data-status, og absorberer
    multi-plant drop-zonene fra /plants.

    Tre tabs:
      1. Status — auto-import-banner, sammendrag, matrise, topp-overdue
      2. Manuell opplasting — single-plant + multi-plant + multi-operlog
      3. Historikk — siste importer (data_imports-tabellen)
*@

<PageTitle>Data-import</PageTitle>

<MudGrid Class="mb-4">
    <MudItem xs="12">
        <MudText Typo="Typo.h1">Data-import</MudText>
        <MudText Typo="Typo.subtitle1" Color="MudBlazor.Color.Secondary">
            Følg med på automatiske importer, last opp manuelt og se historikk —
            alt på én side.
        </MudText>
    </MudItem>
</MudGrid>

@* ---- Auto-import-banner (alltid synlig på toppen) ---- *@
@if (_recent is not null && _summary is not null)
{
    var imported24h = _recent.Count;
    var newest = _recent.FirstOrDefault();
    var waitingCount = _hotFolder?.Waiting.Count(w => w.Status == "WAITING") ?? 0;
    var processingCount = _hotFolder?.Waiting.Count(w => w.Status == "PROCESSING") ?? 0;

    <MudPaper Class="pa-3 mb-3" Elevation="0"
              Style="border-left: 4px solid var(--mud-palette-primary); background: rgba(30, 95, 142, 0.06);">
        <div class="d-flex align-center flex-wrap" style="gap:24px;">
            <div>
                <MudIcon Icon="@Icons.Material.Filled.Sync" Color="MudBlazor.Color.Primary" />
                <strong>Siste 24 t:</strong>
                @imported24h @(imported24h == 1 ? "import" : "importer") mottatt
                @if (newest is not null)
                {
                    <span style="color:var(--mud-palette-text-secondary);">
                        — sist <strong>@newest.PlantId</strong> @FormatSource(newest.SourceType) for @newest.PeriodFromUtc.LocalDateTime.ToString("MMM yyyy")
                        (@RelativeTime(newest.ImportedAtUtc))
                    </span>
                }
            </div>
            <MudSpacer />
            <div style="display:flex; gap:16px; flex-wrap:wrap;">
                @if (processingCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="MudBlazor.Color.Info" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.HourglassTop">
                        @processingCount auto-importerer nå
                    </MudChip>
                }
                @if (waitingCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="MudBlazor.Color.Default" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.Inbox">
                        @waitingCount filer venter
                    </MudChip>
                }
                <MudChip T="string" Size="Size.Small" Color="MudBlazor.Color.Success" Variant="Variant.Outlined">
                    @_summary.Complete komplett
                </MudChip>
                @if (_summary.Partial > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="MudBlazor.Color.Warning" Variant="Variant.Outlined">
                        @_summary.Partial delvis
                    </MudChip>
                }
                @if (_summary.Overdue > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="MudBlazor.Color.Error" Variant="Variant.Filled">
                        @_summary.Overdue forfalt
                    </MudChip>
                }
            </div>
            <MudTooltip Text="Skann auto-import-mappa nå">
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FolderOpen"
                           OnClick="TriggerScanAsync"
                           Disabled="@_scanning">
                    @(_scanning ? "Skanner…" : "Skann nå")
                </MudButton>
            </MudTooltip>
            <MudTooltip Text="Oppdater visning">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Size="Size.Small"
                               OnClick="LoadStatusAsync"
                               aria-label="Oppdater" />
            </MudTooltip>
        </div>
        @if (_hotFolder is { Enabled: true } && (waitingCount > 0 || processingCount > 0 || _hotFolder.Recent.Any(r => r.Status == "QUARANTINE")))
        {
            <MudExpansionPanels Class="mt-2" Elevation="0">
                <MudExpansionPanel Text="@($"Auto-import-mappe: {_hotFolder.RootPath}")" Dense="true">
                    @if (_hotFolder.Waiting.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-1">I kø</MudText>
                        <MudSimpleTable Dense="true" Style="background:transparent;">
                            <thead><tr><th>Filnavn</th><th>Status</th><th>Detektert</th><th>Størrelse</th></tr></thead>
                            <tbody>
                            @foreach (var w in _hotFolder.Waiting)
                            {
                                <tr>
                                    <td>@w.FileName</td>
                                    <td>
                                        @if (w.Status == "PROCESSING")
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="MudBlazor.Color.Info">Prosesserer</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="MudBlazor.Color.Default" Variant="Variant.Outlined">Venter</MudChip>
                                        }
                                    </td>
                                    <td>@RelativeTime(w.DetectedAtUtc)</td>
                                    <td>@(w.FileSize / 1024) KB</td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                    @if (_hotFolder.Recent.Any(r => r.Status == "QUARANTINE"))
                    {
                        <div class="d-flex justify-space-between align-center mt-3">
                            <MudText Typo="Typo.subtitle2">Filer i karantene (krever oppmerksomhet)</MudText>
                            <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Warning"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Replay"
                                       OnClick="RetryQuarantineAsync"
                                       Disabled="@_retryingQuarantine">
                                @(_retryingQuarantine ? "Prøver…" : "Prøv på nytt")
                            </MudButton>
                        </div>
                        <MudSimpleTable Dense="true" Style="background:transparent;">
                            <thead><tr><th>Filnavn</th><th>Tidspunkt</th><th>Notat</th><th style="width:120px;">Diagnose</th></tr></thead>
                            <tbody>
                            @foreach (var r in _hotFolder.Recent.Where(r => r.Status == "QUARANTINE"))
                            {
                                <tr>
                                    <td>@r.FileName</td>
                                    <td>@RelativeTime(r.ProcessedAtUtc)</td>
                                    <td style="font-size:0.85em; color:var(--mud-palette-error);">@r.Notes</td>
                                    <td>
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.BugReport"
                                                   Color="MudBlazor.Color.Info"
                                                   OnClick="@(() => OpenDiagnoseAsync(r.FileName))">
                                            Vis
                                        </MudButton>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                    @if (_hotFolder.Recent.Any(r => r.Status == "DUPLICATE"))
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-3">Duplikater (allerede importert tidligere)</MudText>
                        <MudSimpleTable Dense="true" Style="background:transparent;">
                            <thead><tr><th>Filnavn</th><th>Tidspunkt</th><th>Detaljer</th></tr></thead>
                            <tbody>
                            @foreach (var r in _hotFolder.Recent.Where(r => r.Status == "DUPLICATE"))
                            {
                                <tr>
                                    <td>@r.FileName</td>
                                    <td>@RelativeTime(r.ProcessedAtUtc)</td>
                                    <td style="font-size:0.85em; color:var(--mud-palette-text-secondary);">@r.Notes</td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudPaper>
}

@* ---- Tabs ---- *@
<MudTabs Outlined="true" Position="Position.Top" Rounded="true" Border="true" Elevation="2"
         ApplyEffectsToContainer="true" @bind-ActivePanelIndex="_activeTab">

    @* ===== TAB 1: STATUS ===== *@
    <MudTabPanel Icon="@Icons.Material.Filled.GridOn" Text="Status">
        <MudPaper Class="pa-4" Elevation="0">
            @if (_statusError is not null)
            {
                <MudAlert Severity="Severity.Error">@_statusError</MudAlert>
            }
            else if (_statusLoading)
            {
                <MudProgressCircular Indeterminate="true" />
                <MudText Class="ml-2 d-inline">Henter status…</MudText>
            }
            else if (_matrix is not null)
            {
                @* Sammendrag-kort — beregnes fra matrise-cellene slik at
                   tallene alltid matcher det brukeren ser i tabellen. *@
                var completeCount = _matrix.Cells.Count(c => c.Status == "COMPLETE");
                var partialCount = _matrix.Cells.Count(c => c.Status == "PARTIAL");
                var overdueCount = _matrix.Cells.Count(c => c.Status == "OVERDUE");
                var totalCount = _matrix.Cells.Count;
                <MudGrid Class="mb-3">
                    <MudItem xs="12" sm="4">
                        <MudPaper Class="pa-3" Elevation="2" Style="border-left: 4px solid var(--mud-palette-success);">
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Komplette</MudText>
                            <MudText Typo="Typo.h3">@completeCount</MudText>
                            <MudText Typo="Typo.caption">av @totalCount forventede</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudPaper Class="pa-3" Elevation="2" Style="border-left: 4px solid var(--mud-palette-warning);">
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Delvise</MudText>
                            <MudText Typo="Typo.h3">@partialCount</MudText>
                            <MudText Typo="Typo.caption">&lt; 95 % dekning</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudPaper Class="pa-3" Elevation="2" Style="border-left: 4px solid var(--mud-palette-error);">
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Forfalt</MudText>
                            <MudText Typo="Typo.h3">@overdueCount</MudText>
                            <MudText Typo="Typo.caption">venter handling</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @* Filter *@
                <MudPaper Class="pa-3 mb-3" Elevation="1">
                    <div class="d-flex align-center flex-wrap" style="gap:12px;">
                        <MudSwitch T="bool" @bind-Value="_onlyOverdue" Color="MudBlazor.Color.Error" Label="Vis kun forfalte" />
                        <MudSelect T="string" @bind-Value="_filterSource" Label="Kildetype" Dense="true" Margin="Margin.Dense" Style="min-width: 180px;">
                            <MudSelectItem Value="@string.Empty">Alle</MudSelectItem>
                            @foreach (var s in _matrix.SourceTypes)
                            {
                                <MudSelectItem Value="@s">@FormatSource(s)</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </MudPaper>

                @* Matrise *@
                @if (_matrix.PlantIds.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">Ingen aktive forventninger registrert.</MudAlert>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table class="data-status-matrix">
                            <thead>
                                <tr>
                                    <th class="plant-col">Anlegg</th>
                                    @foreach (var period in _matrix.Periods)
                                    {
                                        <th class="period-col" colspan="@_matrix.SourceTypes.Count">
                                            @period.LocalDateTime.ToString("MMM yyyy")
                                        </th>
                                    }
                                </tr>
                                <tr class="source-row">
                                    <th></th>
                                    @foreach (var _ in _matrix.Periods)
                                    {
                                        @foreach (var s in _matrix.SourceTypes)
                                        {
                                            <th class="source-col">
                                                <MudTooltip Text="@FormatSource(s)">
                                                    <span>@SourceShort(s)</span>
                                                </MudTooltip>
                                            </th>
                                        }
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var plantId in _matrix.PlantIds)
                                {
                                    <tr>
                                        <td class="plant-col">@plantId</td>
                                        @foreach (var period in _matrix.Periods)
                                        {
                                            @foreach (var source in _matrix.SourceTypes)
                                            {
                                                var cell = FindCell(plantId, source, period);
                                                var visible = !ShouldHide(cell);
                                                <td class="cell" style="@(visible ? "" : "opacity:0.3")">
                                                    @if (cell is null)
                                                    {
                                                        <span class="cell-box cell-box--na" title="Ikke aktiv kilde">·</span>
                                                    }
                                                    else if (cell.Status == "COMPLETE")
                                                    {
                                                        <MudTooltip Text="@CellTooltip(cell)">
                                                            <span class="cell-box @CellBoxClass(cell.Status)">
                                                                <span>@CellBoxLabel(cell)</span>
                                                            </span>
                                                        </MudTooltip>
                                                    }
                                                    else
                                                    {
                                                        @* Klikkbar — åpner detalj-modal med "hva mangler" *@
                                                        var clickCell = cell;
                                                        <MudTooltip Text="@(CellTooltip(cell) + " — klikk for detaljer")">
                                                            <span class="cell-box cell-box--clickable @CellBoxClass(cell.Status)"
                                                                  style="@CellBoxFill(cell)"
                                                                  @onclick="@(() => OpenCellDetail(clickCell))">
                                                                <span>@CellBoxLabel(cell)</span>
                                                            </span>
                                                        </MudTooltip>
                                                    }
                                                </td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3 d-flex align-center flex-wrap" style="font-size:0.9em; gap:14px;">
                        <strong>Tegnforklaring:</strong>
                        <span class="d-inline-flex align-center" style="gap:6px;">
                            <span class="cell-box cell-box--legend cell-box--complete"></span> Komplett
                        </span>
                        <span class="d-inline-flex align-center" style="gap:6px;">
                            <span class="cell-box cell-box--legend cell-box--partial" style="--fill:50%"></span> Delvis (fyllgrad = dekning)
                        </span>
                        <span class="d-inline-flex align-center" style="gap:6px;">
                            <span class="cell-box cell-box--legend cell-box--overdue"><span>!</span></span> Forfalt
                        </span>
                        <span class="d-inline-flex align-center" style="gap:6px;">
                            <span class="cell-box cell-box--legend cell-box--na"></span> Ingen forventning
                        </span>
                    </div>
                }

                @* Topp-overdue *@
                @if (_summary is not null && _summary.TopOverdue.Count > 0)
                {
                    <MudPaper Class="pa-3 mt-4" Elevation="1">
                        <MudText Typo="Typo.h5" Class="mb-2">Topp 5 forfalte importer</MudText>
                        <MudTable Items="_summary.TopOverdue" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Anlegg</MudTh>
                                <MudTh>Kilde</MudTh>
                                <MudTh>Periode</MudTh>
                                <MudTh Style="text-align:right">Dager forfalt</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.PlantId</MudTd>
                                <MudTd>@FormatSource(context.SourceType)</MudTd>
                                <MudTd>@context.PeriodFromUtc.LocalDateTime.ToString("MMM yyyy")</MudTd>
                                <MudTd Style="text-align:right; color: var(--mud-palette-error); font-weight:500;">
                                    @context.DaysOverdue
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }
            }
        </MudPaper>
    </MudTabPanel>

    @* ===== TAB 2: MANUELL OPPLASTING ===== *@
    <MudTabPanel Icon="@Icons.Material.Filled.CloudUpload" Text="Manuell opplasting">
        <MudPaper Class="pa-4" Elevation="0">
            <MudGrid>
                @* Single-plant settlement *@
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.h4" Class="mb-2">Enkelt-anleggs-avregning</MudText>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mb-3">
                            KAIA-eksport (.xlsx) for ett anlegg.
                        </MudText>

                        @if (_singleError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">@_singleError</MudAlert>
                        }
                        @if (_singleSuccess is not null)
                        {
                            <MudAlert Severity="Severity.Success" Class="mb-3">@_singleSuccess</MudAlert>
                        }

                        <MudStack Spacing="3">
                            @if (_plants is null)
                            {
                                <MudSkeleton Height="56px" Width="100%" />
                            }
                            else
                            {
                                <MudSelect T="string" Value="_selectedPlantId" ValueChanged="OnSinglePlantChanged"
                                           Label="Anlegg" Variant="Variant.Outlined"
                                           AdornmentIcon="@Icons.Material.Filled.Factory"
                                           Adornment="Adornment.Start"
                                           Disabled="@_singleUploading">
                                    @foreach (var p in _plants)
                                    {
                                        <MudSelectItem Value="@p.Id">@p.Name (@p.Id)</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            <MudFileUpload T="IBrowserFile" FilesChanged="OnSingleFileChanged" Accept=".xlsx" MaximumFileCount="1"
                                           Disabled="@_singleUploading">
                                <ActivatorContent>
                                    <MudButton HtmlTag="label" Variant="Variant.Outlined"
                                               Color="MudBlazor.Color.Primary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.CloudUpload"
                                               Disabled="@_singleUploading">
                                        @(_singleFile is null ? "Velg Excel-fil" : _singleFile.Name)
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>

                            @if (_singleUploading)
                            {
                                <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" />
                            }

                            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="SubmitSingleAsync"
                                       Disabled="@(!CanSubmitSingle)" FullWidth="true">
                                @(_singleUploading ? "Sender…" : "Last opp")
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                @* Multi-plant settlement *@
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.h4" Class="mb-2">Multi-anleggs-eksport</MudText>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mb-3">
                            Én .xlsx med ≥ 2 anleggs-faner blir én import per anlegg.
                            Nye anlegg auto-opprettes.
                        </MudText>

                        <MudFileUpload T="IBrowserFile" Accept=".xlsx" MaximumFileCount="1"
                                       FilesChanged="@OnMultiPlantDroppedAsync"
                                       Class="@(_multiState.IsUploading ? "dk-multi-dropzone dk-multi-dropzone--busy" : "dk-multi-dropzone")">
                            <ActivatorContent>
                                <MudButton HtmlTag="label" Variant="Variant.Outlined"
                                           Color="MudBlazor.Color.Primary" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.LibraryBooks"
                                           Disabled="@_multiState.IsUploading">
                                    @(_multiState.IsUploading ? "Laster opp…" : "Velg / dra multi-plant .xlsx")
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        @if (_multiState.LastSuccessMessage is not null)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">@_multiState.LastSuccessMessage</MudAlert>
                        }
                        else if (_multiState.Error is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_multiState.Error</MudAlert>
                        }
                    </MudPaper>
                </MudItem>

                @* Multi-plant operlog *@
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.h4" Class="mb-2">Multi-anleggs operlog</MudText>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mb-3">
                            Én .csv med events fra alle stasjoner — splittes på <code>station</code>-feltet
                            og rutes til riktig anlegg via slug-matching.
                        </MudText>

                        <MudFileUpload T="IBrowserFile" Accept=".csv" MaximumFileCount="1"
                                       FilesChanged="@OnMultiPlantOperlogDroppedAsync"
                                       Class="@(_multiOperlogState.IsUploading ? "dk-multi-dropzone dk-multi-dropzone--busy" : "dk-multi-dropzone")">
                            <ActivatorContent>
                                <MudButton HtmlTag="label" Variant="Variant.Outlined"
                                           Color="MudBlazor.Color.Secondary" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Notifications"
                                           Disabled="@_multiOperlogState.IsUploading">
                                    @(_multiOperlogState.IsUploading ? "Laster opp…" : "Velg / dra operlog .csv")
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        @if (_multiOperlogState.LastSuccessMessage is not null)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">@_multiOperlogState.LastSuccessMessage</MudAlert>
                            @if (_multiOperlogState.UnknownStations.Count > 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                    Ukjente stasjoner skippet: @string.Join(", ", _multiOperlogState.UnknownStations)
                                </MudAlert>
                            }
                        }
                        else if (_multiOperlogState.Error is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_multiOperlogState.Error</MudAlert>
                        }
                    </MudPaper>
                </MudItem>

                @* Per-anleggs SCADA / operlog (CSV) — bruker single-plant valgt over *@
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.h4" Class="mb-2">SCADA / operlog (per anlegg)</MudText>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mb-3">
                            CSV for valgt anlegg ovenfor. Filnavn med "operlog" → events.
                            Ellers tolkes som SCADA master-CSV (tidsserier).
                        </MudText>

                        @if (string.IsNullOrEmpty(_selectedPlantId))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Velg anlegg i "Enkelt-anleggs-avregning" først.
                            </MudAlert>
                        }
                        else
                        {
                            <MudFileUpload T="IBrowserFile" Accept=".csv" MaximumFileCount="1"
                                           FilesChanged="@OnSinglePlantCsvDroppedAsync"
                                           Disabled="@_singleCsvUploading">
                                <ActivatorContent>
                                    <MudButton HtmlTag="label" Variant="Variant.Outlined"
                                               Color="MudBlazor.Color.Tertiary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.AttachFile"
                                               Disabled="@_singleCsvUploading">
                                        @(_singleCsvUploading ? "Laster opp…" : $"Velg CSV for {_selectedPlantId}")
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>

                            @if (_singleCsvSuccess is not null)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">@_singleCsvSuccess</MudAlert>
                            }
                            else if (_singleCsvError is not null)
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_singleCsvError</MudAlert>
                            }
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>

    @* ===== TAB 3: HISTORIKK ===== *@
    <MudTabPanel Icon="@Icons.Material.Filled.History" Text="Historikk">
        <MudPaper Class="pa-4" Elevation="0">
            <div class="d-flex align-center mb-3" style="gap:12px;">
                <MudText Typo="Typo.body2">Periode:</MudText>
                <MudSelect T="int" Value="_recentHours" ValueChanged="OnRecentHoursChangedAsync" Dense="true" Margin="Margin.Dense" Style="min-width:160px;">
                    <MudSelectItem Value="24">Siste 24 timer</MudSelectItem>
                    <MudSelectItem Value="72">Siste 3 dager</MudSelectItem>
                    <MudSelectItem Value="168">Siste 7 dager</MudSelectItem>
                </MudSelect>
                <MudSpacer />
                <MudTooltip Text="Oppdater">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   OnClick="LoadStatusAsync"
                                   aria-label="Oppdater" />
                </MudTooltip>
            </div>

            @if (_recent is null)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_recent.Count == 0)
            {
                <MudAlert Severity="Severity.Info">Ingen importer i valgt vindu.</MudAlert>
            }
            else
            {
                <MudTable Items="_recent" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Tidspunkt</MudTh>
                        <MudTh>Anlegg</MudTh>
                        <MudTh>Kilde</MudTh>
                        <MudTh>Periode</MudTh>
                        <MudTh>Filnavn</MudTh>
                        <MudTh Style="text-align:right">Rader</MudTh>
                        <MudTh Style="text-align:right">Dekning</MudTh>
                        <MudTh>Bruker</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ImportedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                        <MudTd><strong>@context.PlantId</strong></MudTd>
                        <MudTd>@FormatSource(context.SourceType)</MudTd>
                        <MudTd>@context.PeriodFromUtc.LocalDateTime.ToString("MMM yyyy")</MudTd>
                        <MudTd>@(context.FileName ?? "—")</MudTd>
                        <MudTd Style="text-align:right">@(context.RowsImported?.ToString() ?? "—")</MudTd>
                        <MudTd Style="text-align:right">
                            @if (context.CoveragePct.HasValue)
                            {
                                <span style="@CoverageStyle(context.CoveragePct.Value)">
                                    @($"{context.CoveragePct.Value * 100:F1} %")
                                </span>
                            }
                            else { <span>—</span> }
                        </MudTd>
                        <MudTd>@(context.UserId ?? "system")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

<style>
    .data-status-matrix {
        border-collapse: collapse;
        font-family: monospace;
        font-size: 0.95em;
    }
    .data-status-matrix th, .data-status-matrix td {
        border: 1px solid var(--mud-palette-lines-default);
        padding: 6px 8px;
        text-align: center;
        vertical-align: middle;
    }
    .data-status-matrix th.plant-col, .data-status-matrix td.plant-col {
        text-align: left;
        font-family: inherit;
        min-width: 110px;
        font-weight: 500;
    }
    .data-status-matrix th.period-col {
        background: var(--mud-palette-background-grey);
        font-size: 0.95em;
        font-weight: 500;
        padding: 6px 4px;
    }
    .data-status-matrix th.source-col {
        font-weight: 500;
        font-size: 0.8em;
        color: var(--mud-palette-text-secondary);
        padding: 2px 4px;
    }
    /* Hver celle er en fast-størrelse boks — ingen overflow uansett innhold. */
    .data-status-matrix td.cell {
        width: 32px;
        height: 32px;
        padding: 2px;
    }
    /* Bytter ut unicode block-tegn med eksplisitte fargete bokser så
       PARTIAL/COMPLETE-rendering er deterministisk uavhengig av font. */
    .cell-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 3px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
        overflow: hidden;
        position: relative;
    }
    .cell-box--complete {
        background: var(--mud-palette-success);
        color: white;
    }
    /* PARTIAL: grå base + grønn fyll-stripe som proporsjon av coverage.
       Bruker --fill CSS-variabel som settes inline per celle. */
    .cell-box--partial {
        background: var(--mud-palette-background-grey);
        color: var(--mud-palette-warning-darken);
        border: 1px solid var(--mud-palette-warning);
    }
    .cell-box--partial::before {
        content: "";
        position: absolute;
        left: 0; bottom: 0; right: 0;
        height: var(--fill, 50%);
        background: var(--mud-palette-warning);
        opacity: 0.55;
        z-index: 0;
    }
    .cell-box--partial > span { position: relative; z-index: 1; }
    .cell-box--overdue {
        background: var(--mud-palette-error);
        color: white;
    }
    .cell-box--pending {
        background: var(--mud-palette-info);
        color: white;
    }
    .cell-box--na {
        background: transparent;
        color: var(--mud-palette-text-disabled);
        border: 1px dashed var(--mud-palette-lines-default);
        opacity: 0.4;
    }
    .cell-box--clickable {
        cursor: pointer;
        transition: transform 0.1s, box-shadow 0.1s;
    }
    .cell-box--clickable:hover {
        transform: scale(1.15);
        box-shadow: 0 0 0 2px var(--mud-palette-primary);
    }
    /* Legend: samme bokser, mindre */
    .cell-box--legend { width: 16px; height: 16px; font-size: 10px; }
    /* Symbol-versjon beholdes for legacy bruk (Top 5 osv) */
    .cell-symbol { font-weight: bold; font-family: monospace; }
    .cell-complete { color: var(--mud-palette-success); }
    .cell-partial  { color: var(--mud-palette-warning); }
    .cell-pending  { color: var(--mud-palette-info); }
    .cell-overdue  { color: var(--mud-palette-error); }
    .cell-na       { color: var(--mud-palette-text-disabled); }
    .dk-multi-dropzone {
        border: 2px dashed var(--mud-palette-lines-default);
        padding: 16px;
        text-align: center;
        transition: all 0.2s;
    }
    .dk-multi-dropzone--busy {
        border-color: var(--mud-palette-primary);
        background: rgba(30, 95, 142, 0.04);
    }
    .diag-attempts {
        font-family: monospace;
        font-size: 0.85em;
        background: var(--mud-palette-background-grey);
        padding: 8px 12px;
        border-radius: 4px;
        max-height: 320px;
        overflow-y: auto;
    }
    .diag-attempts li { margin: 2px 0; }
    .diag-key-value {
        font-family: monospace;
        font-size: 0.85em;
    }
    .diag-key-value th { text-align: left; padding-right: 12px; color: var(--mud-palette-text-secondary); font-weight: 400; vertical-align: top; }
    .diag-key-value td { word-break: break-all; }
</style>

@* ---- Diagnose-modal ---- *@
<MudDialog @bind-Visible="_diagOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-2" />
        Diagnose: @_diagFileName
    </TitleContent>
    <DialogContent>
        @if (_diagLoading)
        {
            <MudProgressCircular Indeterminate="true" />
            <MudText Class="ml-2 d-inline">Henter detaljer…</MudText>
        }
        else if (_diagResult is null)
        {
            <MudAlert Severity="Severity.Warning">Klarte ikke å hente diagnose. Filen er kanskje flyttet.</MudAlert>
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <table class="diag-key-value">
                        <tr><th>Filstørrelse</th><td>@(_diagResult.FileSizeBytes / 1024) KB</td></tr>
                        <tr><th>I karantene siden</th><td>@_diagResult.QuarantinedAtUtc.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td></tr>
                        @if (_diagResult.Diagnostics is not null)
                        {
                            <tr><th>Detektert filtype</th><td>@(_diagResult.Diagnostics.DetectedSourceType ?? "(ingen)")</td></tr>
                            <tr><th>Plant-id resolved</th><td>@(_diagResult.Diagnostics.ResolvedPlantId ?? "(ingen)")</td></tr>
                        }
                    </table>
                </MudItem>

                @if (!string.IsNullOrEmpty(_diagResult.ErrorMessage))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2">Feilmelding</MudText>
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1">@_diagResult.ErrorMessage</MudAlert>
                    </MudItem>
                }

                @if (_diagResult.Diagnostics is { Attempts: { Count: > 0 } } d)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2">Detektor-trase (steg-for-steg)</MudText>
                        <ol class="diag-attempts">
                            @foreach (var step in d.Attempts)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    </MudItem>

                    @if (d.SheetNames is { Count: > 0 })
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2">Faner i workbook</MudText>
                            <ul class="diag-attempts">
                                @foreach (var sheet in d.SheetNames)
                                {
                                    <li>
                                        <strong>@sheet</strong>
                                        @if (d.SheetTitleCells.TryGetValue(sheet, out var a1))
                                        {
                                            <span style="color:var(--mud-palette-text-secondary);"> — A1: "@a1"</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </MudItem>
                    }

                    @if (!string.IsNullOrEmpty(d.HeaderLine))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2">CSV-header (truncated)</MudText>
                            <pre class="diag-attempts" style="white-space:pre-wrap;">@d.HeaderLine</pre>
                        </MudItem>
                    }

                    @if (d.ScadaPrefixCounts is { Count: > 0 })
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2">SCADA tag-prefikser i header</MudText>
                            <table class="diag-key-value">
                                @foreach (var kv in d.ScadaPrefixCounts.OrderByDescending(p => p.Value))
                                {
                                    <tr><th>@kv.Key</th><td>@kv.Value tags</td></tr>
                                }
                            </table>
                        </MudItem>
                    }

                    @if (d.OperlogStations is { Count: > 0 })
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2">Operlog stations (topp)</MudText>
                            <table class="diag-key-value">
                                @foreach (var kv in d.OperlogStations.OrderByDescending(p => p.Value))
                                {
                                    <tr><th>@kv.Key</th><td>@kv.Value rader</td></tr>
                                }
                            </table>
                        </MudItem>
                    }
                }
                else if (_diagResult.HasDetailedDiagnostics == false)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Ingen detaljert detektor-trase tilgjengelig (eldre fil eller import-feil).
                            Kun feilmelding over.
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDiagnose">Lukk</MudButton>
    </DialogActions>
</MudDialog>

@* ---- Celle-detalj-modal: hva mangler i en delvis/forfalt celle ---- *@
<MudDialog @bind-Visible="_cellDetailOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        @if (_cellDetail is { } c)
        {
            <MudIcon Icon="@(c.Status == "OVERDUE" ? Icons.Material.Filled.Error : Icons.Material.Filled.PieChartOutline)"
                     Class="mr-2"
                     Color="@(c.Status == "OVERDUE" ? MudBlazor.Color.Error : MudBlazor.Color.Warning)" />
            <span>@c.PlantId — @FormatSource(c.SourceType) — @c.Period.LocalDateTime.ToString("MMMM yyyy")</span>
        }
    </TitleContent>
    <DialogContent>
        @if (_cellDetail is { } cell)
        {
            var (coveredDays, totalDays, missingFrom, missingTo) = ComputeMonthCoverage(cell);
            var coveragePct = (cell.CoveragePct ?? 0) * 100;
            var thresholdPct = (cell.Threshold ?? 0.95) * 100;

            <MudGrid Spacing="2">
                @if (cell.Status == "OVERDUE")
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Dense="true">
                            <strong>Ingen import mottatt</strong> for denne måneden enda.
                            Forventet senest @(cell.Period.AddMonths(1).LocalDateTime.ToString("dd.MM.yyyy")) +
                            lag-dager (se PlantAdmin → Forventede datakilder).
                        </MudAlert>
                    </MudItem>
                }
                else
                {
                    @* Status-strip *@
                    <MudItem xs="12">
                        <div class="d-flex align-center" style="gap:12px;">
                            <span class="cell-box cell-box--partial" style="--fill:@($"{coveragePct:F0}")%; width:32px; height:32px;"></span>
                            <div>
                                <MudText Typo="Typo.h6">Dekning: @coveragePct.ToString("F1") %</MudText>
                                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                                    Grense for komplett: @thresholdPct.ToString("F0") %
                                    — mangler @((thresholdPct - coveragePct).ToString("F1")) prosentpoeng
                                </MudText>
                            </div>
                        </div>
                    </MudItem>

                    @* Periode-dekning *@
                    <MudItem xs="12">
                        <table class="diag-key-value" style="width:100%;">
                            <tr>
                                <th>Måneden i tabellen</th>
                                <td>@cell.Period.LocalDateTime.ToString("dd.MM.yyyy") — @cell.Period.AddMonths(1).LocalDateTime.AddDays(-1).ToString("dd.MM.yyyy") (@totalDays dager)</td>
                            </tr>
                            @if (cell.ImportPeriodFromUtc is not null && cell.ImportPeriodToUtc is not null)
                            {
                                <tr>
                                    <th>Importert periode</th>
                                    <td>@cell.ImportPeriodFromUtc.Value.LocalDateTime.ToString("dd.MM.yyyy HH:mm") — @cell.ImportPeriodToUtc.Value.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <th>Dekket dager i måneden</th>
                                    <td>@coveredDays / @totalDays dager</td>
                                </tr>
                            }
                            @if (cell.RowsImported is { } rows)
                            {
                                <tr><th>Antall rader importert</th><td>@rows.ToString("N0")</td></tr>
                            }
                            @if (!string.IsNullOrEmpty(cell.FileName))
                            {
                                <tr><th>Fil</th><td style="word-break:break-all;">@cell.FileName</td></tr>
                            }
                            @if (cell.LastImportedAt is { } imported)
                            {
                                <tr><th>Sist importert</th><td>@imported.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td></tr>
                            }
                            @if (cell.ImportCount > 1)
                            {
                                <tr><th>Antall imports som dekker måneden</th><td>@cell.ImportCount (siste/beste vinner)</td></tr>
                            }
                            @if (!string.IsNullOrEmpty(cell.Notes))
                            {
                                <tr><th>Notat</th><td>@cell.Notes</td></tr>
                            }
                        </table>
                    </MudItem>

                    @* Hva mangler — basert på om gap-en er periode-grenset eller per-time *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Hva mangler</MudText>
                        @if (cell.SourceType == "operlog")
                        {
                            @* Operlog er event-basert. Periode-gap betyr IKKE manglende data —
                               det betyr bare at det ikke skjedde noen alarmer i den perioden.
                               Vi viser dette tydelig i stedet for å skremme brukeren. *@
                            <MudAlert Severity="Severity.Info" Dense="true">
                                <strong>Operlog er hendelse-basert</strong> — perioden uten events
                                betyr ikke nødvendigvis manglende data, det kan være fredelig drift.<br />
                                <span style="font-size:0.9em;">
                                    Importen inneholder @cell.RowsImported.GetValueOrDefault() events fra
                                    @(cell.ImportPeriodFromUtc?.LocalDateTime.ToString("dd.MM HH:mm") ?? "?") til
                                    @(cell.ImportPeriodToUtc?.LocalDateTime.ToString("dd.MM HH:mm") ?? "?").
                                    Hvis du forventet flere alarmer i denne måneden (eks. fordi du vet det
                                    var en stans 02.04.), eksporter på nytt fra SCADA-systemet og last opp.
                                    Ellers: ingen handling nødvendig.
                                </span>
                            </MudAlert>
                        }
                        else if (missingFrom is not null && missingTo is not null)
                        {
                            var missingDays = (int)Math.Round((missingTo.Value - missingFrom.Value).TotalDays);
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                <strong>Periode-grenset gap:</strong>
                                @missingFrom.Value.LocalDateTime.ToString("dd.MM.yyyy") —
                                @missingTo.Value.LocalDateTime.AddDays(-1).ToString("dd.MM.yyyy")
                                (@missingDays dager).<br />
                                <span style="font-size:0.9em;">
                                    Eksporten dekker bare deler av måneden. Last opp en ny eksport
                                    som inkluderer @missingFrom.Value.LocalDateTime.ToString("MMMM yyyy") for
                                    å fylle hullet.
                                </span>
                            </MudAlert>
                        }
                        else if (cell.ImportPeriodFromUtc is not null)
                        {
                            // Hele måneden dekket av import-perioden, men dekning < threshold —
                            // det betyr per-time-gap (manglende rader, sensor-feil, eller hull i kilden)
                            var expectedRows = totalDays * 24;
                            var actualRows = cell.RowsImported ?? 0;
                            var missingRows = Math.Max(0, expectedRows - actualRows);
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                <strong>Hull i tids-rader:</strong> hele måneden er innenfor importens periode,
                                men dekningen er @coveragePct.ToString("F1") %.<br />
                                <span style="font-size:0.9em;">
                                    @if (cell.SourceType == "scada")
                                    {
                                        <span>Forventet ca. @expectedRows.ToString("N0") timer (@totalDays × 24).
                                        Importert @actualRows.ToString("N0") — dvs. @missingRows.ToString("N0") timer mangler.
                                        Sannsynlig årsak: sensor-feil, kommunikasjonsavbrudd eller hull i SCADA-eksport.</span>
                                    }
                                    else if (cell.SourceType == "settlement")
                                    {
                                        <span>Forventet 720+ timer for en månedlig avregning.
                                        Importert @actualRows.ToString("N0"). Sjekk om filen mangler timer
                                        (DST-overgang i mars/oktober gir små legitime hull).</span>
                                    }
                                    else
                                    {
                                        <span>Operlog er event-basert; dekning beregnes på en annen måte.
                                        Hopp over hvis det ikke er konsistent feilmønster.</span>
                                    }
                                </span>
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Ingen import-detaljer registrert for denne cellen. Mulig at expectation
                                er aktiv før første import er logget — sjekk PlantAdmin.
                            </MudAlert>
                        }
                    </MudItem>

                    @* Forslag til handling — kontekst-sensitive per kilde-type *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Forslag</MudText>
                        <ul style="margin:0; padding-left:20px; font-size:0.9em;">
                            @if (cell.SourceType == "operlog")
                            {
                                <li>Sjekk Nedetid-rapporten for samme måned. Hvis det ikke er registrert hendelser der heller, har anlegget gått problemfritt.</li>
                                <li>Hvis du vet det skjedde alarmer som mangler: re-eksporter operlog fra SCADA og last opp. Duplikat-vakt fanger om innholdet er likt.</li>
                                <li>For å undertrykke "delvis"-status for stille operlog-måneder: senk <em>completion_threshold_pct</em> for kilden i PlantAdmin (eller deaktiver kilden hvis anlegget aldri har alarmer).</li>
                            }
                            else if (missingFrom is not null)
                            {
                                <li>Eksporter ny fil fra KAIA/SCADA som dekker @missingFrom.Value.LocalDateTime.ToString("MMMM yyyy"), legg den i /imports.</li>
                                <li>Duplikat-vakt fanger hvis innholdet er identisk med tidligere import.</li>
                            }
                            else if (cell.SourceType == "scada")
                            {
                                <li>Sjekk om SCADA-eksporten har sensor-feil/kommunikasjonsbrudd i denne perioden.</li>
                                <li>Hvis dekning er forventet lav for dette anlegget (kjent sensor-utfordring), senk <em>completion_threshold_pct</em> i PlantAdmin.</li>
                            }
                            else
                            {
                                <li>Sjekk eksporten mot kilden — manglende timer kan være DST-relaterte (legitim) eller hull (ikke ok).</li>
                            }
                        </ul>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseCellDetail">Lukk</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [SupplyParameterFromQuery(Name = "plant")] public string? PreselectedPlantId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? InitialTab { get; set; }

