@page "/nedetid"
@page "/nedetid/{PlantId}"
@using ApexCharts
@implements IDisposable
@inject NedetidApi NedetidApi
@inject AnnotationsApi AnnotationsApi
@inject FilterState Filter
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject CauseFormatter CauseFormatter

<PageTitle>Nedetids-analyse</PageTitle>

<PageHeader Title="Nedetids-analyse"
            Subtitle="Hendelser, varighet og produksjons-tap per kategori for valgt periode." />

@* Anlegg + periode styres av global velger i AppBar (FilterState). *@

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2">Henter data…</MudText>
}
else if (_response is not null)
{
    @* ---- Datakvalitets-banner (SPEC-MVP-HARDENING tiltak C) ----
       Vis dekning og prosent god kvalitet for valgt periode slik at drifts-leder
       kan vurdere hvor pålitelige nedetid-tallene er. Filter-toggle "skjul
       dårlige timer" krever endring i backend-aggregator og kommer i neste
       iterasjon. *@
    @if (_dataQuality is not null && _dataQuality.GoodPct < 1.0)
    {
        <MudPaper Class="pa-2 mb-3" Elevation="0"
                  Style="border-left: 4px solid var(--mud-palette-warning); background: rgba(243, 156, 18, 0.06);">
            <div class="d-flex align-center" style="gap:12px; flex-wrap:wrap;">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" />
                <MudText Typo="Typo.body2">
                    <strong>Datakvalitet:</strong>
                    @($"{_dataQuality.GoodPct * 100:F1} %") god av @_dataQuality.TotalHours timer.
                    @if (_dataQuality.WarningHours + _dataQuality.BadHours + _dataQuality.MissingHours > 0)
                    {
                        <span>(@(_dataQuality.WarningHours) advarsel, @(_dataQuality.BadHours) dårlig, @(_dataQuality.MissingHours) mangler.)</span>
                    }
                    @if (_dataQuality.ManglerImportHours > 0)
                    {
                        <span> @_dataQuality.ManglerImportHours timer er ikke importert.</span>
                    }
                </MudText>
            </div>
        </MudPaper>
    }

    @* ---- KPI-kort ---- *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Antall events"
                     Value="@_response.AntallEvents.ToString()"
                     SubText="@($"{_response.AntallEvents} nedetid-hendelser")"
                     Accent="KpiAccent.Negative" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Total nedetid"
                     Value="@_response.TotalNedetidTimer.ToString("F1")"
                     SubText="timer"
                     Accent="KpiAccent.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Estimert tap"
                     Value="@_response.TotalTapMwh.ToString("F1")"
                     SubText="MWh (plan/spotbud i nedetidstimene)"
                     Accent="KpiAccent.Neutral" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <KpiCard Label="Tap i NOK"
                     Value="@FormatNok(_response.TotalTapNok)"
                     SubText="brutto, basert på spotpris"
                     Accent="KpiAccent.Positive" />
        </MudItem>
    </MudGrid>

    @* ---- Donut + trend ---- *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h3" Class="mb-3">Tap per kategori</MudText>
                @if (_response.KategoriSummaries.Count > 0)
                {
                    <ApexChart @key="_chartVersion" TItem="NedetidKategoriSummary"
                               Options="_donutOptions" Height="300">
                        <ApexPointSeries TItem="NedetidKategoriSummary"
                                         Items="_response.KategoriSummaries"
                                         Name="Tap NOK"
                                         SeriesType="SeriesType.Donut"
                                         XValue="s => DisplayKategori(s.Kategori)"
                                         YAggregate="xs => (decimal)xs.Sum(x => x.TotalTapNok)" />
                    </ApexChart>
                }
                else
                {
                    <MudText>Ingen events i perioden.</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h3" Class="mb-3">Nedetid per uke</MudText>
                @if (_weeklyTrend.Count > 0)
                {
                    <ApexChart @key="_chartVersion" TItem="WeeklyPoint"
                               Options="_trendOptions" Height="300">
                        <ApexPointSeries TItem="WeeklyPoint"
                                         Items="_weeklyTrend"
                                         Name="Timer nedetid"
                                         SeriesType="SeriesType.Bar"
                                         XValue="p => p.WeekStart.UtcDateTime"
                                         YValue="p => (decimal)p.Hours" />
                    </ApexChart>
                }
                else
                {
                    <MudText>Ingen nedetid i perioden.</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ---- Hendelses-tabell + CSV ---- *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-3">
            <MudText Typo="Typo.h3">Hendelser (@_response.AntallEvents)</MudText>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Download"
                       Href="@_csvUrl"
                       Target="_blank"
                       Disabled="@(_csvUrl is null)">
                Last ned CSV
            </MudButton>
        </div>
        <MudTable Items="_response.Events" Hover="true" Dense="true" Elevation="0"
                  FixedHeader="true" Height="500px" Virtualize="true"
                  Filter="MatchesEventSearch">
            <ToolBarContent>
                <MudTextField @bind-Value="_eventSearch" Placeholder="Søk kategori, cause-code…"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Margin="Margin.Dense" Immediate="true" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="@SortByEventStart"
                       InitialDirection="SortDirection.Descending">Start</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@SortByEventEnd">Slutt</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByEventDuration">Varighet (t)</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@SortByEventCategory">Kategori</MudTableSortLabel></MudTh>
                <MudTh>
                    <MudTooltip Text="Årsak = HVORFOR enheten er i tilstanden (operlog/SCADA-cause-kode). Drifts-leder kan gi koden brukervennlig tekst på /admin/kategorier.">
                        Årsak
                    </MudTooltip>
                </MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByEventTapMwh">Tap (MWh)</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel SortBy="@SortByEventTapNok">Tap (NOK)</MudTableSortLabel></MudTh>
                <MudTh>Operlog</MudTh>
                <MudTh Style="text-align:center; width:48px;">Rediger</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Start">@FormatLocal(context.StartUtc)</MudTd>
                <MudTd DataLabel="Slutt">@FormatLocal(context.EndUtc)</MudTd>
                <MudTd DataLabel="Varighet" Style="text-align:right; font-variant-numeric: tabular-nums;">@context.VarighetTimer.ToString("F1")</MudTd>
                <MudTd DataLabel="Kategori">
                    <MudChip T="string" Size="MudBlazor.Size.Small" Color="@KategoriColor(context.Kategori)">@DisplayKategori(context.Kategori)</MudChip>
                </MudTd>
                <MudTd DataLabel="Årsak">
                    <MudTooltip Text="@(context.CauseCode ?? "")">
                        <span>@CauseFormatter.Display(context.CauseCode)</span>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Tap (MWh)" Style="text-align:right">@context.TapMwh.ToString("F2")</MudTd>
                <MudTd DataLabel="Tap (NOK)" Style="text-align:right">@FormatNok(context.TapNok)</MudTd>
                <MudTd DataLabel="Operlog">@(context.HarOperlogMatch ? "✓" : "")</MudTd>
                <MudTd DataLabel="Rediger" Style="text-align:center;">
                    <MudTooltip Text="@(IsAnnotated(context) ? "Rediger annotering" : "Annotér hendelse")">
                        <MudIconButton
                            Icon="@(IsAnnotated(context) ? Icons.Material.Filled.EditNote : Icons.Material.Outlined.Edit)"
                            Size="MudBlazor.Size.Small"
                            Color="@(IsAnnotated(context) ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                            OnClick="@(() => OpenAnnotationDialogAsync(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @* ---- Kategori-summary-tabell ---- *@
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h3" Class="mb-3">Per kategori</MudText>
        <MudTable Items="_response.KategoriSummaries" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Kategori</MudTh>
                <MudTh Style="text-align:right">Antall</MudTh>
                <MudTh Style="text-align:right">Total timer</MudTh>
                <MudTh Style="text-align:right">Total tap (NOK)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@DisplayKategori(context.Kategori)</MudTd>
                <MudTd Style="text-align:right">@context.Antall</MudTd>
                <MudTd Style="text-align:right">@context.TotalTimer.ToString("F1")</MudTd>
                <MudTd Style="text-align:right">@FormatNok(context.TotalTapNok)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public string? PlantId { get; set; }

    private bool _loading;
    private string? _error;
    private NedetidResponse? _response;
    private DataQualitySummaryDto? _dataQuality;
    private string? _csvUrl;
    private string _eventSearch = string.Empty;
    private IReadOnlyList<AnnotationCategoryDto> _annotationCategories = Array.Empty<AnnotationCategoryDto>();

    // Sort-funksjoner for events-tabell (default sortering = Start synkende)
    private static readonly Func<NedetidEventDto, object> SortByEventStart    = e => e.StartUtc;
    private static readonly Func<NedetidEventDto, object> SortByEventEnd      = e => e.EndUtc;
    private static readonly Func<NedetidEventDto, object> SortByEventDuration = e => e.VarighetTimer;
    private static readonly Func<NedetidEventDto, object> SortByEventCategory = e => e.Kategori;
    private static readonly Func<NedetidEventDto, object> SortByEventTapMwh   = e => e.TapMwh;
    private static readonly Func<NedetidEventDto, object> SortByEventTapNok   = e => e.TapNok;

    private bool MatchesEventSearch(NedetidEventDto e)
    {
        if (string.IsNullOrWhiteSpace(_eventSearch)) return true;
        var s = _eventSearch.Trim();
        return e.Kategori.Contains(s, StringComparison.OrdinalIgnoreCase)
            || (e.CauseCode?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || e.State.Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// True hvis hendelsen kommer fra en manuell annotering (cause-code-prefiks
    /// "annotation:"). AnnotationOverlayService setter dette når en time er
    /// overstyrt — slik kan UIet vise edit-knappen som "rediger" istedenfor
    /// "annotér".
    /// </summary>
    private static bool IsAnnotated(NedetidEventDto e)
        => e.CauseCode?.StartsWith("annotation:", StringComparison.Ordinal) == true;

    /// <summary>
    /// Åpner annoterings-dialogen forhåndsfylt med hendelsens periode. Hvis en
    /// eksisterende annotering dekker hele perioden, blir den lastet inn for
    /// redigering; ellers åpnes dialogen i opprett-modus.
    /// </summary>
    private async Task OpenAnnotationDialogAsync(NedetidEventDto evt)
    {
        if (_annotationCategories.Count == 0)
        {
            try
            {
                _annotationCategories = await AnnotationsApi.ListCategoriesAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Kunne ikke laste annoterings-kategorier: {ex.Message}", Severity.Error);
                return;
            }
        }

        // Søk eksisterende annotering som dekker hele eventet — hvis funnet,
        // åpner dialogen i edit-modus; ellers create-modus med periode pre-fylt.
        AnnotationDto? existing = null;
        try
        {
            var annotations = await AnnotationsApi.ListAsync(
                Filter.PlantId, evt.StartUtc, evt.EndUtc);
            existing = annotations.FirstOrDefault(
                a => a.StartUtc <= evt.StartUtc && a.EndUtc >= evt.EndUtc);
        }
        catch
        {
            // Hvis listing feiler, åpner vi dialogen som "ny" — overlap-deteksjon
            // i dialogen vil fortsatt advare ved lagring.
        }

        var classification = $"{DisplayKategori(evt.Kategori)} ({evt.VarighetTimer:F1} t)";
        var parameters = new DialogParameters<AnnotationDialog>
        {
            { x => x.PlantId, Filter.PlantId },
            { x => x.Categories, _annotationCategories },
            { x => x.InitialStart, evt.StartUtc },
            { x => x.InitialEnd, evt.EndUtc },
            { x => x.Existing, existing },
            { x => x.CurrentClassification, classification }
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
        };

        var title = existing is null ? "Annotér hendelse" : "Rediger annotering";
        var dialog = await DialogService.ShowAsync<AnnotationDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        // Lagring fullført — invalidér Nedetid + Vakt-ROI-cache slik at neste
        // navigering også henter ferske data, og last på nytt her.
        Filter.InvalidateCaches();
        await LoadAsync();
    }
    private List<WeeklyPoint> _weeklyTrend = new();
    private int _chartVersion;

    private ApexChartOptions<NedetidKategoriSummary> _donutOptions = new();
    private ApexChartOptions<WeeklyPoint> _trendOptions = new();

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;

        // Route-parameter PlantId overstyrer FilterState ved direkte navigering
        // til /nedetid/{plantId}. Etterpå er FilterState autoritativ.
        if (!string.IsNullOrEmpty(PlantId) && PlantId != Filter.PlantId)
        {
            Filter.PlantId = PlantId;
        }

        // Last cause-aliaser i bakgrunnen — UI rendres med rå koder først,
        // erstattes ved neste re-render etter at CauseFormatter er klar.
        _ = CauseFormatter.EnsureLoadedAsync()
            .ContinueWith(_ => InvokeAsync(StateHasChanged), TaskScheduler.Default);

        await LoadFromFilterAsync();
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    private async void OnFilterChanged()
    {
        try
        {
            await LoadFromFilterAsync();
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente nedetids-data: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Last data basert på gjeldende FilterState. Bruker cache hvis filter er
    /// uendret siden sist henting.
    /// </summary>
    private async Task LoadFromFilterAsync()
    {
        if (!Filter.ErKlar)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (Filter.HasFreshNedetid())
        {
            _response = Filter.CachedNedetid;
            BuildCharts(_response!);
            _csvUrl = NedetidApi.BuildCsvUri(Filter.PlantId, "nedetid",
                Filter.FromDate!.Value.ToUtcOffsetSafe(),
                Filter.ToDate!.Value.ToUtcOffsetSafe()).ToString();
            await InvokeAsync(StateHasChanged);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!Filter.ErKlar) return;
        _loading = true;
        _error = null;
        _response = null;
        _dataQuality = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var fromUtc = Filter.FromDate!.Value.ToUtcOffsetSafe();
            var toUtc = Filter.ToDate!.Value.ToUtcOffsetSafe();
            _response = await NedetidApi.GetNedetidAsync(Filter.PlantId, fromUtc, toUtc);
            _csvUrl = NedetidApi.BuildCsvUri(Filter.PlantId, "nedetid", fromUtc, toUtc).ToString();
            Filter.StoreNedetid(_response);
            BuildCharts(_response);

            // Datakvalitet — informasjons-banner. Ikke kritisk om endepunktet
            // feiler; vi viser bare ikke banneren da.
            try { _dataQuality = await NedetidApi.GetDataQualityAsync(Filter.PlantId, fromUtc, toUtc); }
            catch { _dataQuality = null; }
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke hente nedetids-data: {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void BuildCharts(NedetidResponse r)
    {
        _chartVersion++;

        _donutOptions = new ApexChartOptions<NedetidKategoriSummary>
        {
            Colors = r.KategoriSummaries.Select(s => KategoriHex(s.Kategori)).ToList(),
            Legend = new Legend { Position = LegendPosition.Bottom },
            PlotOptions = new PlotOptions { Pie = new PlotOptionsPie { Donut = new PlotOptionsDonut { Size = "65%" } } },
        };

        // Weekly trend
        _weeklyTrend = r.Events
            .GroupBy(e => StartOfWeek(e.StartUtc))
            .Select(g => new WeeklyPoint(g.Key, g.Sum(x => x.VarighetTimer)))
            .OrderBy(p => p.WeekStart)
            .ToList();

        _trendOptions = new ApexChartOptions<WeeklyPoint>
        {
            Xaxis = new XAxis { Type = XAxisType.Datetime },
            // Timer-tall: 1 desimal er nok for ukentlig snitt-varighet
            Yaxis = new List<YAxis>
            {
                new() { Title = new AxisTitle { Text = "Timer" }, DecimalsInFloat = 1 }
            },
            Tooltip = new Tooltip { X = new TooltipX { Format = "dd MMM yyyy" } },
            Colors = new List<string> { "#E76F51" },
        };
    }

    private static DateTimeOffset StartOfWeek(DateTimeOffset dt)
    {
        var local = dt.ToLocalTime();
        var diff = (7 + (int)local.DayOfWeek - (int)DayOfWeek.Monday) % 7;
        return new DateTimeOffset(local.Date.AddDays(-diff), local.Offset);
    }

    private static string FormatLocal(DateTimeOffset dt)
        => dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    // Flyttet til Services/NumberFormat.Norsk (UI-gjennomgang tiltak 9).
    private static readonly System.Globalization.NumberFormatInfo NorskTall = NumberFormat.Norsk;

    private static string FormatNok(double nok)
        => nok.ToString("N0", NorskTall);

    private static string DisplayKategori(string kategori) => kategori switch
    {
        "TripFeil" => "Trip / feil",
        "TettInntaksrist" => "Tett inntaksrist",
        "EksternForstyrrelse" => "Ekstern forstyrrelse",
        "PlanlagtVedlikehold" => "Planlagt vedlikehold",
        "Markedstopp" => "Markedstopp",
        "Ressursmangel" => "Ressursmangel",
        "DataMangel" => "Datamangel",
        "UkjentNedetid" => "Ukjent nedetid",
        _ => kategori,
    };

    private static MudBlazor.Color KategoriColor(string kategori) => kategori switch
    {
        "TripFeil" => MudBlazor.Color.Error,
        "TettInntaksrist" => MudBlazor.Color.Tertiary,
        "EksternForstyrrelse" => MudBlazor.Color.Warning,
        "PlanlagtVedlikehold" => MudBlazor.Color.Info,
        "Markedstopp" => MudBlazor.Color.Secondary,
        "Ressursmangel" => MudBlazor.Color.Default,
        "DataMangel" => MudBlazor.Color.Default,
        _ => MudBlazor.Color.Default,
    };

    private static string KategoriHex(string kategori) => kategori switch
    {
        "TripFeil" => "#E76F51",
        "TettInntaksrist" => "#A0522D", // saddle brown — markerer rist-relaterte stopp
        "EksternForstyrrelse" => "#F39C12",
        "PlanlagtVedlikehold" => "#1E5F8E",
        "Markedstopp" => "#7E57C2",
        "Ressursmangel" => "#00A99D",
        "DataMangel" => "#9AA5B0",
        _ => "#9AA5B0",
    };

    public sealed record WeeklyPoint(DateTimeOffset WeekStart, double Hours);
}
