@page "/upload"
@inject NavigationManager Nav

@*
    Tidligere standalone opplastnings-side. Konsolidert til /data-import
    for å samle all import + status på én plass (per brukerinput 2026-05-03).
    Beholder ruten som tilbakekompabilitet — redirect til /data-import med
    eventuell ?plant=-parameter intakt.
*@

@code {
    [SupplyParameterFromQuery(Name = "plant")] public string? PreselectedPlantId { get; set; }

    protected override void OnInitialized()
    {
        var target = string.IsNullOrEmpty(PreselectedPlantId)
            ? "data-import?tab=manuell"
            : $"data-import?tab=manuell&plant={Uri.EscapeDataString(PreselectedPlantId)}";
        Nav.NavigateTo(target, replace: true);
    }
}
