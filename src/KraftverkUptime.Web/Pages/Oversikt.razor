@page "/"
@inject EconomyApi EconomyApi
@inject NedetidApi NedetidApi
@inject FilterState Filter
@inject NavigationManager Nav

<PageTitle>Oversikt</PageTitle>

<PageHeader Title="Oversikt"
            Subtitle="Statusbilde for hele porteføljen akkurat nå — inneværende måned og siste 7 dager." />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@* ---- Statusbanner: ferske importer + manglende forventede importer ---- *@
@if (_bannerLoaded)
{
    <MudPaper Class="pa-2 mb-4" Elevation="0"
              Style="@($"border-left: 4px solid {(_overdue > 0 ? "var(--mud-palette-warning)" : "var(--mud-palette-success)")}; background: rgba(46,157,143,0.06);")">
        <div class="d-flex align-center" style="gap:12px; flex-wrap:wrap;">
            <MudIcon Icon="@Icons.Material.Filled.CloudSync" Size="MudBlazor.Size.Small"
                     Color="MudBlazor.Color.Secondary" />
            <MudText Typo="Typo.body2">
                <strong>@_recentImports</strong> importer siste 24 t.
            </MudText>
            @if (_overdue > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                         Icon="@Icons.Material.Filled.Warning"
                         OnClick="@(() => Nav.NavigateTo("data-import"))">
                    @_overdue forventede importer mangler
                </MudChip>
            }
        </div>
    </MudPaper>
}

@* ---- KPI-strip (daglig-leder-bildet, inneværende måned) ---- *@
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Label="Produksjon"
                 Value="@($"{FormatMwh(SumProd())} MWh")"
                 SubText="@($"{AnleggCount()} anlegg · {FormatMwh(SumMw())} MW installert")"
                 Accent="KpiAccent.Neutral"
                 State="@KpiLoadState" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Label="Spotomsetning"
                 Value="@($"{FormatNok(SumSpot())} NOK")"
                 TrendCurrent="@(Kpi("spotomsetning")?.Verdi)"
                 TrendPrevious="@(Kpi("spotomsetning")?.VerdiForrige)"
                 HigherIsBetter="true"
                 Accent="KpiAccent.Auto"
                 State="@KpiLoadState" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Label="Nedetidstap"
                 Value="@($"{FormatNok(SumTap())} NOK")"
                 SubText="inneværende måned"
                 Accent="KpiAccent.Negative"
                 InfoText="Estimert økonomisk tap fra nedetid denne måneden (tapt produksjon × spotpris i nedetidstimene)."
                 State="@KpiLoadState" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Label="Reddet av vakt"
                 Value="@($"{FormatNok(SumReddet())} NOK")"
                 SubText="inneværende måned"
                 Accent="KpiAccent.Accent"
                 InfoText="Verdi vakta reddet ved å forkorte nedetid (counterfactual) denne måneden."
                 State="@(_report is null ? KpiLoadState : (SumReddet() > 0 ? KpiState.Normal : KpiState.NoData))" />
    </MudItem>
</MudGrid>

@* ---- Siste nedetidshendelser (driftsleder-blokken, siste 7 dager) ---- *@
<MudPaper Class="pa-4 mb-4 dk-card" Elevation="1">
    <div class="d-flex align-center mb-3" style="gap:8px;">
        <MudText Typo="Typo.h3">Siste nedetidshendelser</MudText>
        <HjelpeIkon Tittel="Siste nedetidshendelser"
                    Beskrivelse="De nyeste nedetidshendelsene på tvers av alle anlegg, siste 7 dager. Klikk en rad for å åpne anleggets nedetids-analyse."
                    Begreper="@(new[] { "NOK" })" />
        <MudSpacer />
        <MudButton Variant="Variant.Text" Size="Size.Small"
                   EndIcon="@Icons.Material.Filled.ChevronRight"
                   OnClick="@(() => Nav.NavigateTo("nedetid"))">Vis alle</MudButton>
    </div>
    <MudTable T="OversiktNedetidEventDto" Items="@Hendelser" Loading="@_loadingHendelser"
              Hover="true" Striped="true" Elevation="0"
              OnRowClick="@((TableRowClickEventArgs<OversiktNedetidEventDto> args) => OnHendelseClick(args.Item))"
              RowStyle="cursor: pointer;">
        <HeaderContent>
            <MudTh>Anlegg</MudTh>
            <MudTh>Start</MudTh>
            <MudTh Style="text-align:right">Varighet</MudTh>
            <MudTh>Kategori</MudTh>
            <MudTh>Årsak</MudTh>
            <MudTh Style="text-align:right">Est. tap</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Anlegg">@context.PlantName</MudTd>
            <MudTd DataLabel="Start">@FormatLocal(context.StartUtc)</MudTd>
            <MudTd DataLabel="Varighet" Style="text-align:right">@($"{NumberFormat.Hours(context.VarighetTimer)} t")</MudTd>
            <MudTd DataLabel="Kategori">@HumanizeKategori(context.Kategori)</MudTd>
            <MudTd DataLabel="Årsak">@AarsakText(context)</MudTd>
            <MudTd DataLabel="Est. tap" Style="text-align:right">@FormatTap(context.TapNok)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-2">Ingen nedetidshendelser siste 7 dager.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText Typo="Typo.body2" Class="pa-2">Henter hendelser…</MudText>
        </LoadingContent>
    </MudTable>
</MudPaper>

@* ---- Anleggsstatus (per anlegg, inneværende måned) ---- *@
<MudPaper Class="pa-4 dk-card" Elevation="1">
    <div class="d-flex align-center mb-3" style="gap:8px;">
        <MudText Typo="Typo.h3">Anleggsstatus</MudText>
        <HjelpeIkon Tittel="Anleggsstatus"
                    Beskrivelse="Nedetid og datakvalitet per anlegg for inneværende måned. Varselikon betyr at de siste timene ennå ikke er importert. Klikk en rad for nedetids-analyse."
                    Begreper="@(new[] { "AF" })" />
    </div>
    <MudTable T="PerPlantEconomyDto" Items="@Anlegg" Loading="@(_report is null && _error is null)"
              Hover="true" Striped="true" Elevation="0"
              OnRowClick="@((TableRowClickEventArgs<PerPlantEconomyDto> args) => OnAnleggClick(args.Item))"
              RowStyle="cursor: pointer;">
        <HeaderContent>
            <MudTh>Anlegg</MudTh>
            <MudTh Style="text-align:right">Nedetid (mnd)</MudTh>
            <MudTh Style="text-align:right">Hendelser</MudTh>
            <MudTh Style="text-align:right">Datakvalitet</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Anlegg">@context.PlantName</MudTd>
            <MudTd DataLabel="Nedetid (mnd)" Style="text-align:right">@($"{NumberFormat.Hours(context.NedetidTimer)} t")</MudTd>
            <MudTd DataLabel="Hendelser" Style="text-align:right">@context.AntallEvents</MudTd>
            <MudTd DataLabel="Datakvalitet" Style="text-align:right">@NumberFormat.Pct(context.GoodHoursPct, 1)</MudTd>
            <MudTd DataLabel="Status">
                @if (context.ManglerImportHours > 0)
                {
                    <MudTooltip Text="@($"Siste {context.ManglerImportHours} timer er ikke importert ennå.")">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.Warning">Mangler import</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                             Icon="@Icons.Material.Filled.CheckCircle">Oppdatert</MudChip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-2">Ingen anlegg å vise.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private EconomyReportDto? _report;
    private OversiktNedetidResponse? _hendelser;
    private bool _loadingHendelser = true;
    private bool _bannerLoaded;
    private int _recentImports;
    private int _overdue;
    private string? _error;

    // Oversikt viser alltid «nå»-bildet uavhengig av global FilterState-periode:
    // inneværende måned for KPI/anleggsstatus, siste 7 dager for hendelser.
    // Periodevelgeren er skjult på «/» (MainLayout.ShowGlobalSelector).
    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1);
        var manedFra = monthStart.ToUtcOffsetSafe();
        var manedTil = monthEnd.ToUtcOffsetSafe();
        var syvFra = today.AddDays(-7).ToUtcOffsetSafe();
        var syvTil = today.AddDays(1).ToUtcOffsetSafe();

        // Hver seksjon lastes uavhengig og rendres SÅ SNART den er klar. Ett
        // tregt kall (typisk det tverranleggs hendelses-kallet som spør 11
        // anlegg) skal ikke fryse hele siden i «laster» — KPI-strip, banner og
        // anleggsstatus dukker opp med en gang deres egne kall er ferdige.
        await Task.WhenAll(
            RefreshWhenDone(LoadEconomyAsync(manedFra, manedTil)),
            RefreshWhenDone(LoadHendelserAsync(syvFra, syvTil)),
            RefreshWhenDone(LoadBannerAsync()));
    }

    /// <summary>
    /// Venter på ett seksjons-kall og tvinger en re-render straks det er ferdig,
    /// uavhengig av de andre. Load-metodene fanger egne feil, så denne kaster ikke.
    /// </summary>
    private async Task RefreshWhenDone(Task work)
    {
        try { await work; }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task LoadEconomyAsync(DateTimeOffset fra, DateTimeOffset til)
    {
        try
        {
            // kind="Month" → backend regner forrige måned som sammenligning, så
            // trend-pilene på KPI-strippen får data.
            _report = await EconomyApi.GetReportAsync(new[] { "all" }, fra, til, kind: "Month");
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke laste KPI-er: {ex.Message}";
        }
    }

    private async Task LoadHendelserAsync(DateTimeOffset fra, DateTimeOffset til)
    {
        try
        {
            _hendelser = await NedetidApi.GetOversiktNedetidHendelserAsync(fra, til, limit: 10);
        }
        catch
        {
            // Tabellen viser tom-tilstand; ikke blokkér resten av siden.
        }
        finally
        {
            _loadingHendelser = false;
        }
    }

    private async Task LoadBannerAsync()
    {
        try
        {
            var recent = await NedetidApi.GetRecentImportsAsync(hours: 24, limit: 100);
            _recentImports = recent.Count;
        }
        catch { /* banner-felt forblir 0 */ }

        try
        {
            var summary = await NedetidApi.GetDataStatusSummaryAsync();
            _overdue = summary.Overdue;
        }
        catch { /* overdue forblir 0 → ingen varsel */ }

        _bannerLoaded = true;
    }

    // -- KPI-aggregater (samme tall-grunnlag som Portefølje, fra /economy) --
    private double SumProd() => _report?.PerPlant.Sum(p => p.TotalProductionMwh) ?? 0;
    private double SumMw() => _report?.PerPlant.Sum(p => p.InstalledCapacityMw) ?? 0;
    private double SumSpot() => _report?.PerPlant.Sum(p => p.SpotomsetningNok) ?? 0;
    private double SumTap() => _report?.PerPlant.Sum(p => p.NedetidstapNok) ?? 0;
    private double SumReddet() => _report?.PerPlant.Sum(p => p.ReddetAvVaktNok) ?? 0;
    private int AnleggCount() => _report?.PerPlant.Length ?? 0;

    private KpiState KpiLoadState => _report is null && _error is null ? KpiState.Loading : KpiState.Normal;

    /// <summary>Finner en KPI på tvers av de tre økonomi-gruppene via stabil nøkkel.</summary>
    private EconomyKpiDto? Kpi(string key) => _report is null
        ? null
        : new[] { _report.Inntekter, _report.Kostnader, _report.Resultat }
            .SelectMany(g => g.Kpis)
            .FirstOrDefault(k => k.Key == key);

    // -- Tabell-kilder --
    private IEnumerable<OversiktNedetidEventDto> Hendelser =>
        _hendelser?.Events ?? Array.Empty<OversiktNedetidEventDto>();

    private IEnumerable<PerPlantEconomyDto> Anlegg => _report is null
        ? Array.Empty<PerPlantEconomyDto>()
        : _report.PerPlant.OrderByDescending(p => p.NedetidTimer);

    // -- Navigasjon --
    private void OnHendelseClick(OversiktNedetidEventDto? e)
    {
        if (e is null) return;
        Filter.PlantId = e.PlantId;
        Nav.NavigateTo("nedetid");
    }

    private void OnAnleggClick(PerPlantEconomyDto? p)
    {
        if (p is null) return;
        Filter.PlantId = p.PlantId;
        Nav.NavigateTo("nedetid");
    }

    // -- Format-helpers (delegerer til Services/NumberFormat for konsistens) --
    private static string FormatMwh(double v) => v == 0 ? "–" : v.ToString("F1", NumberFormat.Norsk);
    private static string FormatNok(double v) => NumberFormat.Nok(v);
    private static string FormatLocal(DateTimeOffset utc) => utc.LocalDateTime.ToString("dd.MM HH:mm");
    private static string FormatTap(double nok) => nok <= 0 ? "–" : $"{NumberFormat.Nok(nok)} NOK";

    private static string AarsakText(OversiktNedetidEventDto e) =>
        !string.IsNullOrWhiteSpace(e.CauseCode) ? e.CauseCode!
        : !string.IsNullOrWhiteSpace(e.Rationale) ? e.Rationale!
        : "—";

    private static string HumanizeKategori(string kategori) => kategori switch
    {
        "TripFeil" => "Trip/feil",
        "TettInntaksrist" => "Tett inntaksrist",
        "EksternForstyrrelse" => "Ekstern forstyrrelse",
        "PlanlagtVedlikehold" => "Planlagt vedlikehold",
        "Markedstopp" => "Markedsstopp",
        "Ressursmangel" => "Ressursmangel",
        "DataMangel" => "Datamangel",
        "UkjentNedetid" => "Ukjent",
        _ => kategori,
    };
}
