@page "/"
@inject ReportsApi Api
@inject IUserContextProvider UserContext
@inject NavigationManager Nav

<PageTitle>KraftverkUptime</PageTitle>

<div class="dk-hero">
    <MudText Typo="Typo.h1">Oversikt</MudText>
    <div class="dk-hero-sub">Oppetidsanalyse for vannkraft – @UserContext.OrgId</div>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@* --- KPI-kort -------------------------------------------------------------- *@
<MudGrid Spacing="3" Class="mb-8">
    <MudItem xs="12" sm="6" md="3" Class="dk-fade-in">
        <MudPaper Class="pa-5 dk-card dk-stat" Elevation="0"
                  Style="--dk-accent: #1E5F8E; --dk-accent-2: #2A7CB5;">
            <div class="dk-stat-icon">
                <MudIcon Icon="@Icons.Material.Filled.Factory" />
            </div>
            <div class="dk-stat-label">Anlegg</div>
            <div class="dk-stat-value">@(_plants?.Count.ToString() ?? "—")</div>
            <div class="dk-stat-sub">registrert i systemet</div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3" Class="dk-fade-in">
        <MudPaper Class="pa-5 dk-card dk-stat" Elevation="0"
                  Style="--dk-accent: #00A99D; --dk-accent-2: #2DD4BF;">
            <div class="dk-stat-icon">
                <MudIcon Icon="@Icons.Material.Filled.Bolt" />
            </div>
            <div class="dk-stat-label">Installert effekt</div>
            <div class="dk-stat-value">@(_plants is null ? "—" : _plants.Sum(p => p.InstalledCapacityMw).ToString("F1")) <span style="font-size:1.25rem; font-weight:600; color:var(--mud-palette-text-secondary);">MW</span></div>
            <div class="dk-stat-sub">total installert kapasitet</div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3" Class="dk-fade-in">
        <MudPaper Class="pa-5 dk-card dk-stat" Elevation="0"
                  Style="--dk-accent: #2A9D8F; --dk-accent-2: #52C5B5;">
            <div class="dk-stat-icon">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
            </div>
            <div class="dk-stat-label">Klare rapporter</div>
            <div class="dk-stat-value">@_readyReports</div>
            <div class="dk-stat-sub">på tvers av anleggene</div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3" Class="dk-fade-in">
        <MudPaper Class="pa-5 dk-card dk-stat dk-action" Elevation="0"
                  Style="--dk-accent: #F39C12; --dk-accent-2: #FFB84D;"
                  @onclick="@(() => Nav.NavigateTo("behandles"))">
            <div class="dk-stat-icon">
                <MudIcon Icon="@Icons.Material.Filled.HourglassTop" />
            </div>
            <div class="dk-stat-label">Behandles</div>
            <div class="dk-stat-value">
                @if (_pendingReports != "0" && _pendingReports != "—" && _pendingReports != "…")
                {
                    <span class="dk-pulse"></span>
                }
                @_pendingReports
            </div>
            <div class="dk-stat-sub">klikk for liste — i klassifiserings-køen</div>
        </MudPaper>
    </MudItem>
</MudGrid>

@* --- Hurtigvalg ----------------------------------------------------------- *@
<MudText Typo="Typo.h4" Class="mb-4" Style="font-weight:600; letter-spacing:-0.015em;">Hurtigvalg</MudText>
<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="4" Class="dk-fade-in">
        <MudPaper Class="pa-5 dk-card dk-action" Elevation="0"
                  Style="--dk-accent: #1E5F8E;"
                  @onclick="@(() => Nav.NavigateTo("data-import"))">
            <div class="dk-action-icon">
                <MudIcon Icon="@Icons.Material.Filled.CloudSync" Size="Size.Medium" />
            </div>
            <MudText Typo="Typo.h5" Class="mb-1">Data-import</MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mud-palette-text-secondary);">
                Status, opplasting og historikk — alt på én side.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       DropShadow="false" Href="data-import" EndIcon="@Icons.Material.Filled.ArrowForward">Åpne</MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4" Class="dk-fade-in">
        <MudPaper Class="pa-5 dk-card dk-action" Elevation="0"
                  Style="--dk-accent: #00A99D;"
                  @onclick="@(() => Nav.NavigateTo("reports"))">
            <div class="dk-action-icon">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Medium" />
            </div>
            <MudText Typo="Typo.h5" Class="mb-1">Se rapporter</MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mud-palette-text-secondary);">
                Filtrer på anlegg og periode. Åpne KPI-rapport eller last ned Excel.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       DropShadow="false" Href="reports" EndIcon="@Icons.Material.Filled.ArrowForward">Åpne</MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4" Class="dk-fade-in">
        <MudPaper Class="pa-5 dk-card dk-action" Elevation="0"
                  Style="--dk-accent: #F39C12;"
                  @onclick="@(() => Nav.NavigateTo("plants"))">
            <div class="dk-action-icon">
                <MudIcon Icon="@Icons.Material.Filled.Factory" Size="Size.Medium" />
            </div>
            <MudText Typo="Typo.h5" Class="mb-1">Anlegg</MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mud-palette-text-secondary);">
                Oversikt over alle registrerte kraftverk og vindparker.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary"
                       DropShadow="false" Href="plants" EndIcon="@Icons.Material.Filled.ArrowForward">Åpne</MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<PlantDto>? _plants;
    private string _readyReports = "—";
    private string _pendingReports = "—";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _plants = await Api.ListPlantsAsync();

            var ready = 0;
            var pending = 0;
            foreach (var p in _plants)
            {
                try
                {
                    var rows = await Api.ListSettlementsAsync(p.Id);
                    ready += rows.Count(r => r.ReportAvailable);
                    pending += rows.Count(r => !r.ReportAvailable);
                }
                catch
                {
                    // Enkelt-feil per plant skal ikke blokkere dashbordet.
                }
            }
            _readyReports = ready.ToString();
            _pendingReports = pending.ToString();
        }
        catch (Exception ex)
        {
            _error = $"Kunne ikke laste oversikt: {ex.Message}";
            _plants = Array.Empty<PlantDto>();
            _readyReports = "0";
            _pendingReports = "0";
        }
    }
}
