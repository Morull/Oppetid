@page "/plants/{PlantId}/admin"
@implements IDisposable
@inject ReportsApi Api
@inject NedetidApi NedetidApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject FilterState Filter

<PageTitle>@($"Admin: {_form?.Name ?? PlantId}")</PageTitle>

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
           Href="/plants" Class="mb-2">
    Tilbake til anlegg
</MudButton>
<PageHeader Title="@($"Admin: {PlantId}")">
    <SubtitleContent>
        <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">
            Oppdater kanonisk navn, type, installert effekt og tidssone for anlegget.
            Brukes typisk for å fylle inn <strong>InstalledCapacityMw</strong> for nye
            auto-opprettede anlegg.
        </MudText>
    </SubtitleContent>
</PageHeader>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2 d-inline">Henter…</MudText>
}
else if (_form is null)
{
    <MudAlert Severity="Severity.Error">@(_loadError ?? "Anlegget ble ikke funnet.")</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width:680px;">
        <MudStack Spacing="3">
            <MudTextField Label="Plant-ID" Value="@PlantId" Disabled="true"
                          Variant="Variant.Outlined"
                          HelperText="Slug-en endres ikke. Slett og opprett på nytt for ny ID." />

            <MudTextField @bind-Value="_form.Name" Label="Navn (kanonisk, med æ/ø/å)"
                          Required="true" Variant="Variant.Outlined" />

            <MudSelect T="string" @bind-Value="_form.Type" Label="Type"
                       Variant="Variant.Outlined" Required="true">
                <MudSelectItem Value="@("Regulated")">Regulated (magasinkraft)</MudSelectItem>
                <MudSelectItem Value="@("RunOfRiver")">RunOfRiver (elvekraft)</MudSelectItem>
                <MudSelectItem Value="@("Mixed")">Mixed (kombinasjon)</MudSelectItem>
                <MudSelectItem Value="@("Pumped")">Pumped (pumpekraft)</MudSelectItem>
            </MudSelect>

            <MudNumericField T="double" @bind-Value="_form.InstalledCapacityMw"
                             Label="Installert effekt (MW)"
                             Min="0" Max="1000" Step="0.1" Format="F2"
                             Required="true" Variant="Variant.Outlined"
                             HelperText="0 = krever oppsett. Vakt-ROI gir 0 NOK for anlegg uten kapasitet." />

            <MudNumericField T="double?" @bind-Value="_form.NormalAarsproduksjonGwh"
                             Label="Normal årsproduksjon (GWh)"
                             Min="0" Max="10000" Step="0.1" Format="F1"
                             Variant="Variant.Outlined"
                             HelperText="Forventet produksjon i et gjennomsnittlig (normalt) år. Brukes til å sammenligne mot faktisk produksjon og til å fordele felleskostnader etter GWh-andel. La stå tom hvis ukjent." />

            <MudTextField @bind-Value="_form.TimeZone" Label="Tidssone (IANA)"
                          Required="true" Variant="Variant.Outlined"
                          HelperText="F.eks. Europe/Oslo. Påvirker DST-tolkning av settlement-data." />

            <MudNumericField T="double" @bind-Value="_form.DeratingThreshold"
                             Label="Plan-avviks-terskel"
                             Min="0.10" Max="1.0" Step="0.05" Format="F2"
                             Required="true" Variant="Variant.Outlined"
                             HelperText="@($"Elhub < {(_form.DeratingThreshold * 100):F0} % av Plan klassifiseres som feil (ForcedDerating). Default 0.80 = avvik > 20 % gir feil.")" />

            <div class="d-flex justify-end" style="gap:8px;">
                <MudButton Variant="Variant.Text" Href="/plants">Avbryt</MudButton>
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="OnSaveAsync" Disabled="@_saving">
                    @(_saving ? "Lagrer…" : "Lagre")
                </MudButton>
            </div>

            @if (_saveError is not null)
            {
                <MudAlert Severity="Severity.Error">@_saveError</MudAlert>
            }
        </MudStack>
    </MudPaper>

    @* ---- Dammer (kaskade-modell) ---- *@
    <MudPaper Class="pa-4 mt-6" Elevation="1" Style="max-width:880px;">
        <div class="d-flex align-center mb-2" style="gap:12px;">
            <MudText Typo="Typo.h3" Class="flex-grow-1">Dammer (kaskade-modell)</MudText>
            <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDam"
                       Disabled="@(_dams is null)">
                Legg til dam
            </MudButton>
        </div>
        <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
            Hvert anlegg har én eller flere dammer. <strong>Terminal-dam</strong>
            (siste før turbin) er den eneste hvor overløp koster produksjon —
            øvre dammer renner videre i kaskaden. HRV/LRV/Volum brukes til
            magasinstand-visualisering og fremtidig vannverdi-modell.
        </MudText>

        @if (_dams is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_dams.Count == 0)
        {
            <MudAlert Severity="Severity.Warning">
                Ingen dammer registrert. Backfill skal ha opprettet en default-dam — sjekk at
                bootstrap-skjema-broen kjørte ved oppstart.
            </MudAlert>
        }
        else
        {
            <MudTable Items="_dams" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Dam</MudTh>
                    <MudTh Style="text-align:center">Kaskade-posisjon</MudTh>
                    <MudTh Style="text-align:center">Terminal</MudTh>
                    <MudTh Style="text-align:right">HRV (moh)</MudTh>
                    <MudTh Style="text-align:right">LRV (moh)</MudTh>
                    <MudTh Style="text-align:right">Volum (Mill.m³)</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <strong>@context.Name</strong>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@context.DamId</MudText>
                    </MudTd>
                    <MudTd Style="text-align:center">@context.CascadePosition</MudTd>
                    <MudTd Style="text-align:center">
                        @if (context.IsTurbineIntake)
                        {
                            <MudChip T="string" Size="MudBlazor.Size.Small"
                                     Color="MudBlazor.Color.Primary" Icon="@Icons.Material.Filled.Bolt">Terminal</MudChip>
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">@(context.HrvMoh?.ToString("F1") ?? "–")</MudTd>
                    <MudTd Style="text-align:right">@(context.LrvMoh?.ToString("F1") ?? "–")</MudTd>
                    <MudTd Style="text-align:right">@(context.VolumeMm3?.ToString("F2") ?? "–")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="MudBlazor.Size.Small"
                                       OnClick="@(() => OpenEditDamAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="MudBlazor.Size.Small"
                                       Color="MudBlazor.Color.Error"
                                       Disabled="@(context.IsTurbineIntake || _dams!.Count == 1)"
                                       OnClick="@(() => OnDeleteDamAsync(context))"
                                       title="@(context.IsTurbineIntake ? "Sett en annen som terminal først" : (_dams!.Count == 1 ? "Kan ikke slette siste dam" : "Slett dam"))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_damSaveError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_damSaveError</MudAlert>
        }
    </MudPaper>

    @* ---- Add-dialog for dam ---- *@
    <MudDialog @bind-Visible="_addingDamOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
        <TitleContent>Legg til dam</TitleContent>
        <DialogContent>
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_addForm.DamId"
                              Label="Dam-id (kortnavn, kun bokstaver/sifre/_)"
                              HelperText="Eks: stolsvt, gjelevt. Brukes som intern referanse — kan ikke endres etterpå."
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_addForm.Name" Label="Navn (vises i UI)"
                              Variant="Variant.Outlined" />
                <MudNumericField T="int" @bind-Value="_addForm.CascadePosition"
                                 Label="Kaskade-posisjon (1=øverst)" Min="1" Max="10"
                                 Variant="Variant.Outlined" />
                <MudCheckBox T="bool" @bind-Value="_addForm.IsTurbineIntake"
                             Label="Sett som terminal-dam (flytter markøren fra eksisterende terminal)" />
                <MudNumericField T="double?" @bind-Value="_addForm.HrvMoh"
                                 Label="HRV (moh) — frivillig"
                                 Step="0.1" Format="F1"
                                 Variant="Variant.Outlined" />
                <MudNumericField T="double?" @bind-Value="_addForm.LrvMoh"
                                 Label="LRV (moh) — frivillig"
                                 Step="0.1" Format="F1"
                                 Variant="Variant.Outlined" />
                <MudNumericField T="double?" @bind-Value="_addForm.VolumeMm3"
                                 Label="Volum (Mill.m³) — frivillig"
                                 Step="0.01" Format="F2"
                                 Variant="Variant.Outlined" />
                <MudNumericField T="int?" @bind-Value="_addForm.OverflowProxyThresholdCm"
                                 Label="Overløps-terskel (cm over HRV) — frivillig"
                                 HelperText="Brukes når anlegget har OverflowMode = LevelProxy. Typisk 10."
                                 Min="0" Max="500"
                                 Variant="Variant.Outlined" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _addingDamOpen = false)">Avbryt</MudButton>
            <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled"
                       OnClick="OnDamCreateAsync" Disabled="@_damSaving">
                @(_damSaving ? "Lagrer…" : "Opprett")
            </MudButton>
        </DialogActions>
    </MudDialog>

    @* ---- Edit-dialog for dam ---- *@
    @if (_editingDam is not null)
    {
        <MudDialog @bind-Visible="_editingDamOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
            <TitleContent>Rediger @_editingDam.Name</TitleContent>
            <DialogContent>
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_editForm.Name" Label="Navn" Variant="Variant.Outlined" />
                    <MudNumericField T="int" @bind-Value="_editForm.CascadePosition"
                                     Label="Kaskade-posisjon (1=øverst)" Min="1" Max="10"
                                     Variant="Variant.Outlined" />
                    <MudCheckBox T="bool" @bind-Value="_editForm.IsTurbineIntake"
                                 Label="Terminal-dam (siste før turbin)" />
                    <MudNumericField T="double?" @bind-Value="_editForm.HrvMoh"
                                     Label="HRV (moh)" Step="0.1" Format="F1"
                                     HelperText="Høyeste regulerte vannstand. Hentes fra konsesjonsdokumenter."
                                     Variant="Variant.Outlined" />
                    <MudNumericField T="double?" @bind-Value="_editForm.LrvMoh"
                                     Label="LRV (moh)" Step="0.1" Format="F1"
                                     HelperText="Laveste regulerte vannstand."
                                     Variant="Variant.Outlined" />
                    <MudNumericField T="double?" @bind-Value="_editForm.VolumeMm3"
                                     Label="Volum (Mill.m³)" Step="0.01" Format="F2"
                                     HelperText="Magasin-volum mellom HRV og LRV."
                                     Variant="Variant.Outlined" />
                    <MudNumericField T="int?" @bind-Value="_editForm.OverflowProxyThresholdCm"
                                     Label="Overløps-terskel (cm over HRV)"
                                     Min="0" Max="500"
                                     HelperText="Brukes når anlegget kjører OverflowMode = LevelProxy (f.eks. Ørsdalen). 10 = 10 cm over HRV regnes som overløp."
                                     Variant="Variant.Outlined" />
                </MudStack>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _editingDamOpen = false)">Avbryt</MudButton>
                <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled"
                           OnClick="OnDamSaveAsync" Disabled="@_damSaving">
                    @(_damSaving ? "Lagrer…" : "Lagre")
                </MudButton>
            </DialogActions>
        </MudDialog>
    }

    @* ---- Overløp-måling (SCADA-tag → terminal-dam) ---- *@
    <MudPaper Class="pa-4 mt-6" Elevation="1" Style="max-width:880px;">
        <MudText Typo="Typo.h3" Class="mb-2">Overløp-måling</MudText>
        <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
            Velg hvilken SCADA-tag som måler overløps-vannføring (m³/s) på terminal-dammen.
            <strong>Vakt-ROI</strong> bruker denne til å beregne hvor mange timer i counterfactual-perioden
            som faktisk hadde overløp — uten en mappet tag rapporteres ROI som
            "OverflowDataMissing".
        </MudText>

        @{
            var terminalDam = _dams?.FirstOrDefault(d => d.IsTurbineIntake);
            var currentOverflow = _overflowMappings?.FirstOrDefault(s =>
                s.DamId == terminalDam?.DamId && s.Role == "OverflowFlow");
        }

        @if (_dams is null || _scadaTags is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (terminalDam is null)
        {
            <MudAlert Severity="Severity.Warning">
                Ingen terminal-dam satt. Sett <em>IsTurbineIntake=true</em> på én av dammene over først.
            </MudAlert>
        }
        else
        {
            <table class="diag-key-value">
                <tr>
                    <th>Terminal-dam</th>
                    <td><strong>@terminalDam.Name</strong> (id=@terminalDam.DamId)</td>
                </tr>
                <tr>
                    <th>Mappet OverflowFlow-tag</th>
                    <td>
                        @if (currentOverflow is not null)
                        {
                            <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Success"
                                     Icon="@Icons.Material.Filled.CheckCircle">@currentOverflow.SignalId</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Warning"
                                     Icon="@Icons.Material.Filled.Warning">Ikke satt</MudChip>
                        }
                    </td>
                </tr>
                @if (_scadaTags.Count == 0)
                {
                    <tr>
                        <th>Tilgjengelige tags</th>
                        <td>
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                                Ingen SCADA-samples importert ennå for dette anlegget. Last opp en master-CSV
                                via /data-import for å fylle tag-listen.
                            </MudText>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <th>Velg tag</th>
                        <td>
                            <MudAutocomplete T="string" @bind-Value="_overflowTagPick"
                                             Label="SCADA-tag (filter på navn)"
                                             SearchFunc="SearchOverflowTags"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             ShowProgressIndicator="true"
                                             CoerceText="false"
                                             AdornmentIcon="@Icons.Material.Filled.Search" />
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                                Søk etter tag som inneholder "OVERLOP", "OVERFLOW" eller similar.
                                Tag-en MÅ levere kontinuerlig vannføring i m³/s — ikke bare alarm-grenser.
                            </MudText>
                        </td>
                    </tr>
                }
            </table>

            <div class="d-flex mt-3" style="gap:8px;">
                <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_overflowSaving || string.IsNullOrEmpty(_overflowTagPick))"
                           OnClick="OnOverflowMapAsync">
                    @(_overflowSaving ? "Lagrer…" : (currentOverflow is not null ? "Endre mapping" : "Sett mapping"))
                </MudButton>
                @if (currentOverflow is not null)
                {
                    <MudButton Color="MudBlazor.Color.Default" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Close"
                               Disabled="@_overflowSaving"
                               OnClick="OnOverflowClearAsync">
                        Fjern mapping
                    </MudButton>
                }
            </div>
            @if (_overflowError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_overflowError</MudAlert>
            }
        }
    </MudPaper>

    @* ---- Forventede datakilder (SPEC-IMPORT-COMPLETENESS) ---- *@
    <MudPaper Class="pa-4 mt-6" Elevation="1" Style="max-width:880px;">
        <MudText Typo="Typo.h3" Class="mb-2">Forventede datakilder</MudText>
        <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
            Toggle hvilke datakilder anlegget skal forvente, og hvor mange dager
            etter periode-slutt vi flagger en manglende import som forfalt.
            Endringer trer i kraft umiddelbart i <MudLink Href="/data-status">data-status</MudLink>-matrisen.
        </MudText>

        @if (_expectations is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudTable Items="_sourceTypes" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Kilde</MudTh>
                    <MudTh Style="text-align:center">Aktiv</MudTh>
                    <MudTh Style="text-align:right">Lag (dager)</MudTh>
                    <MudTh Style="text-align:right">Komplett-grense (%)</MudTh>
                    <MudTh>Aktivert</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var current = _expectations.FirstOrDefault(e => e.SourceType == context);
                    }
                    <MudTd>
                        <strong>@FormatSourceType(context)</strong>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                            @SourceTypeDescription(context)
                        </MudText>
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <MudSwitch T="bool" Value="@(current?.IsActive ?? false)"
                                   Color="MudBlazor.Color.Success"
                                   ValueChanged="async (bool v) => await OnToggleExpectationAsync(context, v, current)"
                                   Disabled="@_expSaving" />
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudNumericField T="int" Value="@(current?.ExpectedLagDays ?? DefaultLagFor(context))"
                                         ValueChanged="async (int v) => await OnLagChangedAsync(context, v, current)"
                                         Min="0" Max="90" Step="1"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Style="width:80px;"
                                         Disabled="@_expSaving" />
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudNumericField T="int" Value="@((int)Math.Round((current?.CompletionThresholdPct ?? DefaultThresholdFor(context)) * 100))"
                                         ValueChanged="async (int v) => await OnThresholdChangedAsync(context, v / 100.0, current)"
                                         Min="0" Max="100" Step="5"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Style="width:90px;"
                                         Disabled="@_expSaving" />
                    </MudTd>
                    <MudTd>
                        @if (current?.ActivatedAtUtc is { } activated)
                        {
                            <MudText Typo="Typo.caption">@activated.LocalDateTime.ToString("yyyy-MM-dd")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">—</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mt-1">
                <strong>Lag</strong> = antall dager etter periode-slutt før manglende data flagges som forfalt.
                <strong>Komplett-grense</strong> = nødvendig dekning (%) for at en periode regnes som komplett.
                Lavere verdi gir mer "grønt" — egnet for SCADA der eksporter har naturlig hull.
            </MudText>

            @if (_expSaveError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_expSaveError</MudAlert>
            }
        }
    </MudPaper>

    @* ---- SCADA-signaler -----------------------------------------------------
       Liste over alle signal-tags konfigurert for anlegget. Flyttet hit
       fra den utgåtte /anlegg/{id}-siden (2026-05-20) siden signal-mapping
       er ren konfig — ikke analyse. *@
    <MudPaper Class="pa-4 mt-6" Elevation="1">
        <MudText Typo="Typo.h3" Class="mb-2">SCADA-signaler</MudText>
        <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
            Alle SCADA-tags som er mappet inn for dette anlegget, med deres
            rolle (OverflowFlow, GeneratorActivePower osv.) og tilknyttet dam.
        </MudText>
        <PlantSignalList PlantId="@PlantId" />
    </MudPaper>

    @* ---- Farezone — slett data ---- *@
    <MudPaper Class="pa-4 mt-6" Elevation="1" Style="max-width:680px; border:1px solid #E76F51;">
        <MudExpansionPanel Text="Farezone — slett data" Style="background:transparent;">
            <ChildContent>
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    Sletter ALL importert data for dette anlegget — settlement-imports,
                    klassifiserte events, SCADA-samples, annoteringer og rapport-blobs.
                    Plant-raden, signal_map og kapasitets-konfigurasjon beholdes.
                    <strong>Kan ikke angres.</strong>
                </MudAlert>
                <MudTextField @bind-Value="_resetConfirmText"
                              Label="@($"Skriv plant-id ({PlantId}) for å bekrefte")"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" />
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           OnClick="OnResetAsync"
                           Disabled="@(_resetting || !string.Equals(_resetConfirmText, PlantId, StringComparison.Ordinal))"
                           Class="mt-3">
                    @(_resetting ? "Sletter…" : "Slett all data")
                </MudButton>

                @if (_resetResult is not null)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">
                        Slettet: @_resetResult.ImportsDeleted imports, @_resetResult.ReportsDeleted rapporter,
                        @_resetResult.EventsDeleted events, @_resetResult.SamplesDeleted samples,
                        @_resetResult.AnnotationsDeleted annoteringer.
                    </MudAlert>
                }
                @if (_resetError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">@_resetError</MudAlert>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudPaper>
}

<style>
    .diag-key-value {
        font-size: 0.9em;
        width: 100%;
        border-collapse: collapse;
    }
    .diag-key-value th {
        text-align: left;
        padding: 8px 12px 8px 0;
        vertical-align: top;
        color: var(--mud-palette-text-secondary);
        font-weight: 400;
        white-space: nowrap;
    }
    .diag-key-value td {
        padding: 8px 0;
        word-break: break-all;
    }
</style>

@code {
    [Parameter] public string PlantId { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _saving;
    private string? _loadError;
    private string? _saveError;
    private FormModel? _form;

    // Reset-state (egen seksjon)
    private string _resetConfirmText = string.Empty;
    private bool _resetting;
    private string? _resetError;
    private ResetResultDto? _resetResult;

    // Dam-state (egen seksjon)
    private List<DamDto>? _dams;
    private DamDto? _editingDam;
    private bool _editingDamOpen;
    private DamEditForm _editForm = new();
    private bool _damSaving;
    private string? _damSaveError;

    // Add-dam state
    private bool _addingDamOpen;
    private DamAddForm _addForm = new();

    // Overflow-mapping (signal-map for OverflowFlow på terminal-dam)
    private List<SignalMapDto>? _overflowMappings;
    private List<ScadaTagDto>? _scadaTags;
    private string? _overflowTagPick;
    private bool _overflowSaving;
    private string? _overflowError;

    // DataSourceExpectations-state (SPEC-IMPORT-COMPLETENESS steg 7)
    private List<DataSourceExpectationDto>? _expectations;
    private bool _expSaving;
    private string? _expSaveError;
    private static readonly string[] _sourceTypes = new[]
    {
        "settlement", "scada", "operlog"
    };

    private sealed class DamEditForm
    {
        public string Name { get; set; } = string.Empty;
        public int CascadePosition { get; set; } = 1;
        public bool IsTurbineIntake { get; set; }
        public double? HrvMoh { get; set; }
        public double? LrvMoh { get; set; }
        public double? VolumeMm3 { get; set; }
        public int? OverflowProxyThresholdCm { get; set; }
    }

    private sealed class DamAddForm
    {
        public string DamId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int CascadePosition { get; set; } = 1;
        public bool IsTurbineIntake { get; set; }
        public double? HrvMoh { get; set; }
        public double? LrvMoh { get; set; }
        public double? VolumeMm3 { get; set; }
        public int? OverflowProxyThresholdCm { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        Filter.OnChange += OnFilterChanged;

        // Sync FilterState med URL slik at AppBar viser riktig anlegg.
        if (!string.IsNullOrEmpty(PlantId) && PlantId != Filter.PlantId)
        {
            Filter.PlantId = PlantId;
        }

        try
        {
            var plant = await Api.GetPlantAsync(PlantId);
            if (plant is null)
            {
                _loadError = $"Anlegget '{PlantId}' eksisterer ikke.";
            }
            else
            {
                _form = new FormModel
                {
                    Name = plant.Name,
                    Type = plant.Type,
                    InstalledCapacityMw = plant.InstalledCapacityMw,
                    TimeZone = plant.TimeZone,
                    DeratingThreshold = plant.DeratingThreshold ?? 0.80,
                    NormalAarsproduksjonGwh = plant.NormalAarsproduksjonGwh,
                };
            }
            await ReloadDamsAsync();
            await ReloadExpectationsAsync();
            await ReloadOverflowMappingAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Kunne ikke hente anlegg: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        Filter.OnChange -= OnFilterChanged;
    }

    private void OnFilterChanged()
    {
        // Når brukeren bytter anlegg via global velger, naviger til den nye
        // adminsiden — periode-endringer påvirker ikke denne siden.
        if (!string.IsNullOrEmpty(Filter.PlantId) && Filter.PlantId != PlantId)
        {
            Nav.NavigateTo($"plants/{Filter.PlantId}/admin");
        }
    }

    private async Task ReloadDamsAsync()
    {
        try
        {
            var rows = await Api.ListDamsAsync(PlantId);
            _dams = rows.ToList();
        }
        catch (Exception ex)
        {
            _damSaveError = $"Kunne ikke hente dammer: {ex.Message}";
            _dams = new();
        }
    }

    private async Task ReloadExpectationsAsync()
    {
        try
        {
            var rows = await NedetidApi.ListExpectationsAsync(PlantId);
            _expectations = rows.ToList();
        }
        catch (Exception ex)
        {
            _expSaveError = $"Kunne ikke hente forventninger: {ex.Message}";
            _expectations = new();
        }
    }

    private async Task OnToggleExpectationAsync(string sourceType, bool newActive, DataSourceExpectationDto? current)
    {
        _expSaving = true;
        _expSaveError = null;
        try
        {
            var lag = current?.ExpectedLagDays ?? DefaultLagFor(sourceType);
            var threshold = current?.CompletionThresholdPct ?? DefaultThresholdFor(sourceType);
            await NedetidApi.UpsertExpectationAsync(
                PlantId, sourceType, newActive, lag,
                completionThresholdPct: threshold);
            Snackbar.Add(newActive ? $"{FormatSourceType(sourceType)} aktivert"
                                   : $"{FormatSourceType(sourceType)} deaktivert",
                         Severity.Success);
            await ReloadExpectationsAsync();
        }
        catch (Exception ex)
        {
            _expSaveError = $"Kunne ikke lagre: {ex.Message}";
        }
        finally
        {
            _expSaving = false;
        }
    }

    private async Task OnLagChangedAsync(string sourceType, int newLag, DataSourceExpectationDto? current)
    {
        if (current is null || current.ExpectedLagDays == newLag) return;
        _expSaving = true;
        _expSaveError = null;
        try
        {
            await NedetidApi.UpsertExpectationAsync(
                PlantId, sourceType, current.IsActive, newLag,
                completionThresholdPct: current.CompletionThresholdPct);
            await ReloadExpectationsAsync();
        }
        catch (Exception ex)
        {
            _expSaveError = $"Kunne ikke lagre: {ex.Message}";
        }
        finally
        {
            _expSaving = false;
        }
    }

    private async Task OnThresholdChangedAsync(string sourceType, double newThreshold, DataSourceExpectationDto? current)
    {
        if (current is null || Math.Abs(current.CompletionThresholdPct - newThreshold) < 0.005) return;
        _expSaving = true;
        _expSaveError = null;
        try
        {
            await NedetidApi.UpsertExpectationAsync(
                PlantId, sourceType, current.IsActive, current.ExpectedLagDays,
                completionThresholdPct: newThreshold);
            await ReloadExpectationsAsync();
            Snackbar.Add($"{FormatSourceType(sourceType)}: komplett-grense satt til {newThreshold:P0}", Severity.Success);
        }
        catch (Exception ex)
        {
            _expSaveError = $"Kunne ikke lagre: {ex.Message}";
        }
        finally
        {
            _expSaving = false;
        }
    }

    private static int DefaultLagFor(string sourceType) => sourceType switch
    {
        "settlement" => 7,
        "scada" => 5,
        "operlog" => 5,
        _ => 7,
    };

    private static double DefaultThresholdFor(string sourceType) => sourceType switch
    {
        "settlement" => 0.95,
        "scada" => 0.80,
        "operlog" => 0.95,
        _ => 0.95,
    };

    private static string FormatSourceType(string sourceType) => sourceType switch
    {
        "settlement" => "Settlement (KAIA)",
        "scada" => "SCADA trender",
        "operlog" => "SCADA alarmer",
        _ => sourceType,
    };

    private static string SourceTypeDescription(string sourceType) => sourceType switch
    {
        "settlement" => "KAIA-eksport (.xlsx) — inkluderer Hydrogrid-plan",
        "scada" => "SCADA master-CSV (tidsserier)",
        "operlog" => "SCADA operator-log (alarmer / events)",
        _ => "",
    };

    private Task OpenEditDamAsync(DamDto dam)
    {
        _editingDam = dam;
        _editForm = new DamEditForm
        {
            Name = dam.Name,
            CascadePosition = dam.CascadePosition,
            IsTurbineIntake = dam.IsTurbineIntake,
            HrvMoh = dam.HrvMoh,
            LrvMoh = dam.LrvMoh,
            VolumeMm3 = dam.VolumeMm3,
            OverflowProxyThresholdCm = dam.OverflowProxyThresholdCm,
        };
        _editingDamOpen = true;
        return Task.CompletedTask;
    }

    private async Task OnDamSaveAsync()
    {
        if (_editingDam is null) return;
        _damSaving = true;
        _damSaveError = null;
        try
        {
            var body = new UpdateDamRequestDto(
                Name: _editForm.Name,
                CascadePosition: _editForm.CascadePosition,
                IsTurbineIntake: _editForm.IsTurbineIntake,
                HrvMoh: _editForm.HrvMoh,
                LrvMoh: _editForm.LrvMoh,
                VolumeMm3: _editForm.VolumeMm3,
                OverflowProxyThresholdCm: _editForm.OverflowProxyThresholdCm);
            await Api.UpdateDamAsync(PlantId, _editingDam.DamId, body);
            Snackbar.Add($"{_editForm.Name} oppdatert.", Severity.Success);
            _editingDamOpen = false;
            await ReloadDamsAsync();
            await ReloadOverflowMappingAsync();
        }
        catch (HttpRequestException ex)
        {
            _damSaveError = $"Lagring feilet: {ex.Message}";
        }
        catch (Exception ex)
        {
            _damSaveError = $"Uventet feil: {ex.Message}";
        }
        finally
        {
            _damSaving = false;
        }
    }

    private void OpenAddDam()
    {
        var nextPosition = (_dams?.Max(d => (int?)d.CascadePosition) ?? 0) + 1;
        _addForm = new DamAddForm { CascadePosition = nextPosition };
        _addingDamOpen = true;
    }

    private async Task OnDamCreateAsync()
    {
        _damSaving = true;
        _damSaveError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_addForm.DamId) || string.IsNullOrWhiteSpace(_addForm.Name))
            {
                _damSaveError = "DamId og Navn er påkrevd.";
                return;
            }
            var body = new CreateDamRequestDto(
                DamId: _addForm.DamId.Trim(),
                Name: _addForm.Name.Trim(),
                CascadePosition: _addForm.CascadePosition,
                IsTurbineIntake: _addForm.IsTurbineIntake,
                HrvMoh: _addForm.HrvMoh,
                LrvMoh: _addForm.LrvMoh,
                VolumeMm3: _addForm.VolumeMm3,
                OverflowProxyThresholdCm: _addForm.OverflowProxyThresholdCm);
            await Api.CreateDamAsync(PlantId, body);
            Snackbar.Add($"{_addForm.Name} opprettet.", Severity.Success);
            _addingDamOpen = false;
            await ReloadDamsAsync();
        }
        catch (HttpRequestException ex)
        {
            _damSaveError = $"Opprettelse feilet: {ex.Message}";
        }
        catch (Exception ex)
        {
            _damSaveError = $"Uventet feil: {ex.Message}";
        }
        finally
        {
            _damSaving = false;
        }
    }

    private async Task OnDeleteDamAsync(DamDto dam)
    {
        _damSaveError = null;
        try
        {
            await Api.DeleteDamAsync(PlantId, dam.DamId);
            Snackbar.Add($"{dam.Name} slettet.", Severity.Success);
            await ReloadDamsAsync();
            await ReloadOverflowMappingAsync();
        }
        catch (HttpRequestException ex)
        {
            _damSaveError = $"Sletting feilet: {ex.Message}";
        }
        catch (Exception ex)
        {
            _damSaveError = $"Uventet feil: {ex.Message}";
        }
    }

    private async Task ReloadOverflowMappingAsync()
    {
        try
        {
            var maps = await Api.ListSignalMapsAsync(PlantId, role: "OverflowFlow");
            _overflowMappings = maps.ToList();
            var tags = await Api.ListScadaTagsAsync(PlantId);
            _scadaTags = tags.ToList();
            // Pre-fyll dropdown med eksisterende mapping hvis terminal-dam har en
            var terminal = _dams?.FirstOrDefault(d => d.IsTurbineIntake);
            var current = _overflowMappings.FirstOrDefault(m => m.DamId == terminal?.DamId);
            _overflowTagPick = current?.SignalId;
        }
        catch (Exception ex)
        {
            _overflowError = $"Kunne ikke laste overflow-mapping: {ex.Message}";
        }
    }

    private Task<IEnumerable<string>> SearchOverflowTags(string? value, CancellationToken ct = default)
    {
        IEnumerable<string> result;
        if (_scadaTags is null)
        {
            result = Array.Empty<string>();
        }
        else if (string.IsNullOrWhiteSpace(value))
        {
            // Default: vis tags som inneholder OVERLOP/OVERFLOW/FLOM
            result = _scadaTags
                .Where(t => t.SignalId.Contains("OVERLOP", StringComparison.OrdinalIgnoreCase)
                         || t.SignalId.Contains("OVERFLOW", StringComparison.OrdinalIgnoreCase)
                         || t.SignalId.Contains("FLOM", StringComparison.OrdinalIgnoreCase))
                .Select(t => t.SignalId)
                .Take(50);
        }
        else
        {
            result = _scadaTags
                .Where(t => t.SignalId.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Select(t => t.SignalId)
                .Take(50);
        }
        return Task.FromResult(result);
    }

    private async Task OnOverflowMapAsync()
    {
        var terminal = _dams?.FirstOrDefault(d => d.IsTurbineIntake);
        if (terminal is null || string.IsNullOrEmpty(_overflowTagPick))
        {
            _overflowError = "Velg en tag og sett en terminal-dam først.";
            return;
        }
        _overflowSaving = true;
        _overflowError = null;
        try
        {
            // Fjern eventuell eksisterende OverflowFlow-mapping for terminal-dam
            // (én aktiv tag per dam-rolle for å unngå konflikter)
            if (_overflowMappings is not null)
            {
                foreach (var existing in _overflowMappings.Where(m =>
                    m.DamId == terminal.DamId && m.SignalId != _overflowTagPick))
                {
                    await Api.DeleteSignalMapAsync(PlantId, existing.SignalId);
                }
            }
            var body = new UpsertSignalMapRequestDto(
                SignalId: _overflowTagPick,
                CsvColumn: $"Value (Cluster1.{_overflowTagPick})", // best-guess; importør oppdaterer ved neste import
                Unit: "m3/s",
                Role: "OverflowFlow",
                DamId: terminal.DamId,
                StoreSamples: true,
                IsActive: true);
            await Api.UpsertSignalMapAsync(PlantId, body);
            Snackbar.Add($"Overflow-tag mappet til {terminal.Name}.", Severity.Success);
            await ReloadOverflowMappingAsync();
        }
        catch (HttpRequestException ex)
        {
            _overflowError = $"Mapping feilet: {ex.Message}";
        }
        catch (Exception ex)
        {
            _overflowError = $"Uventet feil: {ex.Message}";
        }
        finally
        {
            _overflowSaving = false;
        }
    }

    private async Task OnOverflowClearAsync()
    {
        var terminal = _dams?.FirstOrDefault(d => d.IsTurbineIntake);
        if (terminal is null || _overflowMappings is null) return;
        _overflowSaving = true;
        _overflowError = null;
        try
        {
            foreach (var existing in _overflowMappings.Where(m => m.DamId == terminal.DamId))
            {
                await Api.DeleteSignalMapAsync(PlantId, existing.SignalId);
            }
            Snackbar.Add("Overflow-mapping fjernet.", Severity.Info);
            _overflowTagPick = null;
            await ReloadOverflowMappingAsync();
        }
        catch (Exception ex)
        {
            _overflowError = $"Sletting feilet: {ex.Message}";
        }
        finally
        {
            _overflowSaving = false;
        }
    }

    private async Task OnSaveAsync()
    {
        if (_form is null) return;
        _saving = true;
        _saveError = null;
        try
        {
            var body = new UpdatePlantRequest(
                _form.Name, _form.Type, _form.InstalledCapacityMw, _form.TimeZone,
                DeratingThreshold: _form.DeratingThreshold,
                NormalAarsproduksjonGwh: _form.NormalAarsproduksjonGwh);
            await Api.UpdatePlantAsync(PlantId, body);
            Snackbar.Add($"{_form.Name} oppdatert.", Severity.Success);
            Nav.NavigateTo("/plants");
        }
        catch (HttpRequestException ex)
        {
            _saveError = $"Lagring feilet: {ex.Message}";
            Snackbar.Add(_saveError, Severity.Error);
        }
        catch (Exception ex)
        {
            _saveError = $"Uventet feil: {ex.Message}";
            Snackbar.Add(_saveError, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnResetAsync()
    {
        if (!string.Equals(_resetConfirmText, PlantId, StringComparison.Ordinal)) return;
        _resetting = true;
        _resetError = null;
        _resetResult = null;
        try
        {
            _resetResult = await Api.ResetPlantDataAsync(PlantId, _resetConfirmText);
            Snackbar.Add($"All data slettet for {PlantId}.", Severity.Success);
            _resetConfirmText = string.Empty;
        }
        catch (HttpRequestException ex)
        {
            _resetError = $"Sletting feilet: {ex.Message}";
            Snackbar.Add(_resetError, Severity.Error);
        }
        catch (Exception ex)
        {
            _resetError = $"Uventet feil: {ex.Message}";
            Snackbar.Add(_resetError, Severity.Error);
        }
        finally
        {
            _resetting = false;
        }
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = "Regulated";
        public double InstalledCapacityMw { get; set; }
        public string TimeZone { get; set; } = "Europe/Oslo";
        public double DeratingThreshold { get; set; } = 0.80;
        public double? NormalAarsproduksjonGwh { get; set; }
    }
}
