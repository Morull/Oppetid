@page "/plants/{PlantId}/admin"
@inject ReportsApi Api
@inject NedetidApi NedetidApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@($"Admin: {_form?.Name ?? PlantId}")</PageTitle>

<MudGrid Class="mb-4">
    <MudItem xs="12">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/plants" Class="mb-2">
            Tilbake til anlegg
        </MudButton>
        <MudText Typo="Typo.h1">Admin: @PlantId</MudText>
        <MudText Typo="Typo.subtitle1" Color="MudBlazor.Color.Secondary">
            Oppdater kanonisk navn, type, installert effekt og tidssone for anlegget.
            Brukes typisk for å fylle inn <strong>InstalledCapacityMw</strong> for nye
            auto-opprettede anlegg.
        </MudText>
    </MudItem>
</MudGrid>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2 d-inline">Henter…</MudText>
}
else if (_form is null)
{
    <MudAlert Severity="Severity.Error">@(_loadError ?? "Anlegget ble ikke funnet.")</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width:680px;">
        <MudStack Spacing="3">
            <MudTextField Label="Plant-ID" Value="@PlantId" Disabled="true"
                          Variant="Variant.Outlined"
                          HelperText="Slug-en endres ikke. Slett og opprett på nytt for ny ID." />

            <MudTextField @bind-Value="_form.Name" Label="Navn (kanonisk, med æ/ø/å)"
                          Required="true" Variant="Variant.Outlined" />

            <MudSelect T="string" @bind-Value="_form.Type" Label="Type"
                       Variant="Variant.Outlined" Required="true">
                <MudSelectItem Value="@("Regulated")">Regulated (magasinkraft)</MudSelectItem>
                <MudSelectItem Value="@("RunOfRiver")">RunOfRiver (elvekraft)</MudSelectItem>
                <MudSelectItem Value="@("Mixed")">Mixed (kombinasjon)</MudSelectItem>
                <MudSelectItem Value="@("Pumped")">Pumped (pumpekraft)</MudSelectItem>
            </MudSelect>

            <MudNumericField T="double" @bind-Value="_form.InstalledCapacityMw"
                             Label="Installert effekt (MW)"
                             Min="0" Max="1000" Step="0.1" Format="F2"
                             Required="true" Variant="Variant.Outlined"
                             HelperText="0 = krever oppsett. Vakt-ROI gir 0 NOK for anlegg uten kapasitet." />

            <MudTextField @bind-Value="_form.TimeZone" Label="Tidssone (IANA)"
                          Required="true" Variant="Variant.Outlined"
                          HelperText="F.eks. Europe/Oslo. Påvirker DST-tolkning av settlement-data." />

            <MudNumericField T="double" @bind-Value="_form.DeratingThreshold"
                             Label="Plan-avviks-terskel"
                             Min="0.10" Max="1.0" Step="0.05" Format="F2"
                             Required="true" Variant="Variant.Outlined"
                             HelperText="@($"Elhub < {(_form.DeratingThreshold * 100):F0} % av Plan klassifiseres som feil (ForcedDerating). Default 0.80 = avvik > 20 % gir feil.")" />

            <div class="d-flex justify-end" style="gap:8px;">
                <MudButton Variant="Variant.Text" Href="/plants">Avbryt</MudButton>
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="OnSaveAsync" Disabled="@_saving">
                    @(_saving ? "Lagrer…" : "Lagre")
                </MudButton>
            </div>

            @if (_saveError is not null)
            {
                <MudAlert Severity="Severity.Error">@_saveError</MudAlert>
            }
        </MudStack>
    </MudPaper>

    @* ---- Dammer (kaskade-modell) ---- *@
    <MudPaper Class="pa-4 mt-6" Elevation="1" Style="max-width:880px;">
        <MudText Typo="Typo.h3" Class="mb-2">Dammer (kaskade-modell)</MudText>
        <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
            Hvert anlegg har én eller flere dammer. <strong>Terminal-dam</strong>
            (siste før turbin) er den eneste hvor overløp koster produksjon —
            øvre dammer renner videre i kaskaden. HRV/LRV/Volum brukes til
            magasinstand-visualisering og fremtidig vannverdi-modell.
        </MudText>

        @if (_dams is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_dams.Count == 0)
        {
            <MudAlert Severity="Severity.Warning">
                Ingen dammer registrert. Backfill skal ha opprettet en default-dam — sjekk at
                bootstrap-skjema-broen kjørte ved oppstart.
            </MudAlert>
        }
        else
        {
            <MudTable Items="_dams" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Dam</MudTh>
                    <MudTh Style="text-align:center">Kaskade-posisjon</MudTh>
                    <MudTh Style="text-align:center">Terminal</MudTh>
                    <MudTh Style="text-align:right">HRV (moh)</MudTh>
                    <MudTh Style="text-align:right">LRV (moh)</MudTh>
                    <MudTh Style="text-align:right">Volum (Mill.m³)</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <strong>@context.Name</strong>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@context.DamId</MudText>
                    </MudTd>
                    <MudTd Style="text-align:center">@context.CascadePosition</MudTd>
                    <MudTd Style="text-align:center">
                        @if (context.IsTurbineIntake)
                        {
                            <MudChip T="string" Size="MudBlazor.Size.Small"
                                     Color="MudBlazor.Color.Primary" Icon="@Icons.Material.Filled.Bolt">Terminal</MudChip>
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">@(context.HrvMoh?.ToString("F1") ?? "–")</MudTd>
                    <MudTd Style="text-align:right">@(context.LrvMoh?.ToString("F1") ?? "–")</MudTd>
                    <MudTd Style="text-align:right">@(context.VolumeMm3?.ToString("F2") ?? "–")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="MudBlazor.Size.Small"
                                       OnClick="@(() => OpenEditDamAsync(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_damSaveError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_damSaveError</MudAlert>
        }
    </MudPaper>

    @* ---- Edit-dialog for dam ---- *@
    @if (_editingDam is not null)
    {
        <MudDialog @bind-Visible="_editingDamOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
            <TitleContent>Rediger @_editingDam.Name</TitleContent>
            <DialogContent>
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_editForm.Name" Label="Navn" Variant="Variant.Outlined" />
                    <MudNumericField T="int" @bind-Value="_editForm.CascadePosition"
                                     Label="Kaskade-posisjon (1=øverst)" Min="1" Max="10"
                                     Variant="Variant.Outlined" />
                    <MudCheckBox T="bool" @bind-Value="_editForm.IsTurbineIntake"
                                 Label="Terminal-dam (siste før turbin)" />
                    <MudNumericField T="double?" @bind-Value="_editForm.HrvMoh"
                                     Label="HRV (moh)" Step="0.1" Format="F1"
                                     HelperText="Høyeste regulerte vannstand. Hentes fra konsesjonsdokumenter."
                                     Variant="Variant.Outlined" />
                    <MudNumericField T="double?" @bind-Value="_editForm.LrvMoh"
                                     Label="LRV (moh)" Step="0.1" Format="F1"
                                     HelperText="Laveste regulerte vannstand."
                                     Variant="Variant.Outlined" />
                    <MudNumericField T="double?" @bind-Value="_editForm.VolumeMm3"
                                     Label="Volum (Mill.m³)" Step="0.01" Format="F2"
                                     HelperText="Magasin-volum mellom HRV og LRV."
                                     Variant="Variant.Outlined" />
                </MudStack>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _editingDamOpen = false)">Avbryt</MudButton>
                <MudButton Color="MudBlazor.Color.Primary" Variant="Variant.Filled"
                           OnClick="OnDamSaveAsync" Disabled="@_damSaving">
                    @(_damSaving ? "Lagrer…" : "Lagre")
                </MudButton>
            </DialogActions>
        </MudDialog>
    }

    @* ---- Forventede datakilder (SPEC-IMPORT-COMPLETENESS) ---- *@
    <MudPaper Class="pa-4 mt-6" Elevation="1" Style="max-width:880px;">
        <MudText Typo="Typo.h3" Class="mb-2">Forventede datakilder</MudText>
        <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="mb-3">
            Toggle hvilke datakilder anlegget skal forvente, og hvor mange dager
            etter periode-slutt vi flagger en manglende import som forfalt.
            Endringer trer i kraft umiddelbart i <MudLink Href="/data-status">data-status</MudLink>-matrisen.
        </MudText>

        @if (_expectations is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudTable Items="_sourceTypes" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Kilde</MudTh>
                    <MudTh Style="text-align:center">Aktiv</MudTh>
                    <MudTh Style="text-align:right">Lag (dager)</MudTh>
                    <MudTh Style="text-align:right">Komplett-grense (%)</MudTh>
                    <MudTh>Aktivert</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var current = _expectations.FirstOrDefault(e => e.SourceType == context);
                    }
                    <MudTd>
                        <strong>@FormatSourceType(context)</strong>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                            @SourceTypeDescription(context)
                        </MudText>
                    </MudTd>
                    <MudTd Style="text-align:center">
                        <MudSwitch T="bool" Value="@(current?.IsActive ?? false)"
                                   Color="MudBlazor.Color.Success"
                                   ValueChanged="async (bool v) => await OnToggleExpectationAsync(context, v, current)"
                                   Disabled="@_expSaving" />
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudNumericField T="int" Value="@(current?.ExpectedLagDays ?? DefaultLagFor(context))"
                                         ValueChanged="async (int v) => await OnLagChangedAsync(context, v, current)"
                                         Min="0" Max="90" Step="1"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Style="width:80px;"
                                         Disabled="@_expSaving" />
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudNumericField T="int" Value="@((int)Math.Round((current?.CompletionThresholdPct ?? DefaultThresholdFor(context)) * 100))"
                                         ValueChanged="async (int v) => await OnThresholdChangedAsync(context, v / 100.0, current)"
                                         Min="0" Max="100" Step="5"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Style="width:90px;"
                                         Disabled="@_expSaving" />
                    </MudTd>
                    <MudTd>
                        @if (current?.ActivatedAtUtc is { } activated)
                        {
                            <MudText Typo="Typo.caption">@activated.LocalDateTime.ToString("yyyy-MM-dd")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">—</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary" Class="mt-1">
                <strong>Lag</strong> = antall dager etter periode-slutt før manglende data flagges som forfalt.
                <strong>Komplett-grense</strong> = nødvendig dekning (%) for at en periode regnes som komplett.
                Lavere verdi gir mer "grønt" — egnet for SCADA der eksporter har naturlig hull.
            </MudText>

            @if (_expSaveError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_expSaveError</MudAlert>
            }
        }
    </MudPaper>

    @* ---- Farezone — slett data ---- *@
    <MudPaper Class="pa-4 mt-6" Elevation="1" Style="max-width:680px; border:1px solid #E76F51;">
        <MudExpansionPanel Text="Farezone — slett data" Style="background:transparent;">
            <ChildContent>
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    Sletter ALL importert data for dette anlegget — settlement-imports,
                    klassifiserte events, SCADA-samples, annoteringer og rapport-blobs.
                    Plant-raden, signal_map og kapasitets-konfigurasjon beholdes.
                    <strong>Kan ikke angres.</strong>
                </MudAlert>
                <MudTextField @bind-Value="_resetConfirmText"
                              Label="@($"Skriv plant-id ({PlantId}) for å bekrefte")"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" />
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           OnClick="OnResetAsync"
                           Disabled="@(_resetting || !string.Equals(_resetConfirmText, PlantId, StringComparison.Ordinal))"
                           Class="mt-3">
                    @(_resetting ? "Sletter…" : "Slett all data")
                </MudButton>

                @if (_resetResult is not null)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">
                        Slettet: @_resetResult.ImportsDeleted imports, @_resetResult.ReportsDeleted rapporter,
                        @_resetResult.EventsDeleted events, @_resetResult.SamplesDeleted samples,
                        @_resetResult.AnnotationsDeleted annoteringer.
                    </MudAlert>
                }
                @if (_resetError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">@_resetError</MudAlert>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudPaper>
}

@code {
    [Parameter] public string PlantId { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _saving;
    private string? _loadError;
    private string? _saveError;
    private FormModel? _form;

    // Reset-state (egen seksjon)
    private string _resetConfirmText = string.Empty;
    private bool _resetting;
    private string? _resetError;
    private ResetResultDto? _resetResult;

    // Dam-state (egen seksjon)
    private List<DamDto>? _dams;
    private DamDto? _editingDam;
    private bool _editingDamOpen;
    private DamEditForm _editForm = new();
    private bool _damSaving;
    private string? _damSaveError;

    // DataSourceExpectations-state (SPEC-IMPORT-COMPLETENESS steg 7)
    private List<DataSourceExpectationDto>? _expectations;
    private bool _expSaving;
    private string? _expSaveError;
    private static readonly string[] _sourceTypes = new[]
    {
        "settlement", "scada", "operlog"
    };

    private sealed class DamEditForm
    {
        public string Name { get; set; } = string.Empty;
        public int CascadePosition { get; set; } = 1;
        public bool IsTurbineIntake { get; set; }
        public double? HrvMoh { get; set; }
        public double? LrvMoh { get; set; }
        public double? VolumeMm3 { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var plant = await Api.GetPlantAsync(PlantId);
            if (plant is null)
            {
                _loadError = $"Anlegget '{PlantId}' eksisterer ikke.";
            }
            else
            {
                _form = new FormModel
                {
                    Name = plant.Name,
                    Type = plant.Type,
                    InstalledCapacityMw = plant.InstalledCapacityMw,
                    TimeZone = plant.TimeZone,
                    DeratingThreshold = plant.DeratingThreshold ?? 0.80,
                };
            }
            await ReloadDamsAsync();
            await ReloadExpectationsAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Kunne ikke hente anlegg: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadDamsAsync()
    {
        try
        {
            var rows = await Api.ListDamsAsync(PlantId);
            _dams = rows.ToList();
        }
        catch (Exception ex)
        {
            _damSaveError = $"Kunne ikke hente dammer: {ex.Message}";
            _dams = new();
        }
    }

    private async Task ReloadExpectationsAsync()
    {
        try
        {
            var rows = await NedetidApi.ListExpectationsAsync(PlantId);
            _expectations = rows.ToList();
        }
        catch (Exception ex)
        {
            _expSaveError = $"Kunne ikke hente forventninger: {ex.Message}";
            _expectations = new();
        }
    }

    private async Task OnToggleExpectationAsync(string sourceType, bool newActive, DataSourceExpectationDto? current)
    {
        _expSaving = true;
        _expSaveError = null;
        try
        {
            var lag = current?.ExpectedLagDays ?? DefaultLagFor(sourceType);
            var threshold = current?.CompletionThresholdPct ?? DefaultThresholdFor(sourceType);
            await NedetidApi.UpsertExpectationAsync(
                PlantId, sourceType, newActive, lag,
                completionThresholdPct: threshold);
            Snackbar.Add(newActive ? $"{FormatSourceType(sourceType)} aktivert"
                                   : $"{FormatSourceType(sourceType)} deaktivert",
                         Severity.Success);
            await ReloadExpectationsAsync();
        }
        catch (Exception ex)
        {
            _expSaveError = $"Kunne ikke lagre: {ex.Message}";
        }
        finally
        {
            _expSaving = false;
        }
    }

    private async Task OnLagChangedAsync(string sourceType, int newLag, DataSourceExpectationDto? current)
    {
        if (current is null || current.ExpectedLagDays == newLag) return;
        _expSaving = true;
        _expSaveError = null;
        try
        {
            await NedetidApi.UpsertExpectationAsync(
                PlantId, sourceType, current.IsActive, newLag,
                completionThresholdPct: current.CompletionThresholdPct);
            await ReloadExpectationsAsync();
        }
        catch (Exception ex)
        {
            _expSaveError = $"Kunne ikke lagre: {ex.Message}";
        }
        finally
        {
            _expSaving = false;
        }
    }

    private async Task OnThresholdChangedAsync(string sourceType, double newThreshold, DataSourceExpectationDto? current)
    {
        if (current is null || Math.Abs(current.CompletionThresholdPct - newThreshold) < 0.005) return;
        _expSaving = true;
        _expSaveError = null;
        try
        {
            await NedetidApi.UpsertExpectationAsync(
                PlantId, sourceType, current.IsActive, current.ExpectedLagDays,
                completionThresholdPct: newThreshold);
            await ReloadExpectationsAsync();
            Snackbar.Add($"{FormatSourceType(sourceType)}: komplett-grense satt til {newThreshold:P0}", Severity.Success);
        }
        catch (Exception ex)
        {
            _expSaveError = $"Kunne ikke lagre: {ex.Message}";
        }
        finally
        {
            _expSaving = false;
        }
    }

    private static int DefaultLagFor(string sourceType) => sourceType switch
    {
        "settlement" => 7,
        "scada" => 5,
        "operlog" => 5,
        _ => 7,
    };

    private static double DefaultThresholdFor(string sourceType) => sourceType switch
    {
        "settlement" => 0.95,
        "scada" => 0.80,
        "operlog" => 0.95,
        _ => 0.95,
    };

    private static string FormatSourceType(string sourceType) => sourceType switch
    {
        "settlement" => "Settlement (KAIA)",
        "scada" => "SCADA trender",
        "operlog" => "SCADA alarmer",
        _ => sourceType,
    };

    private static string SourceTypeDescription(string sourceType) => sourceType switch
    {
        "settlement" => "KAIA-eksport (.xlsx) — inkluderer Hydrogrid-plan",
        "scada" => "SCADA master-CSV (tidsserier)",
        "operlog" => "SCADA operator-log (alarmer / events)",
        _ => "",
    };

    private Task OpenEditDamAsync(DamDto dam)
    {
        _editingDam = dam;
        _editForm = new DamEditForm
        {
            Name = dam.Name,
            CascadePosition = dam.CascadePosition,
            IsTurbineIntake = dam.IsTurbineIntake,
            HrvMoh = dam.HrvMoh,
            LrvMoh = dam.LrvMoh,
            VolumeMm3 = dam.VolumeMm3,
        };
        _editingDamOpen = true;
        return Task.CompletedTask;
    }

    private async Task OnDamSaveAsync()
    {
        if (_editingDam is null) return;
        _damSaving = true;
        _damSaveError = null;
        try
        {
            var body = new UpdateDamRequestDto(
                Name: _editForm.Name,
                CascadePosition: _editForm.CascadePosition,
                IsTurbineIntake: _editForm.IsTurbineIntake,
                HrvMoh: _editForm.HrvMoh,
                LrvMoh: _editForm.LrvMoh,
                VolumeMm3: _editForm.VolumeMm3);
            await Api.UpdateDamAsync(PlantId, _editingDam.DamId, body);
            Snackbar.Add($"{_editForm.Name} oppdatert.", Severity.Success);
            _editingDamOpen = false;
            await ReloadDamsAsync();
        }
        catch (HttpRequestException ex)
        {
            _damSaveError = $"Lagring feilet: {ex.Message}";
        }
        catch (Exception ex)
        {
            _damSaveError = $"Uventet feil: {ex.Message}";
        }
        finally
        {
            _damSaving = false;
        }
    }

    private async Task OnSaveAsync()
    {
        if (_form is null) return;
        _saving = true;
        _saveError = null;
        try
        {
            var body = new UpdatePlantRequest(
                _form.Name, _form.Type, _form.InstalledCapacityMw, _form.TimeZone,
                DeratingThreshold: _form.DeratingThreshold);
            await Api.UpdatePlantAsync(PlantId, body);
            Snackbar.Add($"{_form.Name} oppdatert.", Severity.Success);
            Nav.NavigateTo("/plants");
        }
        catch (HttpRequestException ex)
        {
            _saveError = $"Lagring feilet: {ex.Message}";
            Snackbar.Add(_saveError, Severity.Error);
        }
        catch (Exception ex)
        {
            _saveError = $"Uventet feil: {ex.Message}";
            Snackbar.Add(_saveError, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnResetAsync()
    {
        if (!string.Equals(_resetConfirmText, PlantId, StringComparison.Ordinal)) return;
        _resetting = true;
        _resetError = null;
        _resetResult = null;
        try
        {
            _resetResult = await Api.ResetPlantDataAsync(PlantId, _resetConfirmText);
            Snackbar.Add($"All data slettet for {PlantId}.", Severity.Success);
            _resetConfirmText = string.Empty;
        }
        catch (HttpRequestException ex)
        {
            _resetError = $"Sletting feilet: {ex.Message}";
            Snackbar.Add(_resetError, Severity.Error);
        }
        catch (Exception ex)
        {
            _resetError = $"Uventet feil: {ex.Message}";
            Snackbar.Add(_resetError, Severity.Error);
        }
        finally
        {
            _resetting = false;
        }
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = "Regulated";
        public double InstalledCapacityMw { get; set; }
        public string TimeZone { get; set; } = "Europe/Oslo";
        public double DeratingThreshold { get; set; } = 0.80;
    }
}
