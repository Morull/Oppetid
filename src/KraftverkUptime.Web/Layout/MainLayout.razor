@inherits LayoutComponentBase
@implements IDisposable
@inject IUserContextProvider UserContext
@inject FilterState Filter
@inject ReportsApi ReportsApi
@inject NavigationManager Nav

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="ToggleDrawer" />

        @* Dalane Kraft-logo i topp-baren. img-tag faller tilbake til tekst-versjon
           hvis logo-fila ikke er på plass i wwwroot/img/. Se LOGO-INSTALL.md for
           hvordan å laste ned PNG-en fra dalane-kraft.no. *@
        <a href="/" class="dk-brand">
            <img src="img/dalane-kraft-logo.png" alt="Dalane Kraft"
                 class="dk-brand-logo"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';" />
            <span class="dk-brand-fallback" style="display:none;">
                <span class="dk-brand-mark">D</span>
                <span class="dk-brand-text">DALANE&nbsp;KRAFT</span>
            </span>
        </a>
        <MudText Typo="Typo.body2" Class="ml-3 dk-app-name" Style="opacity:0.85;">Uptime</MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-2 dk-version">v1</MudChip>

        <MudSpacer />

        <MudTooltip Text="@(App?.IsDarkMode == true ? "Bytt til lyst tema" : "Bytt til mørkt tema")">
            <MudIconButton Color="Color.Inherit"
                           Icon="@(App?.IsDarkMode == true ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           OnClick="ToggleTheme" />
        </MudTooltip>

        <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                 Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 Dense="true">
            <ChildContent>
                <div style="padding: 12px 18px; min-width: 220px;">
                    <MudText Typo="Typo.caption" Style="text-transform:uppercase; letter-spacing:0.06em; color:var(--mud-palette-text-secondary);">Innlogget som</MudText>
                    <MudText Typo="Typo.body1" Class="mb-2" Style="font-weight:600;">@UserContext.UserId</MudText>
                    <MudText Typo="Typo.caption" Style="text-transform:uppercase; letter-spacing:0.06em; color:var(--mud-palette-text-secondary);">Organisasjon</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@UserContext.OrgId</MudText>
                    <MudText Typo="Typo.caption" Style="text-transform:uppercase; letter-spacing:0.06em; color:var(--mud-palette-text-secondary);">Roller</MudText>
                    <MudText Typo="Typo.body2">@(string.Join(", ", UserContext.Roles))</MudText>
                </div>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @* Global anlegg- + periode-velger som driver FilterState. Vises kun
           på sider som har nytte av den; sider som DataImport/Kategorier/Index
           kan velge å skjule via SuppressGlobalSelector-flagget under. *@
        @if (ShowGlobalSelector)
        {
            <AppBarPlantPeriodSelector />
        }

        @* MaxWidth styres per-side: tabelltunge rapport-sider (Portefølje,
           Produksjon, Vakt-ROI) får full bredde fordi de ellers tvinges til
           horisontal scroll på en wide-screen. Skjema- og detalj-sider beholder
           Large (~1280px) for behagelig lesbarhet. UI-gjennomgang 2026-05-20 tiltak 3. *@
        <MudContainer MaxWidth="@ContainerWidth" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] private App? App { get; set; }

    private bool _drawerOpen = true;

    // Sider hvor velgeren ikke gir mening (admin-sider, opplasting, etc.)
    // Resten viser velgeren — de fleste rapport-sider trenger plant + periode.
    // /reports er undertrykt fordi rapport-sidene bruker en egen
    // ReportPageSelector istedenfor den globale periodevelgeren (UI-gjennomgang
    // 2026-05-20 tiltak 4: granularitetsknapper og pil-stegning ga ingen
    // mening på en rapport-side hvor "perioden" er en spesifikk import).
    private static readonly HashSet<string> SuppressedPaths = new(StringComparer.OrdinalIgnoreCase)
    {
        "/data-import",
        "/data-status",
        "/admin/kategorier",
        "/upload",
        "/behandles",
    };

    // Prefix-match for suppressed paths — gjelder også sub-paths som
    // /reports/{plantId}/{key}.
    private static readonly string[] SuppressedPathPrefixes =
    {
        "/reports",
    };

    // Sider med brede tabeller som tjener på full bredde framfor 1280px-cap.
    // Match-stilen er prefix — gjelder også sub-paths som /vakt-roi/{plantId}.
    private static readonly string[] FullWidthPathPrefixes =
    {
        "/portefolje",
        "/produksjon",
        "/vakt-roi",
        "/nedetid",
        "/capture-rate",
        "/effektivitet",
        "/data-import",
    };

    private MaxWidth ContainerWidth
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            if (string.IsNullOrEmpty(path)) path = "/";
            foreach (var prefix in FullWidthPathPrefixes)
            {
                if (path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                {
                    return MaxWidth.False;
                }
            }
            return MaxWidth.Large;
        }
    }

    private bool ShowGlobalSelector
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            if (string.IsNullOrEmpty(path)) path = "/";
            // «/» er Oversikt-landingssiden som alltid viser «nå»-bildet
            // (inneværende måned + siste 7 dager) uavhengig av global periode —
            // den globale velgeren gir ingen mening der og skjules.
            if (path == "/") return false;
            // Eksakt-match for definerte unntak.
            if (SuppressedPaths.Contains(path)) return false;
            // Prefix-match for sub-paths som /reports/{plant}/{key}.
            foreach (var prefix in SuppressedPathPrefixes)
            {
                if (path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                {
                    return false;
                }
            }
            return true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;

        // Last persistert state først — så plant-listen. Rekkefølgen er valgt
        // slik at en eventuell URL-route-parameter kan overstyre persistert
        // PlantId i sidens egen OnInitialized.
        await Filter.LoadFromStorageAsync();

        try
        {
            var plants = await ReportsApi.ListPlantsAsync();
            Filter.SetPlants(plants);

            // Hvis ingen persistert state: sett default plant + forrige måned.
            if (string.IsNullOrEmpty(Filter.PlantId) && plants.Count > 0)
            {
                Filter.PlantId = plants[0].Id;
            }
            if (!Filter.FromDate.HasValue || !Filter.ToDate.HasValue)
            {
                // Default = Hittil i år (drifts-leder vil typisk se total-bildet
                // siden januar). Brukeren kan bytte til Måned/Kvartal/År etc.
                // via hurtigknappene i AppBarPlantPeriodSelector.
                var (from, to) = PeriodCalculator.HittilIAr(DateTime.Today);
                Filter.SetPeriod(from, to, PeriodGranularity.HittilIAr);
            }
        }
        catch
        {
            // Plant-lasting kan feile (API nede); UI viser tom velger,
            // men appen er fortsatt brukbar.
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Re-render slik at ShowGlobalSelector evalueres på nytt.
        StateHasChanged();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleTheme()
    {
        if (App is not null) await App.ToggleDarkMode();
    }
}
