@*
    Gjenbrukbart KPI-kort med innebygd info-ikon for å forklare hva tallet betyr.
    Klikk-bart info-ikon åpner popover med fullstendig forklaring (mer rom enn
    en tooltip på hover). Bruk gjenbrukes på Anlegg, Portefølje, Vakt-ROI osv.
*@

<MudPaper Class="pa-3 dk-kpi-card" Elevation="2" Style="@($"border-left: 4px solid {AccentColor}; position: relative;")">
    <div class="d-flex justify-space-between align-start" style="gap: 4px;">
        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@Label</MudText>
        @if (!string.IsNullOrWhiteSpace(InfoText))
        {
            <MudTooltip Arrow="true" Placement="Placement.Top">
                <TooltipContent>
                    <div style="max-width: 320px; padding: 4px 2px;">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; margin-bottom: 4px;">
                            @Label
                        </MudText>
                        <MudText Typo="Typo.body2">
                            @InfoText
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(InfoFormula))
                        {
                            <MudText Typo="Typo.caption" Style="margin-top: 6px; font-family: monospace; opacity: 0.85;">
                                @InfoFormula
                            </MudText>
                        }
                    </div>
                </TooltipContent>
                <ChildContent>
                    <MudIcon Icon="@Icons.Material.Outlined.Info"
                             Size="MudBlazor.Size.Small"
                             Style="cursor: help; color: var(--mud-palette-text-secondary); opacity: 0.6;" />
                </ChildContent>
            </MudTooltip>
        }
    </div>
    <MudText Typo="Typo.h4">@Value</MudText>
    @if (!string.IsNullOrWhiteSpace(SubText))
    {
        <MudText Typo="Typo.caption">@SubText</MudText>
    }
</MudPaper>

@code {
    /// <summary>Tittel som vises øverst i kortet.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Hovedverdi (allerede formatert som streng).</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    /// <summary>Hex-farge på venstre-rammen (markerer kategori).</summary>
    [Parameter] public string AccentColor { get; set; } = "#1E5F8E";

    /// <summary>Valgfri liten tekst under hovedverdien (eks. enhet eller kontekst).</summary>
    [Parameter] public string? SubText { get; set; }

    /// <summary>
    /// Forklaring som vises i info-tooltip. Hvis null/tom: ingen info-ikon.
    /// Hold til 1-3 setninger som forklarer hva tallet betyr og når det er
    /// viktig.
    /// </summary>
    [Parameter] public string? InfoText { get; set; }

    /// <summary>
    /// Valgfri formel/kilde-info som vises under InfoText i monospace.
    /// Eks: "AF = (timer i drift + planlagt revisjon) / totale timer".
    /// </summary>
    [Parameter] public string? InfoFormula { get; set; }
}
