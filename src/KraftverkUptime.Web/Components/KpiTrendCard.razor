@*
   Gjenbrukbart KPI-kort med trend-pil + endring-prosent vs. forrige periode.
   Tegnet farge-kodes etter HigherIsBetter:
     - HigherIsBetter=true:  oppgang grønn, nedgang rød (CR, AF, produksjon)
     - HigherIsBetter=false: oppgang rød,   nedgang grønn (FOR, nedetid, tap)

   Brukes på CaptureRate, Anlegg/{id}, Portefolje, Effektivitet for å gi
   drifts-leder umiddelbar visuell tilbakemelding uten å lete etter trend
   i grafer.
*@

<MudPaper Class="pa-4 h-100" Elevation="2" Style="@($"border-left: 4px solid {_accentColor};")">
    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@Label</MudText>
    <div class="d-flex align-baseline" style="gap:8px;">
        <MudText Typo="Typo.h3">@FormattedValue</MudText>
        @if (Unit is not null)
        {
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@Unit</MudText>
        }
    </div>
    @if (PreviousValue.HasValue)
    {
        <div class="d-flex align-center mt-1" style="gap:4px;">
            @if (_trendDir != TrendDir.Flat)
            {
                <MudIcon Icon="@_trendIcon" Color="@_trendColor" Size="MudBlazor.Size.Small" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.HorizontalRule" Color="MudBlazor.Color.Secondary" Size="MudBlazor.Size.Small" />
            }
            <MudText Typo="Typo.caption" Color="@_trendColor">
                @if (PreviousValue.Value == 0)
                {
                    @("ny")
                }
                else
                {
                    @($"{(_trendPct >= 0 ? "+" : "")}{_trendPct:F1} %")
                }
            </MudText>
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">vs forrige</MudText>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(SubText))
    {
        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@SubText</MudText>
    }
</MudPaper>

@code {
    /// <summary>Etikett over verdien — f.eks. "Capture rate".</summary>
    [Parameter] public string Label { get; set; } = string.Empty;

    /// <summary>Nåværende verdi som tall (formateres via Format).</summary>
    [Parameter] public double Value { get; set; }

    /// <summary>Verdi for forrige periode. Null = ingen sammenligning vises.</summary>
    [Parameter] public double? PreviousValue { get; set; }

    /// <summary>
    /// True for KPI-er der "høyere er bedre" (CR, AF, produksjon, capture-pris).
    /// False for KPI-er der "lavere er bedre" (FOR, nedetid, tap-NOK).
    /// </summary>
    [Parameter] public bool HigherIsBetter { get; set; } = true;

    /// <summary>Format-streng for verdien — f.eks. "F2", "N0", "F0". Default "F2".</summary>
    [Parameter] public string Format { get; set; } = "F2";

    /// <summary>Valgfri enhets-suffix (f.eks. "NOK/MWh", "%", "MWh").</summary>
    [Parameter] public string? Unit { get; set; }

    /// <summary>Vises under tallet hvis PreviousValue er null. F.eks. "siden start".</summary>
    [Parameter] public string? SubText { get; set; }

    /// <summary>
    /// Aksentfarge på venstre kant. Default "auto" = vurder fra trend
    /// (grønn for bedre, rød for verre, blå hvis ingen sammenligning).
    /// </summary>
    [Parameter] public string AccentColor { get; set; } = "auto";

    /// <summary>
    /// Hvis true, viser kortet "+" foran positive verdier (typisk for
    /// merverdi/saldo-tall som kan være negative).
    /// </summary>
    [Parameter] public bool SignedValue { get; set; }

    private enum TrendDir { Up, Down, Flat }
    private TrendDir _trendDir = TrendDir.Flat;
    private double _trendPct;
    private string _trendIcon = string.Empty;
    private MudBlazor.Color _trendColor = MudBlazor.Color.Default;
    private string _accentColor = "#1E5F8E";

    protected override void OnParametersSet()
    {
        // Beregn trend
        if (PreviousValue.HasValue && PreviousValue.Value != 0)
        {
            _trendPct = (Value - PreviousValue.Value) / Math.Abs(PreviousValue.Value) * 100;
            // Liten endring (< 0.5 %) regnes som flat — drifts-leder bryr seg
            // ikke om støy
            _trendDir = Math.Abs(_trendPct) < 0.5 ? TrendDir.Flat
                : _trendPct > 0 ? TrendDir.Up : TrendDir.Down;
        }
        else if (PreviousValue.HasValue && PreviousValue.Value == 0 && Value != 0)
        {
            _trendDir = Value > 0 ? TrendDir.Up : TrendDir.Down;
            _trendPct = 0;
        }

        // Pil-ikon + farge
        if (_trendDir == TrendDir.Up)
        {
            _trendIcon = Icons.Material.Filled.TrendingUp;
            _trendColor = HigherIsBetter ? MudBlazor.Color.Success : MudBlazor.Color.Error;
        }
        else if (_trendDir == TrendDir.Down)
        {
            _trendIcon = Icons.Material.Filled.TrendingDown;
            _trendColor = HigherIsBetter ? MudBlazor.Color.Error : MudBlazor.Color.Success;
        }
        else
        {
            _trendColor = MudBlazor.Color.Default;
        }

        // Aksentfarge
        if (AccentColor == "auto")
        {
            _accentColor = _trendDir switch
            {
                TrendDir.Up   => HigherIsBetter ? "#2A9D8F" : "#E76F51",
                TrendDir.Down => HigherIsBetter ? "#E76F51" : "#2A9D8F",
                _ => "#1E5F8E",
            };
        }
        else
        {
            _accentColor = AccentColor;
        }
    }

    private string FormattedValue
    {
        get
        {
            if (double.IsNaN(Value) || double.IsInfinity(Value)) return "–";
            if (SignedValue && Value > 0)
                return "+" + Value.ToString(Format, NorskTall);
            return Value.ToString(Format, NorskTall);
        }
    }

    private static readonly System.Globalization.NumberFormatInfo NorskTall = new()
    {
        NumberGroupSeparator = " ",
        NumberDecimalSeparator = ",",
        NumberGroupSizes = new[] { 3 },
    };
}
