@inject IJSRuntime JS

<MudThemeProvider @ref="_themeProvider" Theme="DalaneTheme.Instance" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="this">
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Ikke funnet</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <MudAlert Severity="Severity.Warning">Siden ble ikke funnet.</MudAlert>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingValue>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _isDarkMode = true;

    public bool IsDarkMode => _isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Speil dark-mode til en CSS-klasse på <body> slik at vi kan bruke
        // CSS-targeting til å fikse ApexCharts og andre tredjepartskomponenter
        // som ikke leser MudBlazor-paletten automatisk.
        await JS.InvokeVoidAsync("eval",
            $"document.body.classList.toggle('dk-dark', {(_isDarkMode ? "true" : "false")})");
    }

    public async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        StateHasChanged();
        await JS.InvokeVoidAsync("eval",
            $"document.body.classList.toggle('dk-dark', {(_isDarkMode ? "true" : "false")})");
    }
}
