<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>KraftverkUptime.Infrastructure</RootNamespace>
    <AssemblyName>KraftverkUptime.Infrastructure</AssemblyName>
    <Description>EF Core, Azure-adaptere, default-implementasjoner av retrofit-sømmer.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Infrastructure fungerer som glue-lag mellom DbContext og modul-kontrakter.
      Derfor refererer vi både Core og domenemoduler: implementasjoner som
      ISettlementImportRecorder og IUptimePeriodProvider bor her fordi de
      behøver KraftverkDbContext og EF Core som Settlement/Reporting ikke ser.
    -->
    <ProjectReference Include="..\KraftverkUptime.Core\KraftverkUptime.Core.csproj" />
    <ProjectReference Include="..\KraftverkUptime.Modules.Settlement\KraftverkUptime.Modules.Settlement.csproj" />
    <ProjectReference Include="..\KraftverkUptime.Modules.Classification\KraftverkUptime.Modules.Classification.csproj" />
    <ProjectReference Include="..\KraftverkUptime.Modules.Reporting\KraftverkUptime.Modules.Reporting.csproj" />
    <ProjectReference Include="..\KraftverkUptime.Modules.Annotations\KraftverkUptime.Modules.Annotations.csproj" />
    <ProjectReference Include="..\KraftverkUptime.Modules.Scada\KraftverkUptime.Modules.Scada.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core + Postgres (10.0.4 kreves av Npgsql.EntityFrameworkCore.PostgreSQL 10.0.1) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.0" />

    <!-- DI og konfig (10.0.4 servicing) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.4" />

    <!-- Azure -->
    <PackageReference Include="Azure.Identity" Version="1.13.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- NoDependencies-varianten pakker libfontconfig/libfreetype med, så
         container-imaget slipper apt-pakker (Spec NESTE-CHAT-OKONOMI-OPPFOLGING
         Funn 5, 2026-05-22). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />

    <!-- Eksplisitt pinning for transitiv sårbarhet (CVE-2026-33116 / GHSA-37gx-xxp4-5rgx + GHSA-w3x6-4m5h-cxqf fikset i 10.0.6) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.6" />

    <!-- OpenTelemetry (1.12.0 fikser CVE-2025-27513 / GHSA-8785-wc3w-h8q6; 1.11.2 ble aldri publisert) -->
    <PackageReference Include="OpenTelemetry" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.12.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.3.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

</Project>
